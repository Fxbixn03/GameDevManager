{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "ASPNETCORE_ENVIRONMENT": "Development"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "Read(*)",
      "WebSearch",
      "WebFetch(domain:squidfunk.github.io)",
      "WebFetch(domain:blazordevelopertools.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:www.nuget.org)",
      "mcp__coplay-mcp__*",
      "mcp__mcp-local-rag__*",
      "mcp__claude_ai_Microsoft_Learn__microsoft_docs_search",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "Skill(humanizer)",
      "Skill(humanizer:*)",
      "PowerShell(dotnet build:*)",
      "PowerShell(dotnet build-server shutdown)",
      "PowerShell(dotnet test:*)",
      "PowerShell(dotnet publish:*)",
      "PowerShell(dotnet package search:*)",
      "PowerShell(node --version)",
      "PowerShell(node --check:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git merge-base:*)",
      "PowerShell(git check-ignore:*)",
      "PowerShell(Get-ChildItem:*)",
      "PowerShell(Get-Item:*)",
      "PowerShell(Get-Content:*)",
      "PowerShell(Get-Process:*)",
      "PowerShell(Get-CimInstance:*)",
      "PowerShell(Get-NetTCPConnection:*)",
      "PowerShell(Select-String:*)",
      "PowerShell(Test-Path:*)",
      "PowerShell(New-Item:*)",
      "PowerShell(Copy-Item:*)",
      "PowerShell(Set-Location:*)",
      "PowerShell(dotnet add src/GameDevManager.Data reference src/GameDevManager.Domain)",
      "PowerShell(dotnet add src/GameDevManager.Data.Migrations.SqlServer reference src/GameDevManager.Data)",
      "PowerShell(dotnet add src/GameDevManager.Data.Migrations.PostgreSql reference src/GameDevManager.Data)",
      "PowerShell(dotnet add src/GameDevManager.Data.Migrations.MySql reference src/GameDevManager.Data)",
      "PowerShell(dotnet add src/GameDevManager.Data.Migrations.Sqlite reference src/GameDevManager.Data)",
      "PowerShell(dotnet add src/GameDevManager.Web reference src/GameDevManager.Data src/GameDevManager.Data.Migrations.SqlServer src/GameDevManager.Data.Migrations.PostgreSql src/GameDevManager.Data.Migrations.MySql src/GameDevManager.Data.Migrations.Sqlite)",
      "PowerShell(dotnet add src/GameDevManager.Data package Microsoft.EntityFrameworkCore.SqlServer)",
      "PowerShell(dotnet add src/GameDevManager.Data package Npgsql.EntityFrameworkCore.PostgreSQL)",
      "PowerShell(dotnet add src/GameDevManager.Data package MySql.EntityFrameworkCore)",
      "PowerShell(dotnet add src/GameDevManager.Data package Microsoft.EntityFrameworkCore.Sqlite)",
      "PowerShell(dotnet add src/GameDevManager.Web package MudBlazor)",
      "PowerShell(dotnet add src/GameDevManager.Web package Microsoft.EntityFrameworkCore.Design)",
      "PowerShell(dotnet new tool-manifest --force)",
      "PowerShell(dotnet tool install dotnet-ef)",
      "PowerShell(dotnet ef migrations add InitialCreate --project src/GameDevManager.Data.Migrations.SqlServer --startup-project src/GameDevManager.Web -- --Database:Provider=SqlServer)",
      "PowerShell(dotnet ef migrations add InitialCreate --project src/GameDevManager.Data.Migrations.PostgreSql --startup-project src/GameDevManager.Web -- --Database:Provider=PostgreSql)",
      "PowerShell(dotnet ef migrations add InitialCreate --project src/GameDevManager.Data.Migrations.MySql --startup-project src/GameDevManager.Web -- --Database:Provider=MySql)",
      "PowerShell(dotnet ef migrations add InitialCreate --project src/GameDevManager.Data.Migrations.Sqlite --startup-project src/GameDevManager.Web -- --Database:Provider=Sqlite)",
      "PowerShell(dotnet run --project src/GameDevManager.Web --no-build --urls http://localhost:5599)",
      "PowerShell($ok=$false; foreach \\($i in 1..20\\) { try { $r = Invoke-WebRequest -Uri http://localhost:5599 -UseBasicParsing -TimeoutSec 3; if \\($r.StatusCode -eq 200\\) { $ok=$true; break } } catch { Start-Sleep -Milliseconds 800 } }; if \\($ok\\) { \"HTTP 200 OK\"; \\($r.Content -match 'GameDevManager'\\) ; \\($r.Content.Substring\\(0, 300\\)\\) } else { \"App antwortet nicht\" })",
      "PowerShell(Test-Path src/GameDevManager.Web/gamedevmanager.db; $r2 = Invoke-WebRequest -Uri http://localhost:5599/modules/items -UseBasicParsing; \"Modulseite: $\\($r2.StatusCode\\)\")",
      "PowerShell(dotnet build --nologo -v q)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(git push --force*)",
      "Bash(git clean:*)",
      "Bash(git reset --hard:*)",
      "Bash(dotnet ef database drop:*)",
      "PowerShell(Remove-Item:*)",
      "PowerShell(git push --force*)",
      "PowerShell(git clean:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(dotnet ef database drop:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git restore:*)",
      "Bash(git checkout --:*)",
      "Bash(dotnet ef migrations remove:*)",
      "Bash(sqlcmd:*)",
      "PowerShell(git push:*)",
      "PowerShell(git restore:*)",
      "PowerShell(git checkout --:*)",
      "PowerShell(dotnet ef migrations remove:*)",
      "PowerShell(sqlcmd:*)"
    ]
  }
}
