{
  "__comment": "Beispiel-Dashboard für die Betriebs-Kennzahlen des GameDevManager. Import in Grafana über Dashboards → New → Import; als Datenquelle einen Prometheus wählen, der /api/v1/metrics?format=prometheus mit dem API-Schlüssel im Header X-API-Key abruft.",
  "title": "GameDevManager – Betrieb",
  "uid": "gdm-betrieb",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datenquelle"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Datenbank erreichbar",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gdm_database_reachable", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "Ja", "color": "green" }, "0": { "text": "Nein", "color": "red" } } }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Projekte",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gdm_projects", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Inhalte gesamt",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gdm_content_entities", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Konten",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gdm_users", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Alter des jüngsten Exportstands",
      "description": "Fehlt die Reihe, wurde noch nie gesichert.",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gdm_newest_snapshot_age_hours", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 26 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Belegter Platz im Asset-Verzeichnis",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gdm_asset_bytes", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Inhalte je Projekt",
      "description": "Die GUID ist das Label — Kennzahlen verraten bewusst keine Namen.",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gdm_project_content_entities", "legendFormat": "{{project}}", "refId": "A" }]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Dauer der Hintergrundläufe",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gdm_background_last_run_seconds", "legendFormat": "{{service}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Fehlgeschlagene Hintergrundläufe seit Prozessstart",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gdm_background_errors_total", "legendFormat": "{{service}}", "refId": "A" }]
    }
  ]
}
