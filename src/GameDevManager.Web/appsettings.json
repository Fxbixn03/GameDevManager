{
  "Database": {
    "Provider": "Sqlite",
    "AutoMigrate": true
  },
  "Assets": {
    "StoragePath": "assets",
    "MaxFileSizeBytes": 20971520
  },
  "Exports": {
    "StoragePath": "exports",
    "MaxPerProject": 20,
    "MaxAgeDays": 0
  },
  "ChangeLog": {
    "MaxAgeDays": 365,
    "MaxPerProject": 0,
    "SweepHours": 24
  },
  "ConnectionStrings": {
    "SqlServer": "Server=localhost;Database=GameDevManager;Trusted_Connection=True;TrustServerCertificate=True",
    "PostgreSql": "Host=localhost;Port=5432;Database=gamedevmanager;Username=postgres;Password=postgres",
    "MySql": "Server=localhost;Port=3306;Database=gamedevmanager;Uid=root;Pwd=root",
    "Sqlite": "Data Source=gamedevmanager.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
