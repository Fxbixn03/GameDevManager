@inject ReferenceService References
@inject ConditionLabels Labels
@inject IStringLocalizer<GameStateAssumptionPanel> L

@*
    Die Zustandsleiste der Auswertungs-Ansichten (Dialog durchspielen, Zustands-Sicht):
    ein angenommener Spielzustand, zusammengeklickt statt gespeichert.

    Angeboten werden genau die Stellschrauben, die in den übergebenen Bedingungen vorkommen —
    ein Panel mit allen Items des Projekts wäre Rauschen. Der Elternteil liest den Zustand
    über @ref (State) und wertet selbst mit dem ConditionEvaluator aus; Describe macht ein
    Ergebnis lesbar, weil hier die aufgelösten Zielnamen liegen.
*@

<MudPaper Elevation="0" Class="gdm-panel pa-4">
    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["Heading"]</MudText>

    <MudStack Spacing="3">
        <MudNumericField T="int"
                         Value="_playerLevel"
                         ValueChanged="@((int v) => ChangeAsync(() => _playerLevel = v))"
                         Label="@L["PlayerLevelLabel"]"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         Min="1" />

        @foreach (var item in _itemKnobs)
        {
            <MudNumericField T="double"
                             Value="@_itemCounts.GetValueOrDefault(item.Id)"
                             ValueChanged="@((double v) => ChangeAsync(() => _itemCounts[item.Id] = v))"
                             Label="@L["ItemCountLabel", item.Name]"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Min="0" />
        }

        @foreach (var currency in _currencyKnobs)
        {
            <MudNumericField T="double"
                             Value="@_currencyAmounts.GetValueOrDefault(currency.Id)"
                             ValueChanged="@((double v) => ChangeAsync(() => _currencyAmounts[currency.Id] = v))"
                             Label="@L["CurrencyLabel", currency.Name]"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Min="0" />
        }

        @foreach (var flag in _flagKnobs)
        {
            <MudSwitch T="bool"
                       Value="@_activeFlags.Contains(flag)"
                       ValueChanged="@((bool v) => ChangeAsync(() => Toggle(_activeFlags, flag, v)))"
                       Color="Color.Primary"
                       Label="@L["FlagLabel", flag]" />
        }

        @foreach (var state in _worldKnobs)
        {
            <MudSwitch T="bool"
                       Value="@_activeWorld.Contains(state.Id)"
                       ValueChanged="@((bool v) => ChangeAsync(() => Toggle(_activeWorld, state.Id, v)))"
                       Color="Color.Primary"
                       Label="@($"{state.Name} ({Labels.Describe(state.Kind)})")" />
        }

        @foreach (var npc in _npcKnobs)
        {
            <MudSwitch T="bool"
                       Value="@_defeated.Contains(npc.Id)"
                       ValueChanged="@((bool v) => ChangeAsync(() => Toggle(_defeated, npc.Id, v)))"
                       Color="Color.Primary"
                       Label="@L["DefeatedLabel", npc.Name]" />
        }

        @foreach (var entry in _unlockKnobs)
        {
            <MudSwitch T="bool"
                       Value="@_unlocked.Contains(entry.Id)"
                       ValueChanged="@((bool v) => ChangeAsync(() => Toggle(_unlocked, entry.Id, v)))"
                       Color="Color.Primary"
                       Label="@L["UnlockedLabel", entry.Name]" />
        }

        @foreach (var quest in _questKnobs)
        {
            <MudTextField T="string"
                          Value="@_questStates.GetValueOrDefault(quest.Id)"
                          ValueChanged="@((string v) => ChangeAsync(() => _questStates[quest.Id] = v))"
                          Label="@L["QuestStateLabel", quest.Name]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true" />
        }

        @if (_hasCustom)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["CustomHint"]</MudText>
        }

        @if (!HasKnobs)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NoKnobsHint"]</MudText>
        }
    </MudStack>
</MudPaper>

@code {
    /// <summary>Die Bedingungen, aus denen die Stellschrauben entstehen.</summary>
    [Parameter, EditorRequired]
    public List<Condition> Conditions { get; set; } = [];

    /// <summary>Feuert nach jeder Änderung — der Elternteil wertet dann neu aus.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private int _playerLevel = 1;
    private readonly Dictionary<Guid, double> _itemCounts = [];
    private readonly Dictionary<Guid, double> _currencyAmounts = [];
    private readonly HashSet<string> _activeFlags = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<Guid> _activeWorld = [];
    private readonly HashSet<Guid> _defeated = [];
    private readonly HashSet<Guid> _unlocked = [];
    private readonly Dictionary<Guid, string> _questStates = [];

    private List<(Guid Id, string Name)> _itemKnobs = [];
    private List<(Guid Id, string Name)> _currencyKnobs = [];
    private List<string> _flagKnobs = [];
    private List<(Guid Id, string Name, ConditionKind Kind)> _worldKnobs = [];
    private List<(Guid Id, string Name)> _npcKnobs = [];
    private List<(Guid Id, string Name)> _unlockKnobs = [];
    private List<(Guid Id, string Name)> _questKnobs = [];
    private readonly Dictionary<Guid, string> _targetNames = [];
    private bool _hasCustom;
    private List<Condition>? _builtFor;

    /// <summary>Der aktuell eingestellte Zustand — der Elternteil rechnet damit.</summary>
    public GameStateAssumption State => new()
    {
        PlayerLevel = _playerLevel,
        Items = _itemCounts,
        Currencies = _currencyAmounts,
        Flags = _activeFlags,
        ActiveWorldStates = _activeWorld,
        DefeatedNpcs = _defeated,
        Unlocked = _unlocked,
        QuestStates = _questStates
    };

    private bool HasKnobs =>
        _itemKnobs.Count > 0 || _currencyKnobs.Count > 0 || _flagKnobs.Count > 0
        || _worldKnobs.Count > 0 || _npcKnobs.Count > 0 || _unlockKnobs.Count > 0
        || _questKnobs.Count > 0;

    protected override async Task OnParametersSetAsync()
    {
        if (ReferenceEquals(_builtFor, Conditions))
        {
            return;
        }

        _builtFor = Conditions;
        await BuildKnobsAsync();
    }

    private async Task ChangeAsync(Action change)
    {
        change();
        await OnChanged.InvokeAsync();
    }

    private async Task BuildKnobsAsync()
    {
        _hasCustom = Conditions.Any(condition => condition.Kind == ConditionKind.Custom);

        _flagKnobs =
        [
            .. Conditions
                .Where(condition => condition.Kind == ConditionKind.Flag
                    && !string.IsNullOrWhiteSpace(condition.TextValue))
                .Select(condition => condition.TextValue!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(flag => flag, StringComparer.OrdinalIgnoreCase)
        ];

        _itemKnobs = await ResolveAsync(ConditionKind.HasItem);
        _currencyKnobs = await ResolveAsync(ConditionKind.HasCurrency);
        _npcKnobs = await ResolveAsync(ConditionKind.NpcDefeated);
        _questKnobs = await ResolveAsync(ConditionKind.QuestState);

        var world = new List<(Guid, string, ConditionKind)>();
        foreach (var kind in new[] { ConditionKind.TimeOfDay, ConditionKind.Weather, ConditionKind.Biome })
        {
            world.AddRange((await ResolveAsync(kind)).Select(entry => (entry.Id, entry.Name, kind)));
        }
        _worldKnobs = world;

        // Freischaltbar ist alles — das Modul steht an der Bedingung selbst.
        var unlockables = new List<(Guid Id, string Name)>();
        foreach (var perModule in Conditions
            .Where(condition => condition.Kind == ConditionKind.Unlocked
                && condition.TargetEntityId is not null
                && condition.TargetModuleKey is not null)
            .GroupBy(condition => condition.TargetModuleKey!))
        {
            var ids = perModule.Select(condition => condition.TargetEntityId!.Value).Distinct().ToList();
            var names = await References.ResolveNamesAsync(perModule.Key, ids);
            foreach (var entry in names)
            {
                _targetNames[entry.Key] = entry.Value;
            }
            unlockables.AddRange(ids.Select(id => (id, names.GetValueOrDefault(id, L["UnknownTarget"].Value))));
        }
        _unlockKnobs = [.. unlockables.OrderBy(entry => entry.Name)];
    }

    /// <summary>Die Ziele einer Bedingungsart samt Namen — über das Modul, das die Art festlegt.</summary>
    private async Task<List<(Guid Id, string Name)>> ResolveAsync(ConditionKind kind)
    {
        var sample = Conditions.FirstOrDefault(condition => condition.Kind == kind);
        var ids = Conditions
            .Where(condition => condition.Kind == kind && condition.TargetEntityId is not null)
            .Select(condition => condition.TargetEntityId!.Value)
            .Distinct()
            .ToList();

        if (ids.Count == 0 || sample?.ExpectedTargetModule is not { } moduleKey)
        {
            return [];
        }

        var names = await References.ResolveNamesAsync(moduleKey, ids);
        foreach (var entry in names)
        {
            _targetNames[entry.Key] = entry.Value;
        }

        return
        [
            .. ids
                .Select(id => (id, names.GetValueOrDefault(id, L["UnknownTarget"].Value)))
                .OrderBy(entry => entry.Item2)
        ];
    }

    private static void Toggle<T>(HashSet<T> set, T value, bool active)
    {
        if (active)
        {
            set.Add(value);
        }
        else
        {
            set.Remove(value);
        }
    }

    /// <summary>Eine Bedingung als lesbarer Satzteil — Art, Ziel, Vergleich, was davon trägt.</summary>
    public string Describe(ConditionResult result)
    {
        var condition = result.Condition;
        var parts = new List<string> { Labels.Describe(condition.Kind) };

        if (condition.TargetEntityId is { } target)
        {
            parts.Add(_targetNames.GetValueOrDefault(target, L["UnknownTarget"].Value));
        }

        if (condition.Kind == ConditionKind.Flag || condition.Kind == ConditionKind.QuestState)
        {
            parts.Add(condition.TextValue ?? string.Empty);
        }

        if (condition.UsesNumber)
        {
            parts.Add($"{Labels.Describe(condition.Operator)} {condition.NumberValue ?? 1}");
        }

        if (condition.UsesBoolean && condition.BooleanValue == false)
        {
            parts.Add(L["Negated"]);
        }

        return string.Join(" · ", parts.Where(part => !string.IsNullOrWhiteSpace(part)));
    }
}
