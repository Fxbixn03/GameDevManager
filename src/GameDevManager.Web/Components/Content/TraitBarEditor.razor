@inject IStringLocalizer<TraitBarEditor> L

@* Die zehn festen Wesenszüge eines NPCs als klickbare Balken: zehn gestrichelte Segmente je
   Zug, von links gefüllt bis zum eingestellten Wert. Ein Klick auf ein Segment setzt den
   Wert; ein Klick auf das bereits letzte gefüllte Segment setzt auf 0 zurück — so braucht
   „kein Wert“ keinen eigenen Knopf. Gespeichert wird die kanonische Textspalte über
   GameDevManager.Domain.Entities.NpcTraits.

   Jeder Zug hat seine eigene Farbe — siehe TraitColors unten. Sie trägt keine Bedeutung,
   die nicht auch dastünde (Bezeichnung und Zahl stehen daneben), sondern macht die zehn
   Zeilen im Überblick auseinanderhaltbar. *@

<MudStack Spacing="2">
    @foreach (var key in NpcTraits.Keys)
    {
        var value = _values.GetValueOrDefault(key);

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudText Typo="Typo.body2" Style="width:140px;flex-shrink:0;">@L[$"Trait_{key}"]</MudText>

            <div style="display:flex;gap:4px;flex-grow:1;max-width:340px;"
                 role="group"
                 aria-label="@L[$"Trait_{key}"]">
                @for (var segment = 1; segment <= NpcTraits.MaxValue; segment++)
                {
                    var target = segment;
                    var filled = segment <= value;

                    <div style="@SegmentStyle(filled, key)"
                         title="@L["SegmentTooltip", L[$"Trait_{key}"].Value, target]"
                         @onclick="@(() => SetAsync(key, target))"></div>
                }
            </div>

            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="gdm-mono" Style="width:36px;text-align:right;">
                @value/@NpcTraits.MaxValue
            </MudText>
        </MudStack>
    }
</MudStack>

@code {
    /// <summary>Die kanonische Textspalte <c>Npc.Traits</c>.</summary>
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private Dictionary<string, int> _values = [];
    private string? _parsedFrom;

    protected override void OnParametersSet()
    {
        // Nur neu lesen, wenn der Wert wirklich von außen kam — sonst überschriebe jede
        // eigene Änderung sich beim Rerender selbst.
        if (!string.Equals(_parsedFrom, Value, StringComparison.Ordinal) || _values.Count == 0)
        {
            _values = NpcTraits.Parse(Value);
            _parsedFrom = Value;
        }
    }

    /// <summary>
    /// Eine feste Farbe je Wesenszug, gewählt nach der Wirkung der Farbe: Rot für Mut, Blau
    /// für Treue, Gelb als Warnfarbe fürs Risiko, Grau für den Vorbehalt des Misstrauens.
    /// Empathie und Mitgefühl liegen inhaltlich nah beieinander und werden deshalb bewusst
    /// getrennt — das ruhige Türkis des Sich-Einfühlens gegen das warme Rosé der Güte.
    /// <para>
    /// Bewusst feste Werte und keine Theme-Farben, dieselbe Überlegung wie bei den
    /// Fraktionsringen der Verbindungen: Es braucht zehn nebeneinander unterscheidbare Töne,
    /// und die hat die Palette nicht. Die Helligkeit ist so gewählt, dass sie auf hellem wie
    /// dunklem Grund trägt.
    /// </para>
    /// </summary>
    private static readonly Dictionary<string, string> TraitColors = new()
    {
        ["empathy"] = "#4DB6AC",        // Türkis — zugewandt, ruhig
        ["impulsiveness"] = "#FF8A65",  // Orange — Spontaneität, Bewegung
        ["loyalty"] = "#7986CB",        // Indigo — Treue, Beständigkeit
        ["courage"] = "#E57373",        // Rot — Mut, Tatkraft
        ["honesty"] = "#4FC3F7",        // Hellblau — Klarheit, Offenheit
        ["dominance"] = "#BA68C8",      // Violett — Rang, Herrschaft
        ["patience"] = "#81C784",       // Grün — Ruhe, Wachsenlassen
        ["distrust"] = "#90A4AE",       // Graublau — Distanz, Vorbehalt
        ["riskTaking"] = "#FFC300",     // Gelb — Warnzeichen, Wagnis
        ["compassion"] = "#F06292"      // Rosé — Wärme, Güte
    };

    /// <summary>Ein unbekannter Zug fällt auf den Akzent zurück — er sähe sonst wie „leer“ aus.</summary>
    private static string ColorFor(string key) =>
        TraitColors.GetValueOrDefault(key, "var(--mud-palette-primary)");

    private string SegmentStyle(bool filled, string key) =>
        "flex:1 1 0;height:16px;box-sizing:border-box;"
        + (Disabled ? "" : "cursor:pointer;")
        + "border:1px dashed var(--mud-palette-lines-inputs);"
        + (filled ? $"background:{ColorFor(key)};border-style:solid;" : "background:transparent;");

    private async Task SetAsync(string key, int target)
    {
        if (Disabled)
        {
            return;
        }

        // Klick auf das letzte gefüllte Segment nimmt den Wert ganz zurück.
        _values[key] = _values.GetValueOrDefault(key) == target ? 0 : target;

        Value = NpcTraits.Format(_values);
        _parsedFrom = Value;
        await ValueChanged.InvokeAsync(Value);
    }
}
