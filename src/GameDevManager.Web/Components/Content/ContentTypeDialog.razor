@inject IStringLocalizer<ContentTypeDialog> L

@*
    Anlegen und Bearbeiten einer Art (Item-Art „Waffe“, NPC-Art „Händler“, …). Die Felder der
    Art werden nicht hier, sondern auf der Arten-Seite gepflegt.
*@

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@(string.IsNullOrWhiteSpace(Type.Icon) ? Icons.Material.Filled.Style : Type.Icon)" />
            <MudText Typo="Typo.h6">@(IsNew ? L["TitleNew"] : L["TitleEdit"])</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="4" Style="min-width:min(520px, 80vw);">
            <MudTextField @bind-Value="Type.Name"
                          Label="@L["NameLabel"]"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Required="true"
                          HelperText="@L["NameHelper"]" />

            <MudTextField @bind-Value="Type.Description"
                          Label="@L["DescriptionLabel"]"
                          Variant="Variant.Outlined"
                          Lines="2" />

            @* Unterart: Die Felder der Eltern-Art gelten dann zusätzlich. Angeboten wird nur,
               was keinen Ring ergäbe — die Art selbst und ihre eigenen Unterarten fehlen. *@
            <MudSelect T="Guid?"
                       @bind-Value="Type.ParentId"
                       Label="@L["ParentLabel"]"
                       Variant="Variant.Outlined"
                       Clearable="true"
                       HelperText="@L["ParentHelper"]">
                @foreach (var candidate in ParentChoices)
                {
                    <MudSelectItem T="Guid?" Value="@candidate.Id">@candidate.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="string"
                       @bind-Value="Type.Icon"
                       Label="@L["IconLabel"]"
                       Variant="Variant.Outlined"
                       Clearable="true">
                @foreach (var icon in IconChoices)
                {
                    <MudSelectItem T="string" Value="@icon.Value">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@icon.Value" Size="Size.Small" />
                            <MudText Typo="Typo.body2">@L[icon.Key]</MudText>
                        </MudStack>
                    </MudSelectItem>
                }
            </MudSelect>

            <MudNumericField @bind-Value="Type.SortOrder"
                             Label="@L["SortOrderLabel"]"
                             Variant="Variant.Outlined"
                             HelperText="@L["SortOrderHelper"]" />

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">@L["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">@L["Submit"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public required ContentType Type { get; set; }

    [Parameter]
    public bool IsNew { get; set; }

    /// <summary>
    /// Alle Arten des Moduls in Hierarchie-Reihenfolge — daraus wird die Auswahl der
    /// Eltern-Art gebildet.
    /// </summary>
    [Parameter]
    public IReadOnlyList<ContentType> AllTypes { get; set; } = [];

    private string? _error;

    /// <summary>
    /// Die möglichen Eltern-Arten: alle außer der Art selbst und ihren Nachfahren. Eine Art zu
    /// ihrer eigenen Unterart zu machen, lehnt der Dienst ohnehin ab — hier steht es gar nicht
    /// erst zur Wahl.
    /// </summary>
    private List<ContentType> ParentChoices
    {
        get
        {
            var blocked = new HashSet<Guid> { Type.Id };

            // AllTypes steht in Hierarchie-Reihenfolge: Eltern immer vor ihren Kindern.
            // Ein Durchlauf genügt deshalb, um alle Nachfahren einzusammeln.
            foreach (var candidate in AllTypes)
            {
                if (candidate.ParentId is { } parentId && blocked.Contains(parentId))
                {
                    blocked.Add(candidate.Id);
                }
            }

            return [.. AllTypes.Where(candidate => !blocked.Contains(candidate.Id))];
        }
    }

    /// <summary>
    /// Kleine kuratierte Auswahl statt freier Icon-Eingabe — die Material-Namen kennt niemand
    /// auswendig, und ein Tippfehler ergäbe ein leeres Icon. Der Schlüssel ist der resx-Name,
    /// nicht die Beschriftung selbst — sonst hinge die Auswahl an einer Sprache.
    /// </summary>
    private static readonly Dictionary<string, string> IconChoices = new()
    {
        ["IconGeneral"] = Icons.Material.Filled.Category,
        ["IconWeapon"] = Icons.Material.Filled.Hardware,
        ["IconArmor"] = Icons.Material.Filled.Shield,
        ["IconPotion"] = Icons.Material.Filled.Science,
        ["IconFood"] = Icons.Material.Filled.Restaurant,
        ["IconResource"] = Icons.Material.Filled.Grass,
        ["IconTool"] = Icons.Material.Filled.Build,
        ["IconJewelry"] = Icons.Material.Filled.Diamond,
        ["IconKey"] = Icons.Material.Filled.VpnKey,
        ["IconBook"] = Icons.Material.Filled.MenuBook,
        ["IconCurrency"] = Icons.Material.Filled.Paid,
        ["IconMagic"] = Icons.Material.Filled.AutoAwesome,
        ["IconAmmunition"] = Icons.Material.Filled.Bolt,
        ["IconContainer"] = Icons.Material.Filled.Inventory2,
        ["IconQuest"] = Icons.Material.Filled.Assignment
    };

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(Type.Name))
        {
            _error = L["NameRequired"];
            return;
        }

        _error = null;
        MudDialog.Close(DialogResult.Ok(Type));
    }
}
