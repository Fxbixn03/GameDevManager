@inject NpcService Npcs
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IStringLocalizer<NpcRelationTypesDialog> L

@*
    Verwaltet die Beziehungsarten zwischen NPCs. Jede Art ist ein Bezeichnungspaar —
    „Ist Vater von“ mit der Gegenrichtung „Ist Sohn von“; symmetrische Beziehungen tragen
    auf beiden Seiten denselben Text.
*@

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.People" />
            <MudText Typo="Typo.h6">@L["Title"]</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="3" Style="min-width:min(620px, 85vw);">
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Explanation"]</MudText>

            @if (_types.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @L["EmptyHint"]
                </MudText>
            }
            else
            {
                @foreach (var type in _types)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudTextField Value="type.Name"
                                      ValueChanged="@((string name) => RenameAsync(type, name, type.InverseName))"
                                      T="string"
                                      Label="@L["ForwardLabel"]"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                        <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Secondary" />
                        <MudTextField Value="type.InverseName"
                                      ValueChanged="@((string name) => RenameAsync(type, type.Name, name))"
                                      T="string"
                                      Label="@L["InverseLabel"]"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                        <MudTooltip Text="@L["DeleteTooltip"]">
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                           Size="Size.Small"
                                           OnClick="@(() => DeleteAsync(type))"
                                           aria-label="@L["DeleteAria", type.Name]" />
                        </MudTooltip>
                    </MudStack>
                }
            }

            <MudDivider Class="my-1" />

            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudTextField @bind-Value="_newName"
                              Label="@L["NewForwardLabel"]"
                              Placeholder="@L["NewForwardPlaceholder"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true" />
                <MudTextField @bind-Value="_newInverseName"
                              Label="@L["NewInverseLabel"]"
                              Placeholder="@L["NewInversePlaceholder"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              OnKeyDown="OnKeyDown" />
                <MudButton StartIcon="@Icons.Material.Filled.Add"
                           Size="Size.Small"
                           Disabled="@(string.IsNullOrWhiteSpace(_newName) || string.IsNullOrWhiteSpace(_newInverseName))"
                           OnClick="AddAsync">
                    @L["AddType"]
                </MudButton>
            </MudStack>

            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SymmetricHint"]</MudText>
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => MudDialog.Close(DialogResult.Ok(true)))">
            @L["Done"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private List<NpcRelationType> _types = [];
    private string? _newName;
    private string? _newInverseName;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() =>
        _types = await Npcs.GetRelationTypesAsync(await Project.GetCurrentIdAsync());

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or "NumpadEnter")
        {
            await AddAsync();
        }
    }

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName) || string.IsNullOrWhiteSpace(_newInverseName))
        {
            return;
        }

        await SaveAsync(new NpcRelationType
        {
            GameProjectId = await Project.GetCurrentIdAsync(),
            Name = _newName,
            InverseName = _newInverseName
        });

        _newName = null;
        _newInverseName = null;
    }

    private Task RenameAsync(NpcRelationType type, string name, string inverseName)
    {
        type.Name = name;
        type.InverseName = inverseName;
        return SaveAsync(type);
    }

    private async Task SaveAsync(NpcRelationType type)
    {
        try
        {
            await Npcs.SaveRelationTypeAsync(type);
            await LoadAsync();
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(NpcRelationType type)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", type.Name],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Npcs.DeleteRelationTypeAsync(type.Id);
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }

        await LoadAsync();
    }
}
