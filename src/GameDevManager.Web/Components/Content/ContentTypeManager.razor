@inject ContentTypeService ContentTypes
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IStringLocalizer<ContentTypeManager> L
@inject FieldTypeLabels FieldTypes
@inject ModuleLabels Modules

@*
    Verwaltung der Arten eines Moduls samt ihrer Felder — modulübergreifend, weil Arten und
    Felder laut Konzept überall gleich funktionieren. Die Modulseiten binden sie nur ein und
    geben ihren Modul-Schlüssel mit.
*@

@if (_types is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_types.Count == 0)
{
    <div class="gdm-empty">
        <MudIcon Icon="@Icons.Material.Filled.Style" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
        <MudText Typo="Typo.h6">@EmptyTitleText</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">@EmptyHintText</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddTypeAsync">@L["FirstType"]</MudButton>
    </div>
}
else
{
    <MudStack Spacing="4">
        @foreach (var type in _types)
        {
            @* Felder je Art eingeklappt (CollapsiblePanel-Standard); der Zustand überlebt das
               Neuladen der Liste, weil @key die Komponente an der Art festhält. *@
            <CollapsiblePanel @key="type.Id"
                              ExpandLabel="@L["ShowFieldsTooltip"]"
                              CollapseLabel="@L["HideFieldsTooltip"]">
                <HeaderContent>
                    @* Unterarten rücken ein — die Liste steht in Hierarchie-Reihenfolge, damit
                       die Zugehörigkeit ohne Aufklappen zu sehen ist. *@
                    @if (Depth(type) > 0)
                    {
                        <span style="display:inline-block;width:@(Depth(type) * 24)px;"></span>
                        <MudIcon Icon="@Icons.Material.Filled.SubdirectoryArrowRight"
                                 Size="Size.Small"
                                 Color="Color.Secondary" />
                    }
                    <MudIcon Icon="@(string.IsNullOrWhiteSpace(type.Icon) ? Icons.Material.Filled.Style : type.Icon)"
                             Color="Color.Primary" />
                    <div>
                        <MudText Typo="Typo.h6">@type.Name</MudText>
                        @if (!string.IsNullOrWhiteSpace(type.Description))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@type.Description</MudText>
                        }
                    </div>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">
                        @(type.Fields.Count == 1 ? L["FieldCountOne"] : L["FieldCountMany", type.Fields.Count])
                    </MudChip>
                    @if (type.InheritedFields.Count > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary">
                            @L["InheritedCount", type.InheritedFields.Count, ParentName(type)]
                        </MudChip>
                    }
                </HeaderContent>

                <HeaderActions>
                    <MudButton StartIcon="@Icons.Material.Filled.Add"
                               Size="Size.Small"
                               OnClick="@(() => AddFieldAsync(type))">
                        @L["AddField"]
                    </MudButton>
                    <MudTooltip Text="@L["EditTypeTooltip"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       OnClick="@(() => EditTypeAsync(type))"
                                       aria-label="@L["EditTypeAria", type.Name]" />
                    </MudTooltip>
                    <MudTooltip Text="@L["DeleteTypeTooltip"]">
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteTypeAsync(type))"
                                       aria-label="@L["DeleteTypeAria", type.Name]" />
                    </MudTooltip>
                </HeaderActions>

                <ChildContent>
                    @* Geerbte Felder zuerst und nur zum Nachsehen — geändert werden sie an
                       ihrer Eltern-Art, sonst gälte die Änderung nur für eine Unterart. *@
                    @foreach (var inherited in type.InheritedFields)
                    {
                        <div class="pa-3 gdm-field-row">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                <MudIcon Icon="@FieldTypeLabels.Icon(inherited.Type)" Size="Size.Small" Color="Color.Secondary" />
                                <div>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudText Typo="Typo.body1" Color="Color.Secondary">@inherited.Name</MudText>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary">
                                            @L["InheritedFrom", OwnerName(inherited)]
                                        </MudChip>
                                        @if (inherited.IsRequired)
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                                @L["RequiredChip"]
                                            </MudChip>
                                        }
                                    </MudStack>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@DescribeField(inherited)</MudText>
                                </div>
                            </MudStack>
                        </div>
                    }

                    @if (type.Fields.Count == 0)
                    {
                        <div class="pa-4">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @(type.InheritedFields.Count > 0 ? L["OnlyInheritedFields"] : L["NoFields"])
                            </MudText>
                        </div>
                    }
                    else
                    {
                        @foreach (var field in type.Fields)
                        {
                            <div class="pa-3 gdm-field-row">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="3">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                        <MudIcon Icon="@FieldTypeLabels.Icon(field.Type)" Size="Size.Small" Color="Color.Secondary" />
                                        <div>
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                <MudText Typo="Typo.body1">@field.Name</MudText>
                                                @if (field.IsRequired)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                                        @L["RequiredChip"]
                                                    </MudChip>
                                                }
                                            </MudStack>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@DescribeField(field)</MudText>
                                        </div>
                                    </MudStack>

                                    <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center">
                                        <MudTooltip Text="@L["MoveUpTooltip"]">
                                            <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                                                           Size="Size.Small"
                                                           Disabled="@(type.Fields.IndexOf(field) == 0)"
                                                           OnClick="@(() => MoveFieldAsync(type, field, -1))"
                                                           aria-label="@L["MoveUpAria"]" />
                                        </MudTooltip>
                                        <MudTooltip Text="@L["MoveDownTooltip"]">
                                            <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                                           Size="Size.Small"
                                                           Disabled="@(type.Fields.IndexOf(field) == type.Fields.Count - 1)"
                                                           OnClick="@(() => MoveFieldAsync(type, field, 1))"
                                                           aria-label="@L["MoveDownAria"]" />
                                        </MudTooltip>
                                        <MudTooltip Text="@L["EditFieldTooltip"]">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Size="Size.Small"
                                                           OnClick="@(() => EditFieldAsync(field))"
                                                           aria-label="@L["EditFieldAria", field.Name]" />
                                        </MudTooltip>
                                        <MudTooltip Text="@L["DeleteFieldTooltip"]">
                                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                           Size="Size.Small"
                                                           OnClick="@(() => DeleteFieldAsync(field))"
                                                           aria-label="@L["DeleteFieldAria", field.Name]" />
                                        </MudTooltip>
                                    </MudStack>
                                </MudStack>
                            </div>
                        }
                    }
                </ChildContent>
            </CollapsiblePanel>
        }
    </MudStack>
}

@code {
    [Parameter, EditorRequired]
    public required string ModuleKey { get; set; }

    /// <summary>
    /// Wie die Entitäten dieses Moduls heißen — für Meldungen wie „von 3 Item(s) verwendet“.
    /// Bleibt der Parameter leer, greift der Standardtext aus der resx; deshalb ist er nullable
    /// und wird über die …Text-Eigenschaften aufgelöst statt über einen Feldinitialisierer.
    /// </summary>
    [Parameter]
    public string? EntityNoun { get; set; }

    [Parameter]
    public string? EmptyTitle { get; set; }

    [Parameter]
    public string? EmptyHint { get; set; }

    private string EntityNounText =>
        string.IsNullOrWhiteSpace(EntityNoun) ? L["DefaultEntityNoun"] : EntityNoun;

    private string EmptyTitleText =>
        string.IsNullOrWhiteSpace(EmptyTitle) ? L["DefaultEmptyTitle"] : EmptyTitle;

    private string EmptyHintText =>
        string.IsNullOrWhiteSpace(EmptyHint) ? L["DefaultEmptyHint"] : EmptyHint;

    /// <summary>Meldet der Seite, wie viele Arten es gibt — für die Kopfzeile.</summary>
    [Parameter]
    public EventCallback<int> OnLoaded { get; set; }

    private List<ContentType>? _types;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    /// <summary>Lädt die Arten neu — auch von außen aufrufbar, etwa nach dem Anlegen.</summary>
    public async Task LoadAsync()
    {
        var projectId = await Project.GetCurrentIdAsync();
        _types = await ContentTypes.GetTypesAsync(projectId, ModuleKey);

        await OnLoaded.InvokeAsync(_types.Count);
        StateHasChanged();
    }

    /// <summary>Öffnet den Dialog für eine neue Art — die Seite ruft das über ihren Knopf auf.</summary>
    public async Task AddTypeAsync()
    {
        var projectId = await Project.GetCurrentIdAsync();

        await ShowTypeDialogAsync(new ContentType
        {
            GameProjectId = projectId,
            ModuleKey = ModuleKey,
            Name = string.Empty,
            SortOrder = _types?.Count ?? 0
        }, isNew: true);
    }

    private Task EditTypeAsync(ContentType type) =>
        ShowTypeDialogAsync(new ContentType
        {
            Id = type.Id,
            GameProjectId = type.GameProjectId,
            ModuleKey = type.ModuleKey,
            ParentId = type.ParentId,
            Name = type.Name,
            Description = type.Description,
            Icon = type.Icon,
            SortOrder = type.SortOrder
        }, isNew: false);

    private async Task ShowTypeDialogAsync(ContentType draft, bool isNew)
    {
        var parameters = new DialogParameters<ContentTypeDialog>
        {
            { dialog => dialog.Type, draft },
            { dialog => dialog.IsNew, isNew },
            { dialog => dialog.AllTypes, (IReadOnlyList<ContentType>)(_types ?? []) }
        };

        var reference = await Dialogs.ShowAsync<ContentTypeDialog>(
            isNew ? L["NewTypeDialogTitle"] : L["EditTypeDialogTitle"],
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await reference.Result;
        if (result is null || result.Canceled || result.Data is not ContentType edited)
        {
            return;
        }

        try
        {
            await ContentTypes.SaveTypeAsync(edited);
            await LoadAsync();
            Snackbar.Add(L["TypeSavedMessage", edited.Name], Severity.Success);
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteTypeAsync(ContentType type)
    {
        var usages = await ContentTypes.CountUsagesAsync(ModuleKey, type.Id);

        if (usages > 0)
        {
            Snackbar.Add(
                L["TypeInUseMessage", type.Name, usages, EntityNounText],
                Severity.Warning);
            return;
        }

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteTypeTitle"],
            L["DeleteTypeMessage", type.Name, type.Fields.Count],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await ContentTypes.DeleteTypeAsync(type.Id);
            await LoadAsync();
            Snackbar.Add(L["TypeDeletedMessage"], Severity.Success);
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    // ----------------------------------------------------------------------------- Felder

    private async Task AddFieldAsync(ContentType type) =>
        await ShowFieldDialogAsync(new FieldDefinition
        {
            ModuleKey = ModuleKey,
            ContentTypeId = type.Id,
            Name = string.Empty,
            SortOrder = await ContentTypes.GetNextFieldSortOrderAsync(type.Id, null)
        }, isNew: true);

    private Task EditFieldAsync(FieldDefinition field) =>
        ShowFieldDialogAsync(field.Clone(), isNew: false);

    private async Task ShowFieldDialogAsync(FieldDefinition draft, bool isNew)
    {
        var parameters = new DialogParameters<FieldDefinitionDialog>
        {
            { dialog => dialog.Field, draft },
            { dialog => dialog.IsNew, isNew }
        };

        var reference = await Dialogs.ShowAsync<FieldDefinitionDialog>(
            isNew ? L["NewFieldDialogTitle"] : L["EditFieldDialogTitle"],
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await reference.Result;
        if (result is null || result.Canceled || result.Data is not FieldDefinition edited)
        {
            return;
        }

        try
        {
            await ContentTypes.SaveFieldAsync(edited);
            await LoadAsync();
            Snackbar.Add(L["FieldSavedMessage", edited.Name], Severity.Success);
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteFieldAsync(FieldDefinition field)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteFieldTitle"],
            L["DeleteFieldMessage", field.Name],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await ContentTypes.DeleteFieldAsync(field.Id);
        await LoadAsync();
        Snackbar.Add(L["FieldDeletedMessage"], Severity.Success);
    }

    /// <summary>Tauscht ein Feld mit seinem Nachbarn und schreibt beide Sortiernummern fort.</summary>
    private async Task MoveFieldAsync(ContentType type, FieldDefinition field, int offset)
    {
        var index = type.Fields.IndexOf(field);
        var targetIndex = index + offset;

        if (index < 0 || targetIndex < 0 || targetIndex >= type.Fields.Count)
        {
            return;
        }

        var neighbour = type.Fields[targetIndex];
        (field.SortOrder, neighbour.SortOrder) = (targetIndex, index);

        await ContentTypes.SaveFieldAsync(field);
        await ContentTypes.SaveFieldAsync(neighbour);
        await LoadAsync();
    }

    /// <summary>
    /// Wie tief eine Art in der Hierarchie steckt — nur für die Einrückung. Zählt über die
    /// Eltern-Kette und bricht ab, wenn eine Art zweimal vorkommt.
    /// </summary>
    private int Depth(ContentType type)
    {
        var byId = (_types ?? []).ToDictionary(t => t.Id);
        var seen = new HashSet<Guid> { type.Id };
        var depth = 0;

        var current = type;
        while (current.ParentId is { } parentId
               && byId.TryGetValue(parentId, out var parent)
               && seen.Add(parentId))
        {
            depth++;
            current = parent;
        }

        return depth;
    }

    private string ParentName(ContentType type) =>
        (_types ?? []).FirstOrDefault(candidate => candidate.Id == type.ParentId)?.Name ?? string.Empty;

    /// <summary>An welcher Art ein geerbtes Feld tatsächlich hängt.</summary>
    private string OwnerName(FieldDefinition field) =>
        (_types ?? []).FirstOrDefault(candidate => candidate.Id == field.ContentTypeId)?.Name ?? string.Empty;

    private string DescribeField(FieldDefinition field)
    {
        var parts = new List<string> { FieldTypes.Describe(field.Type) };

        if (field.Type == ContentFieldType.EntityReference)
        {
            parts.Add(L["ReferenceTarget", Modules.NameOrKey(field.ReferenceModuleKey)]);
        }

        if (field.Type == ContentFieldType.Select && field.Options.Count > 0)
        {
            parts.Add(string.Join(" · ", field.Options.Select(option => option.Label)));
        }

        if (!string.IsNullOrWhiteSpace(field.Unit))
        {
            parts.Add(L["UnitFormat", field.Unit]);
        }

        if (!string.IsNullOrWhiteSpace(field.Description))
        {
            parts.Add(field.Description);
        }

        return string.Join(" — ", parts);
    }
}
