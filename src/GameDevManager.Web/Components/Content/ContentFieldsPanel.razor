@typeparam TEntity where TEntity : ContentEntity
@inject ContentTypeService ContentTypes
@inject ReferenceService References
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IStringLocalizer<ContentFieldsPanelText> L

@*
    Die beiden Feldabschnitte einer Bearbeitungsmaske: die Felder der gewählten Art und die
    individuellen Felder dieser einen Entität. Für jedes Modul gleich — deshalb hier und nicht
    in den Modulseiten.
*@

@if (Context.SelectedType is { } selectedType)
{
    <MudPaper Elevation="0" Class="gdm-panel pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudText Typo="Typo.overline" Color="Color.Secondary">
                @L["SectionTypeFields", selectedType.Name]
            </MudText>
            <MudTooltip Text="@L["EditTypeFieldsTooltip"]">
                <MudIconButton Icon="@Icons.Material.Filled.Tune"
                               Size="Size.Small"
                               Href="@TypesRoute"
                               aria-label="@L["EditTypeFieldsTooltip"]" />
            </MudTooltip>
        </MudStack>

        @if (Context.TypeFields.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["TypeWithoutFields"]</MudText>
        }
        else
        {
            <MudStack Spacing="4">
                @foreach (var field in Context.TypeFields)
                {
                    <DynamicFieldInput Definition="field"
                                       Value="Context.ValueFor(field)"
                                       ReferenceOptions="OptionsFor(field)"
                                       OnValueChanged="OnValueChanged" />
                }
            </MudStack>
        }
    </MudPaper>
}

<MudPaper Elevation="0" Class="gdm-panel pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
        <MudText Typo="Typo.overline" Color="Color.Secondary">@L["SectionIndividualFields"]</MudText>
        <MudButton StartIcon="@Icons.Material.Filled.Add"
                   Size="Size.Small"
                   Disabled="Context.IsNew"
                   OnClick="AddFieldAsync">
            @L["AddField"]
        </MudButton>
    </MudStack>

    @if (Context.IsNew)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @L["NewEntityHint"]
        </MudText>
    }
    else if (Context.IndividualFields.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">@IndividualHintText</MudText>
    }
    else
    {
        <MudStack Spacing="4">
            @foreach (var field in Context.IndividualFields)
            {
                <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                    <div style="flex:1 1 auto; min-width:0;">
                        <DynamicFieldInput Definition="field"
                                           Value="Context.ValueFor(field)"
                                           ReferenceOptions="OptionsFor(field)"
                                           OnValueChanged="OnValueChanged" />
                    </div>
                    <MudTooltip Text="@L["EditFieldTooltip"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       OnClick="@(() => EditFieldAsync(field))"
                                       aria-label="@L["EditFieldAria", field.Name]" />
                    </MudTooltip>
                    <MudTooltip Text="@L["DeleteFieldTooltip"]">
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteFieldAsync(field))"
                                       aria-label="@L["DeleteFieldAria", field.Name]" />
                    </MudTooltip>
                </MudStack>
            }
        </MudStack>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public required ContentEditContext<TEntity> Context { get; set; }

    [Parameter, EditorRequired]
    public required string ModuleKey { get; set; }

    /// <summary>Route zur Arten-Verwaltung dieses Moduls.</summary>
    [Parameter, EditorRequired]
    public required string TypesRoute { get; set; }

    /// <summary>
    /// Erklärt, wofür individuelle Felder in diesem Modul gut sind. Leer bedeutet Standardtext
    /// aus der resx — siehe <see cref="IndividualHintText"/>.
    /// </summary>
    [Parameter]
    public string? IndividualHint { get; set; }

    private string IndividualHintText =>
        string.IsNullOrWhiteSpace(IndividualHint) ? L["DefaultIndividualHint"] : IndividualHint;

    /// <summary>Meldet der Seite eine Wertänderung — für „ungespeicherte Änderungen“.</summary>
    [Parameter]
    public EventCallback OnValueChanged { get; set; }

    /// <summary>
    /// Meldet, dass eine Felddefinition angelegt, geändert oder gelöscht wurde. Die Seite muss
    /// daraufhin ihren Kontext neu laden — das kann nur sie, weil es modulspezifisch ist.
    /// </summary>
    [Parameter]
    public EventCallback OnFieldDefinitionChanged { get; set; }

    private readonly Dictionary<string, IReadOnlyList<EntitySummary>> _referenceOptions = [];

    protected override async Task OnParametersSetAsync() => await LoadReferenceOptionsAsync();

    /// <summary>
    /// Lädt die auswählbaren Entitäten für alle sichtbaren Referenzfelder. Je Zielmodul nur
    /// einmal — mehrere Referenzfelder auf dasselbe Modul teilen sich die Liste.
    /// </summary>
    private async Task LoadReferenceOptionsAsync()
    {
        var wanted = Context.ApplicableFields
            .Where(field => field.Type == ContentFieldType.EntityReference)
            .Select(field => field.ReferenceModuleKey)
            .OfType<string>()
            .Distinct();

        var projectId = await Project.GetCurrentIdAsync();

        foreach (var targetModule in wanted)
        {
            if (_referenceOptions.ContainsKey(targetModule))
            {
                continue;
            }

            _referenceOptions[targetModule] = await References.GetEntitiesAsync(projectId, targetModule);
        }
    }

    private IReadOnlyList<EntitySummary> OptionsFor(FieldDefinition field) =>
        field.ReferenceModuleKey is { } targetModule && _referenceOptions.TryGetValue(targetModule, out var options)
            ? options
            : [];

    private async Task AddFieldAsync() =>
        await ShowFieldDialogAsync(new FieldDefinition
        {
            ModuleKey = ModuleKey,
            OwnerEntityId = Context.Entity.Id,
            Name = string.Empty,
            SortOrder = await ContentTypes.GetNextFieldSortOrderAsync(null, Context.Entity.Id)
        }, isNew: true);

    private Task EditFieldAsync(FieldDefinition field) =>
        ShowFieldDialogAsync(field.Clone(), isNew: false);

    private async Task ShowFieldDialogAsync(FieldDefinition draft, bool isNew)
    {
        var parameters = new DialogParameters<FieldDefinitionDialog>
        {
            { dialog => dialog.Field, draft },
            { dialog => dialog.IsNew, isNew }
        };

        var reference = await Dialogs.ShowAsync<FieldDefinitionDialog>(
            isNew ? L["NewFieldDialogTitle"] : L["EditFieldDialogTitle"],
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await reference.Result;
        if (result is null || result.Canceled || result.Data is not FieldDefinition edited)
        {
            return;
        }

        try
        {
            await ContentTypes.SaveFieldAsync(edited);
            await OnFieldDefinitionChanged.InvokeAsync();
            Snackbar.Add(L["FieldSavedMessage", edited.Name], Severity.Success);
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteFieldAsync(FieldDefinition field)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", field.Name],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await ContentTypes.DeleteFieldAsync(field.Id);
        await OnFieldDefinitionChanged.InvokeAsync();
        Snackbar.Add(L["FieldDeletedMessage"], Severity.Success);
    }
}
