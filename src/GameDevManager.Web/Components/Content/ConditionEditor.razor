@inject ConditionService Conditions
@inject WorldService World
@inject ReferenceService References
@inject ProjectContext Project
@inject ISnackbar Snackbar
@inject IStringLocalizer<ConditionEditor> L
@inject ConditionLabels Labels
@inject ModuleLabels Modules

@*
    Der Bedingungs-Editor aus dem Konzept — „ein einheitliches System, welches über alle Module
    hinweg verknüpfbar ist“. Jedes Modul bindet ihn mit der GUID dessen ein, wozu die Bedingungen
    gehören: ein NPC für seinen Shop, ein einzelner Händler-Posten für sich, später ein Dialog
    oder eine Quest.

    Er speichert selbst und nicht über die umgebende Maske, weil er an einer eigenen GUID hängt
    und deshalb unabhängig davon ist, was die Seite gerade sonst bearbeitet.
*@

@if (_set is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudStack Spacing="3">
        @if (_set.Conditions.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@EmptyHintText</MudText>
        }
        else
        {
            <MudSelect T="ConditionLogic"
                       Value="_set.Logic"
                       ValueChanged="@((ConditionLogic logic) => Touch(() => _set.Logic = logic))"
                       Label="@L["LogicLabel"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Style="max-width:280px;">
                <MudSelectItem T="ConditionLogic" Value="@(ConditionLogic.All)">@L["LogicAll"]</MudSelectItem>
                <MudSelectItem T="ConditionLogic" Value="@(ConditionLogic.Any)">@L["LogicAny"]</MudSelectItem>
            </MudSelect>

            @foreach (var condition in _set.Conditions)
            {
                <div class="pa-2 gdm-field-row">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudSelect T="ConditionKind"
                                       Value="condition.Kind"
                                       ValueChanged="@((ConditionKind kind) => ChangeKindAsync(condition, kind))"
                                       Label="@L["KindLabel"]"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense">
                                @foreach (var kind in Enum.GetValues<ConditionKind>())
                                {
                                    <MudSelectItem T="ConditionKind" Value="@kind">@Labels.Describe(kind)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        @* Frei wählbares Zielmodul — bisher nur bei „Freigeschaltet“:
                           freischalten lässt sich alles, und ein fest verdrahtetes Modul
                           verengte den Freischaltungs-Graphen auf eine Sorte Inhalt. *@
                        @if (condition.ChoosesTargetModule)
                        {
                            <MudItem xs="12" sm="6">
                                <MudSelect T="string"
                                           Value="@(condition.TargetModuleKey ?? string.Empty)"
                                           ValueChanged="@((string key) => ChangeTargetModuleAsync(condition, key))"
                                           Label="@L["TargetModuleLabel"]"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense">
                                    @foreach (var module in TargetModules)
                                    {
                                        <MudSelectItem T="string" Value="@module.Id">@ModuleName(module.Id)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        }

                        @if (condition.UsesTarget)
                        {
                            <MudItem xs="12" sm="6">
                                @{
                                    var key = OptionsKey(condition);
                                    var module = condition.TargetModule ?? string.Empty;
                                }
                                @if (Options(key).Count == 0)
                                {
                                    <MudTextField T="string"
                                                  Value="@TargetCaption(condition)"
                                                  Label="@L["TargetLabel"]"
                                                  HelperText="@L["TargetHelperEmpty", TargetCaption(condition)]"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Disabled="true" />
                                }
                                else
                                {
                                    <MudAutocomplete T="EntitySummary"
                                                     Value="@TargetFor(condition)"
                                                     ValueChanged="@((EntitySummary? e) => SetTarget(condition, e, module))"
                                                     SearchFunc="@((string? s, CancellationToken ct) => SearchAsync(key, s))"
                                                     ToStringFunc="@(e => e?.Name ?? string.Empty)"
                                                     Label="@TargetCaption(condition)"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Clearable="true"
                                                     ResetValueOnEmptyText="true"
                                                     CoerceValue="false"
                                                     MaxItems="50" />
                                }
                            </MudItem>
                        }

                        @if (condition.UsesNumber)
                        {
                            <MudItem xs="6" sm="4">
                                <MudSelect T="ComparisonOperator"
                                           Value="condition.Operator"
                                           ValueChanged="@((ComparisonOperator op) => Touch(() => condition.Operator = op))"
                                           Label="@L["OperatorLabel"]"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense">
                                    @foreach (var comparison in Enum.GetValues<ComparisonOperator>())
                                    {
                                        <MudSelectItem T="ComparisonOperator" Value="@comparison">
                                            @Labels.Describe(comparison)
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="6" sm="4">
                                <MudNumericField T="double?"
                                                 Value="condition.NumberValue"
                                                 ValueChanged="@((double? v) => Touch(() => condition.NumberValue = v))"
                                                 Label="@L["NumberLabel"]"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 Min="0" />
                            </MudItem>
                        }

                        @if (condition.UsesBoolean)
                        {
                            <MudItem xs="12" sm="4" Class="d-flex align-center">
                                <MudSwitch T="bool"
                                           Value="@(condition.BooleanValue ?? true)"
                                           ValueChanged="@((bool v) => Touch(() => condition.BooleanValue = v))"
                                           Color="Color.Primary"
                                           Label="@(condition.BooleanValue == false ? L["BooleanFalse"].Value : L["BooleanTrue"].Value)" />
                            </MudItem>
                        }

                        @if (condition.Kind is ConditionKind.Flag or ConditionKind.QuestState or ConditionKind.Custom)
                        {
                            <MudItem xs="12" sm="@(condition.UsesBoolean ? 8 : 12)">
                                <MudTextField T="string"
                                              Value="condition.TextValue"
                                              ValueChanged="@((string v) => Touch(() => condition.TextValue = v))"
                                              Label="@TextLabel(condition.Kind)"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true" />
                            </MudItem>
                        }

                        <MudItem xs="12" Class="d-flex align-center justify-space-between">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @Labels.Sentence(condition, TargetName(condition))
                            </MudText>
                            <MudTooltip Text="@L["RemoveCondition"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                               Size="Size.Small"
                                               OnClick="@(() => Remove(condition))"
                                               aria-label="@L["RemoveCondition"]" />
                            </MudTooltip>
                        </MudItem>
                    </MudGrid>
                </div>
            }
        }

        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="AddAsync">
                @L["AddCondition"]
            </MudButton>

            @if (_dirty)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="SaveAsync">
                    @L["SaveConditions"]
                </MudButton>
                <MudText Typo="Typo.caption" Color="Color.Warning">@L["NotSavedYet"]</MudText>
            }
        </MudStack>
    </MudStack>
}

@code {
    [Parameter, EditorRequired]
    public Guid OwnerId { get; set; }

    [Parameter, EditorRequired]
    public required string OwnerModuleKey { get; set; }

    [Parameter]
    public string Slot { get; set; } = ConditionSlots.Availability;

    /// <summary>Leer bedeutet Standardtext aus der resx — siehe <see cref="EmptyHintText"/>.</summary>
    [Parameter]
    public string? EmptyHint { get; set; }

    private string EmptyHintText =>
        string.IsNullOrWhiteSpace(EmptyHint) ? L["DefaultEmptyHint"] : EmptyHint;

    /// <summary>Meldet der Seite, wie viele Bedingungen gespeichert wurden.</summary>
    [Parameter]
    public EventCallback<int> OnSaved { get; set; }

    private ConditionSet? _set;
    private readonly Dictionary<string, List<EntitySummary>> _options = [];
    private Guid _loadedFor;
    private bool _dirty;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == OwnerId)
        {
            return;
        }

        _loadedFor = OwnerId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var projectId = await Project.GetCurrentIdAsync();
        _set = await Conditions.LoadAsync(projectId, OwnerId, OwnerModuleKey, Slot);
        _dirty = false;

        foreach (var condition in _set.Conditions)
        {
            await EnsureOptionsAsync(projectId, condition);
        }
    }

    /// <summary>
    /// Unter welchem Schlüssel die Auswahl einer Bedingung liegt. Weltzustände werden nach
    /// ihrer Ausprägung getrennt gehalten — unter „Wetter“ sollen keine Biome stehen.
    /// </summary>
    private static string OptionsKey(Condition condition) =>
        condition.ExpectedWorldStateKind is { } kind
            ? $"{ModuleKeys.World}:{kind}"
            : condition.TargetModule ?? string.Empty;

    private async Task EnsureOptionsAsync(Guid projectId, Condition condition)
    {
        var key = OptionsKey(condition);

        if (string.IsNullOrEmpty(key) || _options.ContainsKey(key))
        {
            return;
        }

        _options[key] = condition.ExpectedWorldStateKind is { } kind
            ? [.. (await World.GetStatesAsync(projectId, kind))
                .Select(state => new EntitySummary(state.Id, ModuleKeys.World, state.Name, state.TypeName))]
            : await References.GetEntitiesAsync(projectId, key);
    }

    private List<EntitySummary> Options(string key) => _options.GetValueOrDefault(key, []);

    private string ModuleName(string moduleKey) => Modules.Name(moduleKey);

    /// <summary>Beschriftung des Auswahlfelds: die Ausprägung, sonst der Modulname.</summary>
    private string TargetCaption(Condition condition) =>
        condition.ExpectedWorldStateKind is not null
            ? Labels.Describe(condition.Kind)
            : ModuleName(condition.TargetModule ?? string.Empty);

    /// <summary>
    /// Die Module, auf die eine Freischaltung zeigen darf: alle umgesetzten mit eigenem
    /// Inhalt. Auswertende Module (Statistik, Freischaltungen, Änderungen) tragen keine
    /// Entitäten und stünden im Auswahlfeld als leere Einträge.
    /// </summary>
    private static IEnumerable<ModuleDefinition> TargetModules =>
        ModuleRegistry.All.Where(module => module.Implemented && module.Group != ModuleGroup.Tools);

    private EntitySummary? TargetFor(Condition condition) =>
        condition.TargetEntityId is { } id
            ? Options(OptionsKey(condition)).FirstOrDefault(entity => entity.Id == id)
            : null;

    private string? TargetName(Condition condition) => TargetFor(condition)?.Name;

    private void SetTarget(Condition condition, EntitySummary? entity, string moduleKey) =>
        Touch(() =>
        {
            condition.TargetEntityId = entity?.Id;
            condition.TargetModuleKey = entity?.ModuleKey ?? (string.IsNullOrEmpty(moduleKey) ? null : moduleKey);
        });

    private async Task ChangeTargetModuleAsync(Condition condition, string moduleKey)
    {
        condition.TargetModuleKey = moduleKey;
        condition.TargetEntityId = null;
        _dirty = true;

        await EnsureOptionsAsync(await Project.GetCurrentIdAsync(), condition);
    }

    private Task<IEnumerable<EntitySummary>> SearchAsync(string key, string? search)
    {
        IEnumerable<EntitySummary> matches = string.IsNullOrWhiteSpace(search)
            ? Options(key)
            : Options(key).Where(entity =>
                entity.Name.Contains(search, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(matches);
    }

    private string TextLabel(ConditionKind kind) => kind switch
    {
        ConditionKind.Flag => L["TextLabelFlag"],
        ConditionKind.QuestState => L["TextLabelQuestState"],
        _ => L["TextLabelDefault"]
    };

    private async Task AddAsync()
    {
        if (_set is null)
        {
            return;
        }

        var condition = new Condition
        {
            ConditionSetId = _set.Id,
            Kind = ConditionKind.HasItem,
            TargetModuleKey = ModuleKeys.Items,
            NumberValue = 1,
            SortOrder = _set.Conditions.Count
        };

        _set.Conditions.Add(condition);
        _dirty = true;

        await EnsureOptionsAsync(await Project.GetCurrentIdAsync(), condition);
    }

    private async Task ChangeKindAsync(Condition condition, ConditionKind kind)
    {
        condition.Kind = kind;

        // Bei frei wählbarem Zielmodul steht die erste Wahl schon da, sonst gäbe das
        // Auswahlfeld nichts her, bis der Nutzer es anfasst.
        condition.TargetModuleKey = condition.ExpectedTargetModule
            ?? (condition.ChoosesTargetModule ? ModuleKeys.Items : null);

        // Beim Wechsel passen die alten Angaben nicht mehr — sie werden zurückgesetzt statt
        // stehen zu bleiben und unbemerkt mitgespeichert zu werden.
        condition.TargetEntityId = null;
        condition.NumberValue = condition.UsesNumber ? 1 : null;
        condition.BooleanValue = condition.UsesBoolean ? true : null;

        _dirty = true;

        await EnsureOptionsAsync(await Project.GetCurrentIdAsync(), condition);
    }

    private void Remove(Condition condition)
    {
        _set?.Conditions.Remove(condition);
        _dirty = true;
    }

    private void Touch(Action change)
    {
        change();
        _dirty = true;
    }

    private async Task SaveAsync()
    {
        if (_set is null)
        {
            return;
        }

        try
        {
            await Conditions.SaveAsync(_set);
            _dirty = false;

            Snackbar.Add(
                _set.Conditions.Count == 0 ? L["RemovedMessage"] : L["SavedMessage"],
                Severity.Success);

            await OnSaved.InvokeAsync(_set.Conditions.Count);
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
