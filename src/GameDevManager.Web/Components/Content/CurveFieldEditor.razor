@inject IStringLocalizer<CurveFieldEditor> L

@*
    Die Bedienung eines Feldes vom Typ „Formel/Kurve“: ein Ausdruck über x, die Spanne, in der
    er ausgewertet wird, und eine Wertetabelle für von Hand gesetzte Stufen. Rechts daneben das
    Vorschau-Diagramm, das sich bei jeder Eingabe sofort mitzieht — Balancing lebt davon, die
    Wirkung einer geänderten Zahl gleich zu sehen.

    Gespeichert wird das Ganze als JSON im Textwert des Feldes (siehe CurveDefinition), damit es
    ohne Zutun durch Export, Import, Duplizieren und die Feldvererbung der Unterarten geht.
*@

<MudStack Spacing="3">
    <MudText Typo="Typo.subtitle2">@Label</MudText>

    @if (!string.IsNullOrWhiteSpace(Definition.Description))
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary">@Definition.Description</MudText>
    }

    <MudGrid Spacing="2">
        <MudItem xs="12" md="7">
            <MudTextField T="string"
                          Value="_curve.Expression"
                          ValueChanged="SetExpression"
                          Label="@L["ExpressionLabel"]"
                          HelperText="@ExpressionHelper"
                          Error="_expressionError is not null"
                          ErrorText="@_expressionError"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Placeholder="100 * x ^ 1.5" />
        </MudItem>

        <MudItem xs="12" md="5">
            <MudTextField T="string"
                          Value="_curve.Unit"
                          ValueChanged="@(value => Apply(() => _curve.Unit = Trim(value)))"
                          Label="@L["UnitLabel"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
        </MudItem>

        <MudItem xs="4">
            <MudNumericField T="double"
                             Value="_curve.From"
                             ValueChanged="@(value => Apply(() => _curve.From = value))"
                             Label="@L["FromLabel"]"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="4">
            <MudNumericField T="double"
                             Value="_curve.To"
                             ValueChanged="@(value => Apply(() => _curve.To = value))"
                             Label="@L["ToLabel"]"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="4">
            <MudNumericField T="double"
                             Value="_curve.Step"
                             ValueChanged="@(value => Apply(() => _curve.Step = value))"
                             Label="@L["StepLabel"]"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Min="0" />
        </MudItem>
    </MudGrid>

    <CurveChart Points="_sample" />

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudText Typo="Typo.caption" Color="Color.Secondary">@SampleSummary</MudText>
        <MudSpacer />
        <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="AddOverride">
            @L["AddOverride"]
        </MudButton>
    </MudStack>

    @if (_curve.Overrides.Count > 0)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["OverrideHint"]</MudText>

        @foreach (var point in _curve.Overrides)
        {
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudNumericField T="double"
                                 Value="point.X"
                                 ValueChanged="@(value => Apply(() => point.X = value))"
                                 Label="@L["PointX"]"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Style="max-width:140px;" />
                <MudNumericField T="double"
                                 Value="point.Y"
                                 ValueChanged="@(value => Apply(() => point.Y = value))"
                                 Label="@L["PointY"]"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Style="max-width:160px;" />
                <MudTooltip Text="@L["RemoveOverride"]">
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   Size="Size.Small"
                                   OnClick="@(() => RemoveOverride(point))"
                                   aria-label="@L["RemoveOverride"]" />
                </MudTooltip>
            </MudStack>
        }
    }
</MudStack>

@code {
    [Parameter, EditorRequired]
    public required FieldDefinition Definition { get; set; }

    [Parameter, EditorRequired]
    public required FieldValue Value { get; set; }

    [Parameter]
    public EventCallback OnValueChanged { get; set; }

    private CurveDefinition _curve = new();
    private IReadOnlyList<CurvePoint> _sample = [];
    private string? _expressionError;
    private Guid _loadedFor;

    private string Label => Definition.IsRequired ? L["RequiredLabel", Definition.Name] : Definition.Name;

    private string ExpressionHelper =>
        L["ExpressionHelper", string.Join(", ", CurveExpression.FunctionNames)];

    private string SampleSummary => _sample.Count == 0
        ? L["NoSample"]
        : L["SampleSummary", _sample.Count, Fmt(_sample[0].Y), Fmt(_sample[^1].Y)];

    protected override void OnParametersSet()
    {
        // Neu laden, sobald die Maske auf ein anderes Feld zeigt — dieselbe Komponente wird
        // für jedes Kurvenfeld der Entität verwendet.
        if (_loadedFor == Definition.Id)
        {
            return;
        }

        _loadedFor = Definition.Id;
        _curve = CurveDefinition.Parse(Value.TextValue) ?? new CurveDefinition();
        Recalculate();
    }

    private Task SetExpression(string? expression) =>
        Apply(() => _curve.Expression = Trim(expression));

    private Task AddOverride()
    {
        // Die neue Stufe beginnt am Ende der Spanne — dort setzt man von Hand nach.
        var next = _curve.Overrides.Count == 0 ? _curve.To : _curve.Overrides.Max(point => point.X) + 1;

        return Apply(() => _curve.Overrides.Add(new CurvePoint
        {
            X = next,
            Y = _curve.ValueAt(next) ?? 0
        }));
    }

    private Task RemoveOverride(CurvePoint point) =>
        Apply(() => _curve.Overrides.Remove(point));

    private async Task Apply(Action change)
    {
        change();
        Recalculate();

        Value.TextValue = _curve.Serialize();
        await OnValueChanged.InvokeAsync();
    }

    /// <summary>
    /// Wertet die Kurve neu aus und prüft dabei den Ausdruck. Ein unlesbarer Ausdruck wird
    /// angezeigt, aber nicht verworfen — sonst könnte man eine Formel nicht in Ruhe tippen.
    /// </summary>
    private void Recalculate()
    {
        _expressionError = null;

        if (_curve.HasExpression)
        {
            try
            {
                CurveExpression.Parse(_curve.Expression!);
            }
            catch (CurveExpressionException ex)
            {
                _expressionError = L["ExpressionInvalid", ex.Message];
            }
        }

        _sample = _curve.Sample();
    }

    private static string? Trim(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string Fmt(double value) => value.ToString("0.##");
}
