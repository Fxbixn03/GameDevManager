@inject IStringLocalizer<FieldDefinitionDialog> L
@inject FieldTypeLabels FieldTypes
@inject ModuleLabels Modules

@*
    Anlegen und Bearbeiten einer Felddefinition — gleich für Art-Felder und für individuelle
    Felder einer einzelnen Entität. Der Dialog arbeitet auf einer Kopie; gespeichert wird erst
    von der aufrufenden Seite.
*@

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.ViewList" />
            <MudText Typo="Typo.h6">@(IsNew ? L["TitleNew"] : L["TitleEdit"])</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="4" Style="min-width:min(560px, 80vw);">
            <MudTextField @bind-Value="Field.Name"
                          Label="@L["NameLabel"]"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Required="true"
                          Error="@(_error is not null && string.IsNullOrWhiteSpace(Field.Name))" />

            <MudTextField @bind-Value="Field.Description"
                          Label="@L["DescriptionLabel"]"
                          Variant="Variant.Outlined"
                          HelperText="@L["DescriptionHelper"]" />

            <MudSelect T="ContentFieldType"
                       Value="Field.Type"
                       ValueChanged="ChangeType"
                       Label="@L["TypeLabel"]"
                       Variant="Variant.Outlined">
                @foreach (var type in Enum.GetValues<ContentFieldType>())
                {
                    <MudSelectItem T="ContentFieldType" Value="@type">@FieldTypes.Describe(type)</MudSelectItem>
                }
            </MudSelect>

            @if (!IsNew && _originalType != Field.Type)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    @L["TypeChangeWarning"]
                </MudAlert>
            }

            @if (Field.Type == ContentFieldType.EntityReference)
            {
                <MudSelect T="string"
                           @bind-Value="Field.ReferenceModuleKey"
                           Label="@L["ReferenceModuleLabel"]"
                           Variant="Variant.Outlined"
                           HelperText="@L["ReferenceModuleHelper"]">
                    @foreach (var module in ModuleRegistry.All)
                    {
                        <MudSelectItem T="string" Value="@module.Id">
                            @Modules.Name(module) @(module.Implemented ? string.Empty : L["ModuleNotImplemented"].Value)
                        </MudSelectItem>
                    }
                </MudSelect>

                @* Mehrere Ziele gibt es nur an einer Referenz — die anderen Typen tragen je
                   einen Wert, dieselbe Überlegung wie beim Stichwort-Schalter. *@
                <div>
                    <MudSwitch @bind-Value="Field.IsMultiValue"
                               Color="Color.Primary"
                               Label="@L["MultiValueLabel"]" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["MultiValueHelper"]</MudText>
                </div>
            }

            @if (Field.Type == ContentFieldType.Select)
            {
                <div>
                    <MudText Typo="Typo.overline" Color="Color.Secondary">@L["SectionOptions"]</MudText>

                    @foreach (var option in Field.Options)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                            <MudTextField @bind-Value="option.Label"
                                          Label="@L["OptionLabel"]"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                            <MudTooltip Text="@L["RemoveOptionTooltip"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                               Size="Size.Small"
                                               OnClick="@(() => Field.Options.Remove(option))"
                                               aria-label="@L["RemoveOptionAria"]" />
                            </MudTooltip>
                        </MudStack>
                    }

                    <MudButton StartIcon="@Icons.Material.Filled.Add"
                               Size="Size.Small"
                               Class="mt-2"
                               OnClick="AddOption">
                        @L["AddOption"]
                    </MudButton>
                </div>
            }

            @if (Field.Type is ContentFieldType.Integer or ContentFieldType.Decimal or ContentFieldType.Text)
            {
                <MudTextField @bind-Value="Field.Unit"
                              Label="@L["UnitLabel"]"
                              Variant="Variant.Outlined"
                              HelperText="@L["UnitHelper"]" />
            }

            @* Grenzen gelten nur an Zahlen: An einem Text oder einem Schalter wäre „mindestens 5“
               keine Prüfung, sondern eine Frage. *@
            @if (Field.UsesRange)
            {
                <MudStack Row="true" Spacing="3">
                    <MudNumericField T="double?"
                                     @bind-Value="Field.MinValue"
                                     Label="@L["MinLabel"]"
                                     Variant="Variant.Outlined"
                                     Clearable="true" />
                    <MudNumericField T="double?"
                                     @bind-Value="Field.MaxValue"
                                     Label="@L["MaxLabel"]"
                                     Variant="Variant.Outlined"
                                     Clearable="true" />
                </MudStack>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["RangeHelper"]</MudText>
            }

            @if (Field.UsesPattern)
            {
                <MudTextField @bind-Value="Field.Pattern"
                              Label="@L["PatternLabel"]"
                              Variant="Variant.Outlined"
                              Class="gdm-mono"
                              HelperText="@L["PatternHelper"]" />
            }

            @* Stichwörter gibt es nur im Textfeld — die anderen Typen tragen je einen Wert. *@
            @if (Field.Type == ContentFieldType.Text)
            {
                <div>
                    <MudSwitch @bind-Value="Field.IsTagList"
                               Color="Color.Primary"
                               Label="@L["TagListLabel"]" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["TagListHelper"]</MudText>
                </div>
            }

            @* Ein Abschnitt ist eine Überschrift, kein Verweis — deshalb Freitext mit
               Vorschlägen statt einer Auswahlliste: Der erste Abschnitt einer Art muss sich
               anlegen lassen, ohne ihn vorher irgendwo zu definieren. *@
            <MudAutocomplete T="string"
                             Value="Field.GroupName"
                             ValueChanged="@((string? name) => Field.GroupName = name)"
                             SearchFunc="SearchGroupsAsync"
                             Label="@L["GroupLabel"]"
                             HelperText="@L["GroupHelper"]"
                             Variant="Variant.Outlined"
                             Clearable="true"
                             CoerceValue="true"
                             ResetValueOnEmptyText="true" />

            <MudSwitch @bind-Value="Field.IsRequired"
                       Color="Color.Primary"
                       Label="@L["RequiredLabel"]" />

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">@L["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">@L["Submit"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Die zu bearbeitende Kopie — der Dialog gibt sie bei „Übernehmen" zurück.</summary>
    [Parameter, EditorRequired]
    public required FieldDefinition Field { get; set; }

    [Parameter]
    public bool IsNew { get; set; }

    /// <summary>
    /// Die Abschnitte, die es an dieser Art schon gibt — als Vorschlagsliste. Ohne sie
    /// entstünden „Kampfwerte“ und „Kampfwerte “ als zwei Abschnitte.
    /// </summary>
    [Parameter]
    public IReadOnlyCollection<string> KnownGroups { get; set; } = [];

    private ContentFieldType _originalType;
    private string? _error;

    protected override void OnInitialized() => _originalType = Field.Type;

    private Task<IEnumerable<string>> SearchGroupsAsync(string? search, CancellationToken ct)
    {
        IEnumerable<string> matches = string.IsNullOrWhiteSpace(search)
            ? KnownGroups
            : KnownGroups.Where(group => group.Contains(search, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(matches);
    }

    private void ChangeType(ContentFieldType type)
    {
        Field.Type = type;

        // „Seltenheit“ ist eine Referenz mit festem Ziel — der Schlüssel wird direkt gesetzt,
        // damit die Maske die Auswahlliste laden kann, ohne auf das Speichern zu warten.
        Field.ReferenceModuleKey = type switch
        {
            ContentFieldType.EntityReference => Field.ReferenceModuleKey,
            ContentFieldType.Rarity => ModuleKeys.Rarities,
            _ => null
        };

        // Der Stichwort-Schalter gehört zum Textfeld: Bleibt er an einem Zahlenfeld stehen, wirkt
        // er beim Zurückwechseln unbemerkt weiter. Die Datenschicht räumt ihn ebenso ab.
        if (type != ContentFieldType.Text)
        {
            Field.IsTagList = false;
        }

        // Dasselbe für die Mehrfachauswahl: Sie gehört zur Referenz.
        if (type != ContentFieldType.EntityReference)
        {
            Field.IsMultiValue = false;
        }

        // Dasselbe für Grenzen und Muster — sie gehören zu Zahl bzw. Text.
        if (!Field.UsesRange)
        {
            Field.MinValue = null;
            Field.MaxValue = null;
        }

        if (!Field.UsesPattern)
        {
            Field.Pattern = null;
        }

        if (type != ContentFieldType.Select)
        {
            Field.Options.Clear();
        }
        else if (Field.Options.Count == 0)
        {
            AddOption();
        }
    }

    private void AddOption() =>
        Field.Options.Add(new FieldOption
        {
            FieldDefinitionId = Field.Id,
            Label = string.Empty,
            SortOrder = Field.Options.Count
        });

    private void Submit()
    {
        _error = Validate();
        if (_error is not null)
        {
            return;
        }

        MudDialog.Close(DialogResult.Ok(Field));
    }

    private string? Validate()
    {
        if (string.IsNullOrWhiteSpace(Field.Name))
        {
            return L["NameRequired"];
        }

        if (Field.Type == ContentFieldType.EntityReference && string.IsNullOrWhiteSpace(Field.ReferenceModuleKey))
        {
            return L["ReferenceModuleRequired"];
        }

        if (Field.Type == ContentFieldType.Select)
        {
            if (Field.Options.Count == 0)
            {
                return L["OptionsRequired"];
            }

            if (Field.Options.Any(option => string.IsNullOrWhiteSpace(option.Label)))
            {
                return L["OptionLabelRequired"];
            }
        }

        return null;
    }
}
