@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IStringLocalizer<EntityIdChip> L

@*
    Die GUID einer Entität — die einzige Referenz, über die andere Module sie ansprechen
    (siehe Konzept). Deshalb monospace und mit einem Knopf zum Kopieren.
*@

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
    <span class="gdm-mono">@Id</span>
    <MudTooltip Text="@L["CopyTooltip"]">
        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                       Size="Size.Small"
                       Color="Color.Default"
                       OnClick="CopyAsync"
                       aria-label="@L["CopyTooltip"]" />
    </MudTooltip>
</MudStack>

@code {
    [Parameter, EditorRequired]
    public Guid Id { get; set; }

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Id.ToString());
            Snackbar.Add(L["CopiedMessage"], Severity.Success);
        }
        catch (JSException)
        {
            // Ohne sicheren Kontext (HTTP auf einem fremden Host) gibt es keine Zwischenablage.
            Snackbar.Add(L["CopyRejectedMessage"], Severity.Warning);
        }
    }
}
