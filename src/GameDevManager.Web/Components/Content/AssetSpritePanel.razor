@inject AssetService Library
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IStringLocalizer<AssetSpritePanel> L

@*
    Die Sprites einer Entität — als Abschnitt in den Bearbeitungsmasken der Module.
    Ein Sprite ist das Icon der Entität, die übrigen sind Varianten und Animationsschritte.
*@

<MudPaper Elevation="0" Class="gdm-panel pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
        <MudText Typo="Typo.overline" Color="Color.Secondary">@L["SectionSprites"]</MudText>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            @if (_assets.Count > 0)
            {
                <MudButton Size="Size.Small"
                           Variant="Variant.Text"
                           StartIcon="@Icons.Material.Filled.PhotoLibrary"
                           Href="/modules/assets">
                    @L["LibraryButton"]
                </MudButton>
            }
            <AssetUpload OwnerModuleKey="ModuleKey"
                         OwnerEntityId="EntityId"
                         OnUploaded="ReloadAsync"
                         Disabled="Disabled"
                         Text="@L["UploadText"]"
                         Variant="Variant.Outlined"
                         Color="Color.Default"
                         Size="Size.Small" />
        </MudStack>
    </MudStack>

    @if (Disabled)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @L["DisabledHint"]
        </MudText>
    }
    else if (_assets.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @L["EmptyHint"]
        </MudText>
    }
    else
    {
        <div class="gdm-sprite-grid">
            @foreach (var asset in _assets)
            {
                <div class="gdm-sprite-tile @(asset.IsPrimary ? "gdm-sprite-primary" : null)">
                    <AssetThumbnail AssetId="asset.Id" Size="Size.Large" Alt="@asset.FileName" Title="@asset.FileName" />

                    <div class="gdm-sprite-meta">
                        <MudText Typo="Typo.caption" Class="gdm-ellipsis" title="@asset.FileName">@asset.FileName</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@AssetFormat.Summary(asset)</MudText>
                        @if (asset.IsPrimary)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-1">
                                @L["PrimaryChip"]
                            </MudChip>
                        }
                    </div>

                    <MudStack Row="true" Spacing="0" Justify="Justify.Center" Class="gdm-sprite-actions">
                        <MudTooltip Text="@(asset.IsPrimary ? L["AlreadyPrimary"] : L["SetPrimary"])">
                            <MudIconButton Icon="@(asset.IsPrimary ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder)"
                                           Size="Size.Small"
                                           Color="@(asset.IsPrimary ? Color.Primary : Color.Default)"
                                           Disabled="asset.IsPrimary"
                                           OnClick="@(() => SetPrimaryAsync(asset))"
                                           aria-label="@L["SetPrimary"]" />
                        </MudTooltip>
                        <MudTooltip Text="@L["MoveForwardTooltip"]">
                            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                           Size="Size.Small"
                                           Disabled="@(_assets.IndexOf(asset) == 0)"
                                           OnClick="@(() => MoveAsync(asset, -1))"
                                           aria-label="@L["MoveForwardTooltip"]" />
                        </MudTooltip>
                        <MudTooltip Text="@L["MoveBackwardTooltip"]">
                            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                           Size="Size.Small"
                                           Disabled="@(_assets.IndexOf(asset) == _assets.Count - 1)"
                                           OnClick="@(() => MoveAsync(asset, 1))"
                                           aria-label="@L["MoveBackwardTooltip"]" />
                        </MudTooltip>
                        <MudTooltip Text="@L["EditTooltip"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           OnClick="@(() => EditAsync(asset))"
                                           aria-label="@L["EditTooltip"]" />
                        </MudTooltip>
                        <MudTooltip Text="@L["DeleteTooltip"]">
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                           Size="Size.Small"
                                           OnClick="@(() => DeleteAsync(asset))"
                                           aria-label="@L["DeleteAria"]" />
                        </MudTooltip>
                    </MudStack>
                </div>
            }
        </div>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public required string ModuleKey { get; set; }

    [Parameter, EditorRequired]
    public Guid EntityId { get; set; }

    /// <summary>Gesetzt, solange die Entität noch nicht gespeichert wurde.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Meldet der Seite eine Änderung, damit sie z. B. ihr Icon neu laden kann.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private List<Asset> _assets = [];
    private Guid _loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        if (Disabled || _loadedFor == EntityId)
        {
            return;
        }

        _loadedFor = EntityId;
        _assets = await Library.GetForOwnerAsync(EntityId);
    }

    /// <summary>Lädt die Sprites neu — auch von außen aufrufbar.</summary>
    public async Task ReloadAsync()
    {
        _assets = await Library.GetForOwnerAsync(EntityId);
        await OnChanged.InvokeAsync();
        StateHasChanged();
    }

    private async Task SetPrimaryAsync(Asset asset)
    {
        try
        {
            await Library.SetPrimaryAsync(asset.Id);
            await ReloadAsync();
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task MoveAsync(Asset asset, int offset)
    {
        await Library.MoveAsync(asset.Id, offset);
        await ReloadAsync();
    }

    private async Task EditAsync(Asset asset)
    {
        var parameters = new DialogParameters<AssetDialog> { { dialog => dialog.Asset, asset } };

        var reference = await Dialogs.ShowAsync<AssetDialog>(
            L["EditDialogTitle"], parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        if (await reference.Result is { Canceled: false })
        {
            await ReloadAsync();
        }
    }

    private async Task DeleteAsync(Asset asset)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", asset.FileName],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Library.DeleteAsync(asset.Id);
        await ReloadAsync();
        Snackbar.Add(L["DeletedMessage"], Severity.Success);
    }
}
