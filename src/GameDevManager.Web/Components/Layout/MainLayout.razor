@inherits LayoutComponentBase
@inject NavigationManager Navigation
@implements IAsyncDisposable
@inject IStringLocalizer<MainLayout> L
@inject ModuleLabels Modules
@inject ModuleState ModuleState
@inject TopbarSelection Topbar
@inject AppearanceSelection Appearance
@inject IUserPermissionsProvider PermissionsProvider
@inject IJSRuntime JS

<MudThemeProvider Theme="GameDevManagerTheme.Instance" IsDarkMode="Appearance.IsDarkMode" DefaultScrollbar="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @* Elevation 0 — die Appbar setzt sich über die Trennlinie aus app.css ab, nicht über einen Schatten. *@
    <MudAppBar Elevation="0" Dense="true">
        <MudLink Href="/dashboard" Underline="Underline.None" Color="Color.Inherit">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.SportsEsports" Color="Color.Primary" />
                <MudText Typo="Typo.h6">@L["AppName"]</MudText>
            </MudStack>
        </MudLink>

        <ProjectSwitcher />

        <MudDivider Vertical="true" FlexItem="true" Class="mx-4 my-3" />

        @* Die Leiste nimmt den Platz bis zu den Knöpfen rechts ein und wird nicht mehr
           gescrollt: Was nicht hineinpasst, sammelt der Aufklapp-Knopf am rechten Ende.
           Wie viele Knöpfe hineinpassen, misst der Browser (siehe SetCapacity). *@
        @{
            var strip = BuildStrip();
        }
        <div class="gdm-module-strip" @ref="_stripElement">
            @foreach (var module in strip.Visible)
            {
                @* Eigenes div um Tooltip und Knopf: Es ist das Flex-Kind, dessen Breite die
                   Messung im Browser als Maßstab nimmt — ohne es hinge sie am Aufbau der
                   MudBlazor-Komponenten. *@
                <div class="gdm-module-item">
                    <MudTooltip Text="@Modules.Name(module)">
                        <MudIconButton Icon="@module.Icon"
                                       Href="@module.Route"
                                       Class="@(IsActive(module) ? "gdm-module-active" : null)"
                                       Color="@(IsActive(module) ? Color.Primary : Color.Inherit)" />
                    </MudTooltip>
                </div>
            }

            @if (strip.Overflow.Count > 0)
            {
                <div class="gdm-module-item">
                    <MudMenu Icon="@Icons.Material.Filled.MoreHoriz"
                             Color="Color.Inherit"
                             AriaLabel="@L["MoreModules", strip.Overflow.Count]"
                             AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight">
                        @foreach (var module in strip.Overflow)
                        {
                            <MudMenuItem Href="@module.Route" Icon="@module.Icon">
                                @Modules.Name(module)
                            </MudMenuItem>
                        }
                    </MudMenu>
                </div>
            }
        </div>

        @if (!_permissions.CanWrite)
        {
            <MudTooltip Text="@L["ReadOnlyTooltip"]">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Class="mr-2">
                    @L["ReadOnlyBadge"]
                </MudChip>
            </MudTooltip>
        }

        <GlobalSearch />
        <KeyboardShortcuts />

        <MudTooltip Text="@(Appearance.IsDarkMode ? L["LightTheme"] : L["DarkTheme"])">
            <MudIconButton Icon="@(Appearance.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit"
                           Class="ml-2"
                           OnClick="ToggleDarkMode" />
        </MudTooltip>

        @* Führt auf die Einstellungsseite — früher ein Dialog, dem für Modulliste und
           Verbindungsdaten der Platz fehlte. *@
        <MudTooltip Text="@L["Settings"]">
            <MudIconButton Icon="@Icons.Material.Filled.Settings"
                           Color="Color.Inherit"
                           Href="/einstellungen" />
        </MudTooltip>

        @* Konto und Abmelden. Das Abmelden ist ein echter Seitenaufruf (forceLoad), weil
           nur eine HTTP-Antwort das Cookie wieder loswird. *@
        <MudMenu Icon="@Icons.Material.Filled.AccountCircle"
                 Color="Color.Inherit"
                 AriaLabel="@L["Account"]"
                 AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight">
            <AuthorizeView>
                <Authorized>
                    <MudMenuItem Disabled="true">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @L["SignedInAs", context.User.Identity?.Name ?? string.Empty]
                        </MudText>
                    </MudMenuItem>
                    <MudDivider />
                    <MudMenuItem Href="/konto" Icon="@Icons.Material.Filled.ManageAccounts">@L["MyAccount"]</MudMenuItem>
                    @if (context.User.IsAdministrator())
                    {
                        <MudMenuItem Href="/konto/benutzer" Icon="@Icons.Material.Filled.Group">@L["Users"]</MudMenuItem>
                    }
                    <MudDivider />
                    <MudMenuItem Href="/konto/abmelden" ForceLoad="true" Icon="@Icons.Material.Filled.Logout">
                        @L["SignOut"]
                    </MudMenuItem>
                </Authorized>
            </AuthorizeView>
        </MudMenu>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-6">
            @* Die Modulwache: Seiten eines nicht freigegebenen Moduls werden gar nicht erst
               gerendert — eine Stelle statt einer Prüfung in ~57 Modulseiten. Sie greift auch
               bei direkt eingetippter URL. *@
            @if (BlockedModule() is { } blocked)
            {
                <MudAlert Severity="Severity.Info">@L["ModuleNotAllowed", Modules.Name(blocked)]</MudAlert>
            }
            else
            {
                @Body
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private UserPermissions _permissions = UserPermissions.Full;

    private ElementReference _stripElement;
    private DotNetObjectReference<MainLayout>? _jsReference;

    /// <summary>
    /// Wie viele Modul-Knöpfe nebeneinander Platz haben — gemessen im Browser.
    /// <c>null</c> vor der ersten Messung, negativ, wenn nichts zu messen war; in beiden
    /// Fällen zeigt die Leiste alles.
    /// </summary>
    private int? _capacity;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        ModuleState.Changed += OnModulesChanged;
        Topbar.Changed += OnModulesChanged;

        // Die Berechtigungen des angemeldeten Benutzers — sie stehen in den Ansprüchen des
        // Cookies und ändern sich innerhalb der Verbindung nicht mehr.
        _permissions = await PermissionsProvider.GetCurrentAsync();

        await ModuleState.EnsureLoadedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _jsReference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("gdmTopbar.observe", _stripElement, _jsReference);
    }

    /// <summary>
    /// Meldung des Browsers, wie viele Knöpfe in die Leiste passen. Nur die Geometrie kommt
    /// von dort; welche Module das betrifft, entscheidet <see cref="BuildStrip"/>.
    /// </summary>
    [JSInvokable]
    public void SetCapacity(int capacity)
    {
        if (_capacity == capacity)
        {
            return;
        }

        _capacity = capacity;
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Teilt die Module der Leiste in sichtbare und zusammengefasste auf. Zweifach gefiltert:
    /// je Projekt abgeschaltete Module und je Benutzer nicht freigegebene — die Seiten dahinter
    /// schützt zusätzlich die Modulwache. Die Reihenfolge kommt aus der
    /// <see cref="TopbarSelection"/>.
    /// </summary>
    private (IReadOnlyList<ModuleDefinition> Visible, IReadOnlyList<ModuleDefinition> Overflow) BuildStrip()
    {
        var modules = Topbar.Sort(ModuleState.EnabledModules.Where(m => _permissions.CanAccessModule(m.Id)));

        // Vor der ersten Messung steht alles in der Leiste: ein leeres Band wäre der
        // auffälligere Fehler als ein Frame mit abgeschnittenen Symbolen.
        if (_capacity is not { } capacity || capacity < 0 || capacity >= modules.Count)
        {
            return (modules, []);
        }

        // Ein Platz gehört dem Aufklapp-Knopf selbst.
        var visible = modules.Take(Math.Max(capacity - 1, 0)).ToList();
        var overflow = modules.Skip(visible.Count).ToList();

        // Das geöffnete Modul steht immer in der Leiste, auch wenn es rechnerisch im Aufklapp-
        // Knopf läge — sonst verlöre die Seite, auf der man gerade ist, ihre Markierung. Es
        // verdrängt dafür den letzten sichtbaren Knopf, der an dessen Stelle nach vorn in die
        // Liste rutscht und dort die Reihenfolge wahrt.
        if (overflow.FirstOrDefault(IsActive) is { } active)
        {
            overflow.Remove(active);

            if (visible.Count > 0)
            {
                overflow.Insert(0, visible[^1]);
                visible.RemoveAt(visible.Count - 1);
            }

            visible.Add(active);
        }

        return (visible, overflow);
    }

    /// <summary>
    /// Das Modul der aktuellen Seite, falls es dem Benutzer nicht freigegeben ist —
    /// sonst <c>null</c>. Unbekannte Routensegmente bleiben unbehelligt.
    /// </summary>
    private ModuleDefinition? BlockedModule()
    {
        var path = new Uri(Navigation.Uri).AbsolutePath;
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);

        if (segments.Length < 2 || !segments[0].Equals("modules", StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        var module = ModuleRegistry.Find(segments[1]);
        return module is not null && !_permissions.CanAccessModule(module.Id) ? module : null;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    private void OnModulesChanged() => InvokeAsync(StateHasChanged);

    private bool IsActive(ModuleDefinition module)
    {
        var path = new Uri(Navigation.Uri).AbsolutePath;
        return path.StartsWith(module.Route, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// Die Wahl gilt installationsweit und wird gemerkt (<see cref="AppearanceSelection"/>).
    /// Andere offene Verbindungen ziehen beim nächsten Laden nach — ein Ereignis an jede
    /// Verbindung wäre der aufwendigere Weg für eine Einstellung, die eine Person umlegt.
    /// </summary>
    private Task ToggleDarkMode() => Appearance.SetDarkModeAsync(!Appearance.IsDarkMode);

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        ModuleState.Changed -= OnModulesChanged;
        Topbar.Changed -= OnModulesChanged;

        try
        {
            await JS.InvokeVoidAsync("gdmTopbar.unobserve", _stripElement);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException)
        {
            // Der Kreis ist schon getrennt — dann ist der Beobachter mit der Seite ohnehin weg.
        }

        _jsReference?.Dispose();
    }
}
