@using Microsoft.Extensions.Configuration
@inject IStringLocalizer<SettingsDialog> L
@inject IConfiguration Configuration
@inject DatabaseOptions DbOptions
@inject LocalSettingsFile LocalSettings
@inject ModuleState ModuleState
@inject ModuleLabels Modules
@inject ISnackbar Snackbar

@*
    The topbar settings menu. Database settings land in appsettings.Local.json and apply after
    a restart — the running DbContext factory cannot be rewired. The module switches take effect
    immediately: they persist to the database and notify topbar, dashboard and search via ModuleState.
*@

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Settings" />
            <MudText Typo="Typo.h6">@L["Title"]</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudTabs Elevation="0" ApplyEffectsToContainer="true">
            <MudTabPanel Text="@L["TabDatabase"]" Icon="@Icons.Material.Filled.Storage">
                <MudStack Spacing="3" Class="pt-4">
                    <MudAlert Severity="Severity.Info" Dense="true">@L["RestartHint"]</MudAlert>

                    <MudSelect T="DatabaseProvider"
                               Value="_provider"
                               ValueChanged="OnProviderChanged"
                               Label="@L["ProviderLabel"]"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        @foreach (var provider in Enum.GetValues<DatabaseProvider>())
                        {
                            <MudSelectItem T="DatabaseProvider" Value="provider">@ProviderName(provider)</MudSelectItem>
                        }
                    </MudSelect>

                    <MudTextField T="string"
                                  @bind-Value="_connectionString"
                                  Label="@L["ConnectionStringLabel"]"
                                  HelperText="@L["ConnectionStringHelper"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="2" />

                    @if (_testResult is not null)
                    {
                        <MudAlert Severity="@(_testSucceeded ? Severity.Success : Severity.Error)" Dense="true">
                            @_testResult
                        </MudAlert>
                    }

                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.Cable"
                                   OnClick="TestConnectionAsync"
                                   Disabled="_testing">
                            @L["TestButton"]
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="SaveDatabaseAsync">
                            @L["SaveButton"]
                        </MudButton>
                    </MudStack>
                </MudStack>
            </MudTabPanel>

            <MudTabPanel Text="@L["TabModules"]" Icon="@Icons.Material.Filled.Apps">
                <MudStack Spacing="0" Class="pt-4">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">@L["ModulesHint"]</MudText>

                    @foreach (var module in ModuleRegistry.All)
                    {
                        <MudSwitch T="bool"
                                   Value="ModuleState.IsEnabled(module)"
                                   ValueChanged="@((bool enabled) => ToggleModuleAsync(module, enabled))"
                                   Color="Color.Primary"
                                   Label="@Modules.Name(module)" />
                    }
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Close">@L["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private DatabaseProvider _provider;
    private string _connectionString = string.Empty;

    // Keeps edits per provider so switching back and forth in the select loses nothing.
    private readonly Dictionary<DatabaseProvider, string> _edited = [];

    private bool _testing;
    private bool _testSucceeded;
    private string? _testResult;

    protected override void OnInitialized()
    {
        _provider = DbOptions.Provider;
        _connectionString = StoredConnectionString(_provider);
    }

    private string StoredConnectionString(DatabaseProvider provider) =>
        Configuration.GetConnectionString(provider.ToString()) ?? string.Empty;

    private void OnProviderChanged(DatabaseProvider provider)
    {
        _edited[_provider] = _connectionString;
        _provider = provider;
        _connectionString = _edited.TryGetValue(provider, out var edited)
            ? edited
            : StoredConnectionString(provider);
        _testResult = null;
    }

    private async Task TestConnectionAsync()
    {
        if (string.IsNullOrWhiteSpace(_connectionString))
        {
            Snackbar.Add(L["ConnectionStringRequired"], Severity.Warning);
            return;
        }

        _testing = true;
        _testResult = null;

        try
        {
            await DatabaseServiceExtensions.TestConnectionAsync(_provider, _connectionString.Trim());
            _testSucceeded = true;
            _testResult = L["TestSucceeded"];
        }
        catch (Exception ex)
        {
            _testSucceeded = false;
            _testResult = L["TestFailed", ex.Message];
        }
        finally
        {
            _testing = false;
        }
    }

    private async Task SaveDatabaseAsync()
    {
        if (string.IsNullOrWhiteSpace(_connectionString))
        {
            Snackbar.Add(L["ConnectionStringRequired"], Severity.Warning);
            return;
        }

        await LocalSettings.WriteDatabaseSettingsAsync(_provider, _connectionString.Trim());
        Snackbar.Add(L["SavedRestartRequired"], Severity.Success);
    }

    private Task ToggleModuleAsync(ModuleDefinition module, bool enabled) =>
        ModuleState.SetEnabledAsync(module, enabled);

    private string ProviderName(DatabaseProvider provider) => provider switch
    {
        DatabaseProvider.SqlServer => L["ProviderSqlServer"],
        DatabaseProvider.PostgreSql => L["ProviderPostgreSql"],
        DatabaseProvider.MySql => L["ProviderMySql"],
        _ => L["ProviderSqlite"]
    };

    private void Close() => MudDialog.Close();
}
