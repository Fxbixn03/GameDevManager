@inject ProjectContext Project
@inject ProjectService Projects
@inject NavigationManager Navigation
@inject IStringLocalizer<ProjectSwitcher> L
@implements IDisposable

@*
    Auswahl des aktiven Spielprojekts in der Appbar. Ein Wechsel gilt für die ganze
    Installation und lädt die Anwendung komplett neu — jede Seite holt ihre Daten je
    Projekt, ein Ereignis an 57 Seiten wäre der aufwendigere Weg.
*@

@* „Open“ ist ein zweiweg-gebundener Parameter — beobachten heißt hier binden, sonst wäre der
   Elternteil die Quelle der Wahrheit für einen Wert, den er nie setzt. *@
<MudMenu Dense="true"
         AnchorOrigin="Origin.BottomLeft"
         TransformOrigin="Origin.TopLeft"
         @bind-Open:get="_open"
         @bind-Open:set="OnOpenChangedAsync">
    @* Das Öffnen wird selbst verdrahtet, wie beim EntityContextMenu und den Kanban-Karten:
       ActivatorContent ist ein RenderFragment<MenuContext> — MudBlazor legt um eigenen
       Aktivator-Inhalt keinen Klick-Handler, es reicht nur den Kontext herein. Ohne den Aufruf
       ist der Knopf ein gewöhnlicher Knopf und das Menü geht nie auf.

       Kein MudTooltip mehr darum: Der Knopf trägt Projektnamen und Pfeil und sagt damit
       selbst, was er ist. *@
    <ActivatorContent>
        <MudButton Color="Color.Inherit"
                   StartIcon="@Icons.Material.Filled.FolderSpecial"
                   EndIcon="@Icons.Material.Filled.ArrowDropDown"
                   OnClick="@(args => context.OpenAsync(args))">
            @(_current?.Name ?? L["Loading"])
        </MudButton>
    </ActivatorContent>
    <ChildContent>
        @if (_projects is not null)
        {
            @foreach (var project in _projects)
            {
                var isCurrent = project.Id == _current?.Id;
                <MudMenuItem Icon="@(isCurrent ? Icons.Material.Filled.Check : null)"
                             OnClick="@(() => SwitchAsync(project.Id))">
                    @project.Name
                </MudMenuItem>
            }
            <MudDivider />
        }
        <MudMenuItem Icon="@Icons.Material.Filled.Tune" Href="/projekte">@L["Manage"]</MudMenuItem>
    </ChildContent>
</MudMenu>

@code {
    private GameProject? _current;
    private List<GameProject>? _projects;
    private bool _open;

    protected override async Task OnInitializedAsync()
    {
        Project.Changed += OnProjectChanged;
        _current = await Project.GetCurrentAsync();
        _projects = await Projects.GetProjectsAsync(includeArchived: false);
    }

    // Beim Öffnen frisch laden — auf der Projektseite kann inzwischen eines dazugekommen sein.
    private async Task OnOpenChangedAsync(bool open)
    {
        _open = open;

        if (open)
        {
            _projects = await Projects.GetProjectsAsync(includeArchived: false);
        }
    }

    private async Task SwitchAsync(Guid projectId)
    {
        if (projectId == _current?.Id)
        {
            return;
        }

        await Project.SetCurrentAsync(projectId);
        Navigation.NavigateTo("/dashboard", forceLoad: true);
    }

    private void OnProjectChanged() => _ = InvokeAsync(async () =>
    {
        _current = await Project.GetCurrentAsync();
        _projects = await Projects.GetProjectsAsync(includeArchived: false);
        StateHasChanged();
    });

    public void Dispose() => Project.Changed -= OnProjectChanged;
}
