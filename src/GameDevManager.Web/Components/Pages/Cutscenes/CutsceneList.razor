@page "/modules/cutscenes"
@inject CutsceneService Cutscenes
@inject ContentTypeService ContentTypes
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<CutsceneList> L

<PageTitle>@L["PageTitle"]</PageTitle>

<ModuleHeader Module="Module" Subtitle="@Subtitle">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Style"
                   Href="/modules/cutscenes/arten">
            @L["TypesButton"]
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/modules/cutscenes/neu">
            @L["NewCutscene"]
        </MudButton>
    </Actions>
</ModuleHeader>

@if (_cutscenes is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_cutscenes.Count == 0)
{
    <div class="gdm-empty">
        <MudIcon Icon="@Icons.Material.Filled.Movie" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
        <MudText Typo="Typo.h6">@L["EmptyTitle"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            @L["EmptyHint"]
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/modules/cutscenes/neu">
            @L["FirstCutscene"]
        </MudButton>
    </div>
}
else
{
    <MudPaper Elevation="0" Class="gdm-panel pa-4 mb-4">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_search"
                          Placeholder="@L["SearchPlaceholder"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="max-width:360px;" />

            <MudSelect T="Guid?"
                       @bind-Value="_typeFilter"
                       Label="@L["TypeFilterLabel"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="max-width:220px;">
                @foreach (var type in _types)
                {
                    <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSpacer />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["FilterCount", Filtered.Count, _cutscenes.Count]</MudText>
        </MudStack>
    </MudPaper>

    <MudTable T="CutsceneListRow"
              Items="Filtered"
              Elevation="0"
              Hover="true"
              Dense="true"
              Breakpoint="Breakpoint.Sm"
              OnRowClick="OpenRow"
              RowClass="cursor-pointer">
        <HeaderContent>
            <MudTh Style="width:56px;"></MudTh>
            <MudTh>@L["HeaderName"]</MudTh>
            <MudTh>@L["HeaderShots"]</MudTh>
            <MudTh>@L["HeaderStory"]</MudTh>
            <MudTh>@L["HeaderType"]</MudTh>
            <MudTh Style="width:56px;"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@L["HeaderSprite"]">
                <AssetThumbnail AssetId="context.PrimaryAssetId"
                                Size="Size.Small"
                                Alt="@context.Name"
                                FallbackIcon="@Icons.Material.Filled.Movie" />
            </MudTd>
            <MudTd DataLabel="@L["HeaderName"]">
                <MudText Typo="Typo.body2"><b>@context.Name</b></MudText>
            </MudTd>
            <MudTd DataLabel="@L["HeaderShots"]">
                <MudText Typo="Typo.body2">@context.ShotCount</MudText>
            </MudTd>
            <MudTd DataLabel="@L["HeaderStory"]">
                @if (context.StoryEntryId is null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2">@(context.StoryEntryName ?? L["DeletedStoryEntry"])</MudText>
                }
            </MudTd>
            <MudTd DataLabel="@L["HeaderType"]">
                @if (context.TypeName is null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NoType"]</MudText>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.TypeName</MudChip>
                }
            </MudTd>
            <MudTd>
                <MudTooltip Text="@L["DeleteTooltip"]">
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                   Size="Size.Small"
                                   OnClick="@(() => DeleteAsync(context))"
                                   aria-label="@L["DeleteAria", context.Name]" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">
                @L["NoRecords"]
            </MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Cutscenes);

    private List<CutsceneListRow>? _cutscenes;
    private List<ContentType> _types = [];
    private string? _search;
    private Guid? _typeFilter;

    private string Subtitle => _cutscenes is null
        ? L["Loading"]
        : L["SubtitleCount", _cutscenes.Count];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var projectId = await Project.GetCurrentIdAsync();
        _types = await ContentTypes.GetTypesAsync(projectId, ModuleKeys.Cutscenes);
        _cutscenes = await Cutscenes.GetCutscenesAsync(projectId);
    }

    private List<CutsceneListRow> Filtered
    {
        get
        {
            IEnumerable<CutsceneListRow> rows = _cutscenes ?? [];

            if (_typeFilter is { } typeId)
            {
                rows = rows.Where(row => row.ContentTypeId == typeId);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                rows = rows.Where(row =>
                    row.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (row.StoryEntryName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (row.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return [.. rows];
        }
    }

    private void OpenRow(TableRowClickEventArgs<CutsceneListRow> args)
    {
        if (args.Item is { } row)
        {
            Navigation.NavigateTo($"/modules/cutscenes/{row.Id}");
        }
    }

    private async Task DeleteAsync(CutsceneListRow row)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", row.Name],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Cutscenes.DeleteCutsceneAsync(row.Id);
        Snackbar.Add(L["DeletedMessage", row.Name], Severity.Success);
        await LoadAsync();
    }
}
