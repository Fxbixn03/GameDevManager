@page "/modules/cutscenes/arten"

<PageTitle>Cutscene-Arten – GameDevManager</PageTitle>

<ModuleHeader Module="Module"
              Title="Cutscene-Arten"
              Subtitle="Storyboard und Verknüpfungen stehen fest an der Cutscene — alles Weitere definieren die Felder der Art."
              Breadcrumbs="Breadcrumbs">
    <Actions>
        <MudButton Variant="Variant.Outlined" Href="/modules/cutscenes">Zu den Cutscenes</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddAsync">
            Neue Art
        </MudButton>
    </Actions>
</ModuleHeader>

<ContentTypeManager @ref="_manager"
                    ModuleKey="@ModuleKeys.Cutscenes"
                    EntityNoun="Cutscene"
                    EmptyTitle="Noch keine Cutscene-Arten"
                    EmptyHint="Über Arten lassen sich Cutscenes einteilen — etwa Intro, Zwischensequenz oder Abspann — und um eigene Felder wie Dauer oder Kameraführung ergänzen." />

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Cutscenes);

    private static readonly List<BreadcrumbItem> Breadcrumbs = [new("Arten", null, disabled: true)];

    private ContentTypeManager? _manager;

    private Task AddAsync() => _manager?.AddTypeAsync() ?? Task.CompletedTask;
}
