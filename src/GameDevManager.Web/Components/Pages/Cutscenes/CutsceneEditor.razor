@page "/modules/cutscenes/neu"
@page "/modules/cutscenes/{Id:guid}"
@inject CutsceneService Cutscenes
@inject ReferenceService References
@inject AssetService Assets
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<CutsceneEditor> L

<PageTitle>@L["PageTitle", PageHeading]</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @L["NotFound"]
    </MudAlert>
    <MudButton Variant="Variant.Outlined" Href="/modules/cutscenes">@L["BackToList"]</MudButton>
}
else if (_context is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <ModuleHeader Module="Module"
                  Title="@PageHeading"
                  Subtitle="@(_context.IsNew ? L["NotSavedYet"].Value : null)"
                  Breadcrumbs="Breadcrumbs">
        <Actions>
            @if (_dirty)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                    @L["UnsavedChanges"]
                </MudChip>
            }
            @if (!_context.IsNew)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteOutline"
                           OnClick="DeleteAsync">
                    @L["Delete"]
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Href="/modules/cutscenes">@L["Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       data-gdm-save
                       Disabled="_saving"
                       OnClick="SaveAsync">
                @L["Save"]
            </MudButton>
        </Actions>
    </ModuleHeader>

    @* Sagt vor dem Speichern, was die Schreibkonflikt-Erkennung erst danach meldet. *@
    <EditingPresenceBanner EntityId="@(_context.IsNew ? null : _context.Entity.Id)" />

    <MudGrid Spacing="4">
        <MudItem xs="12" md="8">
            <MudStack Spacing="4">

                @* ------------------------------------------------------------- Stammdaten *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionMasterData"]</MudText>

                    <MudStack Spacing="4">
                        <MudTextField Value="_context.Entity.Name"
                                      ValueChanged="@((string name) => Touch(() => _context.Entity.Name = name))"
                                      T="string"
                                      Label="@L["NameLabel"]"
                                      Variant="Variant.Outlined"
                                      Immediate="true" />

                        <MudTextField Value="_context.Entity.Description"
                                      ValueChanged="@((string text) => Touch(() => _context.Entity.Description = text))"
                                      T="string"
                                      Label="@L["DescriptionLabel"]"
                                      Variant="Variant.Outlined"
                                      Lines="3" />

                        <MudSelect T="Guid?"
                                   Value="_context.Entity.ContentTypeId"
                                   ValueChanged="ChangeType"
                                   Label="@L["TypeLabel"]"
                                   Variant="Variant.Outlined"
                                   Clearable="true"
                                   HelperText="@L["TypeHelper"]">
                            @foreach (var type in _context.AvailableTypes)
                            {
                                <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                            }
                        </MudSelect>

                        <MudAutocomplete T="EntitySummary"
                                         Value="@EntityFor(_storyEntries, _context.Entity.StoryEntryId)"
                                         ValueChanged="@((EntitySummary? e) => Touch(() => _context.Entity.StoryEntryId = e?.Id))"
                                         SearchFunc="@((s, ct) => SearchAsync(_storyEntries, s, ct))"
                                         ToStringFunc="@(e => e?.Name ?? string.Empty)"
                                         Label="@L["StoryEntryLabel"]"
                                         HelperText="@L["StoryEntryHelper"]"
                                         Variant="Variant.Outlined"
                                         Clearable="true"
                                         ResetValueOnEmptyText="true"
                                         CoerceValue="false"
                                         MaxItems="50" />

                        <MudAutocomplete T="EntitySummary"
                                         Value="@EntityFor(_dialogues, _context.Entity.DialogueId)"
                                         ValueChanged="@((EntitySummary? e) => Touch(() => _context.Entity.DialogueId = e?.Id))"
                                         SearchFunc="@((s, ct) => SearchAsync(_dialogues, s, ct))"
                                         ToStringFunc="@(e => e?.Name ?? string.Empty)"
                                         Label="@L["DialogueLabel"]"
                                         HelperText="@L["DialogueHelper"]"
                                         Variant="Variant.Outlined"
                                         Clearable="true"
                                         ResetValueOnEmptyText="true"
                                         CoerceValue="false"
                                         MaxItems="50" />
                    </MudStack>
                </MudPaper>

                @* -------------------------------------------------------------- Storyboard *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">@L["SectionStoryboard"]</MudText>
                        <MudButton StartIcon="@Icons.Material.Filled.Add"
                                   Size="Size.Small"
                                   OnClick="AddShot">
                            @L["AddShot"]
                        </MudButton>
                    </MudStack>

                    @if (_context.Entity.Shots.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @L["NoShots"]
                        </MudText>
                    }
                    else
                    {
                        @* Ein Streifen aus Karten statt einer Aufzählung — ein Storyboard sieht
                           so aus. Die Reihenfolge zieht man; die Pfeile bleiben daneben, weil
                           Drag & Drop mit der Tastatur nicht erreichbar ist. *@
                        <div class="gdm-storyboard">
                            @for (var index = 0; index < _context.Entity.Shots.Count; index++)
                            {
                                var shot = _context.Entity.Shots[index];
                                var position = index;

                                <div class="mud-paper gdm-panel pa-3 gdm-storyboard-card"
                                     style="@(ReferenceEquals(_draggingShot, shot) ? "opacity:0.4;" : null)"
                                     draggable="true"
                                     @ondragstart="@(() => _draggingShot = shot)"
                                     @ondragend="@(() => _draggingShot = null)"
                                     @ondragover:preventDefault="true"
                                     @ondrop="@(() => DropOnShot(shot))">

                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                                        <MudText Typo="Typo.subtitle2" Class="gdm-mono">@(position + 1).</MudText>
                                        <MudStack Row="true" Spacing="0">
                                            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                                           Size="Size.Small"
                                                           Disabled="@(position == 0)"
                                                           OnClick="@(() => MoveShot(position, -1))"
                                                           aria-label="@L["MoveShotUp"]" />
                                            <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward"
                                                           Size="Size.Small"
                                                           Disabled="@(position == _context.Entity.Shots.Count - 1)"
                                                           OnClick="@(() => MoveShot(position, 1))"
                                                           aria-label="@L["MoveShotDown"]" />
                                            <MudTooltip Text="@L["RemoveShot"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                               Size="Size.Small"
                                                               OnClick="@(() => RemoveShot(shot))"
                                                               aria-label="@L["RemoveShot"]" />
                                            </MudTooltip>
                                        </MudStack>
                                    </MudStack>

                                    @* Das Skizzenbild hängt an der GUID der Einstellung — es
                                       lässt sich deshalb erst nach dem ersten Speichern
                                       hochladen, wie jedes Sprite. *@
                                    @if (_context.IsNew || _shotsUnsaved.Contains(shot.Id))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2">
                                            @L["ShotImageAfterSave"]
                                        </MudText>
                                    }
                                    else
                                    {
                                        <AssetThumbnail AssetId="@_shotImages.GetValueOrDefault(shot.Id)"
                                                        Size="Size.Large"
                                                        Alt="@shot.Text"
                                                        FallbackIcon="@Icons.Material.Filled.Camera"
                                                        Class="gdm-storyboard-image" />

                                        <AssetUpload OwnerModuleKey="@ModuleKeys.Cutscenes"
                                                     OwnerEntityId="shot.Id"
                                                     OnUploaded="LoadShotImagesAsync"
                                                     Text="@L["ShotImageUpload"]"
                                                     Variant="Variant.Text"
                                                     Color="Color.Default"
                                                     Size="Size.Small" />
                                    }

                                    <MudTextField T="string"
                                                  Value="shot.Text"
                                                  ValueChanged="@((string text) => Touch(() => shot.Text = text))"
                                                  Label="@L["ShotTextLabel"]"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Lines="3"
                                                  MaxLength="2000"
                                                  Class="mt-2" />

                                    <MudStack Row="true" Spacing="2" Class="mt-2">
                                        <MudNumericField T="double?"
                                                         Value="shot.DurationSeconds"
                                                         ValueChanged="@((double? seconds) => Touch(() => shot.DurationSeconds = seconds))"
                                                         Label="@L["ShotDurationLabel"]"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         Min="0"
                                                         Clearable="true"
                                                         Adornment="Adornment.End"
                                                         AdornmentText="s"
                                                         Style="max-width:110px;" />

                                        <MudTextField T="string"
                                                      Value="shot.CameraNote"
                                                      ValueChanged="@((string note) => Touch(() => shot.CameraNote = note))"
                                                      Label="@L["ShotCameraLabel"]"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      MaxLength="500" />
                                    </MudStack>
                                </div>
                            }
                        </div>

                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">
                            @L["StoryboardHint", TotalDuration.ToString("0.##")]
                        </MudText>
                    }
                </MudPaper>

                @* ------------------------------------------------------------------ Sprites *@
                <AssetSpritePanel ModuleKey="@ModuleKeys.Cutscenes"
                                  EntityId="_context.Entity.Id"
                                  Disabled="_context.IsNew" />

                @* ------------------------------------------------------------------- Felder *@
                <div>
                    <ContentFieldsPanel TEntity="Cutscene"
                                        Context="_context"
                                        ModuleKey="@ModuleKeys.Cutscenes"
                                        TypesRoute="/modules/cutscenes/arten"
                                        IndividualHint="@L["IndividualHint"]"
                                        OnValueChanged="MarkDirty"
                                        OnFieldDefinitionChanged="ReloadKeepingChangesAsync" />
                </div>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudStack Spacing="4">
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionReference"]</MudText>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["GuidCaption"]</MudText>
                        @if (!_context.IsNew)
                        {
                            <EntityPinButton ModuleKey="@Module.Id" EntityId="_context.Entity.Id" />
                        }
                    </MudStack>
                    <EntityIdChip Id="_context.Entity.Id" />

                    <MudDivider Class="my-3" />
                    <EntityStatusSelect Entity="_context.Entity" OnChanged="MarkDirty" />

                    @if (!_context.IsNew)
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["CreatedCaption"]</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">@L["UpdatedCaption"]</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                    }
                </MudPaper>

                @if (!_context.IsNew)
                {
                    <EntityTagsPanel ModuleKey="@ModuleKeys.Cutscenes" EntityId="_context.Entity.Id" />
                    <ReferencesPanel @ref="_referencesPanel" EntityId="_context.Entity.Id" />
                    <EntityHistoryPanel @ref="_historyPanel" EntityId="_context.Entity.Id" />
                    <EntityCommentsPanel ModuleKey="@Module.Id" EntityId="_context.Entity.Id" />
                    <EntityTasksPanel EntityId="_context.Entity.Id" />
                }
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Cutscenes);

    [Parameter]
    public Guid? Id { get; set; }

    private ContentEditContext<Cutscene>? _context;
    private ReferencesPanel? _referencesPanel;
    private EntityHistoryPanel? _historyPanel;
    private List<EntitySummary> _storyEntries = [];
    private List<EntitySummary> _dialogues = [];
    private Guid? _loadedId;
    private bool _notFound;
    private bool _saving;
    private bool _dirty;

    private string PageHeading => _context switch
    {
        null => L["HeadingDefault"],
        { IsNew: true } => L["HeadingNew"],
        { Entity.Name: var name } when !string.IsNullOrWhiteSpace(name) => name,
        _ => L["HeadingUnnamed"]
    };

    private List<BreadcrumbItem> Breadcrumbs => [new(PageHeading, null, disabled: true)];

    protected override async Task OnParametersSetAsync()
    {
        if (_context is not null && _loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _notFound = false;
        _dirty = false;
        _context = null;

        var projectId = await Project.GetCurrentIdAsync();
        _storyEntries = await References.GetEntitiesAsync(projectId, ModuleKeys.Story);
        _dialogues = await References.GetEntitiesAsync(projectId, ModuleKeys.Dialogs);
        _context = await Cutscenes.LoadForEditAsync(projectId, Id);

        if (_context is null)
        {
            _notFound = true;
            return;
        }

        _shotsUnsaved.Clear();
        await LoadShotImagesAsync();
    }

    private static EntitySummary? EntityFor(List<EntitySummary> pool, Guid? id) =>
        id is null ? null : pool.FirstOrDefault(entity => entity.Id == id);

    private static Task<IEnumerable<EntitySummary>> SearchAsync(
        List<EntitySummary> pool, string? search, CancellationToken ct)
    {
        IEnumerable<EntitySummary> matches = string.IsNullOrWhiteSpace(search)
            ? pool
            : pool.Where(entity => entity.Name.Contains(search, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(matches);
    }

    private CutsceneShot? _draggingShot;

    /// <summary>
    /// Lädt die Skizzenbilder aller Einstellungen. Eine Abfrage je Einstellung wäre bei einem
    /// Storyboard aus zwanzig Karten zwanzigmal derselbe Weg — deshalb einmal alle.
    /// </summary>
    private async Task LoadShotImagesAsync()
    {
        if (_context is null || _context.IsNew)
        {
            _shotImages = [];
            return;
        }

        var images = new Dictionary<Guid, Guid?>();

        foreach (var shot in _context.Entity.Shots.Where(shot => !_shotsUnsaved.Contains(shot.Id)))
        {
            images[shot.Id] = await Assets.GetPrimaryAssetIdAsync(shot.Id);
        }

        _shotImages = images;
    }

    /// <summary>
    /// Einstellungen, die es in der Datenbank noch nicht gibt. Ihr Skizzenbild hängt an einer
    /// GUID, die erst mit dem Speichern entsteht — dieselbe Regel wie bei den Bedingungen der
    /// Quest-Ziele.
    /// </summary>
    private readonly HashSet<Guid> _shotsUnsaved = [];

    /// <summary>Das Skizzenbild je Einstellung — ihr primäres Sprite, nachgeschlagen über die GUID.</summary>
    private Dictionary<Guid, Guid?> _shotImages = [];

    /// <summary>Die Gesamtdauer des Storyboards — die Frage, die ein Regisseur zuerst stellt.</summary>
    private double TotalDuration =>
        _context?.Entity.Shots.Sum(shot => shot.DurationSeconds ?? 0) ?? 0;

    private void AddShot() =>
        Touch(() =>
        {
            var shot = new CutsceneShot
            {
                CutsceneId = _context!.Entity.Id,
                Text = string.Empty,
                SortOrder = _context.Entity.Shots.Count
            };

            _context.Entity.Shots.Add(shot);
            _shotsUnsaved.Add(shot.Id);
        });

    /// <summary>
    /// Zieht die gehaltene Einstellung an die Stelle der abgelegten. Natives HTML5-DnD auf
    /// einfachen <c>div</c>s, wie im Kanban-Board — die Direktiven <c>@@ondragover:preventDefault</c>
    /// sind auf MudBlazor-Komponenten nicht erlaubt.
    /// </summary>
    private void DropOnShot(CutsceneShot target)
    {
        if (_draggingShot is null || ReferenceEquals(_draggingShot, target) || _context is null)
        {
            return;
        }

        Touch(() =>
        {
            var shots = _context.Entity.Shots;

            shots.Remove(_draggingShot);
            shots.Insert(shots.IndexOf(target), _draggingShot);
        });

        _draggingShot = null;
    }

    private void RemoveShot(CutsceneShot shot) =>
        Touch(() => _context!.Entity.Shots.Remove(shot));

    private void MoveShot(int index, int offset) =>
        Touch(() =>
        {
            var shots = _context!.Entity.Shots;
            (shots[index], shots[index + offset]) = (shots[index + offset], shots[index]);
        });

    private void ChangeType(Guid? contentTypeId) =>
        Touch(() => _context!.Entity.ContentTypeId = contentTypeId);

    private void Touch(Action change)
    {
        change();
        MarkDirty();
    }

    private void MarkDirty() => _dirty = true;

    private async Task SaveAsync()
    {
        if (_context is null)
        {
            return;
        }

        // Leere Eingabezeilen sind ein Bedienschritt, kein Inhalt.
        _context.Entity.Shots.RemoveAll(shot => string.IsNullOrWhiteSpace(shot.Text));

        _saving = true;

        try
        {
            var wasNew = _context.IsNew;
            await Cutscenes.SaveCutsceneAsync(_context);
            _dirty = false;

            Snackbar.Add(L["SavedMessage", _context.Entity.Name], Severity.Success);

            if (wasNew)
            {
                Navigation.NavigateTo($"/modules/cutscenes/{_context.Entity.Id}");
                return;
            }

            // Frisch angelegte Einstellungen haben ihre GUID erst jetzt in der Datenbank —
            // vorher liefe der Bild-Upload ins Leere.
            _shotsUnsaved.Clear();
            await LoadShotImagesAsync();

            if (_referencesPanel is not null)
            {
                await _referencesPanel.RefreshAsync();
            }

            if (_historyPanel is not null)
            {
                await _historyPanel.RefreshAsync();
            }
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_context is null)
        {
            return;
        }

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", _context.Entity.Name],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Cutscenes.DeleteCutsceneAsync(_context.Entity.Id);
        Snackbar.Add(L["DeletedMessage"], Severity.Success);
        Navigation.NavigateTo("/modules/cutscenes");
    }

    /// <summary>
    /// Lädt nach einer Änderung an den Felddefinitionen neu und behält dabei, was in der Maske
    /// noch nicht gespeichert ist.
    /// </summary>
    private async Task ReloadKeepingChangesAsync()
    {
        if (_context is null)
        {
            return;
        }

        var entity = _context.Entity;
        var wasDirty = _dirty;

        var projectId = await Project.GetCurrentIdAsync();
        var reloaded = await Cutscenes.LoadForEditAsync(projectId, entity.Id);

        if (reloaded is null)
        {
            _notFound = true;
            _context = null;
            return;
        }

        reloaded.Entity.Name = entity.Name;
        reloaded.Entity.Description = entity.Description;
        reloaded.Entity.ContentTypeId = entity.ContentTypeId;
        reloaded.Entity.StoryEntryId = entity.StoryEntryId;
        reloaded.Entity.DialogueId = entity.DialogueId;
        reloaded.Entity.Shots = entity.Shots;

        _context = reloaded;
        _dirty = wasDirty;
    }
}
