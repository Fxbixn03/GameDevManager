@page "/modules/cutscenes/neu"
@page "/modules/cutscenes/{Id:guid}"
@inject CutsceneService Cutscenes
@inject ReferenceService References
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@PageHeading – GameDevManager</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        Es gibt keine Cutscene mit dieser GUID. Vielleicht wurde sie gelöscht.
    </MudAlert>
    <MudButton Variant="Variant.Outlined" Href="/modules/cutscenes">Zurück zur Übersicht</MudButton>
}
else if (_context is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <ModuleHeader Module="Module"
                  Title="@PageHeading"
                  Subtitle="@(_context.IsNew ? "Noch nicht gespeichert" : null)"
                  Breadcrumbs="Breadcrumbs">
        <Actions>
            @if (_dirty)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                    Ungespeicherte Änderungen
                </MudChip>
            }
            @if (!_context.IsNew)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteOutline"
                           OnClick="DeleteAsync">
                    Löschen
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Href="/modules/cutscenes">Abbrechen</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       Disabled="_saving"
                       OnClick="SaveAsync">
                Speichern
            </MudButton>
        </Actions>
    </ModuleHeader>

    <MudGrid Spacing="4">
        <MudItem xs="12" md="8">
            <MudStack Spacing="4">

                @* ------------------------------------------------------------- Stammdaten *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">Stammdaten</MudText>

                    <MudStack Spacing="4">
                        <MudTextField Value="_context.Entity.Name"
                                      ValueChanged="@((string name) => Touch(() => _context.Entity.Name = name))"
                                      T="string"
                                      Label="Name *"
                                      Variant="Variant.Outlined"
                                      Immediate="true" />

                        <MudTextField Value="_context.Entity.Description"
                                      ValueChanged="@((string text) => Touch(() => _context.Entity.Description = text))"
                                      T="string"
                                      Label="Beschreibung"
                                      Variant="Variant.Outlined"
                                      Lines="3" />

                        <MudSelect T="Guid?"
                                   Value="_context.Entity.ContentTypeId"
                                   ValueChanged="ChangeType"
                                   Label="Cutscene-Art"
                                   Variant="Variant.Outlined"
                                   Clearable="true"
                                   HelperText="Über die Art kommen eigene Felder dazu, etwa Dauer oder Kameraführung.">
                            @foreach (var type in _context.AvailableTypes)
                            {
                                <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                            }
                        </MudSelect>

                        <MudAutocomplete T="EntitySummary"
                                         Value="@EntityFor(_storyEntries, _context.Entity.StoryEntryId)"
                                         ValueChanged="@((EntitySummary? e) => Touch(() => _context.Entity.StoryEntryId = e?.Id))"
                                         SearchFunc="@((s, ct) => SearchAsync(_storyEntries, s, ct))"
                                         ToStringFunc="@(e => e?.Name ?? string.Empty)"
                                         Label="Story-Abschnitt"
                                         HelperText="Zu welchem Teil der Story die Cutscene gehört."
                                         Variant="Variant.Outlined"
                                         Clearable="true"
                                         ResetValueOnEmptyText="true"
                                         CoerceValue="false"
                                         MaxItems="50" />

                        <MudAutocomplete T="EntitySummary"
                                         Value="@EntityFor(_dialogues, _context.Entity.DialogueId)"
                                         ValueChanged="@((EntitySummary? e) => Touch(() => _context.Entity.DialogueId = e?.Id))"
                                         SearchFunc="@((s, ct) => SearchAsync(_dialogues, s, ct))"
                                         ToStringFunc="@(e => e?.Name ?? string.Empty)"
                                         Label="Dialog"
                                         HelperText="Was in der Cutscene gesprochen wird."
                                         Variant="Variant.Outlined"
                                         Clearable="true"
                                         ResetValueOnEmptyText="true"
                                         CoerceValue="false"
                                         MaxItems="50" />
                    </MudStack>
                </MudPaper>

                @* -------------------------------------------------------------- Storyboard *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Storyboard</MudText>
                        <MudButton StartIcon="@Icons.Material.Filled.Add"
                                   Size="Size.Small"
                                   OnClick="AddShot">
                            Einstellung
                        </MudButton>
                    </MudStack>

                    @if (_context.Entity.Shots.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Noch keine Einstellung. Je Einstellung wird beschrieben, was in der
                            Szene passiert — die Reihenfolge ist das Storyboard.
                        </MudText>
                    }
                    else
                    {
                        <MudStack Spacing="0">
                            @for (var index = 0; index < _context.Entity.Shots.Count; index++)
                            {
                                var shot = _context.Entity.Shots[index];
                                var position = index;

                                <div class="pa-2 gdm-field-row">
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start">
                                        <MudText Typo="Typo.subtitle2" Class="gdm-mono mt-3" Style="min-width:32px;">
                                            @(position + 1).
                                        </MudText>

                                        <div style="flex:1 1 auto; min-width:0;">
                                            <MudTextField T="string"
                                                          Value="shot.Text"
                                                          ValueChanged="@((string text) => Touch(() => shot.Text = text))"
                                                          Label="Was passiert?"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Lines="2"
                                                          MaxLength="2000" />
                                        </div>

                                        <MudStack Spacing="0">
                                            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                                           Size="Size.Small"
                                                           Disabled="@(position == 0)"
                                                           OnClick="@(() => MoveShot(position, -1))"
                                                           aria-label="Einstellung nach oben" />
                                            <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward"
                                                           Size="Size.Small"
                                                           Disabled="@(position == _context.Entity.Shots.Count - 1)"
                                                           OnClick="@(() => MoveShot(position, 1))"
                                                           aria-label="Einstellung nach unten" />
                                        </MudStack>

                                        <MudTooltip Text="Einstellung entfernen">
                                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                           Size="Size.Small"
                                                           OnClick="@(() => RemoveShot(shot))"
                                                           aria-label="Einstellung entfernen" />
                                        </MudTooltip>
                                    </MudStack>
                                </div>
                            }
                        </MudStack>
                    }
                </MudPaper>

                @* ------------------------------------------------------------------ Sprites *@
                <AssetSpritePanel ModuleKey="@ModuleKeys.Cutscenes"
                                  EntityId="_context.Entity.Id"
                                  Disabled="_context.IsNew" />

                @* ------------------------------------------------------------------- Felder *@
                <div>
                    <ContentFieldsPanel TEntity="Cutscene"
                                        Context="_context"
                                        ModuleKey="@ModuleKeys.Cutscenes"
                                        TypesRoute="/modules/cutscenes/arten"
                                        IndividualHint="Für Angaben, die nur diese eine Cutscene braucht."
                                        OnValueChanged="MarkDirty"
                                        OnFieldDefinitionChanged="ReloadKeepingChangesAsync" />
                </div>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudStack Spacing="4">
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">Referenz</MudText>

                    <MudText Typo="Typo.caption" Color="Color.Secondary">GUID</MudText>
                    <EntityIdChip Id="_context.Entity.Id" />

                    @if (!_context.IsNew)
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Angelegt</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">Zuletzt geändert</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                    }
                </MudPaper>

                @if (!_context.IsNew)
                {
                    <EntityTagsPanel ModuleKey="@ModuleKeys.Cutscenes" EntityId="_context.Entity.Id" />
                    <ReferencesPanel @ref="_referencesPanel" EntityId="_context.Entity.Id" />
                }
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Cutscenes);

    [Parameter]
    public Guid? Id { get; set; }

    private ContentEditContext<Cutscene>? _context;
    private ReferencesPanel? _referencesPanel;
    private List<EntitySummary> _storyEntries = [];
    private List<EntitySummary> _dialogues = [];
    private Guid? _loadedId;
    private bool _notFound;
    private bool _saving;
    private bool _dirty;

    private string PageHeading => _context switch
    {
        null => "Cutscene",
        { IsNew: true } => "Neue Cutscene",
        { Entity.Name: var name } when !string.IsNullOrWhiteSpace(name) => name,
        _ => "Cutscene ohne Namen"
    };

    private List<BreadcrumbItem> Breadcrumbs => [new(PageHeading, null, disabled: true)];

    protected override async Task OnParametersSetAsync()
    {
        if (_context is not null && _loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _notFound = false;
        _dirty = false;
        _context = null;

        var projectId = await Project.GetCurrentIdAsync();
        _storyEntries = await References.GetEntitiesAsync(projectId, ModuleKeys.Story);
        _dialogues = await References.GetEntitiesAsync(projectId, ModuleKeys.Dialogs);
        _context = await Cutscenes.LoadForEditAsync(projectId, Id);

        if (_context is null)
        {
            _notFound = true;
        }
    }

    private static EntitySummary? EntityFor(List<EntitySummary> pool, Guid? id) =>
        id is null ? null : pool.FirstOrDefault(entity => entity.Id == id);

    private static Task<IEnumerable<EntitySummary>> SearchAsync(
        List<EntitySummary> pool, string? search, CancellationToken ct)
    {
        IEnumerable<EntitySummary> matches = string.IsNullOrWhiteSpace(search)
            ? pool
            : pool.Where(entity => entity.Name.Contains(search, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(matches);
    }

    private void AddShot() =>
        Touch(() => _context!.Entity.Shots.Add(new CutsceneShot
        {
            CutsceneId = _context.Entity.Id,
            Text = string.Empty,
            SortOrder = _context.Entity.Shots.Count
        }));

    private void RemoveShot(CutsceneShot shot) =>
        Touch(() => _context!.Entity.Shots.Remove(shot));

    private void MoveShot(int index, int offset) =>
        Touch(() =>
        {
            var shots = _context!.Entity.Shots;
            (shots[index], shots[index + offset]) = (shots[index + offset], shots[index]);
        });

    private void ChangeType(Guid? contentTypeId) =>
        Touch(() => _context!.Entity.ContentTypeId = contentTypeId);

    private void Touch(Action change)
    {
        change();
        MarkDirty();
    }

    private void MarkDirty() => _dirty = true;

    private async Task SaveAsync()
    {
        if (_context is null)
        {
            return;
        }

        // Leere Eingabezeilen sind ein Bedienschritt, kein Inhalt.
        _context.Entity.Shots.RemoveAll(shot => string.IsNullOrWhiteSpace(shot.Text));

        _saving = true;

        try
        {
            var wasNew = _context.IsNew;
            await Cutscenes.SaveCutsceneAsync(_context);
            _dirty = false;

            Snackbar.Add($"„{_context.Entity.Name}“ wurde gespeichert.", Severity.Success);

            if (wasNew)
            {
                Navigation.NavigateTo($"/modules/cutscenes/{_context.Entity.Id}");
                return;
            }

            if (_referencesPanel is not null)
            {
                await _referencesPanel.RefreshAsync();
            }
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_context is null)
        {
            return;
        }

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Cutscene löschen",
            $"„{_context.Entity.Name}“ wird mit Storyboard, Feldwerten, individuellen Feldern und Sprites gelöscht.",
            yesText: "Löschen",
            cancelText: "Abbrechen");

        if (confirmed != true)
        {
            return;
        }

        await Cutscenes.DeleteCutsceneAsync(_context.Entity.Id);
        Snackbar.Add("Cutscene gelöscht.", Severity.Success);
        Navigation.NavigateTo("/modules/cutscenes");
    }

    /// <summary>
    /// Lädt nach einer Änderung an den Felddefinitionen neu und behält dabei, was in der Maske
    /// noch nicht gespeichert ist.
    /// </summary>
    private async Task ReloadKeepingChangesAsync()
    {
        if (_context is null)
        {
            return;
        }

        var entity = _context.Entity;
        var wasDirty = _dirty;

        var projectId = await Project.GetCurrentIdAsync();
        var reloaded = await Cutscenes.LoadForEditAsync(projectId, entity.Id);

        if (reloaded is null)
        {
            _notFound = true;
            _context = null;
            return;
        }

        reloaded.Entity.Name = entity.Name;
        reloaded.Entity.Description = entity.Description;
        reloaded.Entity.ContentTypeId = entity.ContentTypeId;
        reloaded.Entity.StoryEntryId = entity.StoryEntryId;
        reloaded.Entity.DialogueId = entity.DialogueId;
        reloaded.Entity.Shots = entity.Shots;

        _context = reloaded;
        _dirty = wasDirty;
    }
}
