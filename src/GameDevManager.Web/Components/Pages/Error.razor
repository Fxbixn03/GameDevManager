@page "/Error"
@attribute [AllowAnonymous]
@using System.Diagnostics
@inject IStringLocalizer<Error> L

<PageTitle>@L["PageTitle"]</PageTitle>

<h1 class="text-danger">@L["Title"]</h1>
<h2 class="text-danger">@L["Subtitle"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@L["RequestIdLabel"]</strong> <code>@RequestId</code>
    </p>
}

<h3>@L["DevModeTitle"]</h3>
<p>
    @((MarkupString)L["DevModeSwapHint"].Value)
</p>
<p>
    @((MarkupString)L["DevModeWarning"].Value)
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
