@page "/modules/events/neu"
@page "/modules/events/{Id:guid}"
@inject EventService Events
@inject MapService Maps
@inject ReferenceService References
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<EventEditor> L

<PageTitle>@L["PageTitle", PageHeading]</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @L["NotFoundMessage"]
    </MudAlert>
    <MudButton Variant="Variant.Outlined" Href="/modules/events">@L["BackToList"]</MudButton>
}
else if (_context is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <ModuleHeader Module="Module"
                  Title="@PageHeading"
                  Subtitle="@(_context.IsNew ? L["NotSavedYet"].Value : null)"
                  Breadcrumbs="Breadcrumbs">
        <Actions>
            @if (_dirty)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                    @L["UnsavedChanges"]
                </MudChip>
            }
            @if (!_context.IsNew)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteOutline"
                           OnClick="DeleteAsync">
                    @L["DeleteButton"]
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Href="/modules/events">@L["CancelButton"]</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       data-gdm-save
                       Disabled="_saving"
                       OnClick="SaveAsync">
                @L["SaveButton"]
            </MudButton>
        </Actions>
    </ModuleHeader>

    @* Sagt vor dem Speichern, was die Schreibkonflikt-Erkennung erst danach meldet. *@
    <EditingPresenceBanner EntityId="@(_context.IsNew ? null : _context.Entity.Id)" />

    <MudGrid Spacing="4">
        <MudItem xs="12" md="8">
            <MudStack Spacing="4">

                @* ------------------------------------------------------------- Stammdaten *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionBasics"]</MudText>

                    <MudStack Spacing="4">
                        <MudTextField Value="_context.Entity.Name"
                                      ValueChanged="@((string name) => Touch(() => _context.Entity.Name = name))"
                                      T="string"
                                      Label="@L["LabelName"]"
                                      Variant="Variant.Outlined"
                                      Immediate="true" />

                        <MudTextField Value="_context.Entity.Description"
                                      ValueChanged="@((string text) => Touch(() => _context.Entity.Description = text))"
                                      T="string"
                                      Label="@L["LabelDescription"]"
                                      Variant="Variant.Outlined"
                                      Lines="3" />

                        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudNumericField T="double"
                                             Value="_context.Entity.Chance"
                                             ValueChanged="@((double v) => Touch(() => _context.Entity.Chance = v))"
                                             Label="@L["LabelChance"]"
                                             Variant="Variant.Outlined"
                                             Min="0"
                                             Max="100"
                                             Adornment="Adornment.End"
                                             AdornmentText="%"
                                             Style="max-width:220px;" />

                            <MudSelect T="Guid?"
                                       Value="_context.Entity.ContentTypeId"
                                       ValueChanged="ChangeType"
                                       Label="@L["LabelType"]"
                                       Variant="Variant.Outlined"
                                       Clearable="true"
                                       Style="max-width:240px;">
                                @foreach (var type in _context.AvailableTypes)
                                {
                                    <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudStack>

                        @* Im Konzept: „Was ist der Loot-Table als Belohnung?“ *@
                        <MudSelect T="Guid?"
                                   Value="_context.Entity.RewardLootTableId"
                                   ValueChanged="@((Guid? id) => Touch(() => _context.Entity.RewardLootTableId = id))"
                                   Label="@L["LabelRewardLootTable"]"
                                   Variant="Variant.Outlined"
                                   Clearable="true"
                                   Disabled="@(_lootTables.Count == 0)"
                                   HelperText="@(_lootTables.Count == 0
                                       ? L["NoLootTablesHint"].Value
                                       : L["RewardHint"].Value)">
                            @foreach (var table in _lootTables)
                            {
                                <MudSelectItem T="Guid?" Value="@table.Id">@table.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudStack>
                </MudPaper>

                @* ---------------------------------------------------------------- Spawns *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">@L["SectionSpawns"]</MudText>
                        <MudButton StartIcon="@Icons.Material.Filled.Add"
                                   Size="Size.Small"
                                   Disabled="@(_npcs.Count == 0)"
                                   OnClick="AddSpawn">
                            @L["AddSpawn"]
                        </MudButton>
                    </MudStack>

                    @if (_npcs.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">
                            @L["NoNpcsPrefix"]
                            <MudLink Href="/modules/npcs" Color="Color.Primary">@L["NoNpcsLink"]</MudLink>.
                        </MudAlert>
                    }
                    else if (_context.Entity.Spawns.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @L["NoSpawnsHint"]
                        </MudText>
                    }
                    else
                    {
                        <MudStack Spacing="0">
                            @foreach (var spawn in _context.Entity.Spawns)
                            {
                                <div class="pa-2 gdm-field-row">
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="6">
                                            <MudAutocomplete T="EntitySummary"
                                                             Value="@NpcFor(spawn.NpcId)"
                                                             ValueChanged="@((EntitySummary? e) => Touch(() => spawn.NpcId = e?.Id ?? Guid.Empty))"
                                                             SearchFunc="SearchNpcsAsync"
                                                             ToStringFunc="@(e => e?.Name ?? string.Empty)"
                                                             Label="@L["LabelNpc"]"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Clearable="true"
                                                             ResetValueOnEmptyText="true"
                                                             CoerceValue="false"
                                                             MaxItems="50" />
                                        </MudItem>

                                        <MudItem xs="12" sm="4">
                                            <MudNumericField T="int"
                                                             Value="spawn.Count"
                                                             ValueChanged="@((int v) => Touch(() => spawn.Count = v))"
                                                             Label="@L["LabelCount"]"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Min="1" />
                                        </MudItem>

                                        <MudItem xs="12" sm="2" Class="d-flex align-center justify-end">
                                            <MudTooltip Text="@L["RemoveSpawnTooltip"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                               Size="Size.Small"
                                                               OnClick="@(() => RemoveSpawn(spawn))"
                                                               aria-label="@L["RemoveSpawnTooltip"]" />
                                            </MudTooltip>
                                        </MudItem>
                                    </MudGrid>
                                </div>
                            }
                        </MudStack>
                    }
                </MudPaper>

                @* ------------------------------------------------------------------ Sprites *@
                <AssetSpritePanel ModuleKey="@ModuleKeys.Events"
                                  EntityId="_context.Entity.Id"
                                  Disabled="_context.IsNew" />

                @* ------------------------------------------------------------------- Felder *@
                <div>
                    <ContentFieldsPanel TEntity="GameEvent"
                                        Context="_context"
                                        ModuleKey="@ModuleKeys.Events"
                                        TypesRoute="/modules/events/arten"
                                        IndividualHint="@L["IndividualHint"]"
                                        OnValueChanged="MarkDirty"
                                        OnFieldDefinitionChanged="ReloadKeepingChangesAsync" />
                </div>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudStack Spacing="4">
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionReference"]</MudText>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["LabelGuid"]</MudText>
                        @if (!_context.IsNew)
                        {
                            <EntityPinButton ModuleKey="@Module.Id" EntityId="_context.Entity.Id" />
                        }
                    </MudStack>
                    <EntityIdChip Id="_context.Entity.Id" />

                    <MudDivider Class="my-3" />
                    <EntityStatusSelect Entity="_context.Entity" OnChanged="MarkDirty" />

                    @* Das Vorbild einer Variante — die Spalte hängt wie der Stand an
                       ContentEntity und gilt damit in allen Inhaltsmodulen. *@
                    <EntityBaseSelect Entity="_context.Entity"
                                      ModuleKey="@Module.Id"
                                      OnChanged="MarkDirty" />

                    @if (!_context.IsNew)
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["CreatedLabel"]</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">@L["UpdatedLabel"]</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                    }
                </MudPaper>

                @* Im Konzept: „Wo auf der Karte kann dieses Event passieren?“ *@
                @if (!_context.IsNew)
                {
                    <MudPaper Elevation="0" Class="gdm-panel pa-4">
                        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionPlaces"]</MudText>

                        @if (_placements.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @L["NoPlacements"]
                            </MudText>
                        }
                        else
                        {
                            @foreach (var placement in _placements)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"
                                          Class="gdm-field-row py-1">
                                    <MudLink Href="@($"/modules/maps/{placement.MapId}")" Typo="Typo.body2">
                                        @placement.MapName@(string.IsNullOrWhiteSpace(placement.Label) ? "" : $" — {placement.Label}")
                                    </MudLink>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="gdm-mono">
                                        @(placement.Radius is > 0 ? L["PlacementArea"].Value : L["PlacementPoint"].Value)
                                    </MudText>
                                </MudStack>
                            }
                        }
                    </MudPaper>
                }

                @if (!_context.IsNew)
                {
                    <EntityTagsPanel ModuleKey="@ModuleKeys.Events" EntityId="_context.Entity.Id" />
                    <ReferencesPanel @ref="_referencesPanel" EntityId="_context.Entity.Id" />
                    <EntityHistoryPanel @ref="_historyPanel" EntityId="_context.Entity.Id" />
                    <EntityCommentsPanel ModuleKey="@Module.Id" EntityId="_context.Entity.Id" />
                    <EntityTasksPanel EntityId="_context.Entity.Id" />
                }
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Events);

    [Parameter]
    public Guid? Id { get; set; }

    private ContentEditContext<GameEvent>? _context;
    private ReferencesPanel? _referencesPanel;
    private EntityHistoryPanel? _historyPanel;
    private List<EntitySummary> _npcs = [];
    private List<EntitySummary> _lootTables = [];
    private List<MapPlacement> _placements = [];
    private Guid? _loadedId;
    private bool _notFound;
    private bool _saving;
    private bool _dirty;

    private string PageHeading => _context switch
    {
        null => L["HeadingDefault"],
        { IsNew: true } => L["HeadingNew"],
        { Entity.Name: var name } when !string.IsNullOrWhiteSpace(name) => name,
        _ => L["HeadingUnnamed"]
    };

    private List<BreadcrumbItem> Breadcrumbs => [new(PageHeading, null, disabled: true)];

    protected override async Task OnParametersSetAsync()
    {
        if (_context is not null && _loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _notFound = false;
        _dirty = false;
        _context = null;

        var projectId = await Project.GetCurrentIdAsync();
        _npcs = await References.GetEntitiesAsync(projectId, ModuleKeys.Npcs);
        _lootTables = await References.GetEntitiesAsync(projectId, ModuleKeys.Loot);
        _context = await Events.LoadForEditAsync(projectId, Id);

        if (_context is null)
        {
            _notFound = true;
            return;
        }

        if (!_context.IsNew)
        {
            _placements = await Maps.GetPlacementsForEntityAsync(projectId, _context.Entity.Id);
        }
    }

    private EntitySummary? NpcFor(Guid npcId) => _npcs.FirstOrDefault(entity => entity.Id == npcId);

    private Task<IEnumerable<EntitySummary>> SearchNpcsAsync(string? search, CancellationToken ct)
    {
        IEnumerable<EntitySummary> matches = string.IsNullOrWhiteSpace(search)
            ? _npcs
            : _npcs.Where(entity => entity.Name.Contains(search, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(matches);
    }

    private void AddSpawn() =>
        Touch(() => _context!.Entity.Spawns.Add(new EventSpawn
        {
            GameEventId = _context.Entity.Id,
            NpcId = Guid.Empty,
            SortOrder = _context.Entity.Spawns.Count
        }));

    private void RemoveSpawn(EventSpawn spawn) =>
        Touch(() => _context!.Entity.Spawns.Remove(spawn));

    private void ChangeType(Guid? contentTypeId) =>
        Touch(() => _context!.Entity.ContentTypeId = contentTypeId);

    private void Touch(Action change)
    {
        change();
        MarkDirty();
    }

    private void MarkDirty() => _dirty = true;

    private async Task SaveAsync()
    {
        if (_context is null)
        {
            return;
        }

        // Leere Eingabezeilen sind ein Bedienschritt, kein Inhalt.
        _context.Entity.Spawns.RemoveAll(spawn => spawn.NpcId == Guid.Empty);

        _saving = true;

        try
        {
            var wasNew = _context.IsNew;
            await Events.SaveEventAsync(_context);
            _dirty = false;

            Snackbar.Add(L["SavedMessage", _context.Entity.Name], Severity.Success);

            if (wasNew)
            {
                Navigation.NavigateTo($"/modules/events/{_context.Entity.Id}");
                return;
            }

            if (_referencesPanel is not null)
            {
                await _referencesPanel.RefreshAsync();
            }

            if (_historyPanel is not null)
            {
                await _historyPanel.RefreshAsync();
            }
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_context is null)
        {
            return;
        }

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", _context.Entity.Name],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Events.DeleteEventAsync(_context.Entity.Id);
        Snackbar.Add(L["DeletedMessage"], Severity.Success);
        Navigation.NavigateTo("/modules/events");
    }

    /// <summary>
    /// Lädt nach einer Änderung an den Felddefinitionen neu und behält dabei, was in der Maske
    /// noch nicht gespeichert ist.
    /// </summary>
    private async Task ReloadKeepingChangesAsync()
    {
        if (_context is null)
        {
            return;
        }

        var entity = _context.Entity;
        var wasDirty = _dirty;

        var projectId = await Project.GetCurrentIdAsync();
        var reloaded = await Events.LoadForEditAsync(projectId, entity.Id);

        if (reloaded is null)
        {
            _notFound = true;
            _context = null;
            return;
        }

        reloaded.Entity.Name = entity.Name;
        reloaded.Entity.Description = entity.Description;
        reloaded.Entity.ContentTypeId = entity.ContentTypeId;
        reloaded.Entity.Chance = entity.Chance;
        reloaded.Entity.RewardLootTableId = entity.RewardLootTableId;
        reloaded.Entity.Spawns = entity.Spawns;

        _context = reloaded;
        _dirty = wasDirty;
    }
}
