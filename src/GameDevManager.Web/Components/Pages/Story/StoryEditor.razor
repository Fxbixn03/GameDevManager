@page "/modules/story/neu"
@page "/modules/story/{Id:guid}"
@inject StoryService Story
@inject MapService Maps
@inject ReferenceService References
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<StoryEditor> L
@inject ModuleLabels Modules

<PageTitle>@L["PageTitle", PageHeading]</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @L["NotFoundMessage"]
    </MudAlert>
    <MudButton Variant="Variant.Outlined" Href="/modules/story">@L["BackToTimeline"]</MudButton>
}
else if (_context is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <ModuleHeader Module="Module"
                  Title="@PageHeading"
                  Subtitle="@(_context.IsNew ? L["NotSavedYet"].Value : null)"
                  Breadcrumbs="Breadcrumbs">
        <Actions>
            @if (_dirty)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                    @L["UnsavedChanges"]
                </MudChip>
            }
            @if (!_context.IsNew)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteOutline"
                           OnClick="DeleteAsync">
                    @L["Delete"]
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Href="/modules/story">@L["Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       Disabled="_saving"
                       data-gdm-save
                       OnClick="SaveAsync">
                @L["Save"]
            </MudButton>
        </Actions>
    </ModuleHeader>

    @* Sagt vor dem Speichern, was die Schreibkonflikt-Erkennung erst danach meldet. *@
    <EditingPresenceBanner EntityId="@(_context.IsNew ? null : _context.Entity.Id)" />

    <MudGrid Spacing="4">
        <MudItem xs="12" md="8">
            <MudStack Spacing="4">

                @* ------------------------------------------------------------- Stammdaten *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["MasterDataSection"]</MudText>

                    <MudStack Spacing="4">
                        <MudTextField Value="_context.Entity.Name"
                                      ValueChanged="@((string name) => Touch(() => _context.Entity.Name = name))"
                                      T="string"
                                      Label="@L["NameLabel"]"
                                      Variant="Variant.Outlined"
                                      Immediate="true" />

                        <MudTextField Value="_context.Entity.Description"
                                      ValueChanged="@((string text) => Touch(() => _context.Entity.Description = text))"
                                      T="string"
                                      Label="@L["SummaryLabel"]"
                                      HelperText="@L["SummaryHelper"]"
                                      Variant="Variant.Outlined"
                                      Lines="2" />

                        <MudSelect T="Guid?"
                                   Value="_context.Entity.ContentTypeId"
                                   ValueChanged="ChangeType"
                                   Label="@L["TypeLabel"]"
                                   Variant="Variant.Outlined"
                                   Clearable="true"
                                   HelperText="@L["TypeHelper"]">
                            @foreach (var type in _context.AvailableTypes)
                            {
                                <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                            }
                        </MudSelect>

                        <MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap">
                            <MudTextField Value="_context.Entity.Mood"
                                          ValueChanged="@((string v) => Touch(() => _context.Entity.Mood = v))"
                                          T="string"
                                          Label="@L["MoodLabel"]"
                                          Placeholder="@L["MoodPlaceholder"]"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Style="min-width:180px;" />
                            <MudTextField Value="_context.Entity.GameDate"
                                          ValueChanged="@((string v) => Touch(() => _context.Entity.GameDate = v))"
                                          T="string"
                                          Label="@L["GameDateLabel"]"
                                          Placeholder="@L["GameDatePlaceholder"]"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Style="min-width:180px;" />
                            <MudTextField Value="_context.Entity.Duration"
                                          ValueChanged="@((string v) => Touch(() => _context.Entity.Duration = v))"
                                          T="string"
                                          Label="@L["DurationLabel"]"
                                          Placeholder="@L["DurationPlaceholder"]"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Style="min-width:180px;" />
                        </MudStack>
                    </MudStack>
                </MudPaper>

                @* ------------------------------------------------------------ Schauplatz *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["LocationSection"]</MudText>

                    <MudStack Spacing="4">
                        <MudTextField Value="_context.Entity.Location"
                                      ValueChanged="@((string v) => Touch(() => _context.Entity.Location = v))"
                                      T="string"
                                      Label="@L["LocationLabel"]"
                                      Placeholder="@L["LocationPlaceholder"]"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />

                        <MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                            <MudSelect T="Guid?"
                                       Value="_context.Entity.TargetMapId"
                                       ValueChanged="ChangeTargetMapAsync"
                                       Label="@L["TargetMapLabel"]"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true"
                                       Disabled="@(EntitiesOf(ModuleKeys.Maps).Count == 0)"
                                       HelperText="@(EntitiesOf(ModuleKeys.Maps).Count == 0 ? L["NoMapsHint"].Value : null)"
                                       Style="min-width:240px;">
                                @foreach (var map in EntitiesOf(ModuleKeys.Maps))
                                {
                                    <MudSelectItem T="Guid?" Value="@map.Id">@map.Name</MudSelectItem>
                                }
                            </MudSelect>

                            @if (_context.Entity.TargetMapId is not null)
                            {
                                <MudSelect T="Guid?"
                                           Value="_context.Entity.TargetMapMarkerId"
                                           ValueChanged="@((Guid? id) => Touch(() => _context.Entity.TargetMapMarkerId = id))"
                                           Label="@L["TargetMarkerLabel"]"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Clearable="true"
                                           Disabled="@(_mapMarkers.Count == 0)"
                                           HelperText="@(_mapMarkers.Count == 0 ? L["NoMarkersHint"].Value : null)"
                                           Style="min-width:240px;">
                                    @foreach (var marker in _mapMarkers)
                                    {
                                        <MudSelectItem T="Guid?" Value="@marker.Id">@MarkerOptionTitle(marker)</MudSelectItem>
                                    }
                                </MudSelect>

                                <MudButton Size="Size.Small"
                                           Variant="Variant.Outlined"
                                           StartIcon="@Icons.Material.Filled.Map"
                                           Href="@($"/modules/maps/{_context.Entity.TargetMapId}")">
                                    @L["OpenMap"]
                                </MudButton>
                            }
                        </MudStack>
                    </MudStack>
                </MudPaper>

                @* --------------------------------------------------- Szenen-Verknüpfungen *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">@L["LinksSection"]</MudText>
                        <MudButton StartIcon="@Icons.Material.Filled.Add"
                                   Size="Size.Small"
                                   Disabled="@(_otherEntries.Count == 0)"
                                   OnClick="AddLink">
                            @L["AddLink"]
                        </MudButton>
                    </MudStack>

                    @if (_otherEntries.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["NoOtherEntries"]</MudText>
                    }
                    else if (_context.Entity.Links.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["NoLinks"]</MudText>
                    }
                    else
                    {
                        <MudStack Spacing="0">
                            @foreach (var link in _context.Entity.Links)
                            {
                                <div class="pa-2 gdm-field-row">
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="6">
                                            <MudAutocomplete T="EntitySummary"
                                                             Value="@LinkTargetFor(link)"
                                                             ValueChanged="@((EntitySummary? e) => Touch(() => link.TargetEntryId = e?.Id ?? Guid.Empty))"
                                                             SearchFunc="SearchOtherEntriesAsync"
                                                             ToStringFunc="@(e => e?.Name ?? string.Empty)"
                                                             Label="@L["LinkTargetLabel"]"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Clearable="true"
                                                             ResetValueOnEmptyText="true"
                                                             CoerceValue="false"
                                                             MaxItems="50" />
                                        </MudItem>

                                        <MudItem xs="12" sm="4">
                                            <MudTextField Value="link.Label"
                                                          ValueChanged="@((string v) => Touch(() => link.Label = v))"
                                                          T="string"
                                                          Label="@L["LinkLabelLabel"]"
                                                          Placeholder="@L["LinkLabelPlaceholder"]"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense" />
                                        </MudItem>

                                        <MudItem xs="12" sm="2" Class="d-flex align-center justify-end">
                                            @if (link.TargetEntryId != Guid.Empty)
                                            {
                                                <MudTooltip Text="@L["OpenLinkedEntry"]">
                                                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                                                   Size="Size.Small"
                                                                   Href="@($"/modules/story/{link.TargetEntryId}")"
                                                                   aria-label="@L["OpenLinkedEntry"]" />
                                                </MudTooltip>
                                            }
                                            <MudTooltip Text="@L["RemoveLink"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                               Size="Size.Small"
                                                               OnClick="@(() => RemoveLink(link))"
                                                               aria-label="@L["RemoveLink"]" />
                                            </MudTooltip>
                                        </MudItem>
                                    </MudGrid>
                                </div>
                            }
                        </MudStack>
                    }
                </MudPaper>

                @* ------------------------------------------------------------- Story-Text *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["BodySection"]</MudText>

                    <MudTextField Value="_context.Entity.Body"
                                  ValueChanged="@((string text) => Touch(() => _context.Entity.Body = text))"
                                  T="string"
                                  Label="@L["BodyLabel"]"
                                  Placeholder="@L["BodyPlaceholder"]"
                                  Variant="Variant.Outlined"
                                  Lines="14" />
                </MudPaper>

                @* ------------------------------------------------------------- Beteiligte *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">@L["ParticipantsSection"]</MudText>
                        <MudButton StartIcon="@Icons.Material.Filled.Add"
                                   Size="Size.Small"
                                   OnClick="AddParticipant">
                            @L["AddParticipant"]
                        </MudButton>
                    </MudStack>

                    @if (_context.Entity.Participants.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @L["NoParticipants"]
                        </MudText>
                    }
                    else
                    {
                        <MudStack Spacing="0">
                            @foreach (var participant in _context.Entity.Participants)
                            {
                                <div class="pa-2 gdm-field-row">
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="4">
                                            <MudSelect T="string"
                                                       Value="participant.TargetModuleKey"
                                                       ValueChanged="@((string key) => Touch(() => ChangeParticipantModule(participant, key)))"
                                                       Label="@L["ModuleLabel"]"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense">
                                                @foreach (var module in ParticipantModules)
                                                {
                                                    <MudSelectItem T="string" Value="@module.Id">@Modules.Name(module)</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>

                                        <MudItem xs="12" sm="6">
                                            <MudAutocomplete T="EntitySummary"
                                                             Value="@EntityFor(participant)"
                                                             ValueChanged="@((EntitySummary? e) => Touch(() => participant.TargetEntityId = e?.Id ?? Guid.Empty))"
                                                             SearchFunc="@((s, ct) => SearchEntitiesAsync(participant.TargetModuleKey, s, ct))"
                                                             ToStringFunc="@(e => e?.Name ?? string.Empty)"
                                                             Label="@L["EntityLabel"]"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Clearable="true"
                                                             ResetValueOnEmptyText="true"
                                                             CoerceValue="false"
                                                             MaxItems="50" />
                                        </MudItem>

                                        <MudItem xs="12" sm="2" Class="d-flex align-center justify-end">
                                            <MudTooltip Text="@L["RemoveParticipant"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                               Size="Size.Small"
                                                               OnClick="@(() => RemoveParticipant(participant))"
                                                               aria-label="@L["RemoveParticipant"]" />
                                            </MudTooltip>
                                        </MudItem>
                                    </MudGrid>
                                </div>
                            }
                        </MudStack>
                    }
                </MudPaper>

                @* ------------------------------------------------------------------ Sprites *@
                <AssetSpritePanel ModuleKey="@ModuleKeys.Story"
                                  EntityId="_context.Entity.Id"
                                  Disabled="_context.IsNew" />

                @* ------------------------------------------------------------------- Felder *@
                <div>
                    <ContentFieldsPanel TEntity="StoryEntry"
                                        Context="_context"
                                        ModuleKey="@ModuleKeys.Story"
                                        TypesRoute="/modules/story/arten"
                                        IndividualHint="@L["IndividualHint"]"
                                        OnValueChanged="MarkDirty"
                                        OnFieldDefinitionChanged="ReloadKeepingChangesAsync" />
                </div>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudStack Spacing="4">
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["ReferenceSection"]</MudText>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["GuidLabel"]</MudText>
                        @if (!_context.IsNew)
                        {
                            <EntityPinButton ModuleKey="@Module.Id" EntityId="_context.Entity.Id" />
                        }
                    </MudStack>
                    <EntityIdChip Id="_context.Entity.Id" />

                    <MudDivider Class="my-3" />
                    <EntityStatusSelect Entity="_context.Entity" OnChanged="MarkDirty" />

                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["TimelinePosition"]</MudText>
                    <MudText Typo="Typo.body2">@(_context.Entity.SortOrder + 1)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @L["TimelineReorderHint"]
                    </MudText>

                    @if (!_context.IsNew)
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["CreatedLabel"]</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">@L["UpdatedLabel"]</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                    }
                </MudPaper>

                @if (!_context.IsNew)
                {
                    <EntityTagsPanel ModuleKey="@ModuleKeys.Story" EntityId="_context.Entity.Id" />
                    <ReferencesPanel @ref="_referencesPanel" EntityId="_context.Entity.Id" />
                    <EntityHistoryPanel @ref="_historyPanel" EntityId="_context.Entity.Id" />
                    <EntityCommentsPanel ModuleKey="@Module.Id" EntityId="_context.Entity.Id" />
                    <EntityTasksPanel EntityId="_context.Entity.Id" />
                }
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Story);

    /// <summary>Die Module, deren Entitäten laut Konzept an der Story beteiligt sind.</summary>
    private static readonly ModuleDefinition[] ParticipantModules =
    [
        ModuleRegistry.Get(ModuleKeys.Npcs),
        ModuleRegistry.Get(ModuleKeys.Factions),
        ModuleRegistry.Get(ModuleKeys.Maps)
    ];

    [Parameter]
    public Guid? Id { get; set; }

    private ContentEditContext<StoryEntry>? _context;
    private ReferencesPanel? _referencesPanel;
    private EntityHistoryPanel? _historyPanel;
    private List<EntitySummary> _otherEntries = [];
    private List<MapMarkerOption> _mapMarkers = [];
    private readonly Dictionary<string, List<EntitySummary>> _entitiesByModule = [];
    private Guid? _loadedId;
    private bool _notFound;
    private bool _saving;
    private bool _dirty;

    private string PageHeading => _context switch
    {
        null => L["HeadingDefault"],
        { IsNew: true } => L["HeadingNew"],
        { Entity.Name: var name } when !string.IsNullOrWhiteSpace(name) => name,
        _ => L["HeadingUnnamed"]
    };

    private List<BreadcrumbItem> Breadcrumbs => [new(PageHeading, null, disabled: true)];

    protected override async Task OnParametersSetAsync()
    {
        if (_context is not null && _loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _notFound = false;
        _dirty = false;
        _context = null;

        var projectId = await Project.GetCurrentIdAsync();

        _entitiesByModule.Clear();
        foreach (var module in ParticipantModules)
        {
            _entitiesByModule[module.Id] = await References.GetEntitiesAsync(projectId, module.Id);
        }

        _context = await Story.LoadForEditAsync(projectId, Id);

        if (_context is null)
        {
            _notFound = true;
            return;
        }

        // Für die Szenen-Verknüpfungen — der Abschnitt selbst gehört nicht in die Auswahl.
        _otherEntries = (await References.GetEntitiesAsync(projectId, ModuleKeys.Story))
            .Where(entry => entry.Id != _context.Entity.Id)
            .ToList();

        if (_context.Entity.TargetMapId is { } mapId)
        {
            _mapMarkers = await Maps.GetMarkerOptionsAsync(mapId);
        }
    }

    private async Task ChangeTargetMapAsync(Guid? mapId)
    {
        Touch(() =>
        {
            _context!.Entity.TargetMapId = mapId;
            // Die alte Markierung gehört zu einer anderen Karte und wäre jetzt irreführend.
            _context.Entity.TargetMapMarkerId = null;
        });

        _mapMarkers = mapId is { } id ? await Maps.GetMarkerOptionsAsync(id) : [];
    }

    private string MarkerOptionTitle(MapMarkerOption marker) =>
        string.IsNullOrWhiteSpace(marker.Label)
            ? L["MarkerFallback", (marker.X * 100).ToString("0"), (marker.Y * 100).ToString("0")]
            : marker.Label;

    private EntitySummary? LinkTargetFor(StoryLink link) =>
        _otherEntries.FirstOrDefault(entry => entry.Id == link.TargetEntryId);

    private Task<IEnumerable<EntitySummary>> SearchOtherEntriesAsync(string? search, CancellationToken ct)
    {
        IEnumerable<EntitySummary> matches = string.IsNullOrWhiteSpace(search)
            ? _otherEntries
            : _otherEntries.Where(entry => entry.Name.Contains(search, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(matches);
    }

    private void AddLink() =>
        Touch(() => _context!.Entity.Links.Add(new StoryLink
        {
            StoryEntryId = _context.Entity.Id,
            SortOrder = _context.Entity.Links.Count
        }));

    private void RemoveLink(StoryLink link) =>
        Touch(() => _context!.Entity.Links.Remove(link));

    private List<EntitySummary> EntitiesOf(string moduleKey) =>
        _entitiesByModule.GetValueOrDefault(moduleKey) ?? [];

    private EntitySummary? EntityFor(StoryParticipant participant) =>
        EntitiesOf(participant.TargetModuleKey).FirstOrDefault(e => e.Id == participant.TargetEntityId);

    private Task<IEnumerable<EntitySummary>> SearchEntitiesAsync(
        string moduleKey, string? search, CancellationToken ct)
    {
        var pool = EntitiesOf(moduleKey);

        IEnumerable<EntitySummary> matches = string.IsNullOrWhiteSpace(search)
            ? pool
            : pool.Where(entity => entity.Name.Contains(search, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(matches);
    }

    private void ChangeParticipantModule(StoryParticipant participant, string moduleKey)
    {
        participant.TargetModuleKey = moduleKey;
        // Die alte Auswahl gehört zu einem anderen Modul und wäre jetzt irreführend.
        participant.TargetEntityId = Guid.Empty;
    }

    private void AddParticipant() =>
        Touch(() => _context!.Entity.Participants.Add(new StoryParticipant
        {
            StoryEntryId = _context.Entity.Id,
            TargetModuleKey = ModuleKeys.Npcs,
            TargetEntityId = Guid.Empty,
            SortOrder = _context.Entity.Participants.Count
        }));

    private void RemoveParticipant(StoryParticipant participant) =>
        Touch(() => _context!.Entity.Participants.Remove(participant));

    private void ChangeType(Guid? contentTypeId) =>
        Touch(() => _context!.Entity.ContentTypeId = contentTypeId);

    private void Touch(Action change)
    {
        change();
        MarkDirty();
    }

    private void MarkDirty() => _dirty = true;

    private async Task SaveAsync()
    {
        if (_context is null)
        {
            return;
        }

        // Leere Eingabezeilen sind ein Bedienschritt, kein Inhalt.
        _context.Entity.Participants.RemoveAll(p => p.TargetEntityId == Guid.Empty);
        _context.Entity.Links.RemoveAll(l => l.TargetEntryId == Guid.Empty);

        _saving = true;

        try
        {
            var wasNew = _context.IsNew;
            await Story.SaveEntryAsync(_context);
            _dirty = false;

            Snackbar.Add(L["SavedMessage", _context.Entity.Name], Severity.Success);

            if (wasNew)
            {
                Navigation.NavigateTo($"/modules/story/{_context.Entity.Id}");
                return;
            }

            if (_referencesPanel is not null)
            {
                await _referencesPanel.RefreshAsync();
            }

            if (_historyPanel is not null)
            {
                await _historyPanel.RefreshAsync();
            }
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_context is null)
        {
            return;
        }

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", _context.Entity.Name],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Story.DeleteEntryAsync(_context.Entity.Id);
        Snackbar.Add(L["DeletedMessage"], Severity.Success);
        Navigation.NavigateTo("/modules/story");
    }

    /// <summary>
    /// Lädt nach einer Änderung an den Felddefinitionen neu und behält dabei, was in der Maske
    /// noch nicht gespeichert ist.
    /// </summary>
    private async Task ReloadKeepingChangesAsync()
    {
        if (_context is null)
        {
            return;
        }

        var entity = _context.Entity;
        var wasDirty = _dirty;

        var projectId = await Project.GetCurrentIdAsync();
        var reloaded = await Story.LoadForEditAsync(projectId, entity.Id);

        if (reloaded is null)
        {
            _notFound = true;
            _context = null;
            return;
        }

        reloaded.Entity.Name = entity.Name;
        reloaded.Entity.Description = entity.Description;
        reloaded.Entity.ContentTypeId = entity.ContentTypeId;
        reloaded.Entity.Body = entity.Body;
        reloaded.Entity.Mood = entity.Mood;
        reloaded.Entity.GameDate = entity.GameDate;
        reloaded.Entity.Duration = entity.Duration;
        reloaded.Entity.Location = entity.Location;
        reloaded.Entity.TargetMapId = entity.TargetMapId;
        reloaded.Entity.TargetMapMarkerId = entity.TargetMapMarkerId;
        reloaded.Entity.SortOrder = entity.SortOrder;
        reloaded.Entity.Participants = entity.Participants;
        reloaded.Entity.Links = entity.Links;

        _context = reloaded;
        _dirty = wasDirty;
    }
}
