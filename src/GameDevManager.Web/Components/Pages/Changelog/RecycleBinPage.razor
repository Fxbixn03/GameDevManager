@page "/modules/changelog/papierkorb"
@inject RecycleBinService RecycleBin
@inject ProjectContext Project
@inject ModuleLabels Modules
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject IStringLocalizer<RecycleBinPage> L

@*
    Der Papierkorb (F24): eine versehentlich gelöschte Entität zurückholen, ohne den letzten
    Exportstand einzuspielen und alles seitdem zu verlieren.

    Er steht beim Änderungsprotokoll und nicht als eigenes Modul: Beide beantworten dieselbe
    Frage aus zwei Richtungen — „wer hat was gelöscht“ und „hol es zurück“.

    Aufbewahrt wird der vollständige JSON-Baum; erfasst wird in EntityCleanup, der einen Stelle,
    durch die jeder Löschpfad läuft.
*@

<PageTitle>@L["PageTitle"]</PageTitle>

<ModuleHeader Module="Module" Title="@L["Heading"]" Subtitle="@Subtitle" Breadcrumbs="Breadcrumbs">
    <Actions>
        <MudButton Variant="Variant.Outlined" Href="/modules/changelog">@L["ToChangelog"]</MudButton>
        @if (_rows is { Count: > 0 })
        {
            <MudButton Variant="Variant.Text"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.DeleteSweep"
                       OnClick="EmptyAsync">
                @L["Empty"]
            </MudButton>
        }
    </Actions>
</ModuleHeader>

@if (_rows is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_rows.Count == 0)
{
    <MudPaper Elevation="0" Class="gdm-panel pa-8 d-flex flex-column align-center">
        <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
        <MudText Typo="Typo.body1">@L["EmptyHeading"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["EmptyHint"]</MudText>
    </MudPaper>
}
else
{
    <MudPaper Elevation="0" Class="gdm-panel">
        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Style="overflow-x:auto;">
            <thead>
                <tr>
                    <th>@L["ColumnName"]</th>
                    <th>@L["ColumnModule"]</th>
                    <th>@L["ColumnDeletedAt"]</th>
                    <th>@L["ColumnDeletedBy"]</th>
                    <th style="width:220px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr>
                        <td>
                            <MudText Typo="Typo.body2"><b>@row.EntityName</b></MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="gdm-mono">
                                @row.EntityId
                            </MudText>
                        </td>
                        <td>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@ModuleIcon(row.ModuleKey)" Size="Size.Small" />
                                <MudText Typo="Typo.body2">@ModuleName(row.ModuleKey)</MudText>
                            </MudStack>
                        </td>
                        <td>
                            <MudText Typo="Typo.body2">
                                @row.DeletedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </MudText>
                        </td>
                        <td>
                            <MudText Typo="Typo.body2">@row.DeletedBy</MudText>
                        </td>
                        <td>
                            <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                                @if (row.IsBlocked)
                                {
                                    @* Unter dieser GUID steht schon wieder etwas — meist eine
                                       Wiederherstellung aus einem Exportstand. *@
                                    <MudTooltip Text="@L["BlockedTooltip"]">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                                            @L["Blocked"]
                                        </MudChip>
                                    </MudTooltip>
                                }
                                else
                                {
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Outlined"
                                               StartIcon="@Icons.Material.Filled.Restore"
                                               OnClick="@(() => RestoreAsync(row))">
                                        @L["Restore"]
                                    </MudButton>
                                }
                                <MudTooltip Text="@L["PurgeTooltip"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteForever"
                                                   Size="Size.Small"
                                                   OnClick="@(() => PurgeAsync(row))"
                                                   aria-label="@L["PurgeAria", row.EntityName]" />
                                </MudTooltip>
                            </MudStack>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-3">
        @RetentionText
    </MudText>

    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">@L["SpriteHint"]</MudAlert>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Changelog);

    private List<RecycleBinRow>? _rows;

    private List<BreadcrumbItem> Breadcrumbs =>
        [new(Modules.Name(Module), "/modules/changelog"), new(L["Heading"], null, disabled: true)];

    private string Subtitle => L["Subtitle"];

    /// <summary>
    /// Die geltende Regel im Klartext — auch „unbegrenzt“, sonst wäre die Einstellung nicht
    /// auffindbar. Dieselbe Linie wie bei den Exportständen.
    /// </summary>
    private string RetentionText
    {
        get
        {
            var options = RecycleBin.Options;

            if (!options.HasRetentionRule)
            {
                return L["RetentionNone"];
            }

            if (options.MaxAgeDays > 0 && options.MaxPerProject > 0)
            {
                return L["RetentionBoth", options.MaxAgeDays, options.MaxPerProject];
            }

            return options.MaxAgeDays > 0
                ? L["RetentionAge", options.MaxAgeDays]
                : L["RetentionCount", options.MaxPerProject];
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _rows = null;
        _rows = await RecycleBin.GetEntriesAsync(await Project.GetCurrentIdAsync());
    }

    private string ModuleName(string moduleKey) =>
        ModuleRegistry.Find(moduleKey) is { } module ? Modules.Name(module) : moduleKey;

    private static string ModuleIcon(string moduleKey) =>
        ModuleRegistry.Find(moduleKey)?.Icon ?? Icons.Material.Filled.Folder;

    private async Task RestoreAsync(RecycleBinRow row)
    {
        try
        {
            await RecycleBin.RestoreAsync(row.Id);
            Snackbar.Add(L["RestoredMessage", row.EntityName], Severity.Success);
            await LoadAsync();
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task PurgeAsync(RecycleBinRow row)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["PurgeConfirmTitle"],
            L["PurgeConfirmMessage", row.EntityName],
            yesText: L["PurgeYes"],
            cancelText: L["Cancel"]);

        if (confirmed != true)
        {
            return;
        }

        await RecycleBin.PurgeAsync(row.Id);
        await LoadAsync();
    }

    private async Task EmptyAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["EmptyConfirmTitle"],
            L["EmptyConfirmMessage", _rows?.Count ?? 0],
            yesText: L["EmptyYes"],
            cancelText: L["Cancel"]);

        if (confirmed != true)
        {
            return;
        }

        var removed = await RecycleBin.EmptyAsync(await Project.GetCurrentIdAsync());
        Snackbar.Add(L["EmptiedMessage", removed], Severity.Success);
        await LoadAsync();
    }
}
