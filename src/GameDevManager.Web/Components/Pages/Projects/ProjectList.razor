@page "/projekte"
@inject ProjectService Projects
@inject SampleProjectService Samples
@inject ProjectContext Project
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IStringLocalizer<ProjectList> L

<PageTitle>@L["PageTitle"]</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6">
    <div>
        <MudText Typo="Typo.h4" GutterBottom="true">@L["Heading"]</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">@L["Subtitle"]</MudText>
    </div>
    <MudStack Row="true" Spacing="2">
        <MudTooltip Text="@L["SampleTooltip"]">
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.AutoAwesome"
                       Disabled="@_creatingSample"
                       OnClick="CreateSampleAsync">
                @L["SampleButton"]
            </MudButton>
        </MudTooltip>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddAsync">
            @L["AddButton"]
        </MudButton>
    </MudStack>
</MudStack>

@* Das Anlegen läuft durch alle Modul-Dienste — kurz, aber nicht sofort. *@
@if (_creatingSample)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
}

@* Beim Duplizieren bleibt die Liste stehen — das Kopieren läuft über Export und Import
   und kann bei einem großen Projekt dauern. *@
@if (_duplicating)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
}

@if (_projects is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    var archived = _projects.Where(p => p.IsArchived).ToList();

    <MudPaper Elevation="0" Class="gdm-panel">
        @foreach (var project in _projects.Where(p => !p.IsArchived))
        {
            var isCurrent = project.Id == _currentId;
            <div class="pa-3 gdm-field-row">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Filled.SportsEsports"
                             Color="@(isCurrent ? Color.Primary : Color.Default)" />

                    <div style="flex:1; min-width:0;">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.subtitle2">@project.Name</MudText>
                            @if (isCurrent)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">
                                    @L["ActiveChip"]
                                </MudChip>
                            }
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @L["CreatedAt", project.CreatedAtUtc.ToLocalTime().ToString("g")]@(string.IsNullOrWhiteSpace(project.Description) ? null : $" — {project.Description}")
                        </MudText>
                    </div>

                    <MudTooltip Text="@L["ActivateTooltip"]">
                        <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz"
                                       Size="Size.Small"
                                       Disabled="@isCurrent"
                                       aria-label="@L["ActivateAria"]"
                                       OnClick="@(() => ActivateAsync(project))" />
                    </MudTooltip>
                    <MudTooltip Text="@L["EditTooltip"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       aria-label="@L["EditAria"]"
                                       OnClick="@(() => EditAsync(project))" />
                    </MudTooltip>
                    <MudTooltip Text="@L["DuplicateTooltip"]">
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                       Size="Size.Small"
                                       Disabled="@_duplicating"
                                       aria-label="@L["DuplicateAria"]"
                                       OnClick="@(() => DuplicateAsync(project))" />
                    </MudTooltip>
                    <MudTooltip Text="@(isCurrent ? L["ArchiveActiveTooltip"] : L["ArchiveTooltip"])">
                        <MudIconButton Icon="@Icons.Material.Filled.Archive"
                                       Size="Size.Small"
                                       Disabled="@isCurrent"
                                       aria-label="@L["ArchiveAria"]"
                                       OnClick="@(() => ArchiveAsync(project))" />
                    </MudTooltip>
                    <MudTooltip Text="@(isCurrent ? L["DeleteActiveTooltip"] : L["DeleteTooltip"])">
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                       Size="Size.Small"
                                       Disabled="@isCurrent"
                                       aria-label="@L["DeleteAria"]"
                                       OnClick="@(() => DeleteAsync(project))" />
                    </MudTooltip>
                </MudStack>
            </div>
        }
    </MudPaper>

    @* Archivierte Projekte: aus dem Weg, aber nicht weg — sie erscheinen nur noch hier.
       Entarchivieren stellt alles wieder her; Löschen bleibt getrennt und behält sein
       Sicherheitsnetz. *@
    @if (archived.Count > 0)
    {
        <MudText Typo="Typo.h6" Class="mt-8 mb-1">@L["ArchivedHeading"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">@L["ArchivedSubtitle"]</MudText>

        <MudPaper Elevation="0" Class="gdm-panel">
            @foreach (var project in archived)
            {
                <div class="pa-3 gdm-field-row">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Default" />

                        <div style="flex:1; min-width:0;">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudText Typo="Typo.subtitle2">@project.Name</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">
                                    @L["ArchivedChip"]
                                </MudChip>
                            </MudStack>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @L["CreatedAt", project.CreatedAtUtc.ToLocalTime().ToString("g")]@(string.IsNullOrWhiteSpace(project.Description) ? null : $" — {project.Description}")
                            </MudText>
                        </div>

                        <MudTooltip Text="@L["UnarchiveTooltip"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Unarchive"
                                           Size="Size.Small"
                                           aria-label="@L["UnarchiveAria"]"
                                           OnClick="@(() => UnarchiveAsync(project))" />
                        </MudTooltip>
                        <MudTooltip Text="@L["DeleteTooltip"]">
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                           Size="Size.Small"
                                           aria-label="@L["DeleteAria"]"
                                           OnClick="@(() => DeleteAsync(project))" />
                        </MudTooltip>
                    </MudStack>
                </div>
            }
        </MudPaper>
    }
}

@code {
    private List<GameProject>? _projects;
    private Guid _currentId;
    private bool _duplicating;
    private bool _creatingSample;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _currentId = await Project.GetCurrentIdAsync();
        _projects = await Projects.GetProjectsAsync();
    }

    private Task AddAsync() =>
        EditWithDialogAsync(new GameProject { Name = string.Empty }, isNew: true);

    /// <summary>
    /// Legt das Beispielprojekt an und wechselt hinein — wer es anlegt, will es sehen.
    /// Der Name weicht von selbst aus, wenn es schon eines gibt.
    /// </summary>
    private async Task CreateSampleAsync()
    {
        _creatingSample = true;

        try
        {
            var sample = await Samples.CreateAsync();
            Snackbar.Add(L["SampleCreatedMessage", sample.Name], Severity.Success);

            await Project.SetCurrentAsync(sample.Id);
            Navigation.NavigateTo("/dashboard", forceLoad: true);
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _creatingSample = false;
        }
    }

    // Kopie statt Original in den Dialog — Abbrechen darf die Liste nicht verändert zurücklassen.
    private Task EditAsync(GameProject project) =>
        EditWithDialogAsync(new GameProject
        {
            Id = project.Id,
            Name = project.Name,
            Description = project.Description,
            CreatedAtUtc = project.CreatedAtUtc
        }, isNew: false);

    private async Task EditWithDialogAsync(GameProject project, bool isNew)
    {
        var edited = await AskAsync(project, isNew, isNew ? L["DialogTitleNew"] : L["DialogTitleEdit"]);
        if (edited is null)
        {
            return;
        }

        try
        {
            await Projects.SaveProjectAsync(edited);
            Snackbar.Add(L["SavedMessage", edited.Name], Severity.Success);

            if (edited.Id == _currentId)
            {
                // Appbar und Cache zeigen sonst den alten Namen.
                Project.Invalidate();
            }

            await LoadAsync();
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /// <summary>
    /// Fragt Name und Beschreibung ab. Die Kopie im Dialog statt des Originals — Abbrechen
    /// darf die Liste nicht verändert zurücklassen. <c>null</c> heißt abgebrochen.
    /// </summary>
    private async Task<GameProject?> AskAsync(GameProject project, bool isNew, string title)
    {
        var parameters = new DialogParameters<ProjectDialog>
        {
            { d => d.Project, project },
            { d => d.IsNew, isNew },
            { d => d.Title, title }
        };

        var reference = await Dialogs.ShowAsync<ProjectDialog>(
            title, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await reference.Result;
        return result is null || result.Canceled ? null : result.Data as GameProject;
    }

    /// <summary>
    /// Legt eine Kopie an. Der Name kommt aus demselben Dialog wie beim Anlegen, vorbelegt
    /// mit „… (Kopie)“ — eindeutig muss er trotzdem sein, den Rest prüft der Dienst.
    /// </summary>
    private async Task DuplicateAsync(GameProject project)
    {
        var wanted = await AskAsync(
            new GameProject
            {
                Name = L["CopyNameSuffix", project.Name],
                Description = project.Description
            },
            isNew: true,
            L["DialogTitleDuplicate"]);

        if (wanted is null)
        {
            return;
        }

        _duplicating = true;

        try
        {
            var copy = await Projects.DuplicateProjectAsync(project.Id, wanted.Name, wanted.Description);
            Snackbar.Add(L["DuplicatedMessage", copy.Name], Severity.Success);
            await LoadAsync();
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _duplicating = false;
        }
    }

    private async Task ArchiveAsync(GameProject project)
    {
        try
        {
            await Projects.ArchiveProjectAsync(project.Id, _currentId);
            Snackbar.Add(L["ArchivedMessage", project.Name], Severity.Success);
            await LoadAsync();
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task UnarchiveAsync(GameProject project)
    {
        try
        {
            await Projects.UnarchiveProjectAsync(project.Id);
            Snackbar.Add(L["UnarchivedMessage", project.Name], Severity.Success);
            await LoadAsync();
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ActivateAsync(GameProject project)
    {
        await Project.SetCurrentAsync(project.Id);
        Navigation.NavigateTo("/dashboard", forceLoad: true);
    }

    private async Task DeleteAsync(GameProject project)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", project.Name],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Projects.DeleteProjectAsync(project.Id);
            Snackbar.Add(L["DeletedMessage"], Severity.Success);
            await LoadAsync();
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
