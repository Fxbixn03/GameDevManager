@inject IStringLocalizer<ProjectDialog> L

@*
    Anlegen und Bearbeiten eines Spielprojekts — nur Name und Beschreibung, die Inhalte
    entstehen in den Modulen.
*@

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.SportsEsports" />
            <MudText Typo="Typo.h6">@TitleText</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="4" Style="min-width:min(520px, 80vw);">
            <MudTextField @bind-Value="Project.Name"
                          Label="@L["NameLabel"]"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Required="true"
                          HelperText="@L["NameHelper"]" />

            <MudTextField @bind-Value="Project.Description"
                          Label="@L["DescriptionLabel"]"
                          Variant="Variant.Outlined"
                          Lines="2" />

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">@L["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">@L["Submit"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public required GameProject Project { get; set; }

    [Parameter]
    public bool IsNew { get; set; }

    /// <summary>
    /// Überschrift des Dialogs. Ein Feldinitialisierer kennt den Localizer noch nicht —
    /// deshalb <c>string?</c> und die Auflösung erst in <see cref="TitleText"/>.
    /// </summary>
    [Parameter]
    public string? Title { get; set; }

    private string TitleText => Title ?? (IsNew ? L["TitleNew"] : L["TitleEdit"]);

    private string? _error;

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(Project.Name))
        {
            _error = L["NameRequired"];
            return;
        }

        _error = null;
        MudDialog.Close(DialogResult.Ok(Project));
    }
}
