@page "/modules/tags"
@inject TagService Tags
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IStringLocalizer<TagList> L
@inject ModuleLabels Modules

<PageTitle>@L["PageTitle"]</PageTitle>

<ModuleHeader Module="Module" Subtitle="@Subtitle">
    <Actions>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddTag">
            @L["NewTag"]
        </MudButton>
    </Actions>
</ModuleHeader>

@if (_tags is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_tags.Count == 0 && _editing.Count == 0)
{
    <div class="gdm-empty">
        <MudIcon Icon="@Icons.Material.Filled.Label" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
        <MudText Typo="Typo.h6">@L["EmptyTitle"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            @L["EmptyHint"]
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddTag">
            @L["FirstTag"]
        </MudButton>
    </div>
}
else
{
    <MudStack Spacing="3">
        @foreach (var draft in _editing)
        {
            <MudPaper Elevation="0" Class="gdm-panel pa-4">
                <MudGrid Spacing="2" Class="align-center">
                    <MudItem xs="12" sm="3">
                        <MudTextField T="string"
                                      @bind-Value="draft.Name"
                                      Label="@L["NameLabel"]"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      MaxLength="100" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudTextField T="string"
                                      @bind-Value="draft.Description"
                                      Label="@L["DescriptionLabel"]"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="6" sm="2">
                        <MudTextField T="string"
                                      @bind-Value="draft.Color"
                                      Label="@L["ColorLabel"]"
                                      Placeholder="#FFC300"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      MaxLength="20" />
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudSelect T="string"
                                   MultiSelection="true"
                                   @bind-SelectedValues="draft.ModuleKeys"
                                   Label="@L["ModulesLabel"]"
                                   HelperText="@L["ModulesHelper"]"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Clearable="true">
                            @foreach (var module in ImplementedModules)
                            {
                                <MudSelectItem T="string" Value="@module.Id">@Modules.Name(module)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="1" Class="d-flex justify-end">
                        <MudTooltip Text="@L["SaveTooltip"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Save"
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           OnClick="@(() => SaveAsync(draft))"
                                           aria-label="@L["SaveAria"]" />
                        </MudTooltip>
                        <MudTooltip Text="@L["DiscardTooltip"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Size="Size.Small"
                                           OnClick="@(() => _editing.Remove(draft))"
                                           aria-label="@L["DiscardAria"]" />
                        </MudTooltip>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }

        @if (_tags.Count > 0)
        {
            @* Tags haben keine eigene Maske — die Kachel öffnet die Zeile oben zum Bearbeiten. *@
            <div class="gdm-item-grid">
                @foreach (var tag in _tags)
                {
                    <MudPaper Elevation="0" Class="gdm-panel gdm-card-link">
                        <div class="cursor-pointer" @onclick="@(() => EditTag(tag))">
                            <AssetThumbnail Class="gdm-item-tile"
                                            Alt="@tag.Name"
                                            FallbackIcon="@Icons.Material.Filled.Label" />
                        </div>

                        <div class="pa-3">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                                @* min-width:0, sonst schrumpft der Name neben den Knöpfen nicht und kürzt nie. *@
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="min-width:0;">
                                    @if (!string.IsNullOrWhiteSpace(tag.Color))
                                    {
                                        <span class="gdm-color-dot" style="@($"background-color:{tag.Color};")"></span>
                                    }
                                    <MudText Typo="Typo.body1" Class="gdm-ellipsis"><b>@tag.Name</b></MudText>
                                </MudStack>
                                <MudStack Row="true" Spacing="0">
                                    <MudTooltip Text="@L["EditTooltip"]">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Size="Size.Small"
                                                       OnClick="@(() => EditTag(tag))"
                                                       aria-label="@L["EditAria", tag.Name]" />
                                    </MudTooltip>
                                    <MudTooltip Text="@L["DeleteTooltip"]">
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                       Size="Size.Small"
                                                       OnClick="@(() => DeleteAsync(tag))"
                                                       aria-label="@L["DeleteAria", tag.Name]" />
                                    </MudTooltip>
                                </MudStack>
                            </MudStack>

                            @if (!string.IsNullOrWhiteSpace(tag.Description))
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="gdm-ellipsis">
                                    @tag.Description
                                </MudText>
                            }

                            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-2">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">
                                    @L["UsageCountChip", tag.AssignmentCount]
                                </MudChip>
                            </MudStack>

                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 gdm-ellipsis">
                                @(tag.ModuleKeys.Count == 0 ? L["Everywhere"].Value : ModuleNames(tag.ModuleKeys))
                            </MudText>
                        </div>
                    </MudPaper>
                }
            </div>
        }
    </MudStack>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Tags);

    private static readonly List<ModuleDefinition> ImplementedModules =
        [.. ModuleRegistry.All.Where(m => m.Implemented && m.Id != ModuleKeys.Tags)];

    /// <summary>Bearbeitungszustand einer Zeile — bestehendes Tag oder neuer Entwurf.</summary>
    private sealed class TagDraft
    {
        public Guid Id { get; init; } = Guid.NewGuid();
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string? Color { get; set; }
        public IReadOnlyCollection<string> ModuleKeys { get; set; } = [];
    }

    private List<ContentTagRow>? _tags;
    private readonly List<TagDraft> _editing = [];
    private Guid _projectId;

    private string Subtitle => _tags is null
        ? L["Loading"]
        : L["SubtitleCount", _tags.Count];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _projectId = await Project.GetCurrentIdAsync();
        _tags = await Tags.GetTagsAsync(_projectId);
    }

    private string ModuleNames(IReadOnlyList<string> keys) =>
        string.Join(", ", keys.Select(Modules.Name));

    private void AddTag() => _editing.Insert(0, new TagDraft());

    private void EditTag(ContentTagRow row)
    {
        if (_editing.Any(draft => draft.Id == row.Id))
        {
            return;
        }

        _editing.Insert(0, new TagDraft
        {
            Id = row.Id,
            Name = row.Name,
            Description = row.Description,
            Color = row.Color,
            ModuleKeys = [.. row.ModuleKeys]
        });
    }

    private async Task SaveAsync(TagDraft draft)
    {
        try
        {
            await Tags.SaveTagAsync(
                _projectId, draft.Id, draft.Name, draft.Description, draft.Color, [.. draft.ModuleKeys]);
            _editing.Remove(draft);
            Snackbar.Add(L["SavedMessage", draft.Name], Severity.Success);
            await LoadAsync();
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(ContentTagRow row)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", row.Name, row.AssignmentCount],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Tags.DeleteTagAsync(row.Id);
        Snackbar.Add(L["DeletedMessage", row.Name], Severity.Success);
        await LoadAsync();
    }
}
