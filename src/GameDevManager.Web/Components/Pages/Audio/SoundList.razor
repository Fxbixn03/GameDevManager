@page "/modules/audio"
@inject AudioService Audio
@inject ContentTypeService ContentTypes
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>SFX/Audio – GameDevManager</PageTitle>

<ModuleHeader Module="Module" Subtitle="@Subtitle">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Style"
                   Href="/modules/audio/arten">
            Audio-Arten
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/modules/audio/neu">
            Neuer Sound
        </MudButton>
    </Actions>
</ModuleHeader>

@if (_sounds is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_sounds.Count == 0)
{
    <div class="gdm-empty">
        <MudIcon Icon="@Icons.Material.Filled.MusicNote" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
        <MudText Typo="Typo.h6">Noch keine Sounds</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Soundeffekte und Musik. Die Audiodateien (MP3, OGG, WAV) hängen als Dateien an
            der jeweiligen Entität und lassen sich direkt in der Maske anhören.
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/modules/audio/neu">
            Erster Sound
        </MudButton>
    </div>
}
else
{
    <MudPaper Elevation="0" Class="gdm-panel pa-4 mb-4">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_search"
                          Placeholder="Nach Name oder Beschreibung suchen"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="max-width:360px;" />

            <MudSelect T="Guid?"
                       @bind-Value="_typeFilter"
                       Label="Art"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="max-width:220px;">
                @foreach (var type in _types)
                {
                    <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSpacer />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Filtered.Count von @_sounds.Count</MudText>
        </MudStack>
    </MudPaper>

    <MudTable T="SoundEffectListRow"
              Items="Filtered"
              Elevation="0"
              Hover="true"
              Dense="true"
              Breakpoint="Breakpoint.Sm"
              OnRowClick="OpenRow"
              RowClass="cursor-pointer">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Beschreibung</MudTh>
            <MudTh>Audiodateien</MudTh>
            <MudTh>Art</MudTh>
            <MudTh Style="width:56px;"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.MusicNote" Size="Size.Small" Color="Color.Secondary" />
                    <MudText Typo="Typo.body2"><b>@context.Name</b></MudText>
                </MudStack>
            </MudTd>
            <MudTd DataLabel="Beschreibung">
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Shorten(context.Description)</MudText>
            </MudTd>
            <MudTd DataLabel="Audiodateien">
                @if (context.AudioFileCount == 0)
                {
                    <MudTooltip Text="Noch keine Audiodatei hochgeladen">
                        <MudText Typo="Typo.caption" Color="Color.Warning">keine</MudText>
                    </MudTooltip>
                }
                else
                {
                    <MudText Typo="Typo.body2">@context.AudioFileCount</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Art">
                @if (context.TypeName is null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">ohne Art</MudText>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.TypeName</MudChip>
                }
            </MudTd>
            <MudTd>
                <MudTooltip Text="Löschen">
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                   Size="Size.Small"
                                   OnClick="@(() => DeleteAsync(context))"
                                   aria-label="@($"{context.Name} löschen")" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">
                Kein Sound passt zur Suche.
            </MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Audio);

    private List<SoundEffectListRow>? _sounds;
    private List<ContentType> _types = [];
    private string? _search;
    private Guid? _typeFilter;

    private string Subtitle => _sounds is null
        ? "Wird geladen …"
        : $"{_sounds.Count} Sound(s)";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var projectId = await Project.GetCurrentIdAsync();
        _types = await ContentTypes.GetTypesAsync(projectId, ModuleKeys.Audio);
        _sounds = await Audio.GetSoundsAsync(projectId);
    }

    private List<SoundEffectListRow> Filtered
    {
        get
        {
            IEnumerable<SoundEffectListRow> rows = _sounds ?? [];

            if (_typeFilter is { } typeId)
            {
                rows = rows.Where(row => row.ContentTypeId == typeId);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                rows = rows.Where(row =>
                    row.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (row.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return [.. rows];
        }
    }

    private void OpenRow(TableRowClickEventArgs<SoundEffectListRow> args)
    {
        if (args.Item is { } row)
        {
            Navigation.NavigateTo($"/modules/audio/{row.Id}");
        }
    }

    private async Task DeleteAsync(SoundEffectListRow row)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Sound löschen",
            $"„{row.Name}“ wird mit Feldwerten und allen Audiodateien gelöscht.",
            yesText: "Löschen",
            cancelText: "Abbrechen");

        if (confirmed != true)
        {
            return;
        }

        await Audio.DeleteSoundAsync(row.Id);
        Snackbar.Add($"„{row.Name}“ wurde gelöscht.", Severity.Success);
        await LoadAsync();
    }

    private static string Shorten(string? text) =>
        string.IsNullOrWhiteSpace(text)
            ? "—"
            : text.Length <= 90 ? text : string.Concat(text.AsSpan(0, 90), "…");
}
