@page "/modules/assets"
@inject AssetService Library
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Assets – GameDevManager</PageTitle>

<ModuleHeader Module="Module" Subtitle="@Subtitle">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Label"
                   OnClick="ManageTagsAsync">
            Stichwörter
        </MudButton>
        <AssetUpload OnUploaded="LoadAsync" Text="Dateien hochladen" />
    </Actions>
</ModuleHeader>

@if (_entries is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_entries.Count == 0)
{
    <div class="gdm-empty">
        <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
        <MudText Typo="Typo.h6">Noch keine Assets</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Sprites lassen sich hier hochladen oder direkt in der Maske einer Entität. Auch
            Dateien, die nur das Tool selbst braucht — etwa Marker für Karten — gehören hierher.
        </MudText>
        <AssetUpload OnUploaded="LoadAsync" Text="Erste Dateien hochladen" />
    </div>
}
else
{
    <MudPaper Elevation="0" Class="gdm-panel pa-4 mb-4">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_search"
                          Placeholder="Nach Dateiname, Entität oder Beschreibung suchen"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="max-width:380px;" />

            <MudSelect T="string"
                       @bind-Value="_moduleFilter"
                       Label="Modul"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="max-width:220px;">
                <MudSelectItem T="string" Value="@ToolGroupKey">Werkzeug-Assets</MudSelectItem>
                @foreach (var moduleKey in UsedModuleKeys)
                {
                    <MudSelectItem T="string" Value="@moduleKey">@ModuleName(moduleKey)</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="Guid"
                       MultiSelection="true"
                       SelectedValues="_tagFilter"
                       SelectedValuesChanged="ids => _tagFilter = [.. ids]"
                       MultiSelectionTextFunc="@(_ => DescribeTagFilter())"
                       Label="Stichwörter"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Disabled="@(_tags.Count == 0)"
                       Style="max-width:240px;">
                @foreach (var tag in _tags)
                {
                    <MudSelectItem T="Guid" Value="@tag.Id">@tag.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSpacer />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Filtered.Count von @_entries.Count</MudText>
        </MudStack>
    </MudPaper>

    @if (Filtered.Count == 0)
    {
        <div class="gdm-empty">
            <MudText Typo="Typo.body2" Color="Color.Secondary">Kein Asset passt zu den Filtern.</MudText>
        </div>
    }
    else
    {
        <MudStack Spacing="4">
            @foreach (var group in Grouped)
            {
                <MudPaper Elevation="0" Class="gdm-panel">
                    <div class="pa-4 gdm-panel-head">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                            <MudIcon Icon="@GroupIcon(group.Key)" Color="Color.Primary" />
                            <MudText Typo="Typo.h6">@GroupName(group.Key)</MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">
                                @group.Count()
                            </MudChip>
                        </MudStack>
                    </div>

                    <div class="pa-4">
                        <div class="gdm-sprite-grid">
                            @foreach (var entry in group)
                            {
                                <div class="gdm-sprite-tile @(entry.Asset.IsPrimary ? "gdm-sprite-primary" : null)">
                                    <AssetThumbnail AssetId="entry.Asset.Id"
                                                    Size="Size.Large"
                                                    Alt="@entry.Asset.FileName"
                                                    Title="@entry.Asset.FileName" />

                                    <div class="gdm-sprite-meta">
                                        <MudText Typo="Typo.caption" Class="gdm-ellipsis" title="@entry.Asset.FileName">
                                            @entry.Asset.FileName
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @AssetFormat.Summary(entry.Asset)
                                        </MudText>
                                        @if (entry.OwnerName is not null)
                                        {
                                            <MudText Typo="Typo.caption" Class="gdm-ellipsis" title="@entry.OwnerName">
                                                @entry.OwnerName
                                            </MudText>
                                        }
                                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-1">
                                            @if (entry.Asset.IsPrimary)
                                            {
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                                    Icon
                                                </MudChip>
                                            }
                                            @foreach (var tagName in TagNames(entry.Asset))
                                            {
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@tagName</MudChip>
                                            }
                                        </MudStack>
                                    </div>

                                    <MudStack Row="true" Spacing="0" Justify="Justify.Center" Class="gdm-sprite-actions">
                                        <MudTooltip Text="In neuem Tab öffnen">
                                            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                                           Size="Size.Small"
                                                           Href="@($"/assets/{entry.Asset.Id}")"
                                                           Target="_blank"
                                                           aria-label="In neuem Tab öffnen" />
                                        </MudTooltip>
                                        <MudTooltip Text="Angaben bearbeiten">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Size="Size.Small"
                                                           OnClick="@(() => EditAsync(entry.Asset))"
                                                           aria-label="Angaben bearbeiten" />
                                        </MudTooltip>
                                        <MudTooltip Text="Löschen">
                                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                           Size="Size.Small"
                                                           OnClick="@(() => DeleteAsync(entry.Asset))"
                                                           aria-label="Asset löschen" />
                                        </MudTooltip>
                                    </MudStack>
                                </div>
                            }
                        </div>
                    </div>
                </MudPaper>
            }
        </MudStack>
    }
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Assets);

    /// <summary>Sammelschlüssel für Assets ohne Entität — sie haben kein eigenes Modul.</summary>
    private const string ToolGroupKey = "__tool";

    private List<AssetLibraryEntry>? _entries;
    private List<AssetTag> _tags = [];
    private string? _search;
    private string? _moduleFilter;
    private HashSet<Guid> _tagFilter = [];

    private string Subtitle => _entries is null
        ? "Wird geladen …"
        : $"{_entries.Count} Datei(en), {AssetFormat.Size(_entries.Sum(entry => entry.Asset.SizeBytes))}";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var projectId = await Project.GetCurrentIdAsync();
        _tags = await Library.GetTagsAsync(projectId);
        _entries = await Library.GetLibraryAsync(projectId);
    }

    private List<string> UsedModuleKeys =>
    [
        .. (_entries ?? [])
            .Select(entry => entry.Asset.OwnerModuleKey)
            .OfType<string>()
            .Distinct()
            .OrderBy(ModuleName)
    ];

    private List<AssetLibraryEntry> Filtered
    {
        get
        {
            IEnumerable<AssetLibraryEntry> entries = _entries ?? [];

            if (_moduleFilter == ToolGroupKey)
            {
                entries = entries.Where(entry => entry.Asset.IsToolAsset);
            }
            else if (_moduleFilter is { } moduleKey)
            {
                entries = entries.Where(entry => entry.Asset.OwnerModuleKey == moduleKey);
            }

            if (_tagFilter.Count > 0)
            {
                // Alle gewählten Stichwörter müssen zutreffen — sonst wäre der Filter nutzlos,
                // sobald man zwei davon anklickt.
                entries = entries.Where(entry =>
                    _tagFilter.All(tagId => entry.Asset.Tags.Any(assignment => assignment.AssetTagId == tagId)));
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                entries = entries.Where(entry =>
                    entry.Asset.FileName.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (entry.OwnerName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (entry.Asset.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return [.. entries];
        }
    }

    private List<IGrouping<string, AssetLibraryEntry>> Grouped =>
    [
        .. Filtered
            .GroupBy(entry => entry.Asset.OwnerModuleKey ?? ToolGroupKey)
            .OrderBy(group => group.Key == ToolGroupKey ? 1 : 0)
            .ThenBy(group => GroupName(group.Key))
    ];

    private static string ModuleName(string moduleKey) =>
        ModuleRegistry.Find(moduleKey)?.Name ?? moduleKey;

    private static string GroupName(string groupKey) =>
        groupKey == ToolGroupKey ? "Werkzeug-Assets (ohne Entität)" : ModuleName(groupKey);

    private static string GroupIcon(string groupKey) =>
        groupKey == ToolGroupKey
            ? Icons.Material.Filled.Build
            : ModuleRegistry.Find(groupKey)?.Icon ?? Icons.Material.Filled.Folder;

    private string DescribeTagFilter()
    {
        var names = _tags.Where(tag => _tagFilter.Contains(tag.Id)).Select(tag => tag.Name).ToList();
        return names.Count == 0 ? string.Empty : string.Join(", ", names);
    }

    private List<string> TagNames(Asset asset) =>
    [
        .. asset.Tags
            .Select(assignment => _tags.FirstOrDefault(tag => tag.Id == assignment.AssetTagId)?.Name)
            .OfType<string>()
            .Order()
    ];

    private async Task EditAsync(Asset asset)
    {
        var parameters = new DialogParameters<AssetDialog> { { dialog => dialog.Asset, asset } };

        var reference = await Dialogs.ShowAsync<AssetDialog>(
            "Asset bearbeiten", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        if (await reference.Result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(Asset asset)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Asset löschen",
            $"„{asset.FileName}“ wird samt Datei gelöscht. Das lässt sich nicht rückgängig machen.",
            yesText: "Löschen",
            cancelText: "Abbrechen");

        if (confirmed != true)
        {
            return;
        }

        await Library.DeleteAsync(asset.Id);
        await LoadAsync();
        Snackbar.Add("Asset gelöscht.", Severity.Success);
    }

    private async Task ManageTagsAsync()
    {
        var reference = await Dialogs.ShowAsync<AssetTagsDialog>(
            "Stichwörter", new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        await reference.Result;
        await LoadAsync();
    }
}
