@page "/modules/dialogs"
@inject DialogueService Dialogues
@inject ContentTypeService ContentTypes
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IStringLocalizer<DialogueList> L

<PageTitle>@L["PageTitle"]</PageTitle>

<ModuleHeader Module="Module" Subtitle="@Subtitle">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Style"
                   Href="/modules/dialogs/arten">
            @L["TypesButton"]
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/modules/dialogs/neu">
            @L["NewDialogue"]
        </MudButton>
    </Actions>
</ModuleHeader>

@if (_dialogues is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_dialogues.Count == 0)
{
    <div class="gdm-empty">
        <MudIcon Icon="@Icons.Material.Filled.Chat" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
        <MudText Typo="Typo.h6">@L["EmptyTitle"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            @L["EmptyHint"]
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/modules/dialogs/neu">
            @L["FirstDialogue"]
        </MudButton>
    </div>
}
else
{
    @if (_problems.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            <MudText Typo="Typo.body2"><b>@L["ProblemsTitle"]</b></MudText>
            <MudText Typo="Typo.body2">
                @L["ProblemsHint"]
            </MudText>
            @foreach (var problem in _problems)
            {
                <MudText Typo="Typo.body2">
                    <MudLink Href="@($"/modules/dialogs/{problem.DialogueId}")">@problem.DialogueName</MudLink>
                    — @problem.Message
                </MudText>
            }
        </MudAlert>
    }

    var filtered = Filtered;

    <MudPaper Elevation="0" Class="gdm-panel pa-4 mb-4">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_search"
                          Placeholder="@L["SearchPlaceholder"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="max-width:340px;" />

            <MudSelect T="DialogueKind?"
                       @bind-Value="_kindFilter"
                       Label="@L["KindFilterLabel"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="max-width:190px;">
                <MudSelectItem T="DialogueKind?" Value="@(DialogueKind.Conversation)">@L["FilterConversations"]</MudSelectItem>
                <MudSelectItem T="DialogueKind?" Value="@(DialogueKind.Bark)">@L["FilterBarks"]</MudSelectItem>
            </MudSelect>

            <MudSelect T="Guid?"
                       @bind-Value="_typeFilter"
                       Label="@L["TypeFilterLabel"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="max-width:200px;">
                @foreach (var type in _types)
                {
                    <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSpacer />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["FilterCount", filtered.Count, _dialogues.Count]</MudText>
        </MudStack>
    </MudPaper>

    @if (filtered.Count == 0)
    {
        <MudPaper Elevation="0" Class="gdm-panel pa-4">
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["NoRecords"]</MudText>
        </MudPaper>
    }
    else
    {
        @* Dialoge tragen keine Sprites — die Kachel zeigt deshalb das Symbol ihrer Form. *@
        <div class="gdm-item-grid">
            @foreach (var dialogue in filtered)
            {
                <EntityContextMenu ModuleKey="@Module.Id"
                                   EntityId="dialogue.Id"
                                   Name="@dialogue.Name"
                                   EditRoute="/modules/dialogs"
                                   OnDelete="@(() => DeleteAsync(dialogue))">
                    <MudPaper Elevation="0" Class="gdm-panel gdm-card-link">
                        <MudLink Href="@($"/modules/dialogs/{dialogue.Id}")" Underline="Underline.None">
                            <AssetThumbnail Class="gdm-item-tile"
                                            Alt="@dialogue.Name"
                                            FallbackIcon="@KindIcon(dialogue.Kind)" />
                        </MudLink>

                        <div class="pa-3">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                                <MudLink Href="@($"/modules/dialogs/{dialogue.Id}")" Typo="Typo.body1" Class="gdm-ellipsis">
                                    <b>@dialogue.Name</b>
                                </MudLink>
                                @* Sprechblasen haben keinen Verlauf — für sie zeigte der Graph
                                   nur unverbundene Knoten. *@
                                @if (dialogue.Kind == DialogueKind.Conversation && dialogue.LineCount > 0)
                                {
                                    <MudTooltip Text="@L["GraphTooltip"]">
                                        <MudIconButton Icon="@Icons.Material.Filled.Hub"
                                                       Size="Size.Small"
                                                       Href="@($"/modules/dialogs/{dialogue.Id}/graph")"
                                                       aria-label="@L["GraphAria", dialogue.Name]" />
                                    </MudTooltip>
                                }
                                <EntityDuplicateButton ModuleKey="@Module.Id"
                                                       EntityId="dialogue.Id"
                                                       Name="@dialogue.Name"
                                                       EditRoute="/modules/dialogs" />
                                <MudTooltip Text="@L["DeleteTooltip"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                   Size="Size.Small"
                                                   OnClick="@(() => DeleteAsync(dialogue))"
                                                   aria-label="@L["DeleteAria", dialogue.Name]" />
                                </MudTooltip>
                            </MudStack>

                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="gdm-ellipsis">
                                @(dialogue.IncludesPlayer
                                    ? L["ParticipantsWithPlayer", dialogue.ParticipantCount]
                                    : L["ParticipantsNpcOnly", dialogue.ParticipantCount])
                            </MudText>

                            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-2">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">
                                    @(dialogue.Kind == DialogueKind.Bark ? L["KindBark"] : L["KindConversation"])
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">
                                    @L["LineCountChip", dialogue.LineCount]
                                </MudChip>
                                @if (dialogue.TypeName is null)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NoType"]</MudText>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@dialogue.TypeName</MudChip>
                                }
                            </MudStack>

                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                @L["UpdatedAt", dialogue.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")]
                            </MudText>
                        </div>
                    </MudPaper>
                </EntityContextMenu>
            }
        </div>
    }
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Dialogs);

    private List<DialogueListRow>? _dialogues;
    private List<DialogueProblem> _problems = [];
    private List<ContentType> _types = [];
    private string? _search;
    private DialogueKind? _kindFilter;
    private Guid? _typeFilter;

    private string Subtitle => _dialogues is null
        ? L["Loading"]
        : L["SubtitleCount",
            _dialogues.Count(d => d.Kind == DialogueKind.Conversation),
            _dialogues.Count(d => d.Kind == DialogueKind.Bark)];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var projectId = await Project.GetCurrentIdAsync();
        _types = await ContentTypes.GetTypesAsync(projectId, ModuleKeys.Dialogs);
        _dialogues = await Dialogues.GetDialoguesAsync(projectId);
        _problems = await Dialogues.FindProblemsAsync(projectId);
    }

    private List<DialogueListRow> Filtered
    {
        get
        {
            IEnumerable<DialogueListRow> rows = _dialogues ?? [];

            if (_kindFilter is { } kind)
            {
                rows = rows.Where(row => row.Kind == kind);
            }

            if (_typeFilter is { } typeId)
            {
                rows = rows.Where(row => row.ContentTypeId == typeId);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                rows = rows.Where(row =>
                    row.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (row.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return [.. rows];
        }
    }

    /// <summary>Sprechblasen und Gespräche sind auf einen Blick auseinanderzuhalten.</summary>
    private static string KindIcon(DialogueKind kind) => kind == DialogueKind.Bark
        ? Icons.Material.Filled.Campaign
        : Icons.Material.Filled.Chat;

    private async Task DeleteAsync(DialogueListRow row)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", row.Name, row.LineCount],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Dialogues.DeleteDialogueAsync(row.Id);
        Snackbar.Add(L["DeletedMessage", row.Name], Severity.Success);
        await LoadAsync();
    }
}
