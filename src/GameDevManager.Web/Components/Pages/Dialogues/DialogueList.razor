@page "/modules/dialogs"
@inject DialogueService Dialogues
@inject ContentTypeService ContentTypes
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<DialogueList> L

<PageTitle>@L["PageTitle"]</PageTitle>

<ModuleHeader Module="Module" Subtitle="@Subtitle">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Style"
                   Href="/modules/dialogs/arten">
            @L["TypesButton"]
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/modules/dialogs/neu">
            @L["NewDialogue"]
        </MudButton>
    </Actions>
</ModuleHeader>

@if (_dialogues is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_dialogues.Count == 0)
{
    <div class="gdm-empty">
        <MudIcon Icon="@Icons.Material.Filled.Chat" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
        <MudText Typo="Typo.h6">@L["EmptyTitle"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            @L["EmptyHint"]
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/modules/dialogs/neu">
            @L["FirstDialogue"]
        </MudButton>
    </div>
}
else
{
    @if (_problems.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            <MudText Typo="Typo.body2"><b>@L["ProblemsTitle"]</b></MudText>
            <MudText Typo="Typo.body2">
                @L["ProblemsHint"]
            </MudText>
            @foreach (var problem in _problems)
            {
                <MudText Typo="Typo.body2">
                    <MudLink Href="@($"/modules/dialogs/{problem.DialogueId}")">@problem.DialogueName</MudLink>
                    — @problem.Message
                </MudText>
            }
        </MudAlert>
    }

    <MudPaper Elevation="0" Class="gdm-panel pa-4 mb-4">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_search"
                          Placeholder="@L["SearchPlaceholder"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="max-width:340px;" />

            <MudSelect T="DialogueKind?"
                       @bind-Value="_kindFilter"
                       Label="@L["KindFilterLabel"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="max-width:190px;">
                <MudSelectItem T="DialogueKind?" Value="@(DialogueKind.Conversation)">@L["FilterConversations"]</MudSelectItem>
                <MudSelectItem T="DialogueKind?" Value="@(DialogueKind.Bark)">@L["FilterBarks"]</MudSelectItem>
            </MudSelect>

            <MudSelect T="Guid?"
                       @bind-Value="_typeFilter"
                       Label="@L["TypeFilterLabel"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="max-width:200px;">
                @foreach (var type in _types)
                {
                    <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSpacer />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["FilterCount", Filtered.Count, _dialogues.Count]</MudText>
        </MudStack>
    </MudPaper>

    <MudTable T="DialogueListRow"
              Items="Filtered"
              Elevation="0"
              Hover="true"
              Dense="true"
              Breakpoint="Breakpoint.Sm"
              OnRowClick="OpenRow"
              RowClass="cursor-pointer">
        <HeaderContent>
            <MudTh>@L["HeaderName"]</MudTh>
            <MudTh>@L["HeaderKind"]</MudTh>
            <MudTh>@L["HeaderParticipants"]</MudTh>
            <MudTh>@L["HeaderLines"]</MudTh>
            <MudTh>@L["HeaderType"]</MudTh>
            <MudTh Style="width:56px;"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@L["HeaderName"]">
                <MudText Typo="Typo.body2"><b>@context.Name</b></MudText>
            </MudTd>
            <MudTd DataLabel="@L["HeaderKind"]">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                    @(context.Kind == DialogueKind.Bark ? L["KindBark"] : L["KindConversation"])
                </MudChip>
            </MudTd>
            <MudTd DataLabel="@L["HeaderParticipants"]">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @(context.IncludesPlayer ? L["ParticipantsWithPlayer", context.ParticipantCount] : L["ParticipantsNpcOnly", context.ParticipantCount])
                </MudText>
            </MudTd>
            <MudTd DataLabel="@L["HeaderLines"]">
                <MudText Typo="Typo.body2" Color="Color.Secondary">@context.LineCount</MudText>
            </MudTd>
            <MudTd DataLabel="@L["HeaderType"]">
                @if (context.TypeName is null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NoType"]</MudText>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.TypeName</MudChip>
                }
            </MudTd>
            <MudTd>
                <MudTooltip Text="@L["DeleteTooltip"]">
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                   Size="Size.Small"
                                   OnClick="@(() => DeleteAsync(context))"
                                   aria-label="@L["DeleteAria", context.Name]" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">
                @L["NoRecords"]
            </MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Dialogs);

    private List<DialogueListRow>? _dialogues;
    private List<DialogueProblem> _problems = [];
    private List<ContentType> _types = [];
    private string? _search;
    private DialogueKind? _kindFilter;
    private Guid? _typeFilter;

    private string Subtitle => _dialogues is null
        ? L["Loading"]
        : L["SubtitleCount",
            _dialogues.Count(d => d.Kind == DialogueKind.Conversation),
            _dialogues.Count(d => d.Kind == DialogueKind.Bark)];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var projectId = await Project.GetCurrentIdAsync();
        _types = await ContentTypes.GetTypesAsync(projectId, ModuleKeys.Dialogs);
        _dialogues = await Dialogues.GetDialoguesAsync(projectId);
        _problems = await Dialogues.FindProblemsAsync(projectId);
    }

    private List<DialogueListRow> Filtered
    {
        get
        {
            IEnumerable<DialogueListRow> rows = _dialogues ?? [];

            if (_kindFilter is { } kind)
            {
                rows = rows.Where(row => row.Kind == kind);
            }

            if (_typeFilter is { } typeId)
            {
                rows = rows.Where(row => row.ContentTypeId == typeId);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                rows = rows.Where(row =>
                    row.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (row.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return [.. rows];
        }
    }

    private void OpenRow(TableRowClickEventArgs<DialogueListRow> args)
    {
        if (args.Item is { } row)
        {
            Navigation.NavigateTo($"/modules/dialogs/{row.Id}");
        }
    }

    private async Task DeleteAsync(DialogueListRow row)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", row.Name, row.LineCount],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Dialogues.DeleteDialogueAsync(row.Id);
        Snackbar.Add(L["DeletedMessage", row.Name], Severity.Success);
        await LoadAsync();
    }
}
