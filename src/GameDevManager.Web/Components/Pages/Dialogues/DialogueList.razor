@page "/modules/dialogs"
@inject DialogueService Dialogues
@inject ContentTypeService ContentTypes
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Dialoge – GameDevManager</PageTitle>

<ModuleHeader Module="Module" Subtitle="@Subtitle">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Style"
                   Href="/modules/dialogs/arten">
            Dialog-Arten
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/modules/dialogs/neu">
            Neuer Dialog
        </MudButton>
    </Actions>
</ModuleHeader>

@if (_dialogues is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_dialogues.Count == 0)
{
    <div class="gdm-empty">
        <MudIcon Icon="@Icons.Material.Filled.Chat" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
        <MudText Typo="Typo.h6">Noch keine Dialoge</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Sprechblasen erscheinen zufällig in der Open World, Gespräche haben einen Verlauf
            mit Antwortmöglichkeiten. Beteiligt sein können NPCs untereinander, mit dem Spieler
            oder beides.
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/modules/dialogs/neu">
            Ersten Dialog anlegen
        </MudButton>
    </div>
}
else
{
    @if (_problems.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            <MudText Typo="Typo.body2"><b>Dialog-Sackgassen</b></MudText>
            <MudText Typo="Typo.body2">
                Diese Zeilen sind von keiner Antwort aus erreichbar — der Spieler bekommt sie nie zu sehen:
            </MudText>
            @foreach (var problem in _problems)
            {
                <MudText Typo="Typo.body2">
                    <MudLink Href="@($"/modules/dialogs/{problem.DialogueId}")">@problem.DialogueName</MudLink>
                    — @problem.Message
                </MudText>
            }
        </MudAlert>
    }

    <MudPaper Elevation="0" Class="gdm-panel pa-4 mb-4">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_search"
                          Placeholder="Nach Name oder Beschreibung suchen"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="max-width:340px;" />

            <MudSelect T="DialogueKind?"
                       @bind-Value="_kindFilter"
                       Label="Form"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="max-width:190px;">
                <MudSelectItem T="DialogueKind?" Value="@(DialogueKind.Conversation)">Gespräche</MudSelectItem>
                <MudSelectItem T="DialogueKind?" Value="@(DialogueKind.Bark)">Sprechblasen</MudSelectItem>
            </MudSelect>

            <MudSelect T="Guid?"
                       @bind-Value="_typeFilter"
                       Label="Art"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="max-width:200px;">
                @foreach (var type in _types)
                {
                    <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSpacer />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Filtered.Count von @_dialogues.Count</MudText>
        </MudStack>
    </MudPaper>

    <MudTable T="DialogueListRow"
              Items="Filtered"
              Elevation="0"
              Hover="true"
              Dense="true"
              Breakpoint="Breakpoint.Sm"
              OnRowClick="OpenRow"
              RowClass="cursor-pointer">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Form</MudTh>
            <MudTh>Beteiligte</MudTh>
            <MudTh>Zeilen</MudTh>
            <MudTh>Art</MudTh>
            <MudTh Style="width:56px;"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">
                <MudText Typo="Typo.body2"><b>@context.Name</b></MudText>
            </MudTd>
            <MudTd DataLabel="Form">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                    @(context.Kind == DialogueKind.Bark ? "Sprechblasen" : "Gespräch")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Beteiligte">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @context.ParticipantCount NPC(s)@(context.IncludesPlayer ? " + Spieler" : "")
                </MudText>
            </MudTd>
            <MudTd DataLabel="Zeilen">
                <MudText Typo="Typo.body2" Color="Color.Secondary">@context.LineCount</MudText>
            </MudTd>
            <MudTd DataLabel="Art">
                @if (context.TypeName is null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">ohne Art</MudText>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.TypeName</MudChip>
                }
            </MudTd>
            <MudTd>
                <MudTooltip Text="Löschen">
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                   Size="Size.Small"
                                   OnClick="@(() => DeleteAsync(context))"
                                   aria-label="@($"{context.Name} löschen")" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">
                Kein Dialog passt zu den Filtern.
            </MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Dialogs);

    private List<DialogueListRow>? _dialogues;
    private List<DialogueProblem> _problems = [];
    private List<ContentType> _types = [];
    private string? _search;
    private DialogueKind? _kindFilter;
    private Guid? _typeFilter;

    private string Subtitle => _dialogues is null
        ? "Wird geladen …"
        : $"{_dialogues.Count(d => d.Kind == DialogueKind.Conversation)} Gespräch(e), "
          + $"{_dialogues.Count(d => d.Kind == DialogueKind.Bark)} Sprechblasen-Satz/-Sätze";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var projectId = await Project.GetCurrentIdAsync();
        _types = await ContentTypes.GetTypesAsync(projectId, ModuleKeys.Dialogs);
        _dialogues = await Dialogues.GetDialoguesAsync(projectId);
        _problems = await Dialogues.FindProblemsAsync(projectId);
    }

    private List<DialogueListRow> Filtered
    {
        get
        {
            IEnumerable<DialogueListRow> rows = _dialogues ?? [];

            if (_kindFilter is { } kind)
            {
                rows = rows.Where(row => row.Kind == kind);
            }

            if (_typeFilter is { } typeId)
            {
                rows = rows.Where(row => row.ContentTypeId == typeId);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                rows = rows.Where(row =>
                    row.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (row.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return [.. rows];
        }
    }

    private void OpenRow(TableRowClickEventArgs<DialogueListRow> args)
    {
        if (args.Item is { } row)
        {
            Navigation.NavigateTo($"/modules/dialogs/{row.Id}");
        }
    }

    private async Task DeleteAsync(DialogueListRow row)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Dialog löschen",
            $"„{row.Name}“ wird mit seinen {row.LineCount} Zeile(n) und allen Antwortmöglichkeiten gelöscht.",
            yesText: "Löschen",
            cancelText: "Abbrechen");

        if (confirmed != true)
        {
            return;
        }

        await Dialogues.DeleteDialogueAsync(row.Id);
        Snackbar.Add($"„{row.Name}“ wurde gelöscht.", Severity.Success);
        await LoadAsync();
    }
}
