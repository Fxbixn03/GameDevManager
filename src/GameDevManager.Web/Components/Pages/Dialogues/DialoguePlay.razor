@page "/modules/dialogs/{Id:guid}/play"
@inject DialogueService Dialogues
@inject ProjectContext Project
@inject IStringLocalizer<DialoguePlay> L

@*
    Ein Gespräch im Browser durchklicken, mit angenommenem Spielzustand (F11). Der Graph zeigt
    die Struktur — hier steht das Erlebnis: Wo eine Bedingung den Dialog stumm abbricht, sieht
    man es, bevor es die Engine tut.

    Die Zustandsleiste ist das GameStateAssumptionPanel — dieselbe Komponente wie in der
    Zustands-Sicht (F19); gerechnet wird im ConditionEvaluator der Datenschicht.
*@

<PageTitle>@L["PageTitle", _data?.Dialogue.Name ?? string.Empty]</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@L["NotFound"]</MudAlert>
    <MudButton Variant="Variant.Outlined" Href="/modules/dialogs">@L["BackToList"]</MudButton>
}
else if (_data is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <ModuleHeader Module="Module"
                  Title="@L["Heading", _data.Dialogue.Name]"
                  Breadcrumbs="Breadcrumbs">
        <Actions>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Edit"
                       Href="@($"/modules/dialogs/{Id}")">
                @L["ToEditor"]
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Replay"
                       OnClick="Restart">
                @L["Restart"]
            </MudButton>
        </Actions>
    </ModuleHeader>

    <MudGrid Spacing="4">

        @* ------------------------------------------------------------ Spielzustand *@
        <MudItem xs="12" md="4">
            <GameStateAssumptionPanel @ref="_statePanel"
                                      Conditions="_allConditions"
                                      OnChanged="@(() => InvokeAsync(StateHasChanged))" />
        </MudItem>

        @* --------------------------------------------------------------- Gespräch *@
        <MudItem xs="12" md="8">
            <MudStack Spacing="4">

                @if (DialogueResult is { Satisfied: false } blockedDialogue)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        @L["DialogueBlocked"]
                        <ul class="my-1 ml-4">
                            @foreach (var failed in blockedDialogue.Failed)
                            {
                                <li><MudText Typo="Typo.caption">@Describe(failed)</MudText></li>
                            }
                        </ul>
                    </MudAlert>
                }

                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["ConversationHeading"]</MudText>

                    @if (_transcript.Count == 0 && _silentLine is null)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["NoLines"]</MudText>
                    }

                    <MudStack Spacing="2">
                        @foreach (var entry in _transcript)
                        {
                            <div class="@(entry.IsChoice ? "ml-8" : null)">
                                <MudText Typo="Typo.caption"
                                         Color="@(entry.IsChoice ? Color.Primary : Color.Secondary)">
                                    @entry.Speaker
                                </MudText>
                                <MudText Typo="Typo.body2"
                                         Style="@(entry.IsChoice ? "font-style:italic;" : null)">
                                    @entry.Text
                                </MudText>
                            </div>
                        }
                    </MudStack>

                    @if (_silentLine is { } silent)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">
                            @L["SilentAbort", Shorten(silent.Text)]
                            <ul class="my-1 ml-4">
                                @foreach (var failed in ResultFor(silent.Id).Failed)
                                {
                                    <li><MudText Typo="Typo.caption">@Describe(failed)</MudText></li>
                                }
                            </ul>
                        </MudAlert>
                    }
                    else if (_ended)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">@L["ConversationEnded"]</MudAlert>
                    }
                    else if (CurrentLine is { } current)
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.overline" Color="Color.Secondary">@L["ChoicesHeading"]</MudText>

                        <MudStack Spacing="2" Class="mt-2">
                            @foreach (var choice in current.Choices)
                            {
                                var result = ResultFor(choice.Id);
                                <div>
                                    <MudButton Variant="@(result.Satisfied ? Variant.Filled : Variant.Outlined)"
                                               Color="@(result.Satisfied ? Color.Primary : Color.Default)"
                                               Size="Size.Small"
                                               Disabled="@(!result.Satisfied)"
                                               OnClick="@(() => Choose(choice))">
                                        @choice.Text
                                    </MudButton>
                                    @if (!result.Satisfied)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block">
                                            @L["ChoiceBlocked"] @string.Join(" · ", result.Failed.Select(Describe))
                                        </MudText>
                                    }
                                </div>
                            }
                        </MudStack>
                    }
                </MudPaper>
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Dialogs);

    [Parameter]
    public Guid Id { get; set; }

    private DialoguePlayData? _data;
    private List<Condition> _allConditions = [];
    private GameStateAssumptionPanel? _statePanel;
    private bool _notFound;

    private readonly List<TranscriptEntry> _transcript = [];
    private Guid? _currentLineId;
    private DialogueLine? _silentLine;
    private bool _ended;

    private List<BreadcrumbItem> Breadcrumbs =>
        [new(_data?.Dialogue.Name ?? string.Empty, $"/modules/dialogs/{Id}"), new(L["BreadcrumbPlay"], null, disabled: true)];

    private DialogueLine? CurrentLine =>
        _data?.Dialogue.Lines.FirstOrDefault(line => line.Id == _currentLineId);

    private ConditionSetResult? DialogueResult =>
        _data is null ? null : ResultFor(_data.Dialogue.Id);

    private GameStateAssumption State => _statePanel?.State ?? new GameStateAssumption();

    protected override async Task OnParametersSetAsync()
    {
        var projectId = await Project.GetCurrentIdAsync();
        _data = await Dialogues.GetPlayDataAsync(projectId, Id);

        if (_data is null)
        {
            _notFound = true;
            return;
        }

        _allConditions = [.. _data.AvailabilityByOwner.Values.SelectMany(set => set.Conditions)];
        Restart();
    }

    private ConditionSetResult ResultFor(Guid ownerId) =>
        ConditionEvaluator.Evaluate(_data!.AvailabilityByOwner.GetValueOrDefault(ownerId), State);

    private string Describe(ConditionResult result) => _statePanel?.Describe(result) ?? string.Empty;

    // ------------------------------------------------------------------ Durchlauf

    private void Restart()
    {
        _transcript.Clear();
        _silentLine = null;
        _ended = false;
        _currentLineId = null;

        var first = _data!.Dialogue.Lines.FirstOrDefault();
        if (first is null)
        {
            _ended = true;
            return;
        }

        EnterLine(first);
    }

    private void EnterLine(DialogueLine line)
    {
        // Genau der Fall, für den es diese Seite gibt: Die Zeile wäre im Spiel nicht
        // verfügbar, und das Gespräch bräche stumm ab.
        if (!ResultFor(line.Id).Satisfied)
        {
            _silentLine = line;
            _ended = true;
            return;
        }

        _transcript.Add(new TranscriptEntry(SpeakerName(line), line.Text, IsChoice: false));
        _currentLineId = line.Id;

        if (line.Choices.Count == 0)
        {
            _ended = true;
        }
    }

    private void Choose(DialogueChoice choice)
    {
        _transcript.Add(new TranscriptEntry(L["SpeakerPlayer"], choice.Text, IsChoice: true));

        if (choice.NextLineId is not { } nextId)
        {
            _ended = true;
            _currentLineId = null;
            return;
        }

        var next = _data!.Dialogue.Lines.FirstOrDefault(line => line.Id == nextId);
        if (next is null)
        {
            _ended = true;
            return;
        }

        EnterLine(next);
    }

    private string SpeakerName(DialogueLine line) =>
        line.SpeakerNpcId is { } id
            ? _data!.NpcNames.GetValueOrDefault(id, L["UnknownTarget"].Value)
            : L["SpeakerPlayer"];

    private static string Shorten(string text) =>
        text.Length <= 60 ? text : string.Concat(text.AsSpan(0, 60), "…");

    private sealed record TranscriptEntry(string Speaker, string Text, bool IsChoice);
}
