@page "/modules/dialogs/arten"

<PageTitle>Dialog-Arten – GameDevManager</PageTitle>

<ModuleHeader Module="Module"
              Title="Dialog-Arten"
              Subtitle="Form, Beteiligte und Verlauf stehen fest am Dialog — alles Weitere definieren die Felder der Art."
              Breadcrumbs="Breadcrumbs">
    <Actions>
        <MudButton Variant="Variant.Outlined" Href="/modules/dialogs">Zu den Dialogen</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddAsync">
            Neue Art
        </MudButton>
    </Actions>
</ModuleHeader>

<ContentTypeManager @ref="_manager"
                    ModuleKey="@ModuleKeys.Dialogs"
                    EntityNoun="Dialog"
                    EmptyTitle="Noch keine Dialog-Arten"
                    EmptyHint="Über Arten lassen sich Angaben ergänzen, die der Dialog selbst nicht kennt — etwa Stimmung, Sprachausgabe-Kennung oder Wiederholbarkeit." />

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Dialogs);

    private static readonly List<BreadcrumbItem> Breadcrumbs = [new("Arten", null, disabled: true)];

    private ContentTypeManager? _manager;

    private Task AddAsync() => _manager?.AddTypeAsync() ?? Task.CompletedTask;
}
