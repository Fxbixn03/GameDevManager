@page "/modules/dialogs/neu"
@page "/modules/dialogs/{Id:guid}"
@inject DialogueService Dialogues
@inject ReferenceService References
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<DialogueEditor> L

<PageTitle>@L["PageTitle", PageHeading]</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @L["NotFound"]
    </MudAlert>
    <MudButton Variant="Variant.Outlined" Href="/modules/dialogs">@L["BackToList"]</MudButton>
}
else if (_context is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <ModuleHeader Module="Module"
                  Title="@PageHeading"
                  Subtitle="@(_context.IsNew ? (string?)L["SubtitleNew"] : null)"
                  Breadcrumbs="Breadcrumbs">
        <Actions>
            @if (_dirty)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                    @L["UnsavedChanges"]
                </MudChip>
            }
            @if (!_context.IsNew)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteOutline"
                           OnClick="DeleteAsync">
                    @L["Delete"]
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Href="/modules/dialogs">@L["Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       Disabled="_saving"
                       OnClick="SaveAsync">
                @L["Save"]
            </MudButton>
        </Actions>
    </ModuleHeader>

    <MudGrid Spacing="4">
        <MudItem xs="12" md="8">
            <MudStack Spacing="4">

                @* ------------------------------------------------------------- Stammdaten *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionMasterData"]</MudText>

                    <MudStack Spacing="4">
                        <MudTextField Value="_context.Entity.Name"
                                      ValueChanged="@((string name) => Touch(() => _context.Entity.Name = name))"
                                      T="string"
                                      Label="@L["NameLabel"]"
                                      Variant="Variant.Outlined"
                                      Immediate="true" />

                        <MudTextField Value="_context.Entity.Description"
                                      ValueChanged="@((string text) => Touch(() => _context.Entity.Description = text))"
                                      T="string"
                                      Label="@L["DescriptionLabel"]"
                                      Variant="Variant.Outlined"
                                      Lines="2" />

                        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudSelect T="DialogueKind"
                                       Value="_context.Entity.Kind"
                                       ValueChanged="ChangeKind"
                                       Label="@L["KindLabel"]"
                                       Variant="Variant.Outlined"
                                       HelperText="@KindHint"
                                       Style="max-width:260px;">
                                <MudSelectItem T="DialogueKind" Value="@(DialogueKind.Conversation)">@L["KindConversation"]</MudSelectItem>
                                <MudSelectItem T="DialogueKind" Value="@(DialogueKind.Bark)">@L["KindBark"]</MudSelectItem>
                            </MudSelect>

                            <MudSelect T="Guid?"
                                       Value="_context.Entity.ContentTypeId"
                                       ValueChanged="@((Guid? id) => Touch(() => _context.Entity.ContentTypeId = id))"
                                       Label="@L["TypeLabel"]"
                                       Variant="Variant.Outlined"
                                       Clearable="true"
                                       Style="max-width:240px;">
                                @foreach (var type in _context.AvailableTypes)
                                {
                                    <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                                }
                            </MudSelect>

                            <MudSwitch T="bool"
                                       Value="_context.Entity.IncludesPlayer"
                                       ValueChanged="TogglePlayer"
                                       Color="Color.Primary"
                                       Label="@L["IncludesPlayerLabel"]" />
                        </MudStack>
                    </MudStack>
                </MudPaper>

                @* ----------------------------------------------------------- Beteiligte *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">@L["SectionParticipants"]</MudText>
                        <MudButton StartIcon="@Icons.Material.Filled.Add"
                                   Size="Size.Small"
                                   Disabled="@(_npcs.Count == 0)"
                                   OnClick="AddParticipant">
                            @L["AddNpc"]
                        </MudButton>
                    </MudStack>

                    @if (_npcs.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">
                            @L["NoNpcsPrefix"]
                            <MudLink Href="/modules/npcs" Color="Color.Primary">@L["NoNpcsLink"]</MudLink>.
                        </MudAlert>
                    }
                    else if (_context.Entity.Participants.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @L["NoParticipants"]
                        </MudText>
                    }
                    else
                    {
                        <MudStack Spacing="2">
                            @foreach (var participant in _context.Entity.Participants)
                            {
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                    <div style="flex:1 1 auto; min-width:0;">
                                        <MudAutocomplete T="EntitySummary"
                                                         Value="@NpcFor(participant.NpcId)"
                                                         ValueChanged="@((EntitySummary? e) => SetParticipant(participant, e))"
                                                         SearchFunc="SearchNpcsAsync"
                                                         ToStringFunc="@(e => e?.Name ?? string.Empty)"
                                                         Label="@L["NpcLabel"]"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         Clearable="true"
                                                         ResetValueOnEmptyText="true"
                                                         CoerceValue="false"
                                                         MaxItems="50" />
                                    </div>
                                    <MudTooltip Text="@L["RemoveTooltip"]">
                                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                       Size="Size.Small"
                                                       OnClick="@(() => RemoveParticipant(participant))"
                                                       aria-label="@L["RemoveParticipantAria"]" />
                                    </MudTooltip>
                                </MudStack>
                            }
                        </MudStack>
                    }
                </MudPaper>

                @* --------------------------------------------------------------- Verlauf *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">
                            @(IsBark ? L["SectionBarks"] : L["SectionFlow"])
                        </MudText>
                        <MudButton StartIcon="@Icons.Material.Filled.Add"
                                   Size="Size.Small"
                                   Disabled="@(!CanSpeak)"
                                   OnClick="AddLine">
                            @L["AddLine"]
                        </MudButton>
                    </MudStack>

                    @if (!CanSpeak)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">
                            @L["NeedSpeaker"]
                        </MudAlert>
                    }
                    else if (_context.Entity.Lines.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @(IsBark
                                ? L["NoLinesBark"]
                                : L["NoLinesConversation"])
                        </MudText>
                    }
                    else
                    {
                        <MudStack Spacing="0">
                            @foreach (var line in _context.Entity.Lines)
                            {
                                <div class="pa-2 gdm-field-row">
                                    <MudStack Spacing="2">
                                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                            @if (!IsBark && _context.Entity.Lines.IndexOf(line) == 0)
                                            {
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                                    @L["EntryChip"]
                                                </MudChip>
                                            }

                                            <MudSelect T="Guid?"
                                                       Value="line.SpeakerNpcId"
                                                       ValueChanged="@((Guid? id) => Touch(() => line.SpeakerNpcId = id))"
                                                       Label="@L["SpeakerLabel"]"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       Style="max-width:220px;">
                                                @if (_context.Entity.IncludesPlayer)
                                                {
                                                    <MudSelectItem T="Guid?" Value="@(null as Guid?)">@L["SpeakerPlayer"]</MudSelectItem>
                                                }
                                                @foreach (var participant in _context.Entity.Participants)
                                                {
                                                    <MudSelectItem T="Guid?" Value="@participant.NpcId">
                                                        @(NpcFor(participant.NpcId)?.Name ?? L["UnknownNpc"])
                                                    </MudSelectItem>
                                                }
                                            </MudSelect>

                                            <MudSpacer />

                                            <MudTooltip Text="@L["MoveUpTooltip"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                                                               Size="Size.Small"
                                                               Disabled="@(_context.Entity.Lines.IndexOf(line) == 0)"
                                                               OnClick="@(() => MoveLine(line, -1))"
                                                               aria-label="@L["MoveUpAria"]" />
                                            </MudTooltip>
                                            <MudTooltip Text="@L["MoveDownTooltip"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                                               Size="Size.Small"
                                                               Disabled="@(_context.Entity.Lines.IndexOf(line) == _context.Entity.Lines.Count - 1)"
                                                               OnClick="@(() => MoveLine(line, 1))"
                                                               aria-label="@L["MoveDownAria"]" />
                                            </MudTooltip>
                                            <MudTooltip Text="@L["RemoveLine"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                               Size="Size.Small"
                                                               OnClick="@(() => RemoveLine(line))"
                                                               aria-label="@L["RemoveLine"]" />
                                            </MudTooltip>
                                        </MudStack>

                                        <MudTextField T="string"
                                                      Value="line.Text"
                                                      ValueChanged="@((string v) => Touch(() => line.Text = v))"
                                                      Label="@L["TextLabel"]"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Lines="2" />

                                        @if (!IsBark)
                                        {
                                            @foreach (var choice in line.Choices)
                                            {
                                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="ml-6">
                                                    <MudIcon Icon="@Icons.Material.Filled.SubdirectoryArrowRight"
                                                             Size="Size.Small"
                                                             Color="Color.Secondary" />

                                                    <div style="flex:1 1 auto; min-width:0;">
                                                        <MudTextField T="string"
                                                                      Value="choice.Text"
                                                                      ValueChanged="@((string v) => Touch(() => choice.Text = v))"
                                                                      Label="@L["ChoiceLabel"]"
                                                                      Variant="Variant.Outlined"
                                                                      Margin="Margin.Dense" />
                                                    </div>

                                                    <MudSelect T="Guid?"
                                                               Value="choice.NextLineId"
                                                               ValueChanged="@((Guid? id) => Touch(() => choice.NextLineId = id))"
                                                               Label="@L["NextLineLabel"]"
                                                               Variant="Variant.Outlined"
                                                               Margin="Margin.Dense"
                                                               Style="max-width:260px;">
                                                        <MudSelectItem T="Guid?" Value="@(null as Guid?)">@L["ConversationEnds"]</MudSelectItem>
                                                        @foreach (var target in _context.Entity.Lines.Where(l => l.Id != line.Id))
                                                        {
                                                            <MudSelectItem T="Guid?" Value="@target.Id">
                                                                @LineLabel(target)
                                                            </MudSelectItem>
                                                        }
                                                    </MudSelect>

                                                    <MudTooltip Text="@L["RemoveChoice"]">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                                       Size="Size.Small"
                                                                       OnClick="@(() => RemoveChoice(line, choice))"
                                                                       aria-label="@L["RemoveChoice"]" />
                                                    </MudTooltip>
                                                </MudStack>
                                            }

                                            <MudButton StartIcon="@Icons.Material.Filled.Add"
                                                       Size="Size.Small"
                                                       Class="ml-6"
                                                       OnClick="@(() => AddChoice(line))">
                                                @L["AddChoice"]
                                            </MudButton>
                                        }
                                    </MudStack>
                                </div>
                            }
                        </MudStack>
                    }
                </MudPaper>

                @* -------------------------------------------------------------- Felder *@
                <div>
                    <ContentFieldsPanel TEntity="Dialogue"
                                        Context="_context"
                                        ModuleKey="@ModuleKeys.Dialogs"
                                        TypesRoute="/modules/dialogs/arten"
                                        IndividualHint="@L["IndividualHint"]"
                                        OnValueChanged="MarkDirty"
                                        OnFieldDefinitionChanged="ReloadKeepingChangesAsync" />
                </div>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudStack Spacing="4">

                @* --------------------------------------------------------- Bedingungen *@
                @if (!_context.IsNew)
                {
                    <MudPaper Elevation="0" Class="gdm-panel pa-4">
                        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">
                            @L["SectionAvailability"]
                        </MudText>
                        <ConditionEditor OwnerId="_context.Entity.Id"
                                         OwnerModuleKey="@ModuleKeys.Dialogs"
                                         Slot="@ConditionSlots.Availability"
                                         EmptyHint="@L["AvailabilityEmptyHint"]" />
                    </MudPaper>
                }

                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionReference"]</MudText>

                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["GuidLabel"]</MudText>
                    <EntityIdChip Id="_context.Entity.Id" />

                    @if (!_context.IsNew)
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["LastModified"]</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                    }
                </MudPaper>

                @if (!_context.IsNew)
                {
                    <EntityTagsPanel ModuleKey="@ModuleKeys.Dialogs" EntityId="_context.Entity.Id" />
                    <ReferencesPanel @ref="_referencesPanel" EntityId="_context.Entity.Id" />
                    <EntityHistoryPanel @ref="_historyPanel" EntityId="_context.Entity.Id" />
                }
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Dialogs);

    [Parameter]
    public Guid? Id { get; set; }

    private ContentEditContext<Dialogue>? _context;
    private ReferencesPanel? _referencesPanel;
    private EntityHistoryPanel? _historyPanel;
    private List<EntitySummary> _npcs = [];
    private Guid? _loadedId;
    private bool _notFound;
    private bool _saving;
    private bool _dirty;

    private bool IsBark => _context?.Entity.Kind == DialogueKind.Bark;

    /// <summary>Ohne Beteiligten und ohne Spieler kann niemand sprechen.</summary>
    private bool CanSpeak =>
        _context is not null
        && (_context.Entity.IncludesPlayer || _context.Entity.Participants.Count > 0);

    private string KindHint => IsBark
        ? L["KindHintBark"]
        : L["KindHintConversation"];

    private string PageHeading => _context switch
    {
        null => L["HeadingDefault"],
        { IsNew: true } => L["HeadingNew"],
        { Entity.Name: var name } when !string.IsNullOrWhiteSpace(name) => name,
        _ => L["HeadingUnnamed"]
    };

    private List<BreadcrumbItem> Breadcrumbs => [new(PageHeading, null, disabled: true)];

    protected override async Task OnParametersSetAsync()
    {
        if (_context is not null && _loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _notFound = false;
        _dirty = false;
        _context = null;

        var projectId = await Project.GetCurrentIdAsync();
        _npcs = await References.GetEntitiesAsync(projectId, ModuleKeys.Npcs);
        _context = await Dialogues.LoadForEditAsync(projectId, Id);

        if (_context is null)
        {
            _notFound = true;
        }
    }

    private EntitySummary? NpcFor(Guid npcId) => _npcs.FirstOrDefault(entity => entity.Id == npcId);

    private Task<IEnumerable<EntitySummary>> SearchNpcsAsync(string? search, CancellationToken ct)
    {
        IEnumerable<EntitySummary> matches = string.IsNullOrWhiteSpace(search)
            ? _npcs
            : _npcs.Where(entity => entity.Name.Contains(search, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(matches);
    }

    private string LineLabel(DialogueLine line)
    {
        var speaker = line.SpeakerNpcId is { } id ? NpcFor(id)?.Name ?? "?" : "Spieler";
        var text = string.IsNullOrWhiteSpace(line.Text) ? L["NoText"].Value : line.Text;

        return L["LineLabelFormat", speaker, text.Length <= 32 ? text : string.Concat(text.AsSpan(0, 32), "…")];
    }

    // ------------------------------------------------------------------------- Bearbeiten

    private void ChangeKind(DialogueKind kind) =>
        Touch(() =>
        {
            _context!.Entity.Kind = kind;

            // Sprechblasen haben keine Antworten — sie stehen unabhängig nebeneinander.
            if (kind == DialogueKind.Bark)
            {
                foreach (var line in _context.Entity.Lines)
                {
                    line.Choices.Clear();
                }
            }
        });

    private void TogglePlayer(bool includesPlayer) =>
        Touch(() =>
        {
            _context!.Entity.IncludesPlayer = includesPlayer;

            // Zeilen ohne Sprecher gehören dem Spieler — ohne ihn brauchen sie einen neuen.
            if (!includesPlayer)
            {
                var fallback = _context.Entity.Participants.FirstOrDefault()?.NpcId;

                foreach (var line in _context.Entity.Lines.Where(l => l.SpeakerNpcId is null))
                {
                    line.SpeakerNpcId = fallback;
                }
            }
        });

    private void AddParticipant() =>
        Touch(() => _context!.Entity.Participants.Add(new DialogueParticipant
        {
            DialogueId = _context.Entity.Id,
            SortOrder = _context.Entity.Participants.Count
        }));

    private void SetParticipant(DialogueParticipant participant, EntitySummary? entity) =>
        Touch(() => participant.NpcId = entity?.Id ?? Guid.Empty);

    private void RemoveParticipant(DialogueParticipant participant) =>
        Touch(() =>
        {
            _context!.Entity.Participants.Remove(participant);

            // Zeilen dieses Sprechers fallen sonst beim Speichern durch die Prüfung.
            foreach (var line in _context.Entity.Lines.Where(l => l.SpeakerNpcId == participant.NpcId))
            {
                line.SpeakerNpcId = _context.Entity.IncludesPlayer
                    ? null
                    : _context.Entity.Participants.FirstOrDefault()?.NpcId;
            }
        });

    private void AddLine() =>
        Touch(() => _context!.Entity.Lines.Add(new DialogueLine
        {
            DialogueId = _context.Entity.Id,
            SpeakerNpcId = _context.Entity.IncludesPlayer
                ? null
                : _context.Entity.Participants.FirstOrDefault()?.NpcId,
            Text = string.Empty,
            SortOrder = _context.Entity.Lines.Count
        }));

    private void RemoveLine(DialogueLine line) =>
        Touch(() =>
        {
            _context!.Entity.Lines.Remove(line);

            // Antworten, die hierher führten, liefen sonst ins Leere.
            foreach (var choice in _context.Entity.Lines.SelectMany(l => l.Choices)
                .Where(choice => choice.NextLineId == line.Id))
            {
                choice.NextLineId = null;
            }
        });

    private void MoveLine(DialogueLine line, int offset) =>
        Touch(() =>
        {
            var lines = _context!.Entity.Lines;
            var index = lines.IndexOf(line);
            var targetIndex = index + offset;

            if (index < 0 || targetIndex < 0 || targetIndex >= lines.Count)
            {
                return;
            }

            lines.RemoveAt(index);
            lines.Insert(targetIndex, line);
        });

    private void AddChoice(DialogueLine line) =>
        Touch(() => line.Choices.Add(new DialogueChoice
        {
            DialogueLineId = line.Id,
            Text = string.Empty,
            SortOrder = line.Choices.Count
        }));

    private void RemoveChoice(DialogueLine line, DialogueChoice choice) =>
        Touch(() => line.Choices.Remove(choice));

    private void Touch(Action change)
    {
        change();
        MarkDirty();
    }

    private void MarkDirty() => _dirty = true;

    // -------------------------------------------------------------------------- Speichern

    private async Task SaveAsync()
    {
        if (_context is null)
        {
            return;
        }

        // Leere Eingabezeilen sind ein Bedienschritt, kein Inhalt.
        _context.Entity.Participants.RemoveAll(p => p.NpcId == Guid.Empty);
        _context.Entity.Lines.RemoveAll(line => string.IsNullOrWhiteSpace(line.Text));

        foreach (var line in _context.Entity.Lines)
        {
            line.Choices.RemoveAll(choice => string.IsNullOrWhiteSpace(choice.Text));
        }

        _saving = true;

        try
        {
            var wasNew = _context.IsNew;
            await Dialogues.SaveDialogueAsync(_context);
            _dirty = false;

            Snackbar.Add(L["SavedMessage", _context.Entity.Name], Severity.Success);

            if (wasNew)
            {
                Navigation.NavigateTo($"/modules/dialogs/{_context.Entity.Id}");
                return;
            }

            if (_referencesPanel is not null)
            {
                await _referencesPanel.RefreshAsync();
            }

            if (_historyPanel is not null)
            {
                await _historyPanel.RefreshAsync();
            }
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_context is null)
        {
            return;
        }

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", _context.Entity.Name],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Dialogues.DeleteDialogueAsync(_context.Entity.Id);
        Snackbar.Add(L["DeletedMessage"], Severity.Success);
        Navigation.NavigateTo("/modules/dialogs");
    }

    /// <summary>
    /// Lädt nach einer Änderung an den Felddefinitionen neu und behält dabei, was in der Maske
    /// noch nicht gespeichert ist.
    /// </summary>
    private async Task ReloadKeepingChangesAsync()
    {
        if (_context is null)
        {
            return;
        }

        var entity = _context.Entity;
        var wasDirty = _dirty;

        var projectId = await Project.GetCurrentIdAsync();
        var reloaded = await Dialogues.LoadForEditAsync(projectId, entity.Id);

        if (reloaded is null)
        {
            _notFound = true;
            _context = null;
            return;
        }

        reloaded.Entity.Name = entity.Name;
        reloaded.Entity.Description = entity.Description;
        reloaded.Entity.ContentTypeId = entity.ContentTypeId;
        reloaded.Entity.Kind = entity.Kind;
        reloaded.Entity.IncludesPlayer = entity.IncludesPlayer;
        reloaded.Entity.Participants = entity.Participants;
        reloaded.Entity.Lines = entity.Lines;

        _context = reloaded;
        _dirty = wasDirty;
    }
}
