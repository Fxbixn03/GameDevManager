@page "/"
@inject IDbContextFactory<GameDevManager.Data.GameDevManagerDbContext> DbFactory
@inject GameDevManager.Data.DatabaseOptions DbOptions
@inject IStringLocalizer<Home> L
@inject ModuleLabels Modules
@using Microsoft.EntityFrameworkCore

<PageTitle>@L["PageTitle"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@L["Heading"]</MudText>

<MudGrid Spacing="3">

    @* Fixe Card: Import/Export ist immer sichtbar *@
    <MudItem xs="12" sm="6" md="4" lg="3">
        <MudCard Elevation="0" Class="gdm-accent-top" Style="height:100%;">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudIcon Icon="@Icons.Material.Filled.ImportExport" Color="Color.Primary" />
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">@L["ImportExportTitle"]</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2">
                    @L["ImportExportDescription"]
                </MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Disabled="true" StartIcon="@Icons.Material.Filled.FileDownload">@L["InDevelopment"]</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    @* Status-Card: zeigt, dass die Datenbankverbindung steht *@
    <MudItem xs="12" sm="6" md="4" lg="3">
        <MudCard Elevation="0" Style="height:100%;">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudIcon Icon="@Icons.Material.Filled.Storage" Color="@(_dbError is null ? Color.Success : Color.Error)" />
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">@L["DatabaseTitle"]</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2">@L["ProviderLabel"] <b>@DbOptions.Provider</b></MudText>
                @if (_dbError is null)
                {
                    <MudText Typo="Typo.body2" Color="Color.Success">@L["ConnectionOk"]</MudText>
                    <MudText Typo="Typo.body2">@L["ProjectCountLabel"] @(_projectCount?.ToString() ?? "…")</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Error">@_dbError</MudText>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>

    @* Modul-Cards aus der Registry *@
    @foreach (var module in ModuleRegistry.All)
    {
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Elevation="0" Class="gdm-card-link" Style="height:100%;">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudIcon Icon="@module.Icon" />
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@Modules.Name(module)</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.body2">@Modules.Description(module)</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Href="@module.Route" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward">@L["OpenButton"]</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@code {
    private int? _projectCount;
    private string? _dbError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _projectCount = await db.GameProjects.CountAsync();
        }
        catch (Exception ex)
        {
            _dbError = L["NoConnection", ex.Message];
        }
    }
}
