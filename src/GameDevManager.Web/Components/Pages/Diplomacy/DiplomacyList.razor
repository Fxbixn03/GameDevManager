@page "/modules/diplomacy"
@inject DiplomacyService Diplomacy
@inject ContentTypeService ContentTypes
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IStringLocalizer<DiplomacyList> L

<PageTitle>@L["PageTitle"]</PageTitle>

<ModuleHeader Module="Module" Subtitle="@Subtitle">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Hub"
                   Href="/modules/diplomacy/graph">
            @L["GraphButton"]
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Style"
                   Href="/modules/diplomacy/arten">
            @L["TypesButton"]
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/modules/diplomacy/neu">
            @L["NewRelation"]
        </MudButton>
    </Actions>
</ModuleHeader>

@if (_relations is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_relations.Count == 0)
{
    <div class="gdm-empty">
        <MudIcon Icon="@Icons.Material.Filled.Handshake" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
        <MudText Typo="Typo.h6">@L["EmptyTitle"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            @L["EmptyHint"]
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/modules/diplomacy/neu">
            @L["FirstRelation"]
        </MudButton>
    </div>
}
else
{
    var filtered = Filtered;

    <MudPaper Elevation="0" Class="gdm-panel pa-4 mb-4">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_search"
                          Placeholder="@L["SearchPlaceholder"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="max-width:360px;" />

            <MudSelect T="DiplomaticStance?"
                       @bind-Value="_stanceFilter"
                       Label="@L["StanceFilterLabel"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="max-width:220px;">
                @foreach (var stance in Enum.GetValues<DiplomaticStance>())
                {
                    <MudSelectItem T="DiplomaticStance?" Value="@stance">@StanceLabel(stance)</MudSelectItem>
                }
            </MudSelect>

            <MudSpacer />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["FilterCount", filtered.Count, _relations.Count]</MudText>
        </MudStack>
    </MudPaper>

    @if (filtered.Count == 0)
    {
        <MudPaper Elevation="0" Class="gdm-panel pa-4">
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["NoRecords"]</MudText>
        </MudPaper>
    }
    else
    {
        @* Beziehungen tragen keine Sprites — die Kachel zeigt das Symbol der Haltung. *@
        <div class="gdm-item-grid">
            @foreach (var relation in filtered)
            {
                <MudPaper Elevation="0" Class="gdm-panel gdm-card-link">
                    <MudLink Href="@($"/modules/diplomacy/{relation.Id}")" Underline="Underline.None">
                        <AssetThumbnail Class="gdm-item-tile"
                                        Alt="@relation.Name"
                                        FallbackIcon="@Icons.Material.Filled.Handshake" />
                    </MudLink>

                    <div class="pa-3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                            <MudLink Href="@($"/modules/diplomacy/{relation.Id}")" Typo="Typo.body1" Class="gdm-ellipsis">
                                <b>@relation.Name</b>
                            </MudLink>
                            <MudTooltip Text="@L["DeleteTooltip"]">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                               Size="Size.Small"
                                               OnClick="@(() => DeleteAsync(relation))"
                                               aria-label="@L["DeleteAria", relation.Name]" />
                            </MudTooltip>
                        </MudStack>

                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="gdm-ellipsis">
                            @(relation.FactionAName ?? L["DeletedFaction"].Value)
                            <MudIcon Icon="@Icons.Material.Filled.SyncAlt" Size="Size.Small" Class="mx-1" Style="vertical-align:middle;" />
                            @(relation.FactionBName ?? L["DeletedFaction"].Value)
                        </MudText>

                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-2">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@StanceColor(relation.Stance)">
                                @StanceLabel(relation.Stance)
                            </MudChip>
                            @if (relation.TypeName is null)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NoType"]</MudText>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@relation.TypeName</MudChip>
                            }
                        </MudStack>

                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                            @L["UpdatedAt", relation.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")]
                        </MudText>
                    </div>
                </MudPaper>
            }
        </div>
    }
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Diplomacy);

    private List<DiplomacyListRow>? _relations;
    private string? _search;
    private DiplomaticStance? _stanceFilter;

    private string Subtitle => _relations is null
        ? L["Loading"]
        : L["SubtitleCount", _relations.Count];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var projectId = await Project.GetCurrentIdAsync();
        _relations = await Diplomacy.GetRelationsAsync(projectId);
    }

    private List<DiplomacyListRow> Filtered
    {
        get
        {
            IEnumerable<DiplomacyListRow> rows = _relations ?? [];

            if (_stanceFilter is { } stance)
            {
                rows = rows.Where(row => row.Stance == stance);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                rows = rows.Where(row =>
                    row.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (row.FactionAName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (row.FactionBName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return [.. rows];
        }
    }

    private string StanceLabel(DiplomaticStance stance) => stance switch
    {
        DiplomaticStance.Alliance => L["StanceAlliance"],
        DiplomaticStance.Friendship => L["StanceFriendship"],
        DiplomaticStance.Neutral => L["StanceNeutral"],
        DiplomaticStance.Hostility => L["StanceHostility"],
        DiplomaticStance.War => L["StanceWar"],
        _ => stance.ToString()
    };

    /// <summary>Warnfarbe orange statt Gelb — Gelb ist im Theme der Akzent, kein Signal.</summary>
    public static Color StanceColor(DiplomaticStance stance) => stance switch
    {
        DiplomaticStance.Alliance => Color.Success,
        DiplomaticStance.Friendship => Color.Info,
        DiplomaticStance.Hostility => Color.Warning,
        DiplomaticStance.War => Color.Error,
        _ => Color.Default
    };

    private async Task DeleteAsync(DiplomacyListRow row)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", row.Name],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Diplomacy.DeleteRelationAsync(row.Id);
        Snackbar.Add(L["DeletedMessage", row.Name], Severity.Success);
        await LoadAsync();
    }
}
