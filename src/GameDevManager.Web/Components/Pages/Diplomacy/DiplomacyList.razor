@page "/modules/diplomacy"
@inject DiplomacyService Diplomacy
@inject ContentTypeService ContentTypes
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Diplomatie – GameDevManager</PageTitle>

<ModuleHeader Module="Module" Subtitle="@Subtitle">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Hub"
                   Href="/modules/diplomacy/graph">
            Graph
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Style"
                   Href="/modules/diplomacy/arten">
            Beziehungs-Arten
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/modules/diplomacy/neu">
            Neue Beziehung
        </MudButton>
    </Actions>
</ModuleHeader>

@if (_relations is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_relations.Count == 0)
{
    <div class="gdm-empty">
        <MudIcon Icon="@Icons.Material.Filled.Handshake" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
        <MudText Typo="Typo.h6">Noch keine Beziehungen</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Beziehungen verbinden je zwei Fraktionen — von Allianz bis Krieg — und werden
            als Graph angezeigt. Dafür braucht es mindestens zwei Fraktionen.
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/modules/diplomacy/neu">
            Erste Beziehung
        </MudButton>
    </div>
}
else
{
    <MudPaper Elevation="0" Class="gdm-panel pa-4 mb-4">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_search"
                          Placeholder="Nach Name oder Fraktion suchen"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="max-width:360px;" />

            <MudSelect T="DiplomaticStance?"
                       @bind-Value="_stanceFilter"
                       Label="Haltung"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="max-width:220px;">
                @foreach (var stance in Enum.GetValues<DiplomaticStance>())
                {
                    <MudSelectItem T="DiplomaticStance?" Value="@stance">@DiplomacyService.StanceLabel(stance)</MudSelectItem>
                }
            </MudSelect>

            <MudSpacer />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Filtered.Count von @_relations.Count</MudText>
        </MudStack>
    </MudPaper>

    <MudTable T="DiplomacyListRow"
              Items="Filtered"
              Elevation="0"
              Hover="true"
              Dense="true"
              Breakpoint="Breakpoint.Sm"
              OnRowClick="OpenRow"
              RowClass="cursor-pointer">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Fraktionen</MudTh>
            <MudTh>Haltung</MudTh>
            <MudTh>Art</MudTh>
            <MudTh Style="width:56px;"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">
                <MudText Typo="Typo.body2"><b>@context.Name</b></MudText>
            </MudTd>
            <MudTd DataLabel="Fraktionen">
                <MudText Typo="Typo.body2">
                    @(context.FactionAName ?? "(gelöschte Fraktion)")
                    <MudIcon Icon="@Icons.Material.Filled.SyncAlt" Size="Size.Small" Class="mx-1" Style="vertical-align:middle;" />
                    @(context.FactionBName ?? "(gelöschte Fraktion)")
                </MudText>
            </MudTd>
            <MudTd DataLabel="Haltung">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@StanceColor(context.Stance)">
                    @DiplomacyService.StanceLabel(context.Stance)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Art">
                @if (context.TypeName is null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">ohne Art</MudText>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.TypeName</MudChip>
                }
            </MudTd>
            <MudTd>
                <MudTooltip Text="Löschen">
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                   Size="Size.Small"
                                   OnClick="@(() => DeleteAsync(context))"
                                   aria-label="@($"{context.Name} löschen")" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">
                Keine Beziehung passt zur Suche.
            </MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Diplomacy);

    private List<DiplomacyListRow>? _relations;
    private string? _search;
    private DiplomaticStance? _stanceFilter;

    private string Subtitle => _relations is null
        ? "Wird geladen …"
        : $"{_relations.Count} Beziehung(en)";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var projectId = await Project.GetCurrentIdAsync();
        _relations = await Diplomacy.GetRelationsAsync(projectId);
    }

    private List<DiplomacyListRow> Filtered
    {
        get
        {
            IEnumerable<DiplomacyListRow> rows = _relations ?? [];

            if (_stanceFilter is { } stance)
            {
                rows = rows.Where(row => row.Stance == stance);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                rows = rows.Where(row =>
                    row.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (row.FactionAName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (row.FactionBName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return [.. rows];
        }
    }

    /// <summary>Warnfarbe orange statt Gelb — Gelb ist im Theme der Akzent, kein Signal.</summary>
    public static Color StanceColor(DiplomaticStance stance) => stance switch
    {
        DiplomaticStance.Alliance => Color.Success,
        DiplomaticStance.Friendship => Color.Info,
        DiplomaticStance.Hostility => Color.Warning,
        DiplomaticStance.War => Color.Error,
        _ => Color.Default
    };

    private void OpenRow(TableRowClickEventArgs<DiplomacyListRow> args)
    {
        if (args.Item is { } row)
        {
            Navigation.NavigateTo($"/modules/diplomacy/{row.Id}");
        }
    }

    private async Task DeleteAsync(DiplomacyListRow row)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Beziehung löschen",
            $"„{row.Name}“ wird mit allen Feldwerten gelöscht. Die Fraktionen bleiben erhalten.",
            yesText: "Löschen",
            cancelText: "Abbrechen");

        if (confirmed != true)
        {
            return;
        }

        await Diplomacy.DeleteRelationAsync(row.Id);
        Snackbar.Add($"„{row.Name}“ wurde gelöscht.", Severity.Success);
        await LoadAsync();
    }
}
