@page "/modules/diplomacy/neu"
@page "/modules/diplomacy/{Id:guid}"
@inject DiplomacyService Diplomacy
@inject ReferenceService References
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<DiplomacyEditor> L

<PageTitle>@L["PageTitle", PageHeading]</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @L["NotFound"]
    </MudAlert>
    <MudButton Variant="Variant.Outlined" Href="/modules/diplomacy">@L["BackToList"]</MudButton>
}
else if (_context is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <ModuleHeader Module="Module"
                  Title="@PageHeading"
                  Subtitle="@(_context.IsNew ? L["NotSavedYet"].Value : null)"
                  Breadcrumbs="Breadcrumbs">
        <Actions>
            @if (_dirty)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                    @L["UnsavedChanges"]
                </MudChip>
            }
            @if (!_context.IsNew)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteOutline"
                           OnClick="DeleteAsync">
                    @L["Delete"]
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Href="/modules/diplomacy">@L["Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       data-gdm-save
                       Disabled="_saving"
                       OnClick="SaveAsync">
                @L["Save"]
            </MudButton>
        </Actions>
    </ModuleHeader>

    @* Sagt vor dem Speichern, was die Schreibkonflikt-Erkennung erst danach meldet. *@
    <EditingPresenceBanner EntityId="@(_context.IsNew ? null : _context.Entity.Id)" />

    <MudGrid Spacing="4">
        <MudItem xs="12" md="8">
            <MudStack Spacing="4">

                @* ------------------------------------------------------------- Stammdaten *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionMasterData"]</MudText>

                    <MudStack Spacing="4">
                        <MudTextField Value="_context.Entity.Name"
                                      ValueChanged="@((string name) => Touch(() => _context.Entity.Name = name))"
                                      T="string"
                                      Label="@L["NameLabel"]"
                                      HelperText="@L["NameHelper"]"
                                      Variant="Variant.Outlined"
                                      Immediate="true" />

                        @if (_factions.Count < 2)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">
                                @L["NeedTwoFactions"]
                                <MudLink Href="/modules/factions" Color="Color.Primary">@L["NeedTwoFactionsLink"]</MudLink>.
                            </MudAlert>
                        }

                        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudSelect T="Guid"
                                       Value="_context.Entity.FactionAId"
                                       ValueChanged="@((Guid id) => Touch(() => _context.Entity.FactionAId = id))"
                                       Label="@L["FactionLabel"]"
                                       Variant="Variant.Outlined"
                                       Style="min-width:220px;">
                                @foreach (var faction in _factions)
                                {
                                    <MudSelectItem T="Guid" Value="@faction.Id">@faction.Name</MudSelectItem>
                                }
                            </MudSelect>

                            <MudIcon Icon="@Icons.Material.Filled.SyncAlt" />

                            <MudSelect T="Guid"
                                       Value="_context.Entity.FactionBId"
                                       ValueChanged="@((Guid id) => Touch(() => _context.Entity.FactionBId = id))"
                                       Label="@L["FactionLabel"]"
                                       Variant="Variant.Outlined"
                                       Style="min-width:220px;">
                                @foreach (var faction in _factions)
                                {
                                    <MudSelectItem T="Guid" Value="@faction.Id">@faction.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudStack>

                        <MudSelect T="DiplomaticStance"
                                   Value="_context.Entity.Stance"
                                   ValueChanged="@((DiplomaticStance stance) => Touch(() => _context.Entity.Stance = stance))"
                                   Label="@L["StanceLabel"]"
                                   Variant="Variant.Outlined"
                                   Style="max-width:260px;">
                            @foreach (var stance in Enum.GetValues<DiplomaticStance>())
                            {
                                <MudSelectItem T="DiplomaticStance" Value="@stance">@Diplomacy.StanceLabel(stance)</MudSelectItem>
                            }
                        </MudSelect>

                        <MudTextField Value="_context.Entity.Description"
                                      ValueChanged="@((string text) => Touch(() => _context.Entity.Description = text))"
                                      T="string"
                                      Label="@L["DescriptionLabel"]"
                                      Variant="Variant.Outlined"
                                      Lines="3" />

                        <MudSelect T="Guid?"
                                   Value="_context.Entity.ContentTypeId"
                                   ValueChanged="ChangeType"
                                   Label="@L["TypeLabel"]"
                                   Variant="Variant.Outlined"
                                   Clearable="true"
                                   HelperText="@L["TypeHelper"]">
                            @foreach (var type in _context.AvailableTypes)
                            {
                                <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudStack>
                </MudPaper>

                @* ------------------------------------------------------------------- Felder *@
                <div>
                    <ContentFieldsPanel TEntity="DiplomaticRelation"
                                        Context="_context"
                                        ModuleKey="@ModuleKeys.Diplomacy"
                                        TypesRoute="/modules/diplomacy/arten"
                                        IndividualHint="@L["IndividualHint"]"
                                        OnValueChanged="MarkDirty"
                                        OnFieldDefinitionChanged="ReloadKeepingChangesAsync" />
                </div>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudStack Spacing="4">
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionReference"]</MudText>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["GuidCaption"]</MudText>
                        @if (!_context.IsNew)
                        {
                            <EntityPinButton ModuleKey="@Module.Id" EntityId="_context.Entity.Id" />
                        }
                    </MudStack>
                    <EntityIdChip Id="_context.Entity.Id" />

                    <MudDivider Class="my-3" />
                    <EntityStatusSelect Entity="_context.Entity" OnChanged="MarkDirty" />

                    @* Das Vorbild einer Variante — die Spalte hängt wie der Stand an
                       ContentEntity und gilt damit in allen Inhaltsmodulen. *@
                    <EntityBaseSelect Entity="_context.Entity"
                                      ModuleKey="@Module.Id"
                                      OnChanged="MarkDirty" />

                    @if (!_context.IsNew)
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["CreatedCaption"]</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">@L["UpdatedCaption"]</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                    }
                </MudPaper>

                @if (!_context.IsNew)
                {
                    <EntityTagsPanel ModuleKey="@ModuleKeys.Diplomacy" EntityId="_context.Entity.Id" />
                    <ReferencesPanel @ref="_referencesPanel" EntityId="_context.Entity.Id" />
                    <EntityHistoryPanel @ref="_historyPanel" EntityId="_context.Entity.Id" />
                    <EntityCommentsPanel ModuleKey="@Module.Id" EntityId="_context.Entity.Id" />
                    <EntityTasksPanel EntityId="_context.Entity.Id" />
                }
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Diplomacy);

    [Parameter]
    public Guid? Id { get; set; }

    private ContentEditContext<DiplomaticRelation>? _context;
    private ReferencesPanel? _referencesPanel;
    private EntityHistoryPanel? _historyPanel;
    private List<EntitySummary> _factions = [];
    private Guid? _loadedId;
    private bool _notFound;
    private bool _saving;
    private bool _dirty;

    private string PageHeading => _context switch
    {
        null => L["HeadingDefault"],
        { IsNew: true } => L["HeadingNew"],
        { Entity.Name: var name } when !string.IsNullOrWhiteSpace(name) => name,
        _ => L["HeadingUnnamed"]
    };

    private List<BreadcrumbItem> Breadcrumbs => [new(PageHeading, null, disabled: true)];

    protected override async Task OnParametersSetAsync()
    {
        if (_context is not null && _loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _notFound = false;
        _dirty = false;
        _context = null;

        var projectId = await Project.GetCurrentIdAsync();
        _factions = await References.GetEntitiesAsync(projectId, ModuleKeys.Factions);
        _context = await Diplomacy.LoadForEditAsync(projectId, Id);

        if (_context is null)
        {
            _notFound = true;
        }
    }

    private void ChangeType(Guid? contentTypeId) =>
        Touch(() => _context!.Entity.ContentTypeId = contentTypeId);

    private void Touch(Action change)
    {
        change();
        MarkDirty();
    }

    private void MarkDirty() => _dirty = true;

    private async Task SaveAsync()
    {
        if (_context is null)
        {
            return;
        }

        _saving = true;

        try
        {
            var wasNew = _context.IsNew;
            await Diplomacy.SaveRelationAsync(_context);
            _dirty = false;

            Snackbar.Add(L["SavedMessage", _context.Entity.Name], Severity.Success);

            if (wasNew)
            {
                Navigation.NavigateTo($"/modules/diplomacy/{_context.Entity.Id}");
                return;
            }

            if (_referencesPanel is not null)
            {
                await _referencesPanel.RefreshAsync();
            }

            if (_historyPanel is not null)
            {
                await _historyPanel.RefreshAsync();
            }
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_context is null)
        {
            return;
        }

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", _context.Entity.Name],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Diplomacy.DeleteRelationAsync(_context.Entity.Id);
        Snackbar.Add(L["DeletedMessage"], Severity.Success);
        Navigation.NavigateTo("/modules/diplomacy");
    }

    /// <summary>
    /// Lädt nach einer Änderung an den Felddefinitionen neu und behält dabei, was in der Maske
    /// noch nicht gespeichert ist.
    /// </summary>
    private async Task ReloadKeepingChangesAsync()
    {
        if (_context is null)
        {
            return;
        }

        var entity = _context.Entity;
        var wasDirty = _dirty;

        var projectId = await Project.GetCurrentIdAsync();
        var reloaded = await Diplomacy.LoadForEditAsync(projectId, entity.Id);

        if (reloaded is null)
        {
            _notFound = true;
            _context = null;
            return;
        }

        reloaded.Entity.Name = entity.Name;
        reloaded.Entity.Description = entity.Description;
        reloaded.Entity.ContentTypeId = entity.ContentTypeId;
        reloaded.Entity.FactionAId = entity.FactionAId;
        reloaded.Entity.FactionBId = entity.FactionBId;
        reloaded.Entity.Stance = entity.Stance;

        _context = reloaded;
        _dirty = wasDirty;
    }
}
