@page "/modules/{ModuleId}"
@inject IStringLocalizer<ModulePage> L

@if (_module is null)
{
    <PageTitle>@L["UnknownPageTitle"]</PageTitle>
    <MudAlert Severity="Severity.Error">@L["UnknownModuleMessage", ModuleId]</MudAlert>
}
else
{
    <PageTitle>@L["PageTitleFormat", _module.Name]</PageTitle>

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4">
        <MudIcon Icon="@_module.Icon" Size="Size.Large" />
        <MudText Typo="Typo.h4">@_module.Name</MudText>
    </MudStack>

    <MudText Typo="Typo.body1" Class="mb-6">@_module.Description</MudText>

    <MudAlert Severity="Severity.Info">
        @L["InDevelopmentHint"]
    </MudAlert>
}

@code {
    [Parameter]
    public string ModuleId { get; set; } = "";

    private ModuleDefinition? _module;

    protected override void OnParametersSet() =>
        _module = ModuleRegistry.Find(ModuleId);
}
