@page "/modules/player/skills"
@inject PlayerService Player
@inject ContentTypeService ContentTypes
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<SkillList> L

<PageTitle>@L["PageTitle"]</PageTitle>

<ModuleHeader Module="Module"
              Title="@L["Title"]"
              Subtitle="@Subtitle"
              Breadcrumbs="Breadcrumbs">
    <Actions>
        <MudButton Variant="Variant.Outlined" Href="/modules/player">@L["ToOverview"]</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/modules/player/skills/neu">
            @L["NewSkill"]
        </MudButton>
    </Actions>
</ModuleHeader>

@if (_skills is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_skills.Count == 0)
{
    <div class="gdm-empty">
        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
        <MudText Typo="Typo.h6">@L["EmptyTitle"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            @L["EmptyHint"]
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/modules/player/skills/neu">
            @L["FirstSkill"]
        </MudButton>
    </div>
}
else
{
    <MudPaper Elevation="0" Class="gdm-panel pa-4 mb-4">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_search"
                          Placeholder="@L["SearchPlaceholder"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="max-width:360px;" />

            <MudSelect T="Guid?"
                       @bind-Value="_treeFilter"
                       Label="@L["TreeFilterLabel"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="max-width:220px;">
                @foreach (var tree in _trees)
                {
                    <MudSelectItem T="Guid?" Value="@tree.Id">@tree.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSpacer />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["FilterCount", Filtered.Count, _skills.Count]</MudText>
        </MudStack>
    </MudPaper>

    <MudTable T="SkillListRow"
              Items="Filtered"
              Elevation="0"
              Hover="true"
              Dense="true"
              Breakpoint="Breakpoint.Sm"
              OnRowClick="OpenRow"
              RowClass="cursor-pointer">
        <HeaderContent>
            <MudTh Style="width:56px;"></MudTh>
            <MudTh>@L["HeaderName"]</MudTh>
            <MudTh>@L["HeaderTree"]</MudTh>
            <MudTh>@L["HeaderParent"]</MudTh>
            <MudTh>@L["HeaderCost"]</MudTh>
            <MudTh>@L["HeaderType"]</MudTh>
            <MudTh Style="width:56px;"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@L["HeaderSprite"]">
                <AssetThumbnail AssetId="context.PrimaryAssetId"
                                Size="Size.Small"
                                Alt="@context.Name"
                                FallbackIcon="@Icons.Material.Filled.Star" />
            </MudTd>
            <MudTd DataLabel="@L["HeaderName"]">
                <MudText Typo="Typo.body2"><b>@context.Name</b></MudText>
            </MudTd>
            <MudTd DataLabel="@L["HeaderTree"]">
                @if (context.SkillTreeId is null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NoTree"]</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2">@(context.SkillTreeName ?? L["DeletedTree"])</MudText>
                }
            </MudTd>
            <MudTd DataLabel="@L["HeaderParent"]">
                @if (context.ParentSkillId is null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NoParent"]</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2">@(context.ParentSkillName ?? L["DeletedParent"])</MudText>
                }
            </MudTd>
            <MudTd DataLabel="@L["HeaderCost"]">
                <MudText Typo="Typo.body2" Class="gdm-mono">@CostLabel(context)</MudText>
            </MudTd>
            <MudTd DataLabel="@L["HeaderType"]">
                @if (context.TypeName is null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NoType"]</MudText>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.TypeName</MudChip>
                }
            </MudTd>
            <MudTd>
                <MudTooltip Text="@L["DeleteTooltip"]">
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                   Size="Size.Small"
                                   OnClick="@(() => DeleteAsync(context))"
                                   aria-label="@L["DeleteAria", context.Name]" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">
                @L["NoRecords"]
            </MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Player);

    private List<BreadcrumbItem> Breadcrumbs => [new(L["BreadcrumbSkills"], null, disabled: true)];

    private List<SkillListRow>? _skills;
    private List<SkillTreeRow> _trees = [];
    private string? _search;
    private Guid? _treeFilter;

    private string Subtitle => _skills is null
        ? L["Loading"]
        : L["SubtitleCount", _skills.Count];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var projectId = await Project.GetCurrentIdAsync();
        _trees = await Player.GetTreesAsync(projectId);
        _skills = await Player.GetSkillsAsync(projectId);
    }

    private List<SkillListRow> Filtered
    {
        get
        {
            IEnumerable<SkillListRow> rows = _skills ?? [];

            if (_treeFilter is { } treeId)
            {
                rows = rows.Where(row => row.SkillTreeId == treeId);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                rows = rows.Where(row =>
                    row.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (row.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return [.. rows];
        }
    }

    private string CostLabel(SkillListRow skill)
    {
        var parts = new List<string>();

        if (skill.CostPoints is { } points)
        {
            parts.Add(L["CostPoints", points.ToString("0.##")]);
        }

        if (skill.CostItemId is not null)
        {
            parts.Add(L["CostItem", skill.CostItemAmount ?? 1, skill.CostItemName ?? L["DeletedItem"]]);
        }

        return parts.Count == 0 ? L["CostFree"] : string.Join(" + ", parts);
    }

    private void OpenRow(TableRowClickEventArgs<SkillListRow> args)
    {
        if (args.Item is { } row)
        {
            Navigation.NavigateTo($"/modules/player/skills/{row.Id}");
        }
    }

    private async Task DeleteAsync(SkillListRow row)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", row.Name],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Player.DeleteSkillAsync(row.Id);
        Snackbar.Add(L["DeletedMessage", row.Name], Severity.Success);
        await LoadAsync();
    }
}
