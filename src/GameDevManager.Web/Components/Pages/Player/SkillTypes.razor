@page "/modules/player/arten"

<PageTitle>Skill-Arten – GameDevManager</PageTitle>

<ModuleHeader Module="Module"
              Title="Skill-Arten"
              Subtitle="Baum, Voraussetzung und Kosten stehen fest am Skill — alles Weitere definieren die Felder der Art."
              Breadcrumbs="Breadcrumbs">
    <Actions>
        <MudButton Variant="Variant.Outlined" Href="/modules/player">Zur Übersicht</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddAsync">
            Neue Art
        </MudButton>
    </Actions>
</ModuleHeader>

<ContentTypeManager @ref="_manager"
                    ModuleKey="@ModuleKeys.Player"
                    EntityNoun="Skill"
                    EmptyTitle="Noch keine Skill-Arten"
                    EmptyHint="Über Arten lassen sich Skills einteilen — etwa aktiv/passiv — und um eigene Felder wie Abklingzeit oder Schadensformel ergänzen." />

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Player);

    private static readonly List<BreadcrumbItem> Breadcrumbs = [new("Arten", null, disabled: true)];

    private ContentTypeManager? _manager;

    private Task AddAsync() => _manager?.AddTypeAsync() ?? Task.CompletedTask;
}
