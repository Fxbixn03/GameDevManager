@page "/modules/player"
@inject PlayerService Player
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<PlayerOverview> L

<PageTitle>@L["PageTitle"]</PageTitle>

<ModuleHeader Module="Module" Subtitle="@Subtitle">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Style"
                   Href="/modules/player/arten">
            @L["SkillTypesButton"]
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/modules/player/skills/neu">
            @L["NewSkill"]
        </MudButton>
    </Actions>
</ModuleHeader>

@if (_characters is null || _trees is null || _skills is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudGrid Spacing="4">
        <MudItem xs="12" md="5">
            @* ------------------------------------------------------------ Spielerfiguren *@
            @* Der Spieler ist ein NPC — dieses Modul verwaltet nur noch Skilltrees. Was an
               alten Spielerfiguren noch da ist, lässt sich hier in NPCs überführen. *@
            <MudPaper Elevation="0" Class="gdm-panel pa-4">
                <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionCharacters"]</MudText>

                @if (_characters.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        @L["PlayerIsNpcHint"]
                    </MudText>
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.People"
                               Href="/modules/npcs">
                        @L["ToNpcs"]
                    </MudButton>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                        @L["ConvertHint", _characters.Count]
                    </MudAlert>

                    @foreach (var character in _characters)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="gdm-field-row py-1">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Color="Color.Secondary" />
                            <MudText Typo="Typo.body2">@character.Name</MudText>
                        </MudStack>
                    }

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.MoveUp"
                               Class="mt-3"
                               OnClick="ConvertCharactersAsync">
                        @L["ConvertButton"]
                    </MudButton>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="7">
            @* -------------------------------------------------------------- Skilltrees *@
            <MudPaper Elevation="0" Class="gdm-panel pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                    <MudText Typo="Typo.overline" Color="Color.Secondary">@L["SectionTrees"]</MudText>
                    <MudStack Row="true" Spacing="2">
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Text"
                                   Href="/modules/player/skills">
                            @L["AllSkills", _skills.Count]
                        </MudButton>
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="AddTree">
                            @L["AddTree"]
                        </MudButton>
                    </MudStack>
                </MudStack>

                @if (_trees.Count == 0 && _editingTrees.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @L["NoTrees"]
                    </MudText>
                }
                else
                {
                    <MudStack Spacing="3">
                        @foreach (var tree in _editingTrees)
                        {
                            <div class="pa-3 gdm-field-row">
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                    <MudTextField T="string"
                                                  @bind-Value="tree.Name"
                                                  Label="@L["NameLabel"]"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                    <MudTextField T="string"
                                                  @bind-Value="tree.Description"
                                                  Label="@L["DescriptionLabel"]"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                    <MudTooltip Text="@L["SaveTreeTooltip"]">
                                        <MudIconButton Icon="@Icons.Material.Filled.Save"
                                                       Size="Size.Small"
                                                       Color="Color.Primary"
                                                       OnClick="@(() => SaveTreeAsync(tree))"
                                                       aria-label="@L["SaveTreeAria"]" />
                                    </MudTooltip>
                                    <MudTooltip Text="@L["DiscardTreeTooltip"]">
                                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                       Size="Size.Small"
                                                       OnClick="@(() => _editingTrees.Remove(tree))"
                                                       aria-label="@L["DiscardTreeAria"]" />
                                    </MudTooltip>
                                </MudStack>
                            </div>
                        }

                        @foreach (var tree in _trees)
                        {
                            <div class="pa-3 gdm-field-row">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
                                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" />
                                    <MudText Typo="Typo.subtitle1"><b>@tree.Name</b></MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["TreeSkillCount", tree.SkillCount]</MudText>
                                    <MudSpacer />
                                    <MudTooltip Text="@L["DeleteTreeTooltip"]">
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                       Size="Size.Small"
                                                       OnClick="@(() => DeleteTreeAsync(tree))"
                                                       aria-label="@L["DeleteTreeAria", tree.Name]" />
                                    </MudTooltip>
                                </MudStack>

                                @if (!string.IsNullOrWhiteSpace(tree.Description))
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">@tree.Description</MudText>
                                }

                                @foreach (var (skill, depth) in FlattenTree(tree.Id))
                                {
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2"
                                              Class="py-1" Style="@($"margin-left:{depth * 24}px;")">
                                        <MudIcon Icon="@(depth == 0 ? Icons.Material.Filled.Star : Icons.Material.Filled.SubdirectoryArrowRight)"
                                                 Size="Size.Small"
                                                 Color="Color.Secondary" />
                                        <MudLink Href="@($"/modules/player/skills/{skill.Id}")" Typo="Typo.body2">
                                            @skill.Name
                                        </MudLink>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="gdm-mono">
                                            @CostLabel(skill)
                                        </MudText>
                                    </MudStack>
                                }
                            </div>
                        }

                        @{ var withoutTree = _skills.Where(s => s.SkillTreeId is null).ToList(); }
                        @if (withoutTree.Count > 0)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">
                                @L["SkillsWithoutTree", withoutTree.Count]
                                <MudLink Href="/modules/player/skills" Color="Color.Primary">@L["SkillsWithoutTreeLink"]</MudLink>.
                            </MudAlert>
                        }
                    </MudStack>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Player);

    private List<PlayerCharacter>? _characters;
    private List<SkillTreeRow>? _trees;
    private List<SkillListRow>? _skills;
    private readonly List<SkillTree> _editingTrees = [];
    private Guid _projectId;

    private string Subtitle => _skills is null
        ? L["Loading"]
        : L["SubtitleCount", _trees!.Count, _skills.Count];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _projectId = await Project.GetCurrentIdAsync();
        _characters = await Player.GetCharactersAsync(_projectId);
        _trees = await Player.GetTreesAsync(_projectId);
        _skills = await Player.GetSkillsAsync(_projectId);
    }

    /// <summary>Skills eines Baums als eingerückte Liste — Wurzeln zuerst, Kinder darunter.</summary>
    private IEnumerable<(SkillListRow Skill, int Depth)> FlattenTree(Guid treeId)
    {
        var inTree = (_skills ?? []).Where(s => s.SkillTreeId == treeId).ToList();
        var byParent = inTree.ToLookup(s => s.ParentSkillId);
        var visited = new HashSet<Guid>();

        IEnumerable<(SkillListRow, int)> Walk(Guid? parentId, int depth)
        {
            foreach (var skill in byParent[parentId].OrderBy(s => s.Name))
            {
                if (!visited.Add(skill.Id))
                {
                    continue;
                }

                yield return (skill, depth);

                foreach (var child in Walk(skill.Id, depth + 1))
                {
                    yield return child;
                }
            }
        }

        // Auch Skills, deren Voraussetzung gelöscht wurde, sollen sichtbar bleiben.
        foreach (var entry in Walk(null, 0))
        {
            yield return entry;
        }

        foreach (var orphan in inTree.Where(s => !visited.Contains(s.Id)).OrderBy(s => s.Name))
        {
            yield return (orphan, 0);
        }
    }

    private string CostLabel(SkillListRow skill)
    {
        var parts = new List<string>();

        if (skill.CostPoints is { } points)
        {
            parts.Add(L["CostPoints", points.ToString("0.##")]);
        }

        if (skill.CostItemId is not null)
        {
            parts.Add(L["CostItem", skill.CostItemAmount ?? 1, skill.CostItemName ?? L["DeletedItem"]]);
        }

        return parts.Count == 0 ? L["CostFree"] : string.Join(" + ", parts);
    }

    // ---------------------------------------------------------------- Spielerfiguren

    /// <summary>Überführt die verbliebenen Spielerfiguren in NPCs — GUID und Anhänge bleiben.</summary>
    private async Task ConvertCharactersAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["ConvertConfirmTitle"],
            L["ConvertConfirmMessage", _characters!.Count],
            yesText: L["ConvertYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        try
        {
            var count = await Player.ConvertCharactersToNpcsAsync(_projectId);
            Snackbar.Add(L["ConvertedMessage", count], Severity.Success);
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }

        await LoadAsync();
    }

    // -------------------------------------------------------------------- Skilltrees

    private void AddTree() =>
        _editingTrees.Add(new SkillTree { GameProjectId = _projectId, Name = string.Empty });

    private async Task SaveTreeAsync(SkillTree tree)
    {
        try
        {
            await Player.SaveTreeAsync(tree);
            _editingTrees.Remove(tree);
            Snackbar.Add(L["TreeSavedMessage", tree.Name], Severity.Success);
            await LoadAsync();
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteTreeAsync(SkillTreeRow tree)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteTreeTitle"],
            L["DeleteTreeMessage", tree.Name, tree.SkillCount],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Player.DeleteTreeAsync(tree.Id);
        Snackbar.Add(L["TreeDeletedMessage"], Severity.Success);
        await LoadAsync();
    }
}
