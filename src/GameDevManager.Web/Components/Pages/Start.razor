@page "/"
@page "/konto/anmelden"
@layout StartLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject NavigationManager Navigation
@inject IStringLocalizer<Start> L
@inject ExternalLoginOptions ExternalLogin
@inject ProjectContext Project
@inject StartScreenService StartScreen
@inject ModuleLabels Modules
@inject UserService Users
@inject PasswordPolicySelection Policy
@using System.Globalization

@*
    Startscreen und Anmeldung sind dieselbe Seite: Wer nicht angemeldet ist, bekommt an der
    Stelle des Start-Knopfes das Anmeldeformular — Regen, Farbebenen und Partikel laufen
    dahinter weiter. Deshalb zwei Routen; „/konto/anmelden“ bleibt die Adresse, die Cookie,
    RedirectToLogin und Abmelden anlaufen.

    Bewusst statisch gerendert (ExcludeFromInteractiveRouting): Ein Anmelde-Cookie lässt sich
    nur während einer echten HTTP-Antwort setzen — über die SignalR-Verbindung von Blazor
    Server gibt es keine, in die es hineinpasste. Aus demselben Grund ein gewöhnliches
    Formular mit Postback und einfache InputText-Felder statt MudBlazor-Eingaben: Nur echte
    <input name="…">-Elemente kommen beim Postback wieder an. Der Start-Knopf ist deshalb ein
    Link (Href) und kein OnClick.
*@

<PageTitle>@(SignedIn ? L["PageTitle"] : L["PageTitleSignIn"])</PageTitle>

<div class="gdm-start-screen @(SignedIn ? null : "gdm-start-screen-auth")">
    @* Rein dekorative Hintergrundebenen, von hinten nach vorn: ziehende Farbfelder,
       Lichtschein hinter dem Titel, wandernder Lichtstreif, der Inhaltsregen,
       aufsteigende Pixel, Abdunklung zum Rand und der Eckrahmen. *@
    <div class="gdm-start-aurora" aria-hidden="true"></div>
    <div class="gdm-start-glow" aria-hidden="true"></div>
    <div class="gdm-start-beam" aria-hidden="true"></div>

    @* Der Inhaltsregen: angelegte Entitäten des Projekts fallen quer durch alle Module
       durchs Bild. Bahn, Größe, Tempo und Startzeitpunkt stehen als CSS-Variablen am
       Element, die Bewegung selbst macht app.css. Die Ebene entsteht erst mit den
       Tropfen — so beginnt ihr Aufblenden genau dann, wenn es etwas zu sehen gibt. *@
    @if (_drops.Count > 0)
    {
        <div class="gdm-start-rain" aria-hidden="true">
            @foreach (var drop in _drops)
            {
                <div class="gdm-start-drop" style="@drop.Style">
                    <div class="gdm-start-drop-card">
                        <span class="gdm-start-drop-icon">
                            @if (drop.Hit.PrimaryAssetId is { } assetId)
                            {
                                <img src="@($"/assets/{assetId}")" alt="" loading="lazy" />
                            }
                            else
                            {
                                @* Ohne Farbe, weil die Kachel sie setzt: Color.Primary käme
                                   mit !important und ließe sich von der Seltenheit nicht
                                   überschreiben. *@
                                <MudIcon Icon="@drop.Icon" />
                            }
                        </span>
                        <span class="gdm-start-drop-text">
                            <span class="gdm-start-drop-name">@drop.Hit.Name</span>
                            <span class="gdm-start-drop-module">@drop.Module</span>
                        </span>
                    </div>
                </div>
            }
        </div>
    }

    <div class="gdm-start-pixels" aria-hidden="true">
        @for (var i = 0; i < PixelCount; i++)
        {
            <span class="gdm-start-pixel"></span>
        }
    </div>

    <div class="gdm-start-vignette" aria-hidden="true"></div>

    <div class="gdm-start-frame" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
    </div>

    <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="gdm-start-brand">
        <div class="gdm-start-enter gdm-start-enter-1">
            <MudIcon Icon="@Icons.Material.Filled.SportsEsports" Color="Color.Primary" Class="gdm-start-icon" />
        </div>
        <MudText Typo="Typo.h1" Align="Align.Center" Color="Color.Primary"
                 Class="gdm-start-title gdm-start-enter gdm-start-enter-2">@L["Title"]</MudText>
        <div class="gdm-start-rule" aria-hidden="true"></div>
        <MudText Typo="Typo.subtitle1" Align="Align.Center"
                 Class="gdm-start-tagline gdm-start-enter gdm-start-enter-3">@L["Tagline"]</MudText>
    </MudStack>

    @* Angemeldet der Weg ins Werkzeug, sonst die Anmeldung — an derselben Stelle.
       Der Wrapper trägt die Eingangsanimation, damit deren Transform nicht mit dem
       Hover-Transform des Knopfes kollidiert. *@
    <div class="gdm-start-cta gdm-start-enter gdm-start-enter-4">
        @if (SignedIn)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Class="gdm-start-button"
                       Href="/dashboard">@L["StartButton"]</MudButton>
        }
        else
        {
            <div class="gdm-start-login">
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
                }

                @if (LoggedOut)
                {
                    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-4">@L["LoggedOut"]</MudAlert>
                }

                <EditForm Model="Input" FormName="login" OnValidSubmit="SignInAsync">
                    <DataAnnotationsValidator />

                    <label class="gdm-auth-label" for="userName">@L["UserNameLabel"]</label>
                    <InputText id="userName" @bind-Value="Input.UserName" class="gdm-auth-input"
                               autocomplete="username" />

                    @if (!Policy.Current.PasswordsDisabled)
                    {
                        <label class="gdm-auth-label" for="password">@L["PasswordLabel"]</label>
                        <InputText id="password" type="password" @bind-Value="Input.Password"
                                   class="gdm-auth-input" autocomplete="current-password" />
                    }

                    @* Der zweite Faktor erscheint erst, wenn der erste Versuch ihn verlangt
                       hat: Ein Codefeld an einer Anmeldung ohne zweiten Faktor wäre ein Feld,
                       das niemand füllen kann. *@
                    @if (Input.NeedsCode)
                    {
                        <label class="gdm-auth-label" for="code">@L["CodeLabel"]</label>
                        <InputText id="code" @bind-Value="Input.Code" class="gdm-auth-input"
                                   autocomplete="one-time-code" inputmode="numeric" />
                        <div class="gdm-auth-hint">@L["CodeHint"]</div>
                    }

                    <label class="gdm-auth-remember">
                        <InputCheckbox id="rememberMe" @bind-Value="Input.RememberMe" />
                        @L["RememberMe"]
                    </label>

                    <button type="submit" class="gdm-auth-submit gdm-start-login-submit">@L["SignIn"]</button>
                </EditForm>

                @* Der Knopf steht nur da, wenn ein Anbieter eingerichtet ist — ein Knopf, der
                   in eine Fehlermeldung führt, ist schlechter als keiner. Ein Link und kein
                   Formular: Der Weg zum Anbieter ist eine Umleitung, kein Postback. *@
                @if (ExternalLogin.IsConfigured)
                {
                    <a class="gdm-auth-external" href="@ExternalHref">
                        @L["SignInExternal", ExternalLogin.DisplayName]
                    </a>
                }
            </div>
        }
    </div>
</div>

@code {
    private const int PixelCount = 9;

    /// <summary>Der Weg zum externen Anbieter, mit dem ursprünglichen Ziel im Gepäck.</summary>
    private string ExternalHref =>
        "/konto/extern" + (string.IsNullOrWhiteSpace(ReturnUrl)
            ? string.Empty
            : "?ziel=" + Uri.EscapeDataString(ReturnUrl));

    /// <summary>
    /// Wie viele Entitäten höchstens gleichzeitig fallen. Mehr wird unruhig und verdeckt den
    /// Titel, weniger wirkt wie ein Versehen statt wie Regen.
    /// </summary>
    private const int MaxDrops = 16;

    private IReadOnlyList<RainDrop> _drops = [];

    /// <summary>
    /// Der Kontext der Anfrage — die Seite wird statisch gerendert, also steht er immer da.
    /// Er beantwortet zugleich, ob schon jemand angemeldet ist: Ein
    /// <c>AuthenticationStateProvider</c> wäre hier der Umweg über dieselbe Auskunft.
    /// </summary>
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    /// <summary>Wohin es nach der Anmeldung weitergeht — gesetzt von der Umleitung.</summary>
    [SupplyParameterFromQuery(Name = "ziel")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "abgemeldet")]
    public bool LoggedOut { get; set; }

    // Bewusst kein Auto-Property mit Initializer (BL0008): Das Modellbinding setzt diesen
    // Parameter beim Postback und schriebe null hinein, wenn die Bindung nichts hergibt — der
    // Initializer liefe kein zweites Mal, und das Markup liefe in eine NullReferenceException.
    // Das Backing-Feld hält deshalb immer ein Objekt bereit.
    private LoginInput _input = new();

    [SupplyParameterFromForm]
    private LoginInput Input
    {
        get => _input;
        set => _input = value ?? new();
    }

    private string? _error;

    private bool SignedIn => HttpContext.User.Identity?.IsAuthenticated == true;

    protected override async Task OnInitializedAsync()
    {
        if (!SignedIn)
        {
            // Vor dem ersten Konto führt kein Weg an der Ersteinrichtung vorbei — ein
            // ausgeliefertes Standardpasswort gibt es bewusst nicht. Das Umleiten wirft, der
            // Regen darunter lädt dann gar nicht erst.
            if (!await Users.HasAnyUserAsync())
            {
                Navigation.NavigateTo("/konto/einrichten");
                return;
            }
        }

        // Fehlt die Datenbank oder ist das Projekt leer, bleibt der Startscreen ohne Regen —
        // er ist reine Dekoration und darf die Anmeldung nicht aufhalten.
        //
        // Vor der Anmeldung fallen neutrale Platzhalter statt angelegter Inhalte: Die Seite
        // wird statisch gerendert, der Regen käme sonst fertig mit der Antwort — und Namen
        // von Inhalten wären für Installationen im offenen Netz ein Informationsleck. Die
        // Modulnamen stammen aus der festen Registry und verraten nichts über das Projekt.
        try
        {
            if (SignedIn)
            {
                var projectId = await Project.GetCurrentIdAsync();
                _drops = BuildDrops(await StartScreen.SampleEntitiesAsync(projectId, MaxDrops));
            }
            else
            {
                _drops = BuildDrops(BuildPlaceholders());
            }
        }
        catch (Exception)
        {
            _drops = [];
        }
    }

    /// <summary>
    /// Neutrale Tropfen für den nicht angemeldeten Blick: je umgesetztes Modul einer, mit
    /// Modulname und -icon statt eines Inhaltsnamens. <see cref="Guid.Empty"/> kennzeichnet
    /// den Platzhalter — <see cref="BuildDrops"/> lässt dann die Modulzeile leer, sonst
    /// stünde derselbe Name zweimal übereinander.
    /// </summary>
    private List<StartScreenEntity> BuildPlaceholders() =>
        [.. ModuleRegistry.All
            .Where(module => module.Implemented)
            .Take(MaxDrops)
            .Select(module => new StartScreenEntity(
                new SearchHit(Guid.Empty, module.Id, SearchHitKind.Entity, Modules.NameOrKey(module.Id), null, null),
                RarityColor: null))];

    /// <summary>
    /// Verteilt die Entitäten auf Bahnen und würfelt je Tropfen die Tiefe aus: was größer und
    /// heller ist, fällt schneller — daraus entsteht die räumliche Staffelung. Der negative
    /// Startzeitpunkt sorgt dafür, dass der Regen beim Öffnen schon läuft, statt erst von oben
    /// einzusetzen.
    /// </summary>
    private List<RainDrop> BuildDrops(IReadOnlyList<StartScreenEntity> entities)
    {
        if (entities.Count == 0)
        {
            return [];
        }

        // Bei einem frischen Projekt mit wenigen Entitäten fallen dieselben mehrfach — sonst
        // wären es zwei einsame Kacheln. Ab genug Inhalt fällt jede Entität nur einmal.
        var count = Math.Min(MaxDrops, entities.Count * 3);

        // Die Bahnen bleiben zwischen 6 % und 94 %: eine am Rand halb abgeschnittene Kachel
        // sieht nach Layoutfehler aus und nicht nach Regen.
        var lane = 88.0 / count;
        var drops = new List<RainDrop>(count);

        for (var i = 0; i < count; i++)
        {
            var entity = entities[i % entities.Count];
            var hit = entity.Hit;
            var depth = Random.Shared.NextDouble();
            var duration = 30.0 - depth * 13.0;

            // Je Bahn ein eigener Streifen mit etwas Spiel: gleichmäßig verteilt, aber nicht
            // sichtbar in Spalten ausgerichtet.
            var left = 6.0 + lane * (i + 0.2 + Random.Shared.NextDouble() * 0.6);

            drops.Add(new RainDrop(
                hit,
                // Platzhalter tragen den Modulnamen schon als Namen — die Modulzeile bliebe
                // sonst dieselbe Angabe zweimal übereinander.
                hit.Id == Guid.Empty ? string.Empty : Modules.NameOrKey(hit.ModuleKey),
                ModuleRegistry.Find(hit.ModuleKey)?.Icon ?? Icons.Material.Filled.Category,
                Style(
                    left,
                    size: 0.62 + depth * 0.3,
                    opacity: 0.16 + depth * 0.28,
                    duration,
                    delay: -Random.Shared.NextDouble() * duration,
                    entity.RarityColor)));
        }

        return drops;
    }

    /// <summary>
    /// Die ausgewürfelten Werte als CSS-Variablen. Zwingend invariant formatiert: mit
    /// deutscher Kultur stünde dort „0,75rem", und das ist kein gültiger CSS-Wert.
    /// <para>
    /// Die Seltenheitsfarbe wird nur gesetzt, wenn die Entität eine trägt — ohne sie bleibt
    /// die Variable ungesetzt, und die Kachel fällt in app.css auf das Akzentgelb zurück.
    /// </para>
    /// </summary>
    private static string Style(
        double lane, double size, double opacity, double duration, double delay, string? rarityColor)
    {
        var style = string.Create(CultureInfo.InvariantCulture,
            $"--gdm-drop-lane:{lane:0.##}%;--gdm-drop-size:{size:0.###}rem;--gdm-drop-opacity:{opacity:0.###};--gdm-drop-duration:{duration:0.#}s;--gdm-drop-delay:{delay:0.#}s");

        return string.IsNullOrWhiteSpace(rarityColor)
            ? style
            : $"{style};--gdm-drop-color:{rarityColor}";
    }

    private async Task SignInAsync()
    {
        var name = Input.UserName ?? string.Empty;
        var password = Input.Password ?? string.Empty;

        // Erster Schritt: Name und Passwort. Der Zeitstempel des letzten Logins geht dabei
        // noch nicht hoch — ein halber Versuch ist keiner.
        var candidate = await Users.VerifyPasswordAsync(name, password);

        if (candidate is null)
        {
            // Bewusst eine Meldung für beide Fälle: Ein „diesen Benutzer gibt es nicht“ wäre
            // eine Auskunft darüber, welche Konten bestehen.
            _error = Policy.Current.PasswordsDisabled ? L["FailedUserNameOnly"] : L["Failed"];
            Input.NeedsCode = false;
            return;
        }

        if (candidate.HasTwoFactor && string.IsNullOrWhiteSpace(Input.Code))
        {
            // Nachfragen statt abweisen: Das Passwort stimmt, es fehlt nur der zweite Faktor.
            Input.NeedsCode = true;
            _error = null;
            return;
        }

        var user = await Users.AuthenticateWithCodeAsync(name, password, Input.Code ?? string.Empty);

        if (user is null)
        {
            _error = L["FailedCode"];
            Input.NeedsCode = true;
            return;
        }

        await HttpContext.SignInWithUserAsync(user, Input.RememberMe);

        // forceLoad wäre hier falsch: Wir sind mitten in der Antwort, die das Cookie setzt.
        Navigation.NavigateTo(SafeReturnUrl(), forceLoad: false);
    }

    /// <summary>
    /// Nur Pfade innerhalb der Anwendung. Ein „ziel“ aus der Adresszeile darf nicht auf eine
    /// fremde Seite führen — das wäre eine offene Weiterleitung.
    /// </summary>
    private string SafeReturnUrl() =>
        !string.IsNullOrWhiteSpace(ReturnUrl)
            && ReturnUrl.StartsWith('/')
            && !ReturnUrl.StartsWith("//", StringComparison.Ordinal)
            ? ReturnUrl
            : "/dashboard";

    /// <summary>Eine fallende Entität samt ihrer ausgewürfelten Bahn.</summary>
    private sealed record RainDrop(SearchHit Hit, string Module, string Icon, string Style);

    private sealed class LoginInput
    {
        [Required]
        public string? UserName { get; set; }

        // Kein [Required]: Bei deaktivierten Passwörtern gibt es das Feld nicht — ein leeres
        // Passwort bei aktiven Passwörtern weist AuthenticateAsync ohnehin ab.
        public string? Password { get; set; }

        // Vorgabe „aus“: Ein nicht angehakter Haken kommt beim Postback gar nicht an und
        // ließe eine Vorgabe „an“ nie wieder abwählen.
        public bool RememberMe { get; set; }

        /// <summary>Der Code des zweiten Faktors — oder ein Wiederherstellungscode.</summary>
        public string? Code { get; set; }

        /// <summary>
        /// Ob das Codefeld gezeigt wird. Steht im Formularmodell und nicht als Feld der Seite,
        /// weil die Seite statisch gerendert wird: Zwischen den beiden Schritten liegt ein
        /// Postback, und nur das Modell überlebt ihn.
        /// </summary>
        public bool NeedsCode { get; set; }
    }
}
