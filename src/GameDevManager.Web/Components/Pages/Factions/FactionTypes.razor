@page "/modules/factions/arten"

<PageTitle>Fraktions-Arten – GameDevManager</PageTitle>

<ModuleHeader Module="Module"
              Title="Fraktions-Arten"
              Subtitle="Mitglieder und Ränge stehen fest an der Fraktion — alles Weitere definieren die Felder der Art."
              Breadcrumbs="Breadcrumbs">
    <Actions>
        <MudButton Variant="Variant.Outlined" Href="/modules/factions">Zu den Fraktionen</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddAsync">
            Neue Art
        </MudButton>
    </Actions>
</ModuleHeader>

<ContentTypeManager @ref="_manager"
                    ModuleKey="@ModuleKeys.Factions"
                    EntityNoun="Fraktion"
                    EmptyTitle="Noch keine Fraktions-Arten"
                    EmptyHint="Über Arten lassen sich Angaben ergänzen, die die Fraktion selbst nicht kennt — etwa Gesinnung, Hauptsitz oder Start-Ansehen." />

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Factions);

    private static readonly List<BreadcrumbItem> Breadcrumbs = [new("Arten", null, disabled: true)];

    private ContentTypeManager? _manager;

    private Task AddAsync() => _manager?.AddTypeAsync() ?? Task.CompletedTask;
}
