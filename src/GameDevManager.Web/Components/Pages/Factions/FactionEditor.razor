@page "/modules/factions/neu"
@page "/modules/factions/{Id:guid}"
@inject FactionService Factions
@inject ReferenceService References
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@PageHeading – GameDevManager</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        Es gibt keine Fraktion mit dieser GUID. Vielleicht wurde sie gelöscht.
    </MudAlert>
    <MudButton Variant="Variant.Outlined" Href="/modules/factions">Zurück zur Übersicht</MudButton>
}
else if (_context is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <ModuleHeader Module="Module"
                  Title="@PageHeading"
                  Subtitle="@(_context.IsNew ? "Noch nicht gespeichert" : null)"
                  Breadcrumbs="Breadcrumbs">
        <Actions>
            @if (_dirty)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                    Ungespeicherte Änderungen
                </MudChip>
            }
            @if (!_context.IsNew)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteOutline"
                           OnClick="DeleteAsync">
                    Löschen
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Href="/modules/factions">Abbrechen</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       Disabled="_saving"
                       OnClick="SaveAsync">
                Speichern
            </MudButton>
        </Actions>
    </ModuleHeader>

    <MudGrid Spacing="4">
        <MudItem xs="12" md="8">
            <MudStack Spacing="4">

                @* ------------------------------------------------------------- Stammdaten *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">Stammdaten</MudText>

                    <MudStack Spacing="4">
                        <MudTextField Value="_context.Entity.Name"
                                      ValueChanged="@((string name) => Touch(() => _context.Entity.Name = name))"
                                      T="string"
                                      Label="Name *"
                                      Variant="Variant.Outlined"
                                      Immediate="true" />

                        <MudTextField Value="_context.Entity.Description"
                                      ValueChanged="@((string text) => Touch(() => _context.Entity.Description = text))"
                                      T="string"
                                      Label="Beschreibung"
                                      Variant="Variant.Outlined"
                                      Lines="3" />

                        <MudSelect T="Guid?"
                                   Value="_context.Entity.ContentTypeId"
                                   ValueChanged="ChangeType"
                                   Label="Fraktions-Art"
                                   Variant="Variant.Outlined"
                                   Clearable="true"
                                   HelperText="Über die Art kommen eigene Felder dazu, etwa Gesinnung oder Hauptsitz.">
                            @foreach (var type in _context.AvailableTypes)
                            {
                                <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudStack>
                </MudPaper>

                @* ------------------------------------------------------------ Mitglieder *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Mitglieder</MudText>
                        <MudButton StartIcon="@Icons.Material.Filled.Add"
                                   Size="Size.Small"
                                   Disabled="@(_npcs.Count == 0)"
                                   OnClick="AddMember">
                            Mitglied
                        </MudButton>
                    </MudStack>

                    @if (_npcs.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">
                            Es gibt noch keine NPCs —
                            <MudLink Href="/modules/npcs" Color="Color.Primary">jetzt welche anlegen</MudLink>.
                        </MudAlert>
                    }
                    else if (_context.Entity.Members.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Noch kein Mitglied. Je Mitglied lässt sich eine Rolle bzw. ein Rang
                            in der Fraktion festlegen — etwa „Anführerin“ oder „Rekrut“.
                        </MudText>
                    }
                    else
                    {
                        <MudStack Spacing="0">
                            @foreach (var member in _context.Entity.Members)
                            {
                                <div class="pa-2 gdm-field-row">
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="6">
                                            <MudAutocomplete T="EntitySummary"
                                                             Value="@NpcFor(member.NpcId)"
                                                             ValueChanged="@((EntitySummary? e) => Touch(() => member.NpcId = e?.Id ?? Guid.Empty))"
                                                             SearchFunc="SearchNpcsAsync"
                                                             ToStringFunc="@(e => e?.Name ?? string.Empty)"
                                                             Label="NPC"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Clearable="true"
                                                             ResetValueOnEmptyText="true"
                                                             CoerceValue="false"
                                                             MaxItems="50" />
                                        </MudItem>

                                        <MudItem xs="12" sm="4">
                                            <MudTextField T="string"
                                                          Value="member.Role"
                                                          ValueChanged="@((string role) => Touch(() => member.Role = role))"
                                                          Label="Rolle / Rang"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          MaxLength="200" />
                                        </MudItem>

                                        <MudItem xs="12" sm="2" Class="d-flex align-center justify-end">
                                            <MudTooltip Text="Mitglied entfernen">
                                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                               Size="Size.Small"
                                                               OnClick="@(() => RemoveMember(member))"
                                                               aria-label="Mitglied entfernen" />
                                            </MudTooltip>
                                        </MudItem>
                                    </MudGrid>
                                </div>
                            }
                        </MudStack>
                    }
                </MudPaper>

                @* ------------------------------------------------------------------ Sprites *@
                <AssetSpritePanel ModuleKey="@ModuleKeys.Factions"
                                  EntityId="_context.Entity.Id"
                                  Disabled="_context.IsNew" />

                @* ------------------------------------------------------------------- Felder *@
                <div>
                    <ContentFieldsPanel TEntity="Faction"
                                        Context="_context"
                                        ModuleKey="@ModuleKeys.Factions"
                                        TypesRoute="/modules/factions/arten"
                                        IndividualHint="Für Angaben, die nur diese eine Fraktion braucht."
                                        OnValueChanged="MarkDirty"
                                        OnFieldDefinitionChanged="ReloadKeepingChangesAsync" />
                </div>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudStack Spacing="4">
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">Referenz</MudText>

                    <MudText Typo="Typo.caption" Color="Color.Secondary">GUID</MudText>
                    <EntityIdChip Id="_context.Entity.Id" />

                    @if (!_context.IsNew)
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Angelegt</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">Zuletzt geändert</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                    }
                </MudPaper>

                @* Gebiete zeichnet das Karten-Modul; hier steht, wo die Fraktion markiert ist. *@
                @if (!_context.IsNew)
                {
                    <ReferencesPanel @ref="_referencesPanel" EntityId="_context.Entity.Id" />
                }
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Factions);

    [Parameter]
    public Guid? Id { get; set; }

    private ContentEditContext<Faction>? _context;
    private ReferencesPanel? _referencesPanel;
    private List<EntitySummary> _npcs = [];
    private Guid? _loadedId;
    private bool _notFound;
    private bool _saving;
    private bool _dirty;

    private string PageHeading => _context switch
    {
        null => "Fraktion",
        { IsNew: true } => "Neue Fraktion",
        { Entity.Name: var name } when !string.IsNullOrWhiteSpace(name) => name,
        _ => "Fraktion ohne Namen"
    };

    private List<BreadcrumbItem> Breadcrumbs => [new(PageHeading, null, disabled: true)];

    protected override async Task OnParametersSetAsync()
    {
        if (_context is not null && _loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _notFound = false;
        _dirty = false;
        _context = null;

        var projectId = await Project.GetCurrentIdAsync();
        _npcs = await References.GetEntitiesAsync(projectId, ModuleKeys.Npcs);
        _context = await Factions.LoadForEditAsync(projectId, Id);

        if (_context is null)
        {
            _notFound = true;
        }
    }

    private EntitySummary? NpcFor(Guid npcId) => _npcs.FirstOrDefault(entity => entity.Id == npcId);

    private Task<IEnumerable<EntitySummary>> SearchNpcsAsync(string? search, CancellationToken ct)
    {
        IEnumerable<EntitySummary> matches = string.IsNullOrWhiteSpace(search)
            ? _npcs
            : _npcs.Where(entity => entity.Name.Contains(search, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(matches);
    }

    private void AddMember() =>
        Touch(() => _context!.Entity.Members.Add(new FactionMember
        {
            FactionId = _context.Entity.Id,
            NpcId = Guid.Empty,
            SortOrder = _context.Entity.Members.Count
        }));

    private void RemoveMember(FactionMember member) =>
        Touch(() => _context!.Entity.Members.Remove(member));

    private void ChangeType(Guid? contentTypeId) =>
        Touch(() => _context!.Entity.ContentTypeId = contentTypeId);

    private void Touch(Action change)
    {
        change();
        MarkDirty();
    }

    private void MarkDirty() => _dirty = true;

    private async Task SaveAsync()
    {
        if (_context is null)
        {
            return;
        }

        // Leere Eingabezeilen sind ein Bedienschritt, kein Inhalt.
        _context.Entity.Members.RemoveAll(member => member.NpcId == Guid.Empty);

        _saving = true;

        try
        {
            var wasNew = _context.IsNew;
            await Factions.SaveFactionAsync(_context);
            _dirty = false;

            Snackbar.Add($"„{_context.Entity.Name}“ wurde gespeichert.", Severity.Success);

            if (wasNew)
            {
                Navigation.NavigateTo($"/modules/factions/{_context.Entity.Id}");
                return;
            }

            if (_referencesPanel is not null)
            {
                await _referencesPanel.RefreshAsync();
            }
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_context is null)
        {
            return;
        }

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Fraktion löschen",
            $"„{_context.Entity.Name}“ wird mit Mitgliederliste, Feldwerten, individuellen Feldern und Sprites gelöscht. Die NPCs selbst bleiben erhalten.",
            yesText: "Löschen",
            cancelText: "Abbrechen");

        if (confirmed != true)
        {
            return;
        }

        await Factions.DeleteFactionAsync(_context.Entity.Id);
        Snackbar.Add("Fraktion gelöscht.", Severity.Success);
        Navigation.NavigateTo("/modules/factions");
    }

    /// <summary>
    /// Lädt nach einer Änderung an den Felddefinitionen neu und behält dabei, was in der Maske
    /// noch nicht gespeichert ist.
    /// </summary>
    private async Task ReloadKeepingChangesAsync()
    {
        if (_context is null)
        {
            return;
        }

        var entity = _context.Entity;
        var wasDirty = _dirty;

        var projectId = await Project.GetCurrentIdAsync();
        var reloaded = await Factions.LoadForEditAsync(projectId, entity.Id);

        if (reloaded is null)
        {
            _notFound = true;
            _context = null;
            return;
        }

        reloaded.Entity.Name = entity.Name;
        reloaded.Entity.Description = entity.Description;
        reloaded.Entity.ContentTypeId = entity.ContentTypeId;
        reloaded.Entity.Members = entity.Members;

        _context = reloaded;
        _dirty = wasDirty;
    }
}
