@page "/modules/localization"
@inject LocalizationService Localization
@inject ITranslationSuggester Suggester
@inject ProjectContext Project
@inject ModuleLabels Modules
@inject IUserPermissionsProvider PermissionsProvider
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject IStringLocalizer<LocalizationPage> L

@*
    Die Lokalisierung der Spielinhalte. Eine Seite für alle Module — dieselbe Überlegung wie bei
    der Massenbearbeitung: Übersetzt wird in Sitzungen quer über den Bestand, nicht Entität für
    Entität in zwanzig Masken.

    Die Ausgangssprache steht in den Inhalten selbst; hier stehen nur die Übersetzungen daneben.
*@

<PageTitle>@L["PageTitle"]</PageTitle>

<ModuleHeader Module="Module" Subtitle="@Subtitle" />

@if (_languages is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudGrid Spacing="3">
        @* -------------------------------------------------------------------- Sprachen *@
        <MudItem xs="12" md="5">
            <MudPaper Elevation="0" Class="gdm-panel pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudText Typo="Typo.overline" Color="Color.Secondary">@L["LanguagesHeading"]</MudText>
                    <MudSpacer />
                    @if (_permissions.CanWrite)
                    {
                        <MudButton Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="@(() => StartEdit(null))">
                            @L["AddLanguage"]
                        </MudButton>
                    }
                </MudStack>

                @if (_languages.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["NoLanguages"]</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            @foreach (var language in _languages)
                            {
                                <tr>
                                    <td class="gdm-mono">@language.Code</td>
                                    <td>
                                        @language.Name
                                        @if (language.IsSource)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">
                                                @L["SourceLanguage"]
                                            </MudChip>
                                        }
                                    </td>
                                    <td style="text-align:right;white-space:nowrap;">
                                        @if (_permissions.CanWrite)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Size="Size.Small"
                                                           OnClick="@(() => StartEdit(language))"
                                                           aria-label="@L["EditLanguage"]" />
                                            @if (!language.IsSource)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                               Size="Size.Small"
                                                               OnClick="@(() => DeleteLanguageAsync(language))"
                                                               aria-label="@L["DeleteLanguage"]" />
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }

                @if (_editing is not null)
                {
                    <MudDivider Class="my-4" />
                    <MudStack Spacing="2">
                        <MudTextField @bind-Value="_editing.Code"
                                      Label="@L["CodeLabel"]"
                                      HelperText="@L["CodeHelper"]"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                        <MudTextField @bind-Value="_editing.Name"
                                      Label="@L["NameLabel"]"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                        <MudSwitch T="bool" @bind-Value="_editing.IsSource" Color="Color.Primary" Label="@L["IsSourceLabel"]" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["IsSourceHelper"]</MudText>

                        <MudStack Row="true" Spacing="2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveLanguageAsync">
                                @L["SaveLanguage"]
                            </MudButton>
                            <MudButton OnClick="@(() => _editing = null)">@L["Cancel"]</MudButton>
                        </MudStack>
                    </MudStack>
                }
            </MudPaper>
        </MudItem>

        @* ----------------------------------------------------------------- Fortschritt *@
        <MudItem xs="12" md="7">
            <MudPaper Elevation="0" Class="gdm-panel pa-4">
                <MudText Typo="Typo.overline" Color="Color.Secondary">@L["ProgressHeading"]</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1 mb-3">@L["ProgressHint"]</MudText>

                @if (_progress is null)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else if (_progress.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["NoTargets"]</MudText>
                }
                else
                {
                    @foreach (var progress in _progress)
                    {
                        <div class="mb-3">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudText Typo="Typo.body2"><b>@progress.LanguageName</b></MudText>
                                <MudSpacer />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @L["ProgressCounts", progress.Translated, progress.Total, progress.Missing, progress.Stale]
                                </MudText>
                            </MudStack>
                            <MudProgressLinear Value="@progress.Percent" Color="Color.Primary" Class="mt-1" />
                        </div>
                    }
                }
            </MudPaper>
        </MudItem>

        @* ------------------------------------------------------------------ Arbeitsliste *@
        <MudItem xs="12">
            <MudPaper Elevation="0" Class="gdm-panel pa-4">
                <MudText Typo="Typo.overline" Color="Color.Secondary">@L["WorkHeading"]</MudText>

                <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mt-2 mb-3">
                    <MudSelect T="string"
                               Value="_languageCode"
                               ValueChanged="SelectLanguageAsync"
                               Label="@L["TargetLanguage"]"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Style="min-width:200px;">
                        @foreach (var language in _languages.Where(language => !language.IsSource))
                        {
                            <MudSelectItem T="string" Value="@language.Code">@language.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="string"
                               Value="_moduleKey"
                               ValueChanged="SelectModuleAsync"
                               Label="@L["ModuleLabel"]"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Style="min-width:200px;">
                        @foreach (var module in ContentModules)
                        {
                            <MudSelectItem T="string" Value="@module.Id">@Modules.Name(module)</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSwitch T="bool" Value="_openOnly" ValueChanged="ToggleOpenOnly" Color="Color.Primary" Label="@L["OpenOnly"]" />

                    <MudSpacer />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["RowCount", VisibleRows.Count]</MudText>
                </MudStack>

                @* ---------------------------------------------------------------- Tabelle *@
                @* Der Weg zu einem externen Übersetzer: XLIFF wäre der Standard, aber CSV ist
                   das, was jeder ohne Werkzeug öffnet. *@
                @if (_languageCode is not null && (_permissions.CanExport || _permissions.CanImport))
                {
                    <MudPaper Elevation="0" Class="gdm-panel pa-3 mb-3">
                        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["CsvHint"]</MudText>
                            <MudSpacer />

                            @if (_permissions.CanExport)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           StartIcon="@Icons.Material.Filled.Download"
                                           OnClick="DownloadCsv">
                                    @(_openOnly ? L["CsvDownloadOpen"] : L["CsvDownloadAll"])
                                </MudButton>
                            }

                            @if (_permissions.CanImport && _permissions.CanWrite)
                            {
                                <MudFileUpload T="IBrowserFile" FilesChanged="CsvFileSelected" Accept=".csv,.txt" Disabled="@_csvImporting">
                                    <CustomContent Context="upload">
                                        <MudButton Variant="Variant.Outlined"
                                                   StartIcon="@Icons.Material.Filled.UploadFile"
                                                   Disabled="@_csvImporting"
                                                   OnClick="@(() => upload.OpenFilePickerAsync())">
                                            @L["CsvSelectButton"]
                                        </MudButton>
                                    </CustomContent>
                                </MudFileUpload>

                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.FileUpload"
                                           Disabled="@(_csvFile is null || _csvImporting)"
                                           OnClick="ImportCsvAsync">
                                    @L["CsvImportButton"]
                                </MudButton>
                            }
                        </MudStack>

                        @if (_csvFile is not null)
                        {
                            <MudText Typo="Typo.body2" Class="mt-2">@_csvFile.Name</MudText>
                        }

                        @if (_csvResult is not null)
                        {
                            <MudAlert Severity="Severity.Success" Dense="true" Square="true" Class="mt-2">
                                @L["CsvImportedMessage", _csvResult.Created, _csvResult.Updated, _csvResult.Unchanged]
                            </MudAlert>

                            @foreach (var warning in _csvResult.Warnings)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true" Square="true" Class="mt-1">
                                    @warning
                                </MudAlert>
                            }
                        }
                    </MudPaper>
                }

                @if (_rowsLoading)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else if (_languageCode is null || _moduleKey is null)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["PickHint"]</MudText>
                }
                else if (VisibleRows.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["NothingOpen"]</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Elevation="0">
                        <thead>
                            <tr>
                                <th style="width:22%;">@L["ColumnOwner"]</th>
                                <th style="width:12%;">@L["ColumnSlot"]</th>
                                <th style="width:30%;">@L["ColumnSource"]</th>
                                <th>@L["ColumnTranslation"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in VisibleRows)
                            {
                                <tr>
                                    <td class="gdm-ellipsis">@row.OwnerName</td>
                                    <td>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@SlotLabel(row)</MudText>
                                        @if (row.IsStale)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                                                @L["Stale"]
                                            </MudChip>
                                        }
                                    </td>
                                    <td>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@row.SourceText</MudText>
                                        @if (row.IsStale)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Warning">
                                                @L["StaleHint", row.TranslatedFrom ?? string.Empty]
                                            </MudText>
                                        }
                                    </td>
                                    <td>
                                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                            <MudTextField T="string"
                                                          Value="@row.Text"
                                                          ValueChanged="@((string? text) => SaveRowAsync(row, text))"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Disabled="@(!_permissions.CanWrite)"
                                                          Placeholder="@L["TranslationPlaceholder"]"
                                                          Style="flex:1;" />

                                            @* Der Vorschlags-Knopf steht nur mit eingerichtetem
                                               Anbieter da — ein Knopf, der in eine Fehlermeldung
                                               führt, ist schlechter als keiner. *@
                                            @if (Suggester.IsConfigured && _permissions.CanWrite)
                                            {
                                                <MudTooltip Text="@L["SuggestTooltip", Suggester.ProviderName]">
                                                    <MudIconButton Icon="@Icons.Material.Filled.AutoAwesome"
                                                                   Size="Size.Small"
                                                                   Disabled="@_suggesting.Contains(RowKey(row))"
                                                                   aria-label="@L["SuggestAria"]"
                                                                   OnClick="@(() => SuggestAsync(row))" />
                                                </MudTooltip>
                                            }
                                        </MudStack>

                                        @* Ein Vorschlag ist ein Vorschlag: Er steht daneben, bis
                                           ihn ein Klick übernimmt — gespeichert wird dabei über
                                           dieselbe Je-Zelle-Speicherung wie beim Tippen. *@
                                        @if (_suggestions.TryGetValue(RowKey(row), out var suggestion))
                                        {
                                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mt-1">
                                                <MudText Typo="Typo.body2" Color="Color.Secondary" Style="flex:1;">
                                                    @suggestion
                                                </MudText>
                                                <MudTooltip Text="@L["AcceptSuggestion"]">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Check"
                                                                   Size="Size.Small"
                                                                   Color="Color.Success"
                                                                   aria-label="@L["AcceptSuggestion"]"
                                                                   OnClick="@(() => AcceptSuggestionAsync(row, suggestion))" />
                                                </MudTooltip>
                                                <MudTooltip Text="@L["DismissSuggestion"]">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                                   Size="Size.Small"
                                                                   aria-label="@L["DismissSuggestion"]"
                                                                   OnClick="@(() => _suggestions.Remove(RowKey(row)))" />
                                                </MudTooltip>
                                            </MudStack>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Localization);

    private UserPermissions _permissions = UserPermissions.Full;

    private List<ContentLanguage>? _languages;
    private List<TranslationProgress>? _progress;
    private ContentLanguage? _editing;

    private Guid _projectId;
    private string? _languageCode;
    private string? _moduleKey;
    private bool _openOnly = true;
    private bool _rowsLoading;
    private List<TranslationRow> _rows = [];

    /// <summary>Eine Tabelle ist Text und klein — anders als ein ZIP wird sie ganz gelesen.</summary>
    private const long MaxCsvSizeBytes = 32L * 1024 * 1024;

    private IBrowserFile? _csvFile;
    private CsvImportResult? _csvResult;
    private bool _csvImporting;

    private List<ModuleDefinition> ContentModules =>
    [
        .. ModuleRegistry.All
            .Where(module => module.Implemented
                && module.Group != ModuleGroup.Tools
                && _permissions.CanAccessModule(module.Id))
    ];

    /// <summary>„Nur Offenes“ heißt: fehlt ganz oder ist veraltet — beides ist Arbeit.</summary>
    private List<TranslationRow> VisibleRows =>
        _openOnly ? [.. _rows.Where(row => row.IsMissing || row.IsStale)] : _rows;

    private string Subtitle => _languages is null
        ? L["Loading"]
        : L["SubtitleCount", _languages.Count];

    protected override async Task OnInitializedAsync()
    {
        _permissions = await PermissionsProvider.GetCurrentAsync();
        await LoadLanguagesAsync();
    }

    private async Task LoadLanguagesAsync()
    {
        _projectId = await Project.GetCurrentIdAsync();
        var projectId = _projectId;

        _languages = await Localization.GetLanguagesAsync(projectId);
        _languageCode ??= _languages.FirstOrDefault(language => !language.IsSource)?.Code;
        _moduleKey ??= ContentModules.FirstOrDefault()?.Id;

        _progress = await Localization.GetProgressAsync(projectId);
    }

    // -------------------------------------------------------------------------- Sprachen

    private void StartEdit(ContentLanguage? language) =>
        _editing = language is null
            ? new ContentLanguage { Code = string.Empty, Name = string.Empty }
            : new ContentLanguage
            {
                Id = language.Id,
                Code = language.Code,
                Name = language.Name,
                IsSource = language.IsSource,
                SortOrder = language.SortOrder
            };

    private async Task SaveLanguageAsync()
    {
        if (_editing is null)
        {
            return;
        }

        try
        {
            var projectId = await Project.GetCurrentIdAsync();
            await Localization.SaveLanguageAsync(projectId, _editing);

            Snackbar.Add(L["LanguageSaved"], Severity.Success);
            _editing = null;
            await LoadLanguagesAsync();
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteLanguageAsync(ContentLanguage language)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteLanguageTitle"],
            L["DeleteLanguageMessage", language.Name],
            yesText: L["DeleteYes"],
            cancelText: L["Cancel"]);

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Localization.DeleteLanguageAsync(language.Id);
            Snackbar.Add(L["LanguageDeleted"], Severity.Success);

            if (_languageCode == language.Code)
            {
                _languageCode = null;
                _rows = [];
            }

            await LoadLanguagesAsync();
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    // ---------------------------------------------------------------------- Arbeitsliste

    private async Task SelectLanguageAsync(string? code)
    {
        _languageCode = code;
        await LoadRowsAsync();
    }

    private async Task SelectModuleAsync(string? moduleKey)
    {
        _moduleKey = moduleKey;
        await LoadRowsAsync();
    }

    private void ToggleOpenOnly(bool value) => _openOnly = value;

    private async Task LoadRowsAsync()
    {
        if (_languageCode is null || _moduleKey is null)
        {
            _rows = [];
            return;
        }

        _rowsLoading = true;
        try
        {
            var projectId = await Project.GetCurrentIdAsync();
            _rows = await Localization.GetRowsAsync(projectId, _moduleKey, _languageCode);
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _rows = [];
        }
        finally
        {
            _rowsLoading = false;
        }
    }

    /// <summary>
    /// Gespeichert wird je Zelle, nicht über einen Speichern-Knopf: Eine Übersetzungssitzung
    /// geht über hunderte Zeilen, und ein vergessener Klick verlöre sie alle.
    /// </summary>
    // ------------------------------------------------------------------- Vorschläge

    private readonly Dictionary<(Guid, string), string> _suggestions = [];
    private readonly HashSet<(Guid, string)> _suggesting = [];

    private static (Guid, string) RowKey(TranslationRow row) => (row.OwnerEntityId, row.Slot);

    private async Task SuggestAsync(TranslationRow row)
    {
        var key = RowKey(row);
        _suggesting.Add(key);

        try
        {
            var source = _languages?.FirstOrDefault(language => language.IsSource)?.Code;
            var suggestion = await Suggester.SuggestAsync(row.SourceText, source, _languageCode!);

            if (!string.IsNullOrWhiteSpace(suggestion))
            {
                _suggestions[key] = suggestion;
            }
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _suggesting.Remove(key);
        }
    }

    /// <summary>Übernimmt den Vorschlag — über dieselbe Je-Zelle-Speicherung wie beim Tippen.</summary>
    private async Task AcceptSuggestionAsync(TranslationRow row, string suggestion)
    {
        _suggestions.Remove(RowKey(row));
        await SaveRowAsync(row, suggestion);
    }

    private async Task SaveRowAsync(TranslationRow row, string? text)
    {
        try
        {
            var projectId = await Project.GetCurrentIdAsync();

            await Localization.SaveAsync(
                projectId, row.OwnerEntityId, row.OwnerModuleKey, row.Slot,
                _languageCode!, text, row.SourceText);

            // Die Zeile in der Liste mitziehen, statt alles neu zu laden — sonst sprünge die
            // Liste unter dem Cursor weg, sobald „nur Offenes“ eingeschaltet ist.
            var index = _rows.IndexOf(row);
            if (index >= 0)
            {
                _rows[index] = row with { Text = text, TranslatedFrom = row.SourceText };
            }

            _progress = await Localization.GetProgressAsync(projectId);
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    // ---------------------------------------------------------------------------- Tabelle

    /// <summary>
    /// Der Download läuft über einen Endpunkt und nicht über den Blazor-Kreis: Über SignalR
    /// lässt sich keine Datei ausliefern — dieselbe Regel wie beim Export.
    /// </summary>
    private void DownloadCsv() =>
        Nav.NavigateTo(
            $"/export/translations/{_projectId}/{_languageCode}?openOnly={(_openOnly ? "true" : "false")}",
            forceLoad: true);

    private void CsvFileSelected(IBrowserFile? file)
    {
        _csvFile = file;
        _csvResult = null;
    }

    private async Task ImportCsvAsync()
    {
        if (_csvFile is null || _languageCode is null)
        {
            return;
        }

        _csvImporting = true;

        try
        {
            await using var content = _csvFile.OpenReadStream(MaxCsvSizeBytes);
            using var reader = new StreamReader(content);

            _csvResult = await Localization.ImportCsvAsync(
                _projectId, _languageCode, await reader.ReadToEndAsync());

            _csvFile = null;

            // Die Arbeitsliste zeigt danach den neuen Stand — sonst stünde dort noch das,
            // was die Tabelle gerade ersetzt hat.
            await LoadRowsAsync();
            _progress = await Localization.GetProgressAsync(_projectId);
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _csvImporting = false;
        }
    }

    private string SlotLabel(TranslationRow row) => row.Slot switch
    {
        TranslationSlots.Name => L["SlotName"],
        TranslationSlots.Description => L["SlotDescription"],
        _ => row.SlotLabel
    };
}
