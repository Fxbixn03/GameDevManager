@page "/konto/benutzer"
@inject UserService Users
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider Authentication
@inject PasswordPolicySelection Policy
@inject IStringLocalizer<UserList> L

@*
    Die Benutzerverwaltung. Sichtbar nur für Verwalter — wer keiner ist, sieht den Hinweis
    statt der Liste. Feinere Rechte kennt das Tool nicht: Wer sich anmelden darf, darf jedes
    Projekt bearbeiten; unterschieden wird allein, wer Benutzer verwalten kann.
*@

<PageTitle>@L["PageTitle"]</PageTitle>

<div class="gdm-panel-head mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
        <div>
            <MudText Typo="Typo.h5">@L["Title"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Subtitle</MudText>
        </div>
        @if (_isAdministrator)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="@(() => EditAsync(null))">
                @L["NewUser"]
            </MudButton>
        }
    </MudStack>
</div>

@if (!_isAdministrator)
{
    <MudAlert Severity="Severity.Info">@L["NotAllowed"]</MudAlert>
}
else if (_users is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudPaper Elevation="0" Class="gdm-panel">
        <MudStack Spacing="0">
            @foreach (var user in _users)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="pa-3 gdm-field-row">
                    <MudIcon Icon="@(user.IsAdministrator ? Icons.Material.Filled.AdminPanelSettings : Icons.Material.Filled.Person)"
                             Color="@(user.IsDisabled ? Color.Secondary : Color.Default)"
                             Size="Size.Small" />

                    <div style="flex:1 1 auto;min-width:0;">
                        <MudText Typo="Typo.body1" Class="gdm-ellipsis"><b>@user.DisplayName</b></MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="gdm-mono">@user.UserName</MudText>
                    </div>

                    @if (user.IsAdministrator)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                            @L["Administrator"]
                        </MudChip>
                    }
                    @if (user.IsDisabled)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                            @L["Disabled"]
                        </MudChip>
                    }
                    @if (user.Role is { } role && !user.IsAdministrator)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                            @(user.OverridesRole ? L["RoleChipOverridden", role.Name] : role.Name)
                        </MudChip>
                    }
                    @if (!user.IsAdministrator && (user.Role is null || user.OverridesRole))
                    {
                        @if (!user.CanWrite)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary">
                                @L["ReadOnly"]
                            </MudChip>
                        }
                        @if (!user.CanExport)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary">
                                @L["NoExport"]
                            </MudChip>
                        }
                        @if (!user.CanImport)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary">
                                @L["NoImport"]
                            </MudChip>
                        }
                        @if (UserPermissions.ParseModuleKeys(user.AllowedModuleKeys) is { } modules)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary">
                                @L["ModuleCount", modules.Count]
                            </MudChip>
                        }
                    }

                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="min-width:150px;">
                        @(user.LastLoginAtUtc is { } last
                            ? L["LastLogin", last.ToLocalTime().ToString("dd.MM.yyyy HH:mm")].Value
                            : L["NeverLoggedIn"].Value)
                    </MudText>

                    <MudTooltip Text="@L["EditTooltip"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       OnClick="@(() => EditAsync(user))"
                                       aria-label="@L["EditAria", user.DisplayName]" />
                    </MudTooltip>
                    <MudTooltip Text="@L["DeleteTooltip"]">
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                       Size="Size.Small"
                                       Disabled="user.Id == _currentUserId"
                                       OnClick="@(() => DeleteAsync(user))"
                                       aria-label="@L["DeleteAria", user.DisplayName]" />
                    </MudTooltip>
                </MudStack>
            }
        </MudStack>
    </MudPaper>

    @* Rollen bündeln die vier Rechte — beim zehnten Konto setzt niemand zum zehnten Mal
       dieselben Häkchen. Geänderte Rollen gelten wie alle Rechte ab der nächsten Anmeldung. *@
    <MudPaper Elevation="0" Class="gdm-panel pa-4 mt-6">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudText Typo="Typo.overline" Color="Color.Secondary">@L["RolesTitle"]</MudText>
            <MudButton StartIcon="@Icons.Material.Filled.Add"
                       Size="Size.Small"
                       OnClick="@(() => EditRoleAsync(null))">
                @L["NewRole"]
            </MudButton>
        </MudStack>

        @if (_roles is not { Count: > 0 })
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["NoRolesHint"]</MudText>
        }
        else
        {
            @foreach (var role in _roles)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="gdm-field-row py-2">
                    <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" Color="Color.Secondary" />
                    <MudText Typo="Typo.body2" Style="flex:1 1 auto;min-width:0;" Class="gdm-ellipsis">
                        <b>@role.Name</b>
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@RoleRights(role)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="gdm-mono">
                        @L["RoleMembers", role.MemberCount]
                    </MudText>
                    <MudTooltip Text="@L["EditRoleTooltip"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       OnClick="@(() => EditRoleAsync(role))"
                                       aria-label="@L["EditRoleAria", role.Name]" />
                    </MudTooltip>
                    <MudTooltip Text="@L["DeleteRoleTooltip"]">
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteRoleAsync(role))"
                                       aria-label="@L["DeleteRoleAria", role.Name]" />
                    </MudTooltip>
                </MudStack>
            }
        }
    </MudPaper>

    @* Die Passwortrichtlinie der Installation — sie gilt für neue Passwörter; bestehende
       bleiben gültig, geprüft wird erst beim nächsten Setzen. *@
    <MudPaper Elevation="0" Class="gdm-panel pa-4 mt-6">
        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["PolicyTitle"]</MudText>

        <MudStack Spacing="3">
            <MudSwitch @bind-Value="_passwordsDisabled" Color="Color.Warning" Label="@L["PolicyDisabledLabel"]" />

            @if (_passwordsDisabled)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">@L["PolicyDisabledWarning"]</MudAlert>
            }

            <MudNumericField @bind-Value="_minimumLength"
                             T="int"
                             Label="@L["PolicyMinimumLengthLabel"]"
                             HelperText="@L["PolicyMinimumLengthHelper"]"
                             Variant="Variant.Outlined"
                             Min="PasswordPolicy.MinimumLengthFloor"
                             Max="PasswordPolicy.MinimumLengthCeiling"
                             Disabled="_passwordsDisabled"
                             Style="max-width:280px;" />

            <MudSwitch @bind-Value="_requireDigit"
                       Color="Color.Primary"
                       Label="@L["PolicyRequireDigitLabel"]"
                       Disabled="_passwordsDisabled" />

            <MudSwitch @bind-Value="_requireSpecial"
                       Color="Color.Primary"
                       Label="@L["PolicyRequireSpecialLabel"]"
                       Disabled="_passwordsDisabled" />

            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["PolicyHint"]</MudText>

            <div>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           data-gdm-save
                           OnClick="SavePolicyAsync">
                    @L["PolicySave"]
                </MudButton>
            </div>
        </MudStack>
    </MudPaper>
}

@code {
    private List<UserRow>? _users;
    private List<UserRoleRow>? _roles;
    private bool _isAdministrator;
    private Guid? _currentUserId;

    private int _minimumLength;
    private bool _requireDigit;
    private bool _requireSpecial;
    private bool _passwordsDisabled;

    private string Subtitle => _users is null ? L["Loading"] : L["SubtitleCount", _users.Count];

    protected override async Task OnInitializedAsync()
    {
        var state = await Authentication.GetAuthenticationStateAsync();
        _isAdministrator = state.User.IsAdministrator();
        _currentUserId = state.User.UserId();

        var policy = Policy.Current;
        _minimumLength = policy.MinimumLength;
        _requireDigit = policy.RequireDigit;
        _requireSpecial = policy.RequireSpecialCharacter;
        _passwordsDisabled = policy.PasswordsDisabled;

        if (_isAdministrator)
        {
            await LoadAsync();
        }
    }

    private async Task SavePolicyAsync()
    {
        await Policy.SetAsync(new PasswordPolicy(_minimumLength, _requireDigit, _requireSpecial, _passwordsDisabled));
        Snackbar.Add(L["PolicySaved"], Severity.Success);
    }

    private async Task LoadAsync()
    {
        _users = await Users.GetUsersAsync();
        _roles = await Users.GetRolesAsync();
    }

    /// <summary>Kurzfassung der Rollenrechte für die Liste — nur, was eingeschränkt ist.</summary>
    private string RoleRights(UserRoleRow role)
    {
        var parts = new List<string>();

        if (!role.CanWrite)
        {
            parts.Add(L["ReadOnly"]);
        }

        if (!role.CanExport)
        {
            parts.Add(L["NoExport"]);
        }

        if (!role.CanImport)
        {
            parts.Add(L["NoImport"]);
        }

        if (UserPermissions.ParseModuleKeys(role.AllowedModuleKeys) is { } modules)
        {
            parts.Add(L["ModuleCount", modules.Count]);
        }

        return parts.Count == 0 ? L["RoleAllRights"] : string.Join(" · ", parts);
    }

    private async Task EditRoleAsync(UserRoleRow? role)
    {
        var parameters = new DialogParameters<RoleDialog> { { dialog => dialog.Role, role } };

        var reference = await Dialogs.ShowAsync<RoleDialog>(
            role is null ? L["NewRole"] : L["EditRoleTitle", role.Name].Value,
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });

        if (await reference.Result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task DeleteRoleAsync(UserRoleRow role)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteRoleConfirmTitle"],
            L["DeleteRoleConfirmMessage", role.Name, role.MemberCount],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Users.DeleteRoleAsync(role.Id);
            Snackbar.Add(L["RoleDeletedMessage", role.Name], Severity.Success);
            await LoadAsync();
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task EditAsync(UserRow? user)
    {
        var parameters = new DialogParameters<UserDialog>
        {
            { dialog => dialog.User, user },
            { dialog => dialog.Roles, _roles ?? [] }
        };

        var reference = await Dialogs.ShowAsync<UserDialog>(
            user is null ? L["NewUser"] : L["EditTitle", user.DisplayName].Value,
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });

        if (await reference.Result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(UserRow user)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", user.DisplayName],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Users.DeleteUserAsync(user.Id);
            Snackbar.Add(L["DeletedMessage", user.DisplayName], Severity.Success);
            await LoadAsync();
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
