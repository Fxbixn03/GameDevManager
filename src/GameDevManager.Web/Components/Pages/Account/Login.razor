@page "/konto/anmelden"
@layout StartLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject UserService Users
@inject NavigationManager Navigation
@inject PasswordPolicySelection Policy
@inject IStringLocalizer<Login> L

@*
    Die Anmeldung. Bewusst statisch gerendert (ExcludeFromInteractiveRouting): Ein Cookie lässt
    sich nur während einer echten HTTP-Antwort setzen — über die SignalR-Verbindung von Blazor
    Server gibt es keine Antwort, in die es hineinpasste. Deshalb ein gewöhnliches Formular mit
    Postback statt einer interaktiven Maske.

    Aus demselben Grund einfache InputText-Felder statt MudBlazor-Eingaben: Nur echte
    <input name="…">-Elemente kommen beim Postback wieder an.
*@

<PageTitle>@L["PageTitle"]</PageTitle>

<div class="gdm-auth-screen">
    <div class="gdm-auth-card">
        <div class="gdm-auth-brand">
            <MudIcon Icon="@Icons.Material.Filled.SportsEsports" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h5">@L["AppName"]</MudText>
        </div>

        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">@L["Intro"]</MudText>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
        }

        @if (LoggedOut)
        {
            <MudAlert Severity="Severity.Success" Dense="true" Class="mb-4">@L["LoggedOut"]</MudAlert>
        }

        <EditForm Model="Input" FormName="login" OnValidSubmit="SignInAsync">
            <DataAnnotationsValidator />

            <label class="gdm-auth-label" for="userName">@L["UserNameLabel"]</label>
            <InputText id="userName" @bind-Value="Input.UserName" class="gdm-auth-input" autocomplete="username" />

            @if (!Policy.Current.PasswordsDisabled)
            {
                <label class="gdm-auth-label" for="password">@L["PasswordLabel"]</label>
                <InputText id="password" type="password" @bind-Value="Input.Password"
                           class="gdm-auth-input" autocomplete="current-password" />
            }

            <label class="gdm-auth-remember">
                <InputCheckbox id="rememberMe" @bind-Value="Input.RememberMe" />
                @L["RememberMe"]
            </label>

            <button type="submit" class="gdm-auth-submit">@L["SignIn"]</button>
        </EditForm>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Bewusst kein Auto-Property mit Initializer (BL0008): Das Modellbinding setzt diesen
    // Parameter beim Postback und schriebe null hinein, wenn die Bindung nichts hergibt — der
    // Initializer liefe kein zweites Mal, und das Markup liefe in eine NullReferenceException.
    // Das Backing-Feld hält deshalb immer ein Objekt bereit.
    private LoginInput _input = new();

    [SupplyParameterFromForm]
    private LoginInput Input
    {
        get => _input;
        set => _input = value ?? new();
    }

    /// <summary>Wohin es nach der Anmeldung weitergeht — gesetzt von der Umleitung.</summary>
    [SupplyParameterFromQuery(Name = "ziel")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "abgemeldet")]
    public bool LoggedOut { get; set; }

    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        // Vor dem ersten Konto führt kein Weg an der Ersteinrichtung vorbei — ein
        // ausgeliefertes Standardpasswort gibt es bewusst nicht.
        if (!await Users.HasAnyUserAsync())
        {
            Navigation.NavigateTo("/konto/einrichten");
        }
    }

    private async Task SignInAsync()
    {
        var user = await Users.AuthenticateAsync(Input.UserName ?? string.Empty, Input.Password ?? string.Empty);

        if (user is null)
        {
            // Bewusst eine Meldung für beide Fälle: Ein „diesen Benutzer gibt es nicht“ wäre
            // eine Auskunft darüber, welche Konten bestehen.
            _error = Policy.Current.PasswordsDisabled ? L["FailedUserNameOnly"] : L["Failed"];
            return;
        }

        await HttpContext.SignInWithUserAsync(user, Input.RememberMe);

        // forceLoad wäre hier falsch: Wir sind mitten in der Antwort, die das Cookie setzt.
        Navigation.NavigateTo(SafeReturnUrl(), forceLoad: false);
    }

    /// <summary>
    /// Nur Pfade innerhalb der Anwendung. Ein „ziel“ aus der Adresszeile darf nicht auf eine
    /// fremde Seite führen — das wäre eine offene Weiterleitung.
    /// </summary>
    private string SafeReturnUrl() =>
        !string.IsNullOrWhiteSpace(ReturnUrl)
            && ReturnUrl.StartsWith('/')
            && !ReturnUrl.StartsWith("//", StringComparison.Ordinal)
            ? ReturnUrl
            : "/dashboard";

    private sealed class LoginInput
    {
        [Required]
        public string? UserName { get; set; }

        // Kein [Required]: Bei deaktivierten Passwörtern gibt es das Feld nicht — ein leeres
        // Passwort bei aktiven Passwörtern weist AuthenticateAsync ohnehin ab.
        public string? Password { get; set; }

        // Vorgabe „aus“: Ein nicht angehakter Haken kommt beim Postback gar nicht an und
        // ließe eine Vorgabe „an“ nie wieder abwählen.
        public bool RememberMe { get; set; }
    }
}
