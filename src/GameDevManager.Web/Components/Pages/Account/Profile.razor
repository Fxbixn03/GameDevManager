@page "/konto"
@inject UserService Users
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider Authentication
@inject PasswordPolicySelection Policy
@inject IMailSender Mail
@inject IStringLocalizer<Profile> L

@*
    Das eigene Konto: Anzeigename und Passwort. Das Passwort ändert man nur gegen das alte —
    auch der Verwalter, der es bei anderen ohne setzen darf.
*@

<PageTitle>@L["PageTitle"]</PageTitle>

<div class="gdm-panel-head mb-4">
    <MudText Typo="Typo.h5">@L["Title"]</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary">@Subtitle</MudText>
</div>

@if (_user is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudGrid Spacing="4">
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Class="gdm-panel pa-4">
                <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionProfile"]</MudText>

                <MudStack Spacing="4">
                    <MudTextField @bind-Value="_displayName"
                                  T="string"
                                  Label="@L["DisplayNameLabel"]"
                                  HelperText="@L["DisplayNameHelper"]"
                                  Variant="Variant.Outlined"
                                  Immediate="true" />

                    <MudTextField Value="@_user.UserName"
                                  T="string"
                                  Label="@L["UserNameLabel"]"
                                  Variant="Variant.Outlined"
                                  Disabled="true" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               data-gdm-save
                               OnClick="SaveProfileAsync">
                        @L["SaveProfile"]
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Class="gdm-panel pa-4">
                <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionPassword"]</MudText>

                @if (Policy.Current.PasswordsDisabled)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">@L["PasswordsDisabledInfo"]</MudAlert>
                }
                else
                {
                <MudStack Spacing="4">
                    <MudTextField @bind-Value="_currentPassword"
                                  T="string"
                                  Label="@L["CurrentPasswordLabel"]"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password" />

                    <MudTextField @bind-Value="_newPassword"
                                  T="string"
                                  Label="@L["NewPasswordLabel"]"
                                  HelperText="@L["NewPasswordHelper", Policy.Current.MinimumLength]"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password" />

                    <MudTextField @bind-Value="_confirmPassword"
                                  T="string"
                                  Label="@L["ConfirmPasswordLabel"]"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Key"
                               OnClick="ChangePasswordAsync">
                        @L["ChangePassword"]
                    </MudButton>

                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["PasswordHint"]</MudText>
                </MudStack>
                }
            </MudPaper>
        </MudItem>
        @* ------------------------------------------------------ Benachrichtigungen *@
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Class="gdm-panel pa-4">
                <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionNotifications"]</MudText>

                @if (!Mail.IsConfigured)
                {
                    @* Die Einstellungen bleiben trotzdem bedienbar: Sie gelten, sobald ein
                       Verwalter SMTP einrichtet — niemand muss danach alle Konten abklappern. *@
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">@L["MailNotConfigured"]</MudAlert>
                }

                <MudStack Spacing="3">
                    <MudTextField @bind-Value="_email"
                                  T="string"
                                  Label="@L["EmailLabel"]"
                                  HelperText="@L["EmailHelper"]"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email"
                                  Clearable="true" />

                    <MudSwitch @bind-Value="_notifyAssignment"
                               Color="Color.Primary"
                               Label="@L["NotifyAssignmentLabel"]" />
                    <MudSwitch @bind-Value="_notifyComment"
                               Color="Color.Primary"
                               Label="@L["NotifyCommentLabel"]" />
                    <MudSwitch @bind-Value="_notifyReview"
                               Color="Color.Primary"
                               Label="@L["NotifyReviewLabel"]" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveNotificationsAsync">
                        @L["SaveNotifications"]
                    </MudButton>

                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NotificationsHint"]</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>

        @* --------------------------------------------------------- Zweiter Faktor *@
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Class="gdm-panel pa-4">
                <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionTwoFactor"]</MudText>

                @if (_user.HasTwoFactor && _setupSecret is null)
                {
                    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">@L["TwoFactorActive"]</MudAlert>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">@L["DisableHint"]</MudText>

                    <MudTextField @bind-Value="_code"
                                  T="string"
                                  Label="@L["CodeLabel"]"
                                  Variant="Variant.Outlined"
                                  Immediate="true" />

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               Class="mt-3"
                               Disabled="@string.IsNullOrWhiteSpace(_code)"
                               OnClick="DisableTwoFactorAsync">
                        @L["Disable"]
                    </MudButton>
                }
                else if (_setupSecret is null)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">@L["TwoFactorHint"]</MudText>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Security"
                               OnClick="StartTwoFactorAsync">
                        @L["Enable"]
                    </MudButton>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mb-2">@L["SetupStep1"]</MudText>

                    @* Das Geheimnis im Klartext statt als QR-Code: Ein QR-Code brauchte eine
                       Bildbibliothek, und jede Authenticator-App nimmt auch die Eingabe von
                       Hand — dieselbe Abwägung wie beim ImageDimensionReader. *@
                    <MudTextField Value="@_setupSecret"
                                  T="string"
                                  Label="@L["SecretLabel"]"
                                  Variant="Variant.Outlined"
                                  ReadOnly="true"
                                  Class="gdm-mono mb-2" />

                    <MudTextField Value="@_setupUri"
                                  T="string"
                                  Label="@L["UriLabel"]"
                                  HelperText="@L["UriHelper"]"
                                  Variant="Variant.Outlined"
                                  ReadOnly="true"
                                  Lines="2"
                                  Class="gdm-mono mb-4" />

                    <MudText Typo="Typo.body2" Class="mb-2">@L["SetupStep2"]</MudText>

                    <MudTextField @bind-Value="_code"
                                  T="string"
                                  Label="@L["CodeLabel"]"
                                  Variant="Variant.Outlined"
                                  Immediate="true" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Class="mt-3"
                               Disabled="@string.IsNullOrWhiteSpace(_code)"
                               OnClick="ConfirmTwoFactorAsync">
                        @L["Confirm"]
                    </MudButton>
                }

                @if (_recoveryCodes.Count > 0)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-4">
                        @L["RecoveryHint"]
                    </MudAlert>

                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 mt-2 gdm-mono">
                        @* Die Laufvariable heißt nicht „code“: @code ist in Razor die
                           Direktive für den Codeblock. *@
                        @foreach (var recovery in _recoveryCodes)
                        {
                            <MudText Typo="Typo.body2">@recovery</MudText>
                        }
                    </MudPaper>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private UserRow? _user;
    private string? _displayName;
    private string? _currentPassword;
    private string? _newPassword;
    private string? _confirmPassword;

    private string? _setupSecret;
    private string? _setupUri;
    private string? _code;
    private List<string> _recoveryCodes = [];

    private string? _email;
    private bool _notifyAssignment = true;
    private bool _notifyComment = true;
    private bool _notifyReview = true;

    private string Subtitle => _user is null ? L["Loading"] : L["SubtitleName", _user.UserName];

    protected override async Task OnInitializedAsync()
    {
        var state = await Authentication.GetAuthenticationStateAsync();

        if (state.User.UserId() is { } id)
        {
            _user = await Users.GetUserAsync(id);
            _displayName = _user?.DisplayName;
            _email = _user?.Email;
            _notifyAssignment = _user?.NotifyOnAssignment ?? true;
            _notifyComment = _user?.NotifyOnComment ?? true;
            _notifyReview = _user?.NotifyOnReview ?? true;
        }
    }

    // ---------------------------------------------------------- Benachrichtigungen

    private async Task SaveNotificationsAsync()
    {
        if (_user is null)
        {
            return;
        }

        try
        {
            await Users.UpdateOwnMailSettingsAsync(
                _user.Id, _email, _notifyAssignment, _notifyComment, _notifyReview);

            Snackbar.Add(L["NotificationsSaved"], Severity.Success);
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    // ------------------------------------------------------------- Zweiter Faktor

    private async Task StartTwoFactorAsync()
    {
        if (_user is null)
        {
            return;
        }

        (_setupSecret, _setupUri) = await Users.StartTwoFactorAsync(_user.Id);
        _code = null;
        _recoveryCodes = [];
    }

    private async Task ConfirmTwoFactorAsync()
    {
        if (_user is null)
        {
            return;
        }

        try
        {
            // Die Codes stehen genau einmal im Klartext da — gespeichert werden nur Hashes.
            _recoveryCodes = await Users.ConfirmTwoFactorAsync(_user.Id, _code ?? string.Empty);

            _setupSecret = null;
            _setupUri = null;
            _code = null;
            _user = await Users.GetUserAsync(_user.Id);

            Snackbar.Add(L["TwoFactorEnabled"], Severity.Success);
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DisableTwoFactorAsync()
    {
        if (_user is null)
        {
            return;
        }

        try
        {
            await Users.DisableTwoFactorAsync(_user.Id, _code ?? string.Empty);

            _code = null;
            _recoveryCodes = [];
            _user = await Users.GetUserAsync(_user.Id);

            Snackbar.Add(L["TwoFactorDisabled"], Severity.Success);
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SaveProfileAsync()
    {
        if (_user is null)
        {
            return;
        }

        try
        {
            // Verwalterrecht und Sperre bleiben, wie sie sind — sie gehören nicht ins eigene Profil.
            await Users.UpdateUserAsync(_user.Id, _displayName ?? string.Empty, _user.IsAdministrator, _user.IsDisabled);
            Snackbar.Add(L["ProfileSaved"], Severity.Success);
            Snackbar.Add(L["ReloadHint"], Severity.Info);
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ChangePasswordAsync()
    {
        if (_user is null)
        {
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            Snackbar.Add(L["PasswordMismatch"], Severity.Error);
            return;
        }

        try
        {
            await Users.ChangeOwnPasswordAsync(
                _user.Id, _currentPassword ?? string.Empty, _newPassword ?? string.Empty);

            _currentPassword = _newPassword = _confirmPassword = null;
            Snackbar.Add(L["PasswordChanged"], Severity.Success);
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
