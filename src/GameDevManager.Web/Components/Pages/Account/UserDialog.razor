@inject UserService Users
@inject ISnackbar Snackbar
@inject PasswordPolicySelection Policy
@inject ModuleLabels Modules
@inject IStringLocalizer<UserDialog> L

@*
    Anlegen und Ändern eines Benutzers. Das Passwort steht getrennt: Beim Anlegen ist es
    Pflicht, beim Ändern setzt ein leeres Feld es bewusst nicht zurück — sonst löschte jedes
    Umbenennen nebenbei das Passwort.

    Die Berechtigungen (schreiben, Export, Import, Module) stehen nur Nicht-Verwaltern offen —
    Verwalter haben immer alles, die Schalter wären für sie Attrappen. Geänderte Rechte wandern
    als Ansprüche ins Anmelde-Cookie und gelten deshalb ab der nächsten Anmeldung.
*@

<MudDialog>
    <DialogContent>
        <MudStack Spacing="4">
            <MudTextField @bind-Value="_displayName"
                          T="string"
                          Label="@L["DisplayNameLabel"]"
                          HelperText="@L["DisplayNameHelper"]"
                          Variant="Variant.Outlined"
                          Immediate="true" />

            <MudTextField @bind-Value="_userName"
                          T="string"
                          Label="@L["UserNameLabel"]"
                          HelperText="@L["UserNameHelper"]"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Disabled="!IsNew" />

            @if (!Policy.Current.PasswordsDisabled)
            {
                <MudTextField @bind-Value="_password"
                              T="string"
                              Label="@(IsNew ? L["PasswordLabel"].Value : L["NewPasswordLabel"].Value)"
                              HelperText="@(IsNew ? L["PasswordHelper", Policy.Current.MinimumLength].Value : L["NewPasswordHelper"].Value)"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password" />
            }

            <MudSwitch @bind-Value="_isAdministrator" Color="Color.Primary" Label="@L["AdministratorLabel"]" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["AdministratorHelper"]</MudText>

            @if (!IsNew)
            {
                <MudSwitch @bind-Value="_isDisabled" Color="Color.Warning" Label="@L["DisabledLabel"]" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["DisabledHelper"]</MudText>
            }

            <MudDivider />
            <MudText Typo="Typo.overline" Color="Color.Secondary">@L["PermissionsTitle"]</MudText>

            @if (_isAdministrator)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["AdministratorHasAll"]</MudText>
            }
            else
            {
                @* Die Rolle ist die Vorgabe; abgewichen wird ausdrücklich — sonst zeigten
                   die Schalter etwas, das gar nicht gilt. *@
                @if (Roles.Count > 0)
                {
                    <MudSelect T="Guid?"
                               @bind-Value="_roleId"
                               Label="@L["RoleLabel"]"
                               HelperText="@L["RoleHelper"]"
                               Variant="Variant.Outlined"
                               Dense="true">
                        <MudSelectItem T="Guid?" Value="@((Guid?)null)">@L["NoRole"]</MudSelectItem>
                        @foreach (var role in Roles)
                        {
                            <MudSelectItem T="Guid?" Value="@((Guid?)role.Id)">@role.Name</MudSelectItem>
                        }
                    </MudSelect>

                    @if (_roleId is not null)
                    {
                        <MudSwitch @bind-Value="_overridesRole" Color="Color.Primary" Label="@L["OverrideRoleLabel"]" />
                    }
                }

                @if (_roleId is not null && !_overridesRole)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@RoleSummary</MudText>
                }
                else
                {
                <MudSwitch @bind-Value="_canWrite" Color="Color.Primary" Label="@L["CanWriteLabel"]" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["CanWriteHelper"]</MudText>

                <MudSwitch @bind-Value="_canExport" Color="Color.Primary" Label="@L["CanExportLabel"]" />

                <MudSwitch @bind-Value="_canImport" Color="Color.Primary" Label="@L["CanImportLabel"]" />
                @if (_canImport && !_canWrite)
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning">@L["ImportNeedsWriteHint"]</MudText>
                }

                <MudSwitch @bind-Value="_restrictModules" Color="Color.Primary" Label="@L["RestrictModulesLabel"]" />
                @if (_restrictModules)
                {
                    <MudSelect T="string"
                               MultiSelection="true"
                               @bind-SelectedValues="_selectedModules"
                               Label="@L["ModulesLabel"]"
                               HelperText="@L["ModulesHelper"]"
                               Variant="Variant.Outlined"
                               Dense="true">
                        @foreach (var module in ModuleRegistry.All.Where(m => m.Implemented))
                        {
                            <MudSelectItem T="string" Value="@module.Id">@Modules.Name(module)</MudSelectItem>
                        }
                    </MudSelect>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["AllModulesHint"]</MudText>
                }
                }
            }

            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["PermissionsTakeEffectHint"]</MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" OnClick="SaveAsync">
            @L["Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary><c>null</c> heißt „neuer Benutzer“.</summary>
    [Parameter]
    public UserRow? User { get; set; }

    /// <summary>Die wählbaren Rollen — leer, wenn noch keine angelegt sind.</summary>
    [Parameter]
    public List<UserRoleRow> Roles { get; set; } = [];

    private string? _displayName;
    private string? _userName;
    private string? _password;
    private bool _isAdministrator;
    private bool _isDisabled;
    private bool _canWrite = true;
    private bool _canExport = true;
    private bool _canImport = true;
    private bool _restrictModules;
    private IReadOnlyCollection<string> _selectedModules = [];
    private Guid? _roleId;
    private bool _overridesRole;
    private bool _saving;

    private bool IsNew => User is null;

    protected override void OnInitialized()
    {
        _displayName = User?.DisplayName;
        _userName = User?.UserName;
        _isAdministrator = User?.IsAdministrator ?? false;
        _isDisabled = User?.IsDisabled ?? false;
        _canWrite = User?.CanWrite ?? true;
        _canExport = User?.CanExport ?? true;
        _canImport = User?.CanImport ?? true;

        var allowed = UserPermissions.ParseModuleKeys(User?.AllowedModuleKeys);
        _restrictModules = allowed is not null;
        _selectedModules = allowed?.ToList() ?? [];

        _roleId = User?.Role?.Id;
        _overridesRole = User?.OverridesRole ?? false;
    }

    /// <summary>Was die gewählte Rolle erlaubt — damit der Dialog nicht schweigt, was gilt.</summary>
    private string RoleSummary
    {
        get
        {
            var role = Roles.FirstOrDefault(entry => entry.Id == _roleId);
            if (role is null)
            {
                return string.Empty;
            }

            var modules = UserPermissions.ParseModuleKeys(role.AllowedModuleKeys);

            return L["RoleSummary",
                YesNo(role.CanWrite),
                YesNo(role.CanExport),
                YesNo(role.CanImport),
                modules is null ? L["RoleSummaryAllModules"].Value : modules.Count.ToString()];
        }
    }

    private string YesNo(bool value) => value ? L["Yes"] : L["No"];

    /// <summary>
    /// Die Modulliste zum Speichern: <c>null</c> heißt alle. Eine Einschränkung ganz ohne
    /// gewähltes Modul wäre ein Konto, das nichts mehr sieht — sie zählt als „alle“.
    /// </summary>
    private string? AllowedModuleKeys =>
        _restrictModules && _selectedModules.Count > 0
            ? string.Join(",", _selectedModules)
            : null;

    private async Task SaveAsync()
    {
        _saving = true;

        try
        {
            // Für Verwalter zählen die Spalten nicht — sie werden auf „alles erlaubt“
            // gespeichert, damit kein überraschender Rest übrig bleibt, falls das
            // Verwalterrecht später wieder entzogen wird.
            var canWrite = _isAdministrator || _canWrite;
            var canExport = _isAdministrator || _canExport;
            var canImport = _isAdministrator || _canImport;
            var allowedModules = _isAdministrator ? null : AllowedModuleKeys;

            if (User is null)
            {
                await Users.CreateUserAsync(
                    _userName ?? string.Empty,
                    _displayName ?? string.Empty,
                    _password ?? string.Empty,
                    _isAdministrator,
                    canWrite,
                    canExport,
                    canImport,
                    allowedModules,
                    _roleId,
                    _overridesRole);
            }
            else
            {
                await Users.UpdateUserAsync(
                    User.Id,
                    _displayName ?? string.Empty,
                    _isAdministrator,
                    _isDisabled,
                    canWrite,
                    canExport,
                    canImport,
                    allowedModules,
                    _roleId,
                    _overridesRole);

                // Ein leeres Feld lässt das Passwort stehen — nur ein eingetragenes ersetzt es.
                if (!string.IsNullOrWhiteSpace(_password))
                {
                    await Users.SetPasswordAsync(User.Id, _password);
                }
            }

            Snackbar.Add(L["SavedMessage", _displayName ?? _userName ?? string.Empty], Severity.Success);
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => Dialog.Cancel();
}
