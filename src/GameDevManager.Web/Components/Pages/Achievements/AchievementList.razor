@page "/modules/achievements"
@inject AchievementService Achievements
@inject ContentTypeService ContentTypes
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IStringLocalizer<AchievementList> L

<PageTitle>@L["PageTitle"]</PageTitle>

<ModuleHeader Module="Module" Subtitle="@Subtitle">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Style"
                   Href="/modules/achievements/arten">
            @L["TypesButton"]
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/modules/achievements/neu">
            @L["NewAchievement"]
        </MudButton>
    </Actions>
</ModuleHeader>

@if (_achievements is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_achievements.Count == 0)
{
    <div class="gdm-empty">
        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
        <MudText Typo="Typo.h6">@L["EmptyTitle"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            @L["EmptyHint"]
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/modules/achievements/neu">
            @L["FirstAchievement"]
        </MudButton>
    </div>
}
else
{
    var filtered = Filtered;

    <MudPaper Elevation="0" Class="gdm-panel pa-4 mb-4">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_search"
                          Placeholder="@L["SearchPlaceholder"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="max-width:360px;" />

            <MudSelect T="Guid?"
                       @bind-Value="_typeFilter"
                       Label="@L["TypeFilterLabel"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="max-width:220px;">
                @foreach (var type in _types)
                {
                    <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSpacer />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["FilterCount", filtered.Count, _achievements.Count]</MudText>
        </MudStack>
    </MudPaper>

    @if (filtered.Count == 0)
    {
        <MudPaper Elevation="0" Class="gdm-panel pa-4">
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["NoRecords"]</MudText>
        </MudPaper>
    }
    else
    {
        <div class="gdm-item-grid">
            @foreach (var achievement in filtered)
            {
                <EntityContextMenu ModuleKey="@Module.Id"
                                   EntityId="achievement.Id"
                                   Name="@achievement.Name"
                                   EditRoute="/modules/achievements"
                                   OnDelete="@(() => DeleteAsync(achievement))">
                    <MudPaper Elevation="0" Class="gdm-panel gdm-card-link">
                        <MudLink Href="@($"/modules/achievements/{achievement.Id}")" Underline="Underline.None">
                            <AssetThumbnail AssetId="achievement.PrimaryAssetId"
                                            Class="gdm-item-tile"
                                            Alt="@achievement.Name"
                                            FallbackIcon="@Icons.Material.Filled.EmojiEvents" />
                        </MudLink>

                        <div class="pa-3">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                                <MudLink Href="@($"/modules/achievements/{achievement.Id}")" Typo="Typo.body1" Class="gdm-ellipsis">
                                    <b>@achievement.Name</b>
                                </MudLink>
                                <EntityDuplicateButton ModuleKey="@Module.Id"
                                                       EntityId="achievement.Id"
                                                       Name="@achievement.Name"
                                                       EditRoute="/modules/achievements" />
                                <MudTooltip Text="@L["DeleteTooltip"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                   Size="Size.Small"
                                                   OnClick="@(() => DeleteAsync(achievement))"
                                                   aria-label="@L["DeleteAria", achievement.Name]" />
                                </MudTooltip>
                            </MudStack>

                            @if (!string.IsNullOrWhiteSpace(achievement.Description))
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="gdm-ellipsis">
                                    @achievement.Description
                                </MudText>
                            }

                            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-2">
                                @if (achievement.IsSecret)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@L["SecretChip"]</MudChip>
                                }
                                @if (!achievement.HasUnlockCondition)
                                {
                                    <MudTooltip Text="@L["NoUnlockTooltip"]">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning">
                                            @L["NoUnlockChip"]
                                        </MudChip>
                                    </MudTooltip>
                                }
                                @if (achievement.TypeName is null)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NoType"]</MudText>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@achievement.TypeName</MudChip>
                                }
                            </MudStack>

                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                @L["UpdatedAt", achievement.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")]
                            </MudText>
                        </div>
                    </MudPaper>
                </EntityContextMenu>
            }
        </div>
    }
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Achievements);

    private List<AchievementListRow>? _achievements;
    private List<ContentType> _types = [];
    private string? _search;
    private Guid? _typeFilter;

    private string Subtitle => _achievements is null
        ? L["Loading"]
        : L["SubtitleCount", _achievements.Count];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var projectId = await Project.GetCurrentIdAsync();
        _types = await ContentTypes.GetTypesAsync(projectId, ModuleKeys.Achievements);
        _achievements = await Achievements.GetAchievementsAsync(projectId);
    }

    private List<AchievementListRow> Filtered
    {
        get
        {
            IEnumerable<AchievementListRow> rows = _achievements ?? [];

            if (_typeFilter is { } typeId)
            {
                rows = rows.Where(row => row.ContentTypeId == typeId);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                rows = rows.Where(row =>
                    row.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (row.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return [.. rows];
        }
    }

    private async Task DeleteAsync(AchievementListRow row)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", row.Name],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Achievements.DeleteAchievementAsync(row.Id);
        Snackbar.Add(L["DeletedMessage", row.Name], Severity.Success);
        await LoadAsync();
    }
}
