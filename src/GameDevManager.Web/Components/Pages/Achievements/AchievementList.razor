@page "/modules/achievements"
@inject AchievementService Achievements
@inject ContentTypeService ContentTypes
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Achievements – GameDevManager</PageTitle>

<ModuleHeader Module="Module" Subtitle="@Subtitle">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Style"
                   Href="/modules/achievements/arten">
            Achievement-Arten
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/modules/achievements/neu">
            Neues Achievement
        </MudButton>
    </Actions>
</ModuleHeader>

@if (_achievements is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_achievements.Count == 0)
{
    <div class="gdm-empty">
        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
        <MudText Typo="Typo.h6">Noch keine Achievements</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Erfolge wie bei Steam: Icon, Beschreibung, optional versteckt — und die
            Freischaltung als Bedingung aus dem zentralen Bedingungssystem.
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/modules/achievements/neu">
            Erstes Achievement
        </MudButton>
    </div>
}
else
{
    <MudPaper Elevation="0" Class="gdm-panel pa-4 mb-4">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_search"
                          Placeholder="Nach Name oder Beschreibung suchen"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="max-width:360px;" />

            <MudSelect T="Guid?"
                       @bind-Value="_typeFilter"
                       Label="Art"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="max-width:220px;">
                @foreach (var type in _types)
                {
                    <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSpacer />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Filtered.Count von @_achievements.Count</MudText>
        </MudStack>
    </MudPaper>

    <MudTable T="AchievementListRow"
              Items="Filtered"
              Elevation="0"
              Hover="true"
              Dense="true"
              Breakpoint="Breakpoint.Sm"
              OnRowClick="OpenRow"
              RowClass="cursor-pointer">
        <HeaderContent>
            <MudTh Style="width:56px;"></MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Beschreibung</MudTh>
            <MudTh>Versteckt</MudTh>
            <MudTh>Freischaltung</MudTh>
            <MudTh>Art</MudTh>
            <MudTh Style="width:56px;"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Icon">
                <AssetThumbnail AssetId="context.PrimaryAssetId"
                                Size="Size.Small"
                                Alt="@context.Name"
                                FallbackIcon="@Icons.Material.Filled.EmojiEvents" />
            </MudTd>
            <MudTd DataLabel="Name">
                <MudText Typo="Typo.body2"><b>@context.Name</b></MudText>
            </MudTd>
            <MudTd DataLabel="Beschreibung">
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Shorten(context.Description)</MudText>
            </MudTd>
            <MudTd DataLabel="Versteckt">
                @if (context.IsSecret)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">versteckt</MudChip>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Freischaltung">
                @if (context.HasUnlockCondition)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Rule" Size="Size.Small" Color="Color.Success" />
                }
                else
                {
                    <MudTooltip Text="Noch keine Freischalt-Bedingung hinterlegt">
                        <MudIcon Icon="@Icons.Material.Filled.QuestionMark" Size="Size.Small" Color="Color.Warning" />
                    </MudTooltip>
                }
            </MudTd>
            <MudTd DataLabel="Art">
                @if (context.TypeName is null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">ohne Art</MudText>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.TypeName</MudChip>
                }
            </MudTd>
            <MudTd>
                <MudTooltip Text="Löschen">
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                   Size="Size.Small"
                                   OnClick="@(() => DeleteAsync(context))"
                                   aria-label="@($"{context.Name} löschen")" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">
                Kein Achievement passt zur Suche.
            </MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Achievements);

    private List<AchievementListRow>? _achievements;
    private List<ContentType> _types = [];
    private string? _search;
    private Guid? _typeFilter;

    private string Subtitle => _achievements is null
        ? "Wird geladen …"
        : $"{_achievements.Count} Achievement(s)";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var projectId = await Project.GetCurrentIdAsync();
        _types = await ContentTypes.GetTypesAsync(projectId, ModuleKeys.Achievements);
        _achievements = await Achievements.GetAchievementsAsync(projectId);
    }

    private List<AchievementListRow> Filtered
    {
        get
        {
            IEnumerable<AchievementListRow> rows = _achievements ?? [];

            if (_typeFilter is { } typeId)
            {
                rows = rows.Where(row => row.ContentTypeId == typeId);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                rows = rows.Where(row =>
                    row.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (row.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return [.. rows];
        }
    }

    private void OpenRow(TableRowClickEventArgs<AchievementListRow> args)
    {
        if (args.Item is { } row)
        {
            Navigation.NavigateTo($"/modules/achievements/{row.Id}");
        }
    }

    private async Task DeleteAsync(AchievementListRow row)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Achievement löschen",
            $"„{row.Name}“ wird mit Feldwerten, Bedingungen und Sprites gelöscht.",
            yesText: "Löschen",
            cancelText: "Abbrechen");

        if (confirmed != true)
        {
            return;
        }

        await Achievements.DeleteAchievementAsync(row.Id);
        Snackbar.Add($"„{row.Name}“ wurde gelöscht.", Severity.Success);
        await LoadAsync();
    }

    private static string Shorten(string? text) =>
        string.IsNullOrWhiteSpace(text)
            ? "—"
            : text.Length <= 90 ? text : string.Concat(text.AsSpan(0, 90), "…");
}
