@page "/modules/achievements/arten"

<PageTitle>Achievement-Arten – GameDevManager</PageTitle>

<ModuleHeader Module="Module"
              Title="Achievement-Arten"
              Subtitle="Versteckt-Schalter und Freischaltung stehen fest am Achievement — alles Weitere definieren die Felder der Art."
              Breadcrumbs="Breadcrumbs">
    <Actions>
        <MudButton Variant="Variant.Outlined" Href="/modules/achievements">Zu den Achievements</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddAsync">
            Neue Art
        </MudButton>
    </Actions>
</ModuleHeader>

<ContentTypeManager @ref="_manager"
                    ModuleKey="@ModuleKeys.Achievements"
                    EntityNoun="Achievement"
                    EmptyTitle="Noch keine Achievement-Arten"
                    EmptyHint="Über Arten lassen sich Erfolge einteilen — etwa Story, Sammeln oder Herausforderung — und um eigene Felder wie Punkte oder Seltenheit ergänzen." />

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Achievements);

    private static readonly List<BreadcrumbItem> Breadcrumbs = [new("Arten", null, disabled: true)];

    private ContentTypeManager? _manager;

    private Task AddAsync() => _manager?.AddTypeAsync() ?? Task.CompletedTask;
}
