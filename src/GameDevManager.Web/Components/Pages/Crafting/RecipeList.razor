@page "/modules/crafting"
@inject CraftingService Crafting
@inject ContentTypeService ContentTypes
@inject ReferenceService References
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IStringLocalizer<RecipeList> L

<PageTitle>@L["PageTitle"]</PageTitle>

<ModuleHeader Module="Module" Subtitle="@Subtitle">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Style"
                   Href="/modules/crafting/arten">
            @L["TypesButton"]
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/modules/crafting/neu">
            @L["NewRecipe"]
        </MudButton>
    </Actions>
</ModuleHeader>

@if (_recipes is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_recipes.Count == 0)
{
    <div class="gdm-empty">
        <MudIcon Icon="@Icons.Material.Filled.Construction" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
        <MudText Typo="Typo.h6">@L["EmptyTitle"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            @L["EmptyHint"]
            @if (_itemCount == 0)
            {
                <text>@L["EmptyNeedsItems"]</text>
            }
        </MudText>
        @if (_itemCount == 0)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/modules/items">@L["ToItems"]</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/modules/crafting/neu">@L["FirstRecipe"]</MudButton>
        }
    </div>
}
else
{
    var filtered = Filtered;

    <MudPaper Elevation="0" Class="gdm-panel pa-4 mb-4">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_search"
                          Placeholder="@L["SearchPlaceholder"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="max-width:340px;" />

            @* Der Konzept-Wunsch: nach Items filtern — und zwar in beiden Rollen. *@
            <MudAutocomplete T="EntitySummary"
                             Value="_itemFilter"
                             ValueChanged="SetItemFilter"
                             SearchFunc="SearchItemsAsync"
                             ToStringFunc="@(entity => entity?.Name ?? string.Empty)"
                             Label="@L["ItemFilterLabel"]"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Clearable="true"
                             ResetValueOnEmptyText="true"
                             CoerceValue="false"
                             Style="max-width:260px;" />

            @if (_itemFilter is not null)
            {
                <MudSelect T="ItemRole"
                           @bind-Value="_itemRole"
                           Label="@L["RoleFilterLabel"]"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Style="max-width:180px;">
                    <MudSelectItem T="ItemRole" Value="ItemRole.Any">@L["RoleAny"]</MudSelectItem>
                    <MudSelectItem T="ItemRole" Value="ItemRole.Output">@L["RoleOutput"]</MudSelectItem>
                    <MudSelectItem T="ItemRole" Value="ItemRole.Ingredient">@L["RoleIngredient"]</MudSelectItem>
                </MudSelect>
            }

            <MudSelect T="Guid?"
                       @bind-Value="_typeFilter"
                       Label="@L["TypeFilterLabel"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="max-width:200px;">
                @foreach (var type in _types)
                {
                    <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSpacer />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["FilterCount", filtered.Count, _recipes.Count]</MudText>
        </MudStack>
    </MudPaper>

    @if (filtered.Count == 0)
    {
        <MudPaper Elevation="0" Class="gdm-panel pa-4">
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["NoRecords"]</MudText>
        </MudPaper>
    }
    else
    {
        @* Dieselbe Kachelansicht wie bei den Items — das Icon des ersten Ziel-Items trägt
           die Kachel, der Name des Rezepts sind seine Ziel-Items. *@
        <div class="gdm-item-grid">
            @foreach (var recipe in filtered)
            {
                <MudPaper Elevation="0" Class="gdm-panel gdm-card-link">
                    <MudLink Href="@($"/modules/crafting/{recipe.Id}")" Underline="Underline.None">
                        <AssetThumbnail AssetId="recipe.PrimaryOutput?.AssetId"
                                        Class="gdm-item-tile"
                                        Alt="@recipe.Name"
                                        FallbackIcon="@Icons.Material.Filled.Construction" />
                    </MudLink>

                    <div class="pa-3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                            <MudLink Href="@($"/modules/crafting/{recipe.Id}")" Typo="Typo.body1" Class="gdm-ellipsis">
                                <b>@recipe.Name</b>
                            </MudLink>
                            <MudStack Row="true" Spacing="0">
                                @if (recipe.PrimaryOutput?.ItemId is { } outputId)
                                {
                                    <MudTooltip Text="@L["TreeTooltip"]">
                                        <MudIconButton Icon="@Icons.Material.Filled.AccountTree"
                                                       Size="Size.Small"
                                                       Href="@($"/modules/crafting/baum/{outputId}")"
                                                       aria-label="@L["TreeAria"]" />
                                    </MudTooltip>
                                }
                                <MudTooltip Text="@L["DeleteTooltip"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                   Size="Size.Small"
                                                   OnClick="@(() => DeleteAsync(recipe))"
                                                   aria-label="@L["DeleteAria", recipe.Name]" />
                                </MudTooltip>
                            </MudStack>
                        </MudStack>

                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="gdm-ellipsis">
                            @L["IngredientCount", recipe.IngredientCount]
                        </MudText>

                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-2">
                            @if (recipe.Outputs.Count == 0)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning">
                                    @L["NoOutput"]
                                </MudChip>
                            }
                            @if (recipe.TypeName is null)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NoType"]</MudText>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@recipe.TypeName</MudChip>
                            }
                        </MudStack>

                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                            @L["UpdatedAt", recipe.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")]
                        </MudText>
                    </div>
                </MudPaper>
            }
        </div>
    }

    @if (_cycles.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mt-4">
            <MudText Typo="Typo.body2"><b>@L["CyclesTitle"]</b></MudText>
            <MudText Typo="Typo.body2">
                @L["CyclesHint"]
            </MudText>
            @foreach (var cycle in _cycles)
            {
                <MudText Typo="Typo.body2" Class="gdm-mono">@cycle.ToString()</MudText>
            }
        </MudAlert>
    }
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Crafting);

    /// <summary>In welcher Rolle ein Item im Rezept vorkommen soll.</summary>
    public enum ItemRole
    {
        Any,
        Output,
        Ingredient
    }

    private List<RecipeListRow>? _recipes;
    private List<ContentType> _types = [];
    private List<EntitySummary> _items = [];
    private List<CraftingCycle> _cycles = [];
    private HashSet<Guid> _recipesUsingFilterItem = [];
    private int _itemCount;
    private string? _search;
    private Guid? _typeFilter;
    private EntitySummary? _itemFilter;
    private ItemRole _itemRole = ItemRole.Any;

    private string Subtitle => _recipes is null
        ? L["Loading"]
        : L["SubtitleCount", _recipes.Count];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var projectId = await Project.GetCurrentIdAsync();

        _types = await ContentTypes.GetTypesAsync(projectId, ModuleKeys.Crafting);
        _items = await References.GetEntitiesAsync(projectId, ModuleKeys.Items);
        _itemCount = _items.Count;
        _recipes = await Crafting.GetRecipesAsync(projectId);
        _cycles = await Crafting.FindCyclesAsync(projectId);
    }

    private async Task SetItemFilter(EntitySummary? entity)
    {
        _itemFilter = entity;
        _recipesUsingFilterItem = [];

        if (entity is null)
        {
            return;
        }

        var projectId = await Project.GetCurrentIdAsync();
        var (_, consumes) = await Crafting.GetRecipesForItemAsync(projectId, entity.Id);
        _recipesUsingFilterItem = [.. consumes.Select(row => row.Id)];
    }

    private Task<IEnumerable<EntitySummary>> SearchItemsAsync(string? search, CancellationToken ct)
    {
        IEnumerable<EntitySummary> matches = string.IsNullOrWhiteSpace(search)
            ? _items
            : _items.Where(entity => entity.Name.Contains(search, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(matches);
    }

    private List<RecipeListRow> Filtered
    {
        get
        {
            IEnumerable<RecipeListRow> rows = _recipes ?? [];

            if (_typeFilter is { } typeId)
            {
                rows = rows.Where(row => row.ContentTypeId == typeId);
            }

            if (_itemFilter is { } item)
            {
                rows = _itemRole switch
                {
                    ItemRole.Output => rows.Where(row => row.Outputs.Any(output => output.ItemId == item.Id)),
                    ItemRole.Ingredient => rows.Where(row => _recipesUsingFilterItem.Contains(row.Id)),
                    _ => rows.Where(row => row.Outputs.Any(output => output.ItemId == item.Id)
                        || _recipesUsingFilterItem.Contains(row.Id))
                };
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                // Der Name eines Rezepts sind seine Ziel-Items — die Suche darüber trifft sie mit.
                rows = rows.Where(row => row.Name.Contains(_search, StringComparison.OrdinalIgnoreCase));
            }

            return [.. rows];
        }
    }

    private async Task DeleteAsync(RecipeListRow row)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", row.Name],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Crafting.DeleteRecipeAsync(row.Id);
        Snackbar.Add(L["DeletedMessage", row.Name], Severity.Success);
        await LoadAsync();
    }
}
