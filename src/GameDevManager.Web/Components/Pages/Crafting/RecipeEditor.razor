@page "/modules/crafting/neu"
@page "/modules/crafting/{Id:guid}"
@inject CraftingService Crafting
@inject AssetService Library
@inject ReferenceService References
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<RecipeEditor> L

<PageTitle>@L["PageTitle", PageHeading]</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @L["NotFound"]
    </MudAlert>
    <MudButton Variant="Variant.Outlined" Href="/modules/crafting">@L["BackToList"]</MudButton>
}
else if (_context is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <ModuleHeader Module="Module"
                  Title="@PageHeading"
                  Subtitle="@(_context.IsNew ? L["NotSavedYet"].Value : null)"
                  Breadcrumbs="Breadcrumbs">
        <Actions>
            @if (_dirty)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                    @L["UnsavedChanges"]
                </MudChip>
            }
            @if (!_context.IsNew)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteOutline"
                           OnClick="DeleteAsync">
                    @L["Delete"]
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Href="/modules/crafting">@L["Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       Disabled="_saving"
                       OnClick="SaveAsync">
                @L["Save"]
            </MudButton>
        </Actions>
    </ModuleHeader>

    @* Sagt vor dem Speichern, was die Schreibkonflikt-Erkennung erst danach meldet. *@
    <EditingPresenceBanner EntityId="@(_context.IsNew ? null : _context.Entity.Id)" />

    @if (_items.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            @L["NoItemsHint"]
            <MudLink Href="/modules/items" Color="Color.Primary">@L["NoItemsLink"]</MudLink>.
        </MudAlert>
    }

    <MudGrid Spacing="4">
        <MudItem xs="12" md="8">
            <MudStack Spacing="4">

                @* -------------------------------------------------------------- Ziel-Items *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">@L["SectionOutputs"]</MudText>
                        <MudButton StartIcon="@Icons.Material.Filled.Add"
                                   Size="Size.Small"
                                   Disabled="@(_items.Count == 0)"
                                   OnClick="AddOutput">
                            @L["AddOutput"]
                        </MudButton>
                    </MudStack>

                    @if (_context.Entity.Outputs.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @L["NoOutputs"]
                        </MudText>
                    }
                    else
                    {
                        <MudStack Spacing="3">
                            @foreach (var output in _context.Entity.Outputs)
                            {
                                <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
                                    <MudNumericField T="int"
                                                     Value="output.Quantity"
                                                     ValueChanged="@((int quantity) => Touch(() => output.Quantity = quantity))"
                                                     Label="@L["QuantityLabel"]"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Min="1"
                                                     Style="max-width:110px;" />

                                    <div style="flex:1 1 auto; min-width:0;">
                                        <MudAutocomplete T="EntitySummary"
                                                         Value="@ItemFor(output.ItemId)"
                                                         ValueChanged="@((EntitySummary? entity) => SetOutputItemAsync(output, entity))"
                                                         SearchFunc="SearchItemsAsync"
                                                         ToStringFunc="@(entity => entity?.Name ?? string.Empty)"
                                                         Label="@L["OutputItemLabel"]"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         Clearable="true"
                                                         ResetValueOnEmptyText="true"
                                                         CoerceValue="false"
                                                         MaxItems="50" />
                                    </div>

                                    <AssetThumbnail AssetId="@AssetFor(output.ItemId)"
                                                    Size="Size.Small"
                                                    Alt="@(ItemFor(output.ItemId)?.Name ?? "")"
                                                    FallbackIcon="@Icons.Material.Filled.Category" />

                                    <MudTooltip Text="@L["RemoveOutput"]">
                                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                       Size="Size.Small"
                                                       OnClick="@(() => RemoveOutputAsync(output))"
                                                       aria-label="@L["RemoveOutput"]" />
                                    </MudTooltip>
                                </MudStack>
                            }
                        </MudStack>
                    }
                </MudPaper>

                @* --------------------------------------------------------- Benötigte Items *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">@L["SectionIngredients"]</MudText>
                        <MudButton StartIcon="@Icons.Material.Filled.Add"
                                   Size="Size.Small"
                                   Disabled="@(_items.Count == 0)"
                                   OnClick="AddIngredient">
                            @L["AddIngredient"]
                        </MudButton>
                    </MudStack>

                    @if (_context.Entity.Ingredients.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @L["NoIngredients"]
                        </MudText>
                    }
                    else
                    {
                        <MudStack Spacing="3">
                            @foreach (var ingredient in _context.Entity.Ingredients)
                            {
                                <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
                                    <MudNumericField T="int"
                                                     Value="ingredient.Quantity"
                                                     ValueChanged="@((int quantity) => Touch(() => ingredient.Quantity = quantity))"
                                                     Label="@L["QuantityLabel"]"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Min="1"
                                                     Style="max-width:110px;" />

                                    <div style="flex:1 1 auto; min-width:0;">
                                        <MudAutocomplete T="EntitySummary"
                                                         Value="@ItemFor(ingredient.ItemId)"
                                                         ValueChanged="@((EntitySummary? entity) => SetIngredientItem(ingredient, entity))"
                                                         SearchFunc="SearchItemsAsync"
                                                         ToStringFunc="@(entity => entity?.Name ?? string.Empty)"
                                                         Label="@L["IngredientItemLabel"]"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         Clearable="true"
                                                         ResetValueOnEmptyText="true"
                                                         CoerceValue="false"
                                                         MaxItems="50" />
                                    </div>

                                    <MudTooltip Text="@L["RemoveIngredient"]">
                                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                       Size="Size.Small"
                                                       OnClick="@(() => RemoveIngredient(ingredient))"
                                                       aria-label="@L["RemoveIngredient"]" />
                                    </MudTooltip>
                                </MudStack>
                            }
                        </MudStack>
                    }
                </MudPaper>

                @* -------------------------------------------------------------- Rezept-Art *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionType"]</MudText>

                    <MudSelect T="Guid?"
                               Value="_context.Entity.ContentTypeId"
                               ValueChanged="ChangeType"
                               Label="@L["TypeLabel"]"
                               Variant="Variant.Outlined"
                               Clearable="true"
                               HelperText="@L["TypeHelper"]">
                        @foreach (var type in _context.AvailableTypes)
                        {
                            <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudPaper>

                @* ----------------------------------------------- Felder der gewählten Art *@
                <div>
                    <ContentFieldsPanel TEntity="Recipe"
                                        Context="_context"
                                        ModuleKey="@ModuleKeys.Crafting"
                                        TypesRoute="/modules/crafting/arten"
                                        IndividualHint="@L["IndividualHint"]"
                                        OnValueChanged="MarkDirty"
                                        OnFieldDefinitionChanged="ReloadKeepingChangesAsync" />
                </div>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudStack Spacing="4">
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionReference"]</MudText>

                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["GuidCaption"]</MudText>
                    <EntityIdChip Id="_context.Entity.Id" />

                    <MudDivider Class="my-3" />
                    <EntityStatusSelect Entity="_context.Entity" OnChanged="MarkDirty" />

                    @if (!_context.IsNew)
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["CreatedCaption"]</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">@L["UpdatedCaption"]</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                    }
                </MudPaper>

                @if (TreeItemId is { } treeItemId && !_context.IsNew)
                {
                    <MudPaper Elevation="0" Class="gdm-panel pa-4">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                            <MudText Typo="Typo.overline" Color="Color.Secondary">@L["SectionTree"]</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.OpenInFull"
                                           Size="Size.Small"
                                           Href="@($"/modules/crafting/baum/{treeItemId}")"
                                           aria-label="@L["OpenTreeAria"]" />
                        </MudStack>

                        @if (_tree is null)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Loading"]</MudText>
                        }
                        else
                        {
                            <CraftingTreeView Node="_tree" />
                        }
                    </MudPaper>
                }

                @if (!_context.IsNew)
                {
                    <EntityTagsPanel ModuleKey="@ModuleKeys.Crafting" EntityId="_context.Entity.Id" />
                    <ReferencesPanel @ref="_referencesPanel" EntityId="_context.Entity.Id" />
                    <EntityHistoryPanel @ref="_historyPanel" EntityId="_context.Entity.Id" />
                }
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Crafting);

    [Parameter]
    public Guid? Id { get; set; }

    private ContentEditContext<Recipe>? _context;
    private ReferencesPanel? _referencesPanel;
    private EntityHistoryPanel? _historyPanel;
    private List<EntitySummary> _items = [];

    /// <summary>Die Icons der ausgewählten Ziel-Items, einmal je Item nachgeschlagen.</summary>
    private readonly Dictionary<Guid, Guid?> _itemAssets = [];

    private CraftingTreeNode? _tree;
    private Guid? _loadedId;
    private bool _notFound;
    private bool _saving;
    private bool _dirty;

    /// <summary>
    /// Der Name eines Rezepts sind seine Ziel-Items. Er wird beim Speichern gebildet — hier
    /// aus dem noch ungespeicherten Stand, damit die Überschrift sofort mitzieht.
    /// </summary>
    private string OutputSummary => _context is null
        ? string.Empty
        : CraftingService.FormatOutputs(_context.Entity.Outputs
            .Where(output => output.ItemId != Guid.Empty)
            .Select(output => (ItemFor(output.ItemId)?.Name ?? L["DeletedItem"].Value, output.Quantity)));

    private string PageHeading => _context switch
    {
        null => L["PageHeadingDefault"],
        _ when !string.IsNullOrWhiteSpace(OutputSummary) => OutputSummary,
        { IsNew: true } => L["PageHeadingNew"],
        _ => L["PageHeadingUnnamed"]
    };

    private List<BreadcrumbItem> Breadcrumbs => [new(PageHeading, null, disabled: true)];

    /// <summary>Der Baum zeigt das erste Ziel-Item — es ist das, worum es im Rezept geht.</summary>
    private Guid? TreeItemId =>
        _context?.Entity.Outputs.FirstOrDefault(output => output.ItemId != Guid.Empty)?.ItemId;

    protected override async Task OnParametersSetAsync()
    {
        if (_context is not null && _loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _notFound = false;
        _dirty = false;
        _context = null;
        _tree = null;
        _itemAssets.Clear();

        var projectId = await Project.GetCurrentIdAsync();
        _items = await References.GetEntitiesAsync(projectId, ModuleKeys.Items);
        _context = await Crafting.LoadForEditAsync(projectId, Id);

        if (_context is null)
        {
            _notFound = true;
            return;
        }

        await RefreshOutputsAsync();
    }

    private EntitySummary? ItemFor(Guid itemId) =>
        _items.FirstOrDefault(entity => entity.Id == itemId);

    private Guid? AssetFor(Guid itemId) => _itemAssets.GetValueOrDefault(itemId);

    private Task<IEnumerable<EntitySummary>> SearchItemsAsync(string? search, CancellationToken ct)
    {
        IEnumerable<EntitySummary> matches = string.IsNullOrWhiteSpace(search)
            ? _items
            : _items.Where(entity => entity.Name.Contains(search, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(matches);
    }

    private void AddOutput() =>
        Touch(() => _context!.Entity.Outputs.Add(new RecipeOutput
        {
            RecipeId = _context.Entity.Id,
            ItemId = Guid.Empty,
            Quantity = 1,
            SortOrder = _context.Entity.Outputs.Count
        }));

    private async Task RemoveOutputAsync(RecipeOutput output)
    {
        Touch(() => _context!.Entity.Outputs.Remove(output));
        await RefreshOutputsAsync();
    }

    private async Task SetOutputItemAsync(RecipeOutput output, EntitySummary? entity)
    {
        Touch(() => output.ItemId = entity?.Id ?? Guid.Empty);
        await RefreshOutputsAsync();
    }

    /// <summary>Icons der Ziel-Items nachladen und den Baum auf das erste Ziel stellen.</summary>
    private async Task RefreshOutputsAsync()
    {
        if (_context is null)
        {
            return;
        }

        foreach (var output in _context.Entity.Outputs)
        {
            if (output.ItemId != Guid.Empty && !_itemAssets.ContainsKey(output.ItemId))
            {
                _itemAssets[output.ItemId] = await Library.GetPrimaryAssetIdAsync(output.ItemId);
            }
        }

        if (TreeItemId is not { } itemId)
        {
            _tree = null;
            return;
        }

        var projectId = await Project.GetCurrentIdAsync();
        _tree = await Crafting.BuildTreeAsync(projectId, itemId);
    }

    private void AddIngredient() =>
        Touch(() => _context!.Entity.Ingredients.Add(new RecipeIngredient
        {
            RecipeId = _context.Entity.Id,
            ItemId = Guid.Empty,
            Quantity = 1,
            SortOrder = _context.Entity.Ingredients.Count
        }));

    private void RemoveIngredient(RecipeIngredient ingredient) =>
        Touch(() => _context!.Entity.Ingredients.Remove(ingredient));

    private void SetIngredientItem(RecipeIngredient ingredient, EntitySummary? entity) =>
        Touch(() => ingredient.ItemId = entity?.Id ?? Guid.Empty);

    private void ChangeType(Guid? contentTypeId) =>
        Touch(() => _context!.Entity.ContentTypeId = contentTypeId);

    private void Touch(Action change)
    {
        change();
        MarkDirty();
    }

    private void MarkDirty() => _dirty = true;

    private async Task SaveAsync()
    {
        if (_context is null)
        {
            return;
        }

        // Leere Zeilen sind ein Bedienschritt, kein Inhalt — sie fliegen still raus.
        _context.Entity.Outputs.RemoveAll(output => output.ItemId == Guid.Empty);
        _context.Entity.Ingredients.RemoveAll(ingredient => ingredient.ItemId == Guid.Empty);

        _saving = true;

        try
        {
            var wasNew = _context.IsNew;
            await Crafting.SaveRecipeAsync(_context);
            _dirty = false;

            Snackbar.Add(L["SavedMessage", _context.Entity.Name], Severity.Success);

            if (wasNew)
            {
                Navigation.NavigateTo($"/modules/crafting/{_context.Entity.Id}");
                return;
            }

            await RefreshOutputsAsync();

            if (_referencesPanel is not null)
            {
                await _referencesPanel.RefreshAsync();
            }

            if (_historyPanel is not null)
            {
                await _historyPanel.RefreshAsync();
            }
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_context is null)
        {
            return;
        }

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", PageHeading],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Crafting.DeleteRecipeAsync(_context.Entity.Id);
        Snackbar.Add(L["DeletedMessage"], Severity.Success);
        Navigation.NavigateTo("/modules/crafting");
    }

    /// <summary>
    /// Lädt nach einer Änderung an den Felddefinitionen neu und behält dabei, was in der Maske
    /// noch nicht gespeichert ist.
    /// </summary>
    private async Task ReloadKeepingChangesAsync()
    {
        if (_context is null)
        {
            return;
        }

        var entity = _context.Entity;
        var wasDirty = _dirty;

        var projectId = await Project.GetCurrentIdAsync();
        var reloaded = await Crafting.LoadForEditAsync(projectId, entity.Id);

        if (reloaded is null)
        {
            _notFound = true;
            _context = null;
            return;
        }

        reloaded.Entity.ContentTypeId = entity.ContentTypeId;
        reloaded.Entity.Outputs = entity.Outputs;
        reloaded.Entity.Ingredients = entity.Ingredients;

        _context = reloaded;
        _dirty = wasDirty;
    }
}
