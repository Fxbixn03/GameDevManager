@page "/modules/crafting/arten"

<PageTitle>Rezept-Arten – GameDevManager</PageTitle>

<ModuleHeader Module="Module"
              Title="Rezept-Arten"
              Subtitle="Zutaten und Ergebnis stehen fest am Rezept — alles Weitere definieren die Felder der Art."
              Breadcrumbs="Breadcrumbs">
    <Actions>
        <MudButton Variant="Variant.Outlined" Href="/modules/crafting">Zu den Rezepten</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddAsync">
            Neue Art
        </MudButton>
    </Actions>
</ModuleHeader>

<ContentTypeManager @ref="_manager"
                    ModuleKey="@ModuleKeys.Crafting"
                    EntityNoun="Rezept"
                    EmptyTitle="Noch keine Rezept-Arten"
                    EmptyHint="Über Arten lassen sich Angaben ergänzen, die das Rezept selbst nicht kennt — etwa Herstellungsdauer, benötigte Werkbank oder ein Mindestlevel." />

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Crafting);

    private static readonly List<BreadcrumbItem> Breadcrumbs = [new("Arten", null, disabled: true)];

    private ContentTypeManager? _manager;

    private Task AddAsync() => _manager?.AddTypeAsync() ?? Task.CompletedTask;
}
