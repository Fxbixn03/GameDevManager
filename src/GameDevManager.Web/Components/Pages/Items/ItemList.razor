@page "/modules/items"
@inject ItemService Items
@inject ContentTypeService ContentTypes
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Items – GameDevManager</PageTitle>

<ModuleHeader Module="Module" Subtitle="@Subtitle">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Style"
                   Href="/modules/items/arten">
            Item-Arten
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/modules/items/neu">
            Neues Item
        </MudButton>
    </Actions>
</ModuleHeader>

@if (_items is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_items.Count == 0)
{
    <div class="gdm-empty">
        <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
        <MudText Typo="Typo.h6">Noch keine Items</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Lege zuerst Item-Arten mit ihren Feldern an — oder starte direkt mit einem Item ohne Art.
        </MudText>
        <MudStack Row="true" Spacing="2" Justify="Justify.Center">
            <MudButton Variant="Variant.Outlined" Href="/modules/items/arten">Item-Arten anlegen</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/modules/items/neu">Neues Item</MudButton>
        </MudStack>
    </div>
}
else
{
    <MudPaper Elevation="0" Class="gdm-panel pa-4 mb-4">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_search"
                          Placeholder="Nach Name oder Beschreibung suchen"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="max-width:360px;" />

            <MudSelect T="Guid?"
                       @bind-Value="_typeFilter"
                       Label="Art"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="max-width:240px;">
                @foreach (var type in _types)
                {
                    <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSpacer />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@FilteredItems.Count von @_items.Count</MudText>
        </MudStack>
    </MudPaper>

    <MudTable T="ItemListRow"
              Items="FilteredItems"
              Elevation="0"
              Hover="true"
              Dense="true"
              Breakpoint="Breakpoint.Sm"
              OnRowClick="OpenRow"
              RowClass="cursor-pointer">
        <HeaderContent>
            <MudTh Style="width:56px;"></MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Art</MudTh>
            <MudTh>Beschreibung</MudTh>
            <MudTh>Geändert</MudTh>
            <MudTh Style="width:56px;"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Sprite">
                <AssetThumbnail AssetId="context.PrimaryAssetId"
                                Size="Size.Small"
                                Alt="@context.Name"
                                FallbackIcon="@Icons.Material.Filled.Category" />
            </MudTd>
            <MudTd DataLabel="Name">
                <MudText Typo="Typo.body2"><b>@context.Name</b></MudText>
            </MudTd>
            <MudTd DataLabel="Art">
                @if (context.TypeName is null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">ohne Art</MudText>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.TypeName</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Beschreibung">
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Shorten(context.Description)</MudText>
            </MudTd>
            <MudTd DataLabel="Geändert">
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @context.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                </MudText>
            </MudTd>
            <MudTd>
                <MudTooltip Text="Löschen">
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                   Size="Size.Small"
                                   OnClick="@(() => DeleteAsync(context))"
                                   aria-label="@($"{context.Name} löschen")" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">
                Kein Item passt zur Suche.
            </MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Items);

    private List<ItemListRow>? _items;
    private List<ContentType> _types = [];
    private string? _search;
    private Guid? _typeFilter;

    private string Subtitle => _items is null
        ? "Wird geladen …"
        : $"{_items.Count} Item(s) in {_types.Count} Art(en)";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var projectId = await Project.GetCurrentIdAsync();
        _types = await ContentTypes.GetTypesAsync(projectId, ModuleKeys.Items);
        _items = await Items.GetItemsAsync(projectId);
    }

    private List<ItemListRow> FilteredItems
    {
        get
        {
            IEnumerable<ItemListRow> rows = _items ?? [];

            if (_typeFilter is { } typeId)
            {
                rows = rows.Where(row => row.ContentTypeId == typeId);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                rows = rows.Where(row =>
                    row.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (row.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return [.. rows];
        }
    }

    private void OpenRow(TableRowClickEventArgs<ItemListRow> args)
    {
        if (args.Item is { } row)
        {
            Navigation.NavigateTo($"/modules/items/{row.Id}");
        }
    }

    private async Task DeleteAsync(ItemListRow row)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Item löschen",
            $"„{row.Name}“ wird mit allen erfassten Feldwerten gelöscht. Das lässt sich nicht rückgängig machen.",
            yesText: "Löschen",
            cancelText: "Abbrechen");

        if (confirmed != true)
        {
            return;
        }

        await Items.DeleteItemAsync(row.Id);
        Snackbar.Add($"„{row.Name}“ wurde gelöscht.", Severity.Success);
        await LoadAsync();
    }

    private static string Shorten(string? text) =>
        string.IsNullOrWhiteSpace(text)
            ? "—"
            : text.Length <= 90 ? text : string.Concat(text.AsSpan(0, 90), "…");
}
