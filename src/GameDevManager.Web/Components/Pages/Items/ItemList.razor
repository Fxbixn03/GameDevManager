@page "/modules/items"
@inject ItemService Items
@inject ContentTypeService ContentTypes
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IStringLocalizer<ItemList> L

<PageTitle>@L["PageTitle"]</PageTitle>

<ModuleHeader Module="Module" Subtitle="@Subtitle">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Style"
                   Href="/modules/items/arten">
            @L["TypesButton"]
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/modules/items/neu">
            @L["NewItem"]
        </MudButton>
    </Actions>
</ModuleHeader>

@if (_items is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_items.Count == 0)
{
    <div class="gdm-empty">
        <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
        <MudText Typo="Typo.h6">@L["EmptyTitle"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            @L["EmptyHint"]
        </MudText>
        <MudStack Row="true" Spacing="2" Justify="Justify.Center">
            <MudButton Variant="Variant.Outlined" Href="/modules/items/arten">@L["CreateTypes"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/modules/items/neu">@L["NewItem"]</MudButton>
        </MudStack>
    </div>
}
else
{
    var filtered = FilteredItems;

    <MudPaper Elevation="0" Class="gdm-panel pa-4 mb-4">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_search"
                          Placeholder="@L["SearchPlaceholder"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="max-width:360px;" />

            <MudSelect T="Guid?"
                       @bind-Value="_typeFilter"
                       Label="@L["TypeFilterLabel"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="max-width:240px;">
                @foreach (var type in _types)
                {
                    <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSpacer />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["FilterCount", filtered.Count, _items.Count]</MudText>
        </MudStack>
    </MudPaper>

    @if (filtered.Count == 0)
    {
        <MudPaper Elevation="0" Class="gdm-panel pa-4">
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["NoRecords"]</MudText>
        </MudPaper>
    }
    else
    {
        @* Items sind Sprites — eine Kachelansicht zeigt sie wie bei den Karten direkt. *@
        <div class="gdm-item-grid">
            @foreach (var item in filtered)
            {
                <MudPaper Elevation="0" Class="gdm-panel gdm-card-link">
                    <MudLink Href="@($"/modules/items/{item.Id}")" Underline="Underline.None">
                        <AssetThumbnail AssetId="item.PrimaryAssetId"
                                        Class="gdm-item-tile"
                                        Alt="@item.Name"
                                        FallbackIcon="@Icons.Material.Filled.Category" />
                    </MudLink>

                    <div class="pa-3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                            <MudLink Href="@($"/modules/items/{item.Id}")" Typo="Typo.body1" Class="gdm-ellipsis">
                                <b>@item.Name</b>
                            </MudLink>
                            <EntityDuplicateButton ModuleKey="@Module.Id"
                                                   EntityId="item.Id"
                                                   Name="@item.Name"
                                                   EditRoute="/modules/items" />
                            <MudTooltip Text="@L["DeleteTooltip"]">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                               Size="Size.Small"
                                               OnClick="@(() => DeleteAsync(item))"
                                               aria-label="@L["DeleteAria", item.Name]" />
                            </MudTooltip>
                        </MudStack>

                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="gdm-ellipsis">
                                @item.Description
                            </MudText>
                        }

                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-2">
                            @if (item.TypeName is null)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NoType"]</MudText>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@item.TypeName</MudChip>
                            }
                        </MudStack>

                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                            @L["UpdatedAt", item.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")]
                        </MudText>
                    </div>
                </MudPaper>
            }
        </div>
    }
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Items);

    private List<ItemListRow>? _items;
    private List<ContentType> _types = [];
    private string? _search;
    private Guid? _typeFilter;

    private string Subtitle => _items is null
        ? L["Loading"]
        : L["SubtitleCount", _items.Count, _types.Count];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var projectId = await Project.GetCurrentIdAsync();
        _types = await ContentTypes.GetTypesAsync(projectId, ModuleKeys.Items);
        _items = await Items.GetItemsAsync(projectId);
    }

    private List<ItemListRow> FilteredItems
    {
        get
        {
            IEnumerable<ItemListRow> rows = _items ?? [];

            if (_typeFilter is { } typeId)
            {
                rows = rows.Where(row => row.ContentTypeId == typeId);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                rows = rows.Where(row =>
                    row.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (row.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return [.. rows];
        }
    }

    private async Task DeleteAsync(ItemListRow row)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", row.Name],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Items.DeleteItemAsync(row.Id);
        Snackbar.Add(L["DeletedMessage", row.Name], Severity.Success);
        await LoadAsync();
    }
}
