@page "/modules/items/neu"
@page "/modules/items/{Id:guid}"
@inject ItemService Items
@inject CraftingService Crafting
@inject NpcService Npcs
@inject LootService Loot
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<ItemEditor> L

<PageTitle>@L["PageTitle", PageHeading]</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @L["NotFound"]
    </MudAlert>
    <MudButton Variant="Variant.Outlined" Href="/modules/items">@L["BackToList"]</MudButton>
}
else if (_context is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <ModuleHeader Module="Module"
                  Title="@PageHeading"
                  Subtitle="@(_context.IsNew ? L["NotSavedYet"].Value : null)"
                  Breadcrumbs="Breadcrumbs">
        <Actions>
            @if (_dirty)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                    @L["UnsavedChanges"]
                </MudChip>
            }
            @if (!_context.IsNew)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteOutline"
                           OnClick="DeleteAsync">
                    @L["Delete"]
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Href="/modules/items">@L["Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       data-gdm-save
                       Disabled="_saving"
                       OnClick="SaveAsync">
                @L["Save"]
            </MudButton>
        </Actions>
    </ModuleHeader>

    @* Sagt vor dem Speichern, was die Schreibkonflikt-Erkennung erst danach meldet. *@
    <EditingPresenceBanner EntityId="@(_context.IsNew ? null : _context.Entity.Id)" />

    <MudGrid Spacing="4">
        <MudItem xs="12" md="8">
            <MudStack Spacing="4">

                @* ------------------------------------------------------------- Stammdaten *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionBasics"]</MudText>

                    <MudStack Spacing="4">
                        <MudTextField Value="_context.Entity.Name"
                                      ValueChanged="@((string name) => Touch(() => _context.Entity.Name = name))"
                                      T="string"
                                      Label="@L["NameLabel"]"
                                      Variant="Variant.Outlined"
                                      Immediate="true" />

                        <MudTextField Value="_context.Entity.Description"
                                      ValueChanged="@((string text) => Touch(() => _context.Entity.Description = text))"
                                      T="string"
                                      Label="@L["DescriptionLabel"]"
                                      Variant="Variant.Outlined"
                                      Lines="3" />

                        <MudSelect T="Guid?"
                                   Value="_context.Entity.ContentTypeId"
                                   ValueChanged="ChangeType"
                                   Label="@L["TypeLabel"]"
                                   Variant="Variant.Outlined"
                                   Clearable="true"
                                   HelperText="@L["TypeHelperText"]">
                            @foreach (var type in _context.AvailableTypes)
                            {
                                <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                            }
                        </MudSelect>

                        @if (_context.AvailableTypes.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">
                                @L["NoTypesIntro"]
                                <MudLink Href="/modules/items/arten" Color="Color.Primary">@L["NoTypesLink"]</MudLink>@L["NoTypesSuffix"]
                            </MudAlert>
                        }
                    </MudStack>
                </MudPaper>

                @* ------------------------------------------------------------------ Sprites *@
                <AssetSpritePanel ModuleKey="@ModuleKeys.Items"
                                  EntityId="_context.Entity.Id"
                                  Disabled="_context.IsNew" />

                @* ------------------------------------------------------------------- Felder *@
                <div>
                    <ContentFieldsPanel TEntity="Item"
                                        Context="_context"
                                        ModuleKey="@ModuleKeys.Items"
                                        TypesRoute="/modules/items/arten"
                                        IndividualHint="@L["IndividualHint"]"
                                        OnValueChanged="MarkDirty"
                                        OnFieldDefinitionChanged="ReloadKeepingChangesAsync" />
                </div>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudStack Spacing="4">
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionReference"]</MudText>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["GuidCaption"]</MudText>
                        @if (!_context.IsNew)
                        {
                            <EntityPinButton ModuleKey="@Module.Id" EntityId="_context.Entity.Id" />
                        }
                    </MudStack>
                    <EntityIdChip Id="_context.Entity.Id" />

                    <MudDivider Class="my-3" />
                    <EntityStatusSelect Entity="_context.Entity" OnChanged="MarkDirty" />

                    @if (_context.IsNew)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                            @L["AssignedOnSave"]
                        </MudText>
                    }
                    else
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["CreatedCaption"]</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">@L["UpdatedCaption"]</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                    }
                </MudPaper>

                @if (!_context.IsNew)
                {
                    @* --------------------------------------------------------- Crafting *@
                    <MudPaper Elevation="0" Class="gdm-panel pa-4">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                            <MudText Typo="Typo.overline" Color="Color.Secondary">@L["SectionCrafting"]</MudText>
                            @if (_produces.Count > 0)
                            {
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Text"
                                           StartIcon="@Icons.Material.Filled.AccountTree"
                                           Href="@($"/modules/crafting/baum/{_context.Entity.Id}")">
                                    @L["TreeButton"]
                                </MudButton>
                            }
                        </MudStack>

                        @if (_produces.Count == 0 && _consumes.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @L["NoRecipes"]
                            </MudText>
                        }
                        else
                        {
                            @if (_produces.Count > 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["ProducedBy"]</MudText>
                                @foreach (var recipe in _produces)
                                {
                                    <div>
                                        <MudLink Href="@($"/modules/crafting/{recipe.Id}")" Typo="Typo.body2">
                                            @recipe.Name
                                        </MudLink>
                                    </div>
                                }
                            }

                            @if (_consumes.Count > 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">@L["ConsumedBy"]</MudText>
                                @foreach (var recipe in _consumes)
                                {
                                    <div>
                                        <MudLink Href="@($"/modules/crafting/{recipe.Id}")" Typo="Typo.body2">
                                            @recipe.Name
                                        </MudLink>
                                    </div>
                                }
                            }
                        }
                    </MudPaper>

                    @* ------------------------------------------------------------ Handel *@
                    <MudPaper Elevation="0" Class="gdm-panel pa-4">
                        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionSources"]</MudText>

                        @if (_traders.Count == 0 && _lootSources.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @L["NoSources"]
                            </MudText>
                        }
                        else
                        {
                            @if (_traders.Count > 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["TradersCaption"]</MudText>
                                @foreach (var trader in _traders)
                                {
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"
                                              Class="gdm-field-row py-1">
                                        <MudLink Href="@($"/modules/npcs/{trader.NpcId}")" Typo="Typo.body2">
                                            @trader.NpcName
                                        </MudLink>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="gdm-mono">
                                            @DescribePrices(trader)
                                        </MudText>
                                    </MudStack>
                                }
                            }

                            @if (_lootSources.Count > 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">@L["DropsFromCaption"]</MudText>
                                @foreach (var source in _lootSources)
                                {
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"
                                              Class="gdm-field-row py-1">
                                        <MudLink Href="@($"/modules/loot/{source.LootTableId}")" Typo="Typo.body2">
                                            @source.LootTableName
                                        </MudLink>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="gdm-mono">
                                            @source.Chance.ToString("0.##") % · @DescribeQuantity(source)
                                        </MudText>
                                    </MudStack>
                                }
                            }
                        }
                    </MudPaper>

                    <EntityTagsPanel ModuleKey="@ModuleKeys.Items" EntityId="_context.Entity.Id" />
                    <ReferencesPanel @ref="_referencesPanel" EntityId="_context.Entity.Id" />
                    <EntityHistoryPanel @ref="_historyPanel" EntityId="_context.Entity.Id" />
                    <EntityCommentsPanel ModuleKey="@Module.Id" EntityId="_context.Entity.Id" />
                }
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Items);

    [Parameter]
    public Guid? Id { get; set; }

    private ContentEditContext<Item>? _context;
    private ReferencesPanel? _referencesPanel;
    private EntityHistoryPanel? _historyPanel;
    private List<RecipeListRow> _produces = [];
    private List<RecipeListRow> _consumes = [];
    private List<TraderForItem> _traders = [];
    private List<LootSourceForItem> _lootSources = [];
    private Guid? _loadedId;
    private bool _notFound;
    private bool _saving;
    private bool _dirty;

    private string PageHeading => _context switch
    {
        null => L["HeadingFallback"],
        { IsNew: true } => L["HeadingNew"],
        { Entity.Name: var name } when !string.IsNullOrWhiteSpace(name) => name,
        _ => L["HeadingUnnamed"]
    };

    private List<BreadcrumbItem> Breadcrumbs => [new(PageHeading, null, disabled: true)];

    protected override async Task OnParametersSetAsync()
    {
        if (_context is not null && _loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _notFound = false;
        _dirty = false;
        _context = null;
        _produces = [];
        _consumes = [];
        _traders = [];
        _lootSources = [];

        var projectId = await Project.GetCurrentIdAsync();
        _context = await Items.LoadForEditAsync(projectId, Id);

        if (_context is null)
        {
            _notFound = true;
            return;
        }

        if (!_context.IsNew)
        {
            (_produces, _consumes) = await Crafting.GetRecipesForItemAsync(projectId, _context.Entity.Id);
            _traders = await Npcs.GetTradersForItemAsync(projectId, _context.Entity.Id);
            _lootSources = await Loot.GetTablesForItemAsync(projectId, _context.Entity.Id);
        }
    }

    private string DescribeQuantity(LootSourceForItem source) =>
        source.MinQuantity == source.MaxQuantity
            ? L["QuantityExact", source.MinQuantity]
            : L["QuantityRange", source.MinQuantity, source.MaxQuantity];

    /// <summary>Kurzfassung der Preise eines Händlers für die Seitenleiste.</summary>
    private string DescribePrices(TraderForItem trader)
    {
        var parts = new List<string>();

        if (trader.SellPrice is { } sell)
        {
            parts.Add(L["SellPriceFormat", sell]);
        }

        if (trader.BuyPrice is { } buy)
        {
            parts.Add(L["BuyPriceFormat", buy]);
        }

        if (parts.Count == 0)
        {
            return L["NoPrice"];
        }

        return string.IsNullOrWhiteSpace(trader.CurrencyLabel)
            ? string.Join(" · ", parts)
            : $"{string.Join(" · ", parts)} {trader.CurrencyLabel}";
    }

    private void ChangeType(Guid? contentTypeId)
    {
        if (_context is null)
        {
            return;
        }

        _context.Entity.ContentTypeId = contentTypeId;
        MarkDirty();
    }

    private void Touch(Action change)
    {
        change();
        MarkDirty();
    }

    private void MarkDirty() => _dirty = true;

    private async Task SaveAsync()
    {
        if (_context is null)
        {
            return;
        }

        _saving = true;

        try
        {
            var wasNew = _context.IsNew;
            await Items.SaveItemAsync(_context);
            _dirty = false;

            Snackbar.Add(L["SavedMessage", _context.Entity.Name], Severity.Success);

            if (wasNew)
            {
                // Erst ab jetzt gibt es Sprites, individuelle Felder und eine Referenzansicht.
                Navigation.NavigateTo($"/modules/items/{_context.Entity.Id}");
                return;
            }

            if (_referencesPanel is not null)
            {
                await _referencesPanel.RefreshAsync();
            }

            if (_historyPanel is not null)
            {
                await _historyPanel.RefreshAsync();
            }
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_context is null)
        {
            return;
        }

        var usedBy = _produces.Count + _consumes.Count;
        var warning = usedBy == 0
            ? string.Empty
            : $" {L["DeleteWarningRecipes", usedBy]}";

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", _context.Entity.Name, warning],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Items.DeleteItemAsync(_context.Entity.Id);
        Snackbar.Add(L["DeletedMessage"], Severity.Success);
        Navigation.NavigateTo("/modules/items");
    }

    /// <summary>
    /// Lädt Felder und Werte neu, nachdem eine Felddefinition geändert wurde. Die noch nicht
    /// gespeicherten Stammdaten der Maske bleiben erhalten.
    /// </summary>
    private async Task ReloadKeepingChangesAsync()
    {
        if (_context is null)
        {
            return;
        }

        var name = _context.Entity.Name;
        var description = _context.Entity.Description;
        var contentTypeId = _context.Entity.ContentTypeId;
        var wasDirty = _dirty;

        var projectId = await Project.GetCurrentIdAsync();
        var reloaded = await Items.LoadForEditAsync(projectId, _context.Entity.Id);

        if (reloaded is null)
        {
            _notFound = true;
            _context = null;
            return;
        }

        reloaded.Entity.Name = name;
        reloaded.Entity.Description = description;
        reloaded.Entity.ContentTypeId = contentTypeId;

        _context = reloaded;
        _dirty = wasDirty;
    }
}
