@page "/modules/items/neu"
@page "/modules/items/{Id:guid}"
@inject ItemService Items
@inject CraftingService Crafting
@inject NpcService Npcs
@inject LootService Loot
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@PageHeading – GameDevManager</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        Es gibt kein Item mit dieser GUID. Vielleicht wurde es gelöscht.
    </MudAlert>
    <MudButton Variant="Variant.Outlined" Href="/modules/items">Zurück zur Übersicht</MudButton>
}
else if (_context is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <ModuleHeader Module="Module"
                  Title="@PageHeading"
                  Subtitle="@(_context.IsNew ? "Noch nicht gespeichert" : null)"
                  Breadcrumbs="Breadcrumbs">
        <Actions>
            @if (_dirty)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                    Ungespeicherte Änderungen
                </MudChip>
            }
            @if (!_context.IsNew)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteOutline"
                           OnClick="DeleteAsync">
                    Löschen
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Href="/modules/items">Abbrechen</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       Disabled="_saving"
                       OnClick="SaveAsync">
                Speichern
            </MudButton>
        </Actions>
    </ModuleHeader>

    <MudGrid Spacing="4">
        <MudItem xs="12" md="8">
            <MudStack Spacing="4">

                @* ------------------------------------------------------------- Stammdaten *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">Stammdaten</MudText>

                    <MudStack Spacing="4">
                        <MudTextField Value="_context.Entity.Name"
                                      ValueChanged="@((string name) => Touch(() => _context.Entity.Name = name))"
                                      T="string"
                                      Label="Name *"
                                      Variant="Variant.Outlined"
                                      Immediate="true" />

                        <MudTextField Value="_context.Entity.Description"
                                      ValueChanged="@((string text) => Touch(() => _context.Entity.Description = text))"
                                      T="string"
                                      Label="Beschreibung"
                                      Variant="Variant.Outlined"
                                      Lines="3" />

                        <MudSelect T="Guid?"
                                   Value="_context.Entity.ContentTypeId"
                                   ValueChanged="ChangeType"
                                   Label="Item-Art"
                                   Variant="Variant.Outlined"
                                   Clearable="true"
                                   HelperText="Die Art bestimmt, welche Felder dieses Item hat.">
                            @foreach (var type in _context.AvailableTypes)
                            {
                                <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                            }
                        </MudSelect>

                        @if (_context.AvailableTypes.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">
                                Es gibt noch keine Item-Arten.
                                <MudLink Href="/modules/items/arten" Color="Color.Primary">Jetzt eine anlegen</MudLink>,
                                um eigene Felder wie Schaden oder Gewicht zu definieren.
                            </MudAlert>
                        }
                    </MudStack>
                </MudPaper>

                @* ------------------------------------------------------------------ Sprites *@
                <AssetSpritePanel ModuleKey="@ModuleKeys.Items"
                                  EntityId="_context.Entity.Id"
                                  Disabled="_context.IsNew" />

                @* ------------------------------------------------------------------- Felder *@
                <div>
                    <ContentFieldsPanel TEntity="Item"
                                        Context="_context"
                                        ModuleKey="@ModuleKeys.Items"
                                        TypesRoute="/modules/items/arten"
                                        IndividualHint="Für einzigartige Werte, die kein anderes Item dieser Art hat — etwa die Sonderfunktion eines exotischen Items."
                                        OnValueChanged="MarkDirty"
                                        OnFieldDefinitionChanged="ReloadKeepingChangesAsync" />
                </div>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudStack Spacing="4">
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">Referenz</MudText>

                    <MudText Typo="Typo.caption" Color="Color.Secondary">GUID</MudText>
                    <EntityIdChip Id="_context.Entity.Id" />

                    @if (_context.IsNew)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                            Wird beim Speichern vergeben.
                        </MudText>
                    }
                    else
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Angelegt</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">Zuletzt geändert</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                    }
                </MudPaper>

                @if (!_context.IsNew)
                {
                    @* --------------------------------------------------------- Crafting *@
                    <MudPaper Elevation="0" Class="gdm-panel pa-4">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                            <MudText Typo="Typo.overline" Color="Color.Secondary">Crafting</MudText>
                            @if (_produces.Count > 0)
                            {
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Text"
                                           StartIcon="@Icons.Material.Filled.AccountTree"
                                           Href="@($"/modules/crafting/baum/{_context.Entity.Id}")">
                                    Baum
                                </MudButton>
                            }
                        </MudStack>

                        @if (_produces.Count == 0 && _consumes.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Dieses Item kommt in keinem Rezept vor.
                            </MudText>
                        }
                        else
                        {
                            @if (_produces.Count > 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Wird hergestellt durch</MudText>
                                @foreach (var recipe in _produces)
                                {
                                    <div>
                                        <MudLink Href="@($"/modules/crafting/{recipe.Id}")" Typo="Typo.body2">
                                            @recipe.Name
                                        </MudLink>
                                    </div>
                                }
                            }

                            @if (_consumes.Count > 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">Wird gebraucht für</MudText>
                                @foreach (var recipe in _consumes)
                                {
                                    <div>
                                        <MudLink Href="@($"/modules/crafting/{recipe.Id}")" Typo="Typo.body2">
                                            @recipe.Name
                                        </MudLink>
                                    </div>
                                }
                            }
                        }
                    </MudPaper>

                    @* ------------------------------------------------------------ Handel *@
                    <MudPaper Elevation="0" Class="gdm-panel pa-4">
                        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">Bezugsquellen</MudText>

                        @if (_traders.Count == 0 && _lootSources.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Kein Händler führt dieses Item, und es fällt aus keiner Loot-Table.
                            </MudText>
                        }
                        else
                        {
                            @if (_traders.Count > 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Händler</MudText>
                                @foreach (var trader in _traders)
                                {
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"
                                              Class="gdm-field-row py-1">
                                        <MudLink Href="@($"/modules/npcs/{trader.NpcId}")" Typo="Typo.body2">
                                            @trader.NpcName
                                        </MudLink>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="gdm-mono">
                                            @DescribePrices(trader)
                                        </MudText>
                                    </MudStack>
                                }
                            }

                            @if (_lootSources.Count > 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">Fällt aus</MudText>
                                @foreach (var source in _lootSources)
                                {
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"
                                              Class="gdm-field-row py-1">
                                        <MudLink Href="@($"/modules/loot/{source.LootTableId}")" Typo="Typo.body2">
                                            @source.LootTableName
                                        </MudLink>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="gdm-mono">
                                            @source.Chance.ToString("0.##") % · @DescribeQuantity(source)
                                        </MudText>
                                    </MudStack>
                                }
                            }
                        }
                    </MudPaper>

                    <EntityTagsPanel ModuleKey="@ModuleKeys.Items" EntityId="_context.Entity.Id" />
                    <ReferencesPanel @ref="_referencesPanel" EntityId="_context.Entity.Id" />
                }
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Items);

    [Parameter]
    public Guid? Id { get; set; }

    private ContentEditContext<Item>? _context;
    private ReferencesPanel? _referencesPanel;
    private List<RecipeListRow> _produces = [];
    private List<RecipeListRow> _consumes = [];
    private List<TraderForItem> _traders = [];
    private List<LootSourceForItem> _lootSources = [];
    private Guid? _loadedId;
    private bool _notFound;
    private bool _saving;
    private bool _dirty;

    private string PageHeading => _context switch
    {
        null => "Item",
        { IsNew: true } => "Neues Item",
        { Entity.Name: var name } when !string.IsNullOrWhiteSpace(name) => name,
        _ => "Item ohne Namen"
    };

    private List<BreadcrumbItem> Breadcrumbs => [new(PageHeading, null, disabled: true)];

    protected override async Task OnParametersSetAsync()
    {
        if (_context is not null && _loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _notFound = false;
        _dirty = false;
        _context = null;
        _produces = [];
        _consumes = [];
        _traders = [];
        _lootSources = [];

        var projectId = await Project.GetCurrentIdAsync();
        _context = await Items.LoadForEditAsync(projectId, Id);

        if (_context is null)
        {
            _notFound = true;
            return;
        }

        if (!_context.IsNew)
        {
            (_produces, _consumes) = await Crafting.GetRecipesForItemAsync(projectId, _context.Entity.Id);
            _traders = await Npcs.GetTradersForItemAsync(projectId, _context.Entity.Id);
            _lootSources = await Loot.GetTablesForItemAsync(projectId, _context.Entity.Id);
        }
    }

    private static string DescribeQuantity(LootSourceForItem source) =>
        source.MinQuantity == source.MaxQuantity
            ? $"{source.MinQuantity}×"
            : $"{source.MinQuantity}–{source.MaxQuantity}×";

    /// <summary>Kurzfassung der Preise eines Händlers für die Seitenleiste.</summary>
    private static string DescribePrices(TraderForItem trader)
    {
        var parts = new List<string>();

        if (trader.SellPrice is { } sell)
        {
            parts.Add($"VK {sell:0.##}");
        }

        if (trader.BuyPrice is { } buy)
        {
            parts.Add($"AK {buy:0.##}");
        }

        if (parts.Count == 0)
        {
            return "ohne Preis";
        }

        return string.IsNullOrWhiteSpace(trader.CurrencyLabel)
            ? string.Join(" · ", parts)
            : $"{string.Join(" · ", parts)} {trader.CurrencyLabel}";
    }

    private void ChangeType(Guid? contentTypeId)
    {
        if (_context is null)
        {
            return;
        }

        _context.Entity.ContentTypeId = contentTypeId;
        MarkDirty();
    }

    private void Touch(Action change)
    {
        change();
        MarkDirty();
    }

    private void MarkDirty() => _dirty = true;

    private async Task SaveAsync()
    {
        if (_context is null)
        {
            return;
        }

        _saving = true;

        try
        {
            var wasNew = _context.IsNew;
            await Items.SaveItemAsync(_context);
            _dirty = false;

            Snackbar.Add($"„{_context.Entity.Name}“ wurde gespeichert.", Severity.Success);

            if (wasNew)
            {
                // Erst ab jetzt gibt es Sprites, individuelle Felder und eine Referenzansicht.
                Navigation.NavigateTo($"/modules/items/{_context.Entity.Id}");
                return;
            }

            if (_referencesPanel is not null)
            {
                await _referencesPanel.RefreshAsync();
            }
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_context is null)
        {
            return;
        }

        var usedBy = _produces.Count + _consumes.Count;
        var warning = usedBy == 0
            ? string.Empty
            : $" Achtung: {usedBy} Rezept(e) verweisen darauf und stehen danach ins Leere.";

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Item löschen",
            $"„{_context.Entity.Name}“ wird mit allen Feldwerten, individuellen Feldern und Sprites gelöscht.{warning}",
            yesText: "Löschen",
            cancelText: "Abbrechen");

        if (confirmed != true)
        {
            return;
        }

        await Items.DeleteItemAsync(_context.Entity.Id);
        Snackbar.Add("Item gelöscht.", Severity.Success);
        Navigation.NavigateTo("/modules/items");
    }

    /// <summary>
    /// Lädt Felder und Werte neu, nachdem eine Felddefinition geändert wurde. Die noch nicht
    /// gespeicherten Stammdaten der Maske bleiben erhalten.
    /// </summary>
    private async Task ReloadKeepingChangesAsync()
    {
        if (_context is null)
        {
            return;
        }

        var name = _context.Entity.Name;
        var description = _context.Entity.Description;
        var contentTypeId = _context.Entity.ContentTypeId;
        var wasDirty = _dirty;

        var projectId = await Project.GetCurrentIdAsync();
        var reloaded = await Items.LoadForEditAsync(projectId, _context.Entity.Id);

        if (reloaded is null)
        {
            _notFound = true;
            _context = null;
            return;
        }

        reloaded.Entity.Name = name;
        reloaded.Entity.Description = description;
        reloaded.Entity.ContentTypeId = contentTypeId;

        _context = reloaded;
        _dirty = wasDirty;
    }
}
