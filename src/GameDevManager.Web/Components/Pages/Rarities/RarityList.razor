@page "/modules/rarities"
@inject RarityService Rarities
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IStringLocalizer<RarityList> L

<PageTitle>@L["PageTitle"]</PageTitle>

<ModuleHeader Module="Module" Subtitle="@Subtitle">
    <Actions>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/modules/rarities/neu">
            @L["NewRarity"]
        </MudButton>
    </Actions>
</ModuleHeader>

@if (_rarities is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_rarities.Count == 0)
{
    <div class="gdm-empty">
        <MudIcon Icon="@Icons.Material.Filled.Diamond" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
        <MudText Typo="Typo.h6">@L["EmptyTitle"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            @L["EmptyHint"]
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/modules/rarities/neu">
            @L["FirstRarity"]
        </MudButton>
    </div>
}
else
{
    var filtered = Filtered;

    <MudPaper Elevation="0" Class="gdm-panel pa-4 mb-4">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_search"
                          Placeholder="@L["SearchPlaceholder"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="max-width:360px;" />

            <MudSpacer />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["FilterCount", filtered.Count, _rarities.Count]</MudText>
        </MudStack>
    </MudPaper>

    @if (filtered.Count == 0)
    {
        <MudPaper Elevation="0" Class="gdm-panel pa-4">
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["NoRecords"]</MudText>
        </MudPaper>
    }
    else
    {
        <div class="gdm-item-grid">
            @foreach (var rarity in filtered)
            {
                <EntityContextMenu ModuleKey="@Module.Id"
                                   EntityId="rarity.Id"
                                   Name="@rarity.Name"
                                   EditRoute="/modules/rarities"
                                   OnDelete="@(() => DeleteAsync(rarity))">
                    <MudPaper Elevation="0" Class="gdm-panel gdm-card-link">
                        <MudLink Href="@($"/modules/rarities/{rarity.Id}")" Underline="Underline.None">
                            <AssetThumbnail AssetId="rarity.PrimaryAssetId"
                                            Class="gdm-item-tile"
                                            Alt="@rarity.Name"
                                            FallbackIcon="@Icons.Material.Filled.Diamond" />
                        </MudLink>

                        <div class="pa-3">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                                <MudLink Href="@($"/modules/rarities/{rarity.Id}")" Typo="Typo.body1" Class="gdm-ellipsis">
                                    <b>@rarity.Name</b>
                                </MudLink>
                                <EntityDuplicateButton ModuleKey="@Module.Id"
                                                       EntityId="rarity.Id"
                                                       Name="@rarity.Name"
                                                       EditRoute="/modules/rarities" />
                                <MudTooltip Text="@L["DeleteTooltip"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                   Size="Size.Small"
                                                   OnClick="@(() => DeleteAsync(rarity))"
                                                   aria-label="@L["DeleteAria", rarity.Name]" />
                                </MudTooltip>
                            </MudStack>

                            @if (!string.IsNullOrWhiteSpace(rarity.Description))
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="gdm-ellipsis">
                                    @rarity.Description
                                </MudText>
                            }

                            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mt-2">
                                @* Der Rang ist die Reihenfolge der Stufen — er gehört auch auf die Kachel. *@
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="gdm-mono">
                                    @L["RankChip", rarity.SortOrder]
                                </MudChip>
                                @if (!string.IsNullOrWhiteSpace(rarity.Color))
                                {
                                    <span class="gdm-color-dot" style="@($"background-color:{rarity.Color};")"></span>
                                    <MudText Typo="Typo.caption" Class="gdm-mono">@rarity.Color</MudText>
                                }
                            </MudStack>

                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                @L["UpdatedAt", rarity.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")]
                            </MudText>
                        </div>
                    </MudPaper>
                </EntityContextMenu>
            }
        </div>
    }
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Rarities);

    private List<RarityListRow>? _rarities;
    private string? _search;

    private string Subtitle => _rarities is null
        ? L["Loading"]
        : L["SubtitleCount", _rarities.Count];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var projectId = await Project.GetCurrentIdAsync();
        _rarities = await Rarities.GetRaritiesAsync(projectId);
    }

    private List<RarityListRow> Filtered
    {
        get
        {
            IEnumerable<RarityListRow> rows = _rarities ?? [];

            if (!string.IsNullOrWhiteSpace(_search))
            {
                rows = rows.Where(row =>
                    row.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (row.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return [.. rows];
        }
    }

    private async Task DeleteAsync(RarityListRow row)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", row.Name],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Rarities.DeleteRarityAsync(row.Id);
        Snackbar.Add(L["DeletedMessage", row.Name], Severity.Success);
        await LoadAsync();
    }
}
