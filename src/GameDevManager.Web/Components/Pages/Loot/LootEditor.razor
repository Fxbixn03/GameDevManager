@page "/modules/loot/neu"
@page "/modules/loot/{Id:guid}"
@inject LootService Loot
@inject ReferenceService References
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@PageHeading – GameDevManager</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        Es gibt keine Loot-Table mit dieser GUID. Vielleicht wurde sie gelöscht.
    </MudAlert>
    <MudButton Variant="Variant.Outlined" Href="/modules/loot">Zurück zur Übersicht</MudButton>
}
else if (_context is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <ModuleHeader Module="Module"
                  Title="@PageHeading"
                  Subtitle="@(_context.IsNew ? "Noch nicht gespeichert" : null)"
                  Breadcrumbs="Breadcrumbs">
        <Actions>
            @if (_dirty)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                    Ungespeicherte Änderungen
                </MudChip>
            }
            @if (!_context.IsNew)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteOutline"
                           OnClick="DeleteAsync">
                    Löschen
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Href="/modules/loot">Abbrechen</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       Disabled="_saving"
                       OnClick="SaveAsync">
                Speichern
            </MudButton>
        </Actions>
    </ModuleHeader>

    <MudGrid Spacing="4">
        <MudItem xs="12" md="8">
            <MudStack Spacing="4">

                @* ------------------------------------------------------------- Stammdaten *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">Stammdaten</MudText>

                    <MudStack Spacing="4">
                        <MudTextField Value="_context.Entity.Name"
                                      ValueChanged="@((string name) => Touch(() => _context.Entity.Name = name))"
                                      T="string"
                                      Label="Name *"
                                      Variant="Variant.Outlined"
                                      Immediate="true" />

                        <MudTextField Value="_context.Entity.Description"
                                      ValueChanged="@((string text) => Touch(() => _context.Entity.Description = text))"
                                      T="string"
                                      Label="Beschreibung"
                                      Variant="Variant.Outlined"
                                      Lines="2" />

                        <MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap">
                            <MudSelect T="LootRollMode"
                                       Value="_context.Entity.RollMode"
                                       ValueChanged="@((LootRollMode mode) => Touch(() => _context.Entity.RollMode = mode))"
                                       Label="Wurf"
                                       Variant="Variant.Outlined"
                                       HelperText="@RollModeHint"
                                       Style="max-width:280px;">
                                <MudSelectItem T="LootRollMode" Value="@(LootRollMode.Independent)">
                                    Unabhängig je Eintrag
                                </MudSelectItem>
                                <MudSelectItem T="LootRollMode" Value="@(LootRollMode.SinglePick)">
                                    Einzelwurf über alle
                                </MudSelectItem>
                            </MudSelect>

                            <MudSelect T="Guid?"
                                       Value="_context.Entity.ContentTypeId"
                                       ValueChanged="ChangeType"
                                       Label="Loot-Art"
                                       Variant="Variant.Outlined"
                                       Clearable="true"
                                       Style="max-width:240px;">
                                @foreach (var type in _context.AvailableTypes)
                                {
                                    <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudStack>
                    </MudStack>
                </MudPaper>

                @* ------------------------------------------------------------------ Einträge *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Einträge</MudText>
                        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2"
                                     Class="gdm-mono"
                                     Color="@(IsOverfull ? Color.Warning : Color.Secondary)">
                                @TotalChance.ToString("0.##") %
                            </MudText>
                            <MudButton StartIcon="@Icons.Material.Filled.Add"
                                       Size="Size.Small"
                                       Disabled="@(_items.Count == 0)"
                                       OnClick="AddEntry">
                                Eintrag
                            </MudButton>
                        </MudStack>
                    </MudStack>

                    @if (IsOverfull)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                            Bei einem Einzelwurf teilen sich die Einträge eine Ziehung. Über 100 %
                            hinaus sind die hinteren Einträge unerreichbar.
                        </MudAlert>
                    }

                    @if (_items.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">
                            Es gibt noch keine Items —
                            <MudLink Href="/modules/items" Color="Color.Primary">jetzt welche anlegen</MudLink>.
                        </MudAlert>
                    }
                    else if (_context.Entity.Entries.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Noch kein Eintrag. Dasselbe Item darf mehrfach vorkommen — etwa zu 50 %
                            eine Münze und zu 5 % gleich zwanzig.
                        </MudText>
                    }
                    else
                    {
                        @foreach (var entry in _context.Entity.Entries)
                        {
                            <div class="pa-2 gdm-field-row">
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" sm="5">
                                        <MudAutocomplete T="EntitySummary"
                                                         Value="@ItemFor(entry.ItemId)"
                                                         ValueChanged="@((EntitySummary? e) => Touch(() => entry.ItemId = e?.Id ?? Guid.Empty))"
                                                         SearchFunc="SearchItemsAsync"
                                                         ToStringFunc="@(e => e?.Name ?? string.Empty)"
                                                         Label="Item"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         Clearable="true"
                                                         ResetValueOnEmptyText="true"
                                                         CoerceValue="false"
                                                         MaxItems="50" />
                                    </MudItem>

                                    <MudItem xs="6" sm="3">
                                        <MudNumericField T="double"
                                                         Value="entry.Chance"
                                                         ValueChanged="@((double v) => Touch(() => entry.Chance = v))"
                                                         Label="Chance"
                                                         Adornment="Adornment.End"
                                                         AdornmentText="%"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         Min="0"
                                                         Max="100" />
                                    </MudItem>

                                    <MudItem xs="3" sm="2">
                                        <MudNumericField T="int"
                                                         Value="entry.MinQuantity"
                                                         ValueChanged="@((int v) => Touch(() => entry.MinQuantity = v))"
                                                         Label="von"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         Min="1" />
                                    </MudItem>

                                    <MudItem xs="3" sm="2" Class="d-flex align-center">
                                        <MudNumericField T="int"
                                                         Value="entry.MaxQuantity"
                                                         ValueChanged="@((int v) => Touch(() => entry.MaxQuantity = v))"
                                                         Label="bis"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         Min="1" />
                                        <MudTooltip Text="Eintrag entfernen">
                                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                           Size="Size.Small"
                                                           OnClick="@(() => RemoveEntry(entry))"
                                                           aria-label="Eintrag entfernen" />
                                        </MudTooltip>
                                    </MudItem>
                                </MudGrid>
                            </div>
                        }
                    }
                </MudPaper>

                @* ------------------------------------------------------------------- Felder *@
                <div>
                    <ContentFieldsPanel TEntity="LootTable"
                                        Context="_context"
                                        ModuleKey="@ModuleKeys.Loot"
                                        TypesRoute="/modules/loot/arten"
                                        IndividualHint="Für Angaben, die nur diese eine Tabelle braucht."
                                        OnValueChanged="MarkDirty"
                                        OnFieldDefinitionChanged="ReloadKeepingChangesAsync" />
                </div>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudStack Spacing="4">
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">Referenz</MudText>

                    <MudText Typo="Typo.caption" Color="Color.Secondary">GUID</MudText>
                    <EntityIdChip Id="_context.Entity.Id" />

                    @if (!_context.IsNew)
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Angelegt</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">Zuletzt geändert</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                    }
                </MudPaper>

                @if (!_context.IsNew)
                {
                    <ReferencesPanel @ref="_referencesPanel" EntityId="_context.Entity.Id" />
                }
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Loot);

    [Parameter]
    public Guid? Id { get; set; }

    private ContentEditContext<LootTable>? _context;
    private ReferencesPanel? _referencesPanel;
    private List<EntitySummary> _items = [];
    private Guid? _loadedId;
    private bool _notFound;
    private bool _saving;
    private bool _dirty;

    private string PageHeading => _context switch
    {
        null => "Loot-Table",
        { IsNew: true } => "Neue Loot-Table",
        { Entity.Name: var name } when !string.IsNullOrWhiteSpace(name) => name,
        _ => "Loot-Table ohne Namen"
    };

    private List<BreadcrumbItem> Breadcrumbs => [new(PageHeading, null, disabled: true)];

    private double TotalChance => _context?.Entity.Entries.Sum(entry => entry.Chance) ?? 0;

    private bool IsOverfull =>
        _context?.Entity.RollMode == LootRollMode.SinglePick && TotalChance > 100.0001;

    private string RollModeHint => _context?.Entity.RollMode == LootRollMode.SinglePick
        ? "Höchstens ein Eintrag fällt; die Chancen teilen sich einen Wurf."
        : "Jeder Eintrag wird einzeln gewürfelt — mehrere Treffer sind möglich.";

    protected override async Task OnParametersSetAsync()
    {
        if (_context is not null && _loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _notFound = false;
        _dirty = false;
        _context = null;

        var projectId = await Project.GetCurrentIdAsync();
        _items = await References.GetEntitiesAsync(projectId, ModuleKeys.Items);
        _context = await Loot.LoadForEditAsync(projectId, Id);

        if (_context is null)
        {
            _notFound = true;
        }
    }

    private EntitySummary? ItemFor(Guid itemId) => _items.FirstOrDefault(entity => entity.Id == itemId);

    private Task<IEnumerable<EntitySummary>> SearchItemsAsync(string? search, CancellationToken ct)
    {
        IEnumerable<EntitySummary> matches = string.IsNullOrWhiteSpace(search)
            ? _items
            : _items.Where(entity => entity.Name.Contains(search, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(matches);
    }

    private void AddEntry() =>
        Touch(() => _context!.Entity.Entries.Add(new LootEntry
        {
            LootTableId = _context.Entity.Id,
            ItemId = Guid.Empty,
            Chance = 100,
            MinQuantity = 1,
            MaxQuantity = 1,
            SortOrder = _context.Entity.Entries.Count
        }));

    private void RemoveEntry(LootEntry entry) =>
        Touch(() => _context!.Entity.Entries.Remove(entry));

    private void ChangeType(Guid? contentTypeId) =>
        Touch(() => _context!.Entity.ContentTypeId = contentTypeId);

    private void Touch(Action change)
    {
        change();
        MarkDirty();
    }

    private void MarkDirty() => _dirty = true;

    private async Task SaveAsync()
    {
        if (_context is null)
        {
            return;
        }

        // Leere Eingabezeilen sind ein Bedienschritt, kein Inhalt.
        _context.Entity.Entries.RemoveAll(entry => entry.ItemId == Guid.Empty);

        _saving = true;

        try
        {
            var wasNew = _context.IsNew;
            await Loot.SaveTableAsync(_context);
            _dirty = false;

            Snackbar.Add($"„{_context.Entity.Name}“ wurde gespeichert.", Severity.Success);

            if (wasNew)
            {
                Navigation.NavigateTo($"/modules/loot/{_context.Entity.Id}");
                return;
            }

            if (_referencesPanel is not null)
            {
                await _referencesPanel.RefreshAsync();
            }
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_context is null)
        {
            return;
        }

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Loot-Table löschen",
            $"„{_context.Entity.Name}“ wird mit ihren Einträgen gelöscht. NPCs, die darauf verweisen, verlieren ihre Zuordnung.",
            yesText: "Löschen",
            cancelText: "Abbrechen");

        if (confirmed != true)
        {
            return;
        }

        await Loot.DeleteTableAsync(_context.Entity.Id);
        Snackbar.Add("Loot-Table gelöscht.", Severity.Success);
        Navigation.NavigateTo("/modules/loot");
    }

    /// <summary>
    /// Lädt nach einer Änderung an den Felddefinitionen neu und behält dabei, was in der Maske
    /// noch nicht gespeichert ist.
    /// </summary>
    private async Task ReloadKeepingChangesAsync()
    {
        if (_context is null)
        {
            return;
        }

        var entity = _context.Entity;
        var wasDirty = _dirty;

        var projectId = await Project.GetCurrentIdAsync();
        var reloaded = await Loot.LoadForEditAsync(projectId, entity.Id);

        if (reloaded is null)
        {
            _notFound = true;
            _context = null;
            return;
        }

        reloaded.Entity.Name = entity.Name;
        reloaded.Entity.Description = entity.Description;
        reloaded.Entity.ContentTypeId = entity.ContentTypeId;
        reloaded.Entity.RollMode = entity.RollMode;
        reloaded.Entity.Entries = entity.Entries;

        _context = reloaded;
        _dirty = wasDirty;
    }
}
