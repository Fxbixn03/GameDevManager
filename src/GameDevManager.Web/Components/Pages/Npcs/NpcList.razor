@page "/modules/npcs"
@inject NpcService Npcs
@inject ContentTypeService ContentTypes
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IStringLocalizer<NpcList> L

<PageTitle>@L["PageTitle"]</PageTitle>

<ModuleHeader Module="Module" Subtitle="@Subtitle">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Style"
                   Href="/modules/npcs/arten">
            @L["TypesButton"]
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   data-gdm-new
                   Href="/modules/npcs/neu">
            @L["NewNpc"]
        </MudButton>
    </Actions>
</ModuleHeader>

@if (_npcs is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_npcs.Count == 0)
{
    <div class="gdm-empty">
        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
        <MudText Typo="Typo.h6">@L["EmptyTitle"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            @L["EmptyHint"]
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/modules/npcs/neu">@L["FirstNpc"]</MudButton>
    </div>
}
else
{
    var filtered = Filtered;

    <MudPaper Elevation="0" Class="gdm-panel pa-4 mb-4">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_search"
                          Placeholder="@L["SearchPlaceholder"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="max-width:320px;" />

            @* Der Konzept-Wunsch: NPCs und Mobs zusammen, aber filterbar. *@
            <MudSelect T="NpcKind?"
                       @bind-Value="_kindFilter"
                       Label="@L["KindFilterLabel"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="max-width:150px;">
                <MudSelectItem T="NpcKind?" Value="@(NpcKind.Npc)">@L["KindFilterNpcs"]</MudSelectItem>
                <MudSelectItem T="NpcKind?" Value="@(NpcKind.Mob)">@L["KindFilterMobs"]</MudSelectItem>
            </MudSelect>

            <MudSelect T="RoleFilter"
                       @bind-Value="_roleFilter"
                       Label="@L["RoleFilterLabel"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Style="max-width:180px;">
                <MudSelectItem T="RoleFilter" Value="RoleFilter.Any">@L["RoleAny"]</MudSelectItem>
                <MudSelectItem T="RoleFilter" Value="RoleFilter.Trader">@L["RoleTrader"]</MudSelectItem>
                <MudSelectItem T="RoleFilter" Value="RoleFilter.QuestGiver">@L["RoleQuestGiver"]</MudSelectItem>
                <MudSelectItem T="RoleFilter" Value="RoleFilter.None">@L["RoleNone"]</MudSelectItem>
            </MudSelect>

            <MudSelect T="Guid?"
                       @bind-Value="_typeFilter"
                       Label="@L["TypeFilterLabel"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="max-width:200px;">
                @foreach (var type in _types)
                {
                    <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSpacer />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["FilterCount", filtered.Count, _npcs.Count]</MudText>
        </MudStack>
    </MudPaper>

    @if (filtered.Count == 0)
    {
        <MudPaper Elevation="0" Class="gdm-panel pa-4">
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["NoRecords"]</MudText>
        </MudPaper>
    }
    else
    {
        <div class="gdm-item-grid">
            @foreach (var npc in filtered)
            {
                <EntityContextMenu ModuleKey="@Module.Id"
                                   EntityId="npc.Id"
                                   Name="@npc.Name"
                                   EditRoute="/modules/npcs"
                                   OnDelete="@(() => DeleteAsync(npc))">
                    <MudPaper Elevation="0" Class="gdm-panel gdm-card-link">
                        <MudLink Href="@($"/modules/npcs/{npc.Id}")" Underline="Underline.None">
                            <AssetThumbnail AssetId="npc.PrimaryAssetId"
                                            Class="gdm-item-tile"
                                            Alt="@npc.Name"
                                            FallbackIcon="@(npc.Kind == NpcKind.Mob ? Icons.Material.Filled.Pets : Icons.Material.Filled.Person)" />
                        </MudLink>

                        <div class="pa-3">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                                <MudLink Href="@($"/modules/npcs/{npc.Id}")" Typo="Typo.body1" Class="gdm-ellipsis">
                                    <b>@npc.Name</b>
                                </MudLink>
                                <EntityDuplicateButton ModuleKey="@Module.Id"
                                                       EntityId="npc.Id"
                                                       Name="@npc.Name"
                                                       EditRoute="/modules/npcs" />
                                <MudTooltip Text="@L["DeleteTooltip"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                   Size="Size.Small"
                                                   OnClick="@(() => DeleteAsync(npc))"
                                                   aria-label="@L["DeleteAria", npc.Name]" />
                                </MudTooltip>
                            </MudStack>

                            @if (!string.IsNullOrWhiteSpace(npc.Description))
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="gdm-ellipsis">
                                    @npc.Description
                                </MudText>
                            }

                            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-2">
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Variant="Variant.Text"
                                         Color="@(npc.Kind == NpcKind.Mob ? Color.Error : Color.Default)">
                                    @(npc.Kind == NpcKind.Mob ? L["KindMob"] : L["KindNpc"])
                                </MudChip>
                                @if (npc.IsTrader)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">
                                        @L["TraderChip", npc.OfferCount]
                                    </MudChip>
                                }
                                @if (npc.IsQuestGiver)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@L["QuestChip"]</MudChip>
                                }
                                @if (npc.TypeName is null)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NoType"]</MudText>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@npc.TypeName</MudChip>
                                }
                            </MudStack>

                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                @L["UpdatedAt", npc.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")]
                            </MudText>
                        </div>
                    </MudPaper>
                </EntityContextMenu>
            }
        </div>
    }
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Npcs);

    /// <summary>Nach welcher Rolle gefiltert wird.</summary>
    public enum RoleFilter
    {
        Any,
        Trader,
        QuestGiver,
        None
    }

    private List<NpcListRow>? _npcs;
    private List<ContentType> _types = [];
    private string? _search;
    private NpcKind? _kindFilter;
    private RoleFilter _roleFilter = RoleFilter.Any;
    private Guid? _typeFilter;

    private string Subtitle
    {
        get
        {
            if (_npcs is null)
            {
                return L["Loading"];
            }

            var mobs = _npcs.Count(row => row.Kind == NpcKind.Mob);
            var traders = _npcs.Count(row => row.IsTrader);

            return L["SubtitleCount", _npcs.Count - mobs, mobs, traders];
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var projectId = await Project.GetCurrentIdAsync();
        _types = await ContentTypes.GetTypesAsync(projectId, ModuleKeys.Npcs);
        _npcs = await Npcs.GetNpcsAsync(projectId);
    }

    private List<NpcListRow> Filtered
    {
        get
        {
            IEnumerable<NpcListRow> rows = _npcs ?? [];

            if (_kindFilter is { } kind)
            {
                rows = rows.Where(row => row.Kind == kind);
            }

            rows = _roleFilter switch
            {
                RoleFilter.Trader => rows.Where(row => row.IsTrader),
                RoleFilter.QuestGiver => rows.Where(row => row.IsQuestGiver),
                RoleFilter.None => rows.Where(row => !row.IsTrader && !row.IsQuestGiver),
                _ => rows
            };

            if (_typeFilter is { } typeId)
            {
                rows = rows.Where(row => row.ContentTypeId == typeId);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                rows = rows.Where(row =>
                    row.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (row.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return [.. rows];
        }
    }

    private async Task DeleteAsync(NpcListRow row)
    {
        var warning = row.OfferCount == 0
            ? string.Empty
            : L["DeleteOfferWarning", row.OfferCount];

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", row.Name, warning],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Npcs.DeleteNpcAsync(row.Id);
        Snackbar.Add(L["DeletedMessage", row.Name], Severity.Success);
        await LoadAsync();
    }
}
