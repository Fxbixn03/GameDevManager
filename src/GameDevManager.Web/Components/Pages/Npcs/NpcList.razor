@page "/modules/npcs"
@inject NpcService Npcs
@inject ContentTypeService ContentTypes
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>NPCs – GameDevManager</PageTitle>

<ModuleHeader Module="Module" Subtitle="@Subtitle">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Style"
                   Href="/modules/npcs/arten">
            NPC-Arten
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/modules/npcs/neu">
            Neuer NPC
        </MudButton>
    </Actions>
</ModuleHeader>

@if (_npcs is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_npcs.Count == 0)
{
    <div class="gdm-empty">
        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
        <MudText Typo="Typo.h6">Noch keine NPCs</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            NPCs und Mobs liegen zusammen und lassen sich gegeneinander filtern. Ein NPC kann
            Händler sein, Quests vergeben, beides oder nichts davon.
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/modules/npcs/neu">Ersten NPC anlegen</MudButton>
    </div>
}
else
{
    <MudPaper Elevation="0" Class="gdm-panel pa-4 mb-4">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_search"
                          Placeholder="Nach Name oder Beschreibung suchen"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="max-width:320px;" />

            @* Der Konzept-Wunsch: NPCs und Mobs zusammen, aber filterbar. *@
            <MudSelect T="NpcKind?"
                       @bind-Value="_kindFilter"
                       Label="Typ"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="max-width:150px;">
                <MudSelectItem T="NpcKind?" Value="@(NpcKind.Npc)">NPCs</MudSelectItem>
                <MudSelectItem T="NpcKind?" Value="@(NpcKind.Mob)">Mobs</MudSelectItem>
            </MudSelect>

            <MudSelect T="RoleFilter"
                       @bind-Value="_roleFilter"
                       Label="Rolle"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Style="max-width:180px;">
                <MudSelectItem T="RoleFilter" Value="RoleFilter.Any">Alle Rollen</MudSelectItem>
                <MudSelectItem T="RoleFilter" Value="RoleFilter.Trader">Händler</MudSelectItem>
                <MudSelectItem T="RoleFilter" Value="RoleFilter.QuestGiver">Questgeber</MudSelectItem>
                <MudSelectItem T="RoleFilter" Value="RoleFilter.None">Ohne Rolle</MudSelectItem>
            </MudSelect>

            <MudSelect T="Guid?"
                       @bind-Value="_typeFilter"
                       Label="Art"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="max-width:200px;">
                @foreach (var type in _types)
                {
                    <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSpacer />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Filtered.Count von @_npcs.Count</MudText>
        </MudStack>
    </MudPaper>

    <MudTable T="NpcListRow"
              Items="Filtered"
              Elevation="0"
              Hover="true"
              Dense="true"
              Breakpoint="Breakpoint.Sm"
              OnRowClick="OpenRow"
              RowClass="cursor-pointer">
        <HeaderContent>
            <MudTh Style="width:56px;"></MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Typ</MudTh>
            <MudTh>Rollen</MudTh>
            <MudTh>Art</MudTh>
            <MudTh>Beschreibung</MudTh>
            <MudTh Style="width:56px;"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Sprite">
                <AssetThumbnail AssetId="context.PrimaryAssetId"
                                Size="Size.Small"
                                Alt="@context.Name"
                                FallbackIcon="@(context.Kind == NpcKind.Mob ? Icons.Material.Filled.Pets : Icons.Material.Filled.Person)" />
            </MudTd>
            <MudTd DataLabel="Name">
                <MudText Typo="Typo.body2"><b>@context.Name</b></MudText>
            </MudTd>
            <MudTd DataLabel="Typ">
                <MudChip T="string"
                         Size="Size.Small"
                         Variant="Variant.Outlined"
                         Color="@(context.Kind == NpcKind.Mob ? Color.Error : Color.Default)">
                    @(context.Kind == NpcKind.Mob ? "Mob" : "NPC")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Rollen">
                @if (!context.IsTrader && !context.IsQuestGiver)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
                }
                else
                {
                    <MudStack Row="true" Spacing="1">
                        @if (context.IsTrader)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">
                                Händler (@context.OfferCount)
                            </MudChip>
                        }
                        @if (context.IsQuestGiver)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text">Quest</MudChip>
                        }
                    </MudStack>
                }
            </MudTd>
            <MudTd DataLabel="Art">
                @if (context.TypeName is null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">ohne Art</MudText>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.TypeName</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Beschreibung">
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Shorten(context.Description)</MudText>
            </MudTd>
            <MudTd>
                <MudTooltip Text="Löschen">
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                   Size="Size.Small"
                                   OnClick="@(() => DeleteAsync(context))"
                                   aria-label="@($"{context.Name} löschen")" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">
                Kein NPC passt zu den Filtern.
            </MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Npcs);

    /// <summary>Nach welcher Rolle gefiltert wird.</summary>
    public enum RoleFilter
    {
        Any,
        Trader,
        QuestGiver,
        None
    }

    private List<NpcListRow>? _npcs;
    private List<ContentType> _types = [];
    private string? _search;
    private NpcKind? _kindFilter;
    private RoleFilter _roleFilter = RoleFilter.Any;
    private Guid? _typeFilter;

    private string Subtitle
    {
        get
        {
            if (_npcs is null)
            {
                return "Wird geladen …";
            }

            var mobs = _npcs.Count(row => row.Kind == NpcKind.Mob);
            var traders = _npcs.Count(row => row.IsTrader);

            return $"{_npcs.Count - mobs} NPC(s), {mobs} Mob(s), davon {traders} Händler";
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var projectId = await Project.GetCurrentIdAsync();
        _types = await ContentTypes.GetTypesAsync(projectId, ModuleKeys.Npcs);
        _npcs = await Npcs.GetNpcsAsync(projectId);
    }

    private List<NpcListRow> Filtered
    {
        get
        {
            IEnumerable<NpcListRow> rows = _npcs ?? [];

            if (_kindFilter is { } kind)
            {
                rows = rows.Where(row => row.Kind == kind);
            }

            rows = _roleFilter switch
            {
                RoleFilter.Trader => rows.Where(row => row.IsTrader),
                RoleFilter.QuestGiver => rows.Where(row => row.IsQuestGiver),
                RoleFilter.None => rows.Where(row => !row.IsTrader && !row.IsQuestGiver),
                _ => rows
            };

            if (_typeFilter is { } typeId)
            {
                rows = rows.Where(row => row.ContentTypeId == typeId);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                rows = rows.Where(row =>
                    row.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (row.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return [.. rows];
        }
    }

    private void OpenRow(TableRowClickEventArgs<NpcListRow> args)
    {
        if (args.Item is { } row)
        {
            Navigation.NavigateTo($"/modules/npcs/{row.Id}");
        }
    }

    private async Task DeleteAsync(NpcListRow row)
    {
        var warning = row.OfferCount == 0
            ? string.Empty
            : $" Das Warenangebot mit {row.OfferCount} Posten wird mitgelöscht.";

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "NPC löschen",
            $"„{row.Name}“ wird mit allen Feldwerten und Sprites gelöscht.{warning}",
            yesText: "Löschen",
            cancelText: "Abbrechen");

        if (confirmed != true)
        {
            return;
        }

        await Npcs.DeleteNpcAsync(row.Id);
        Snackbar.Add($"„{row.Name}“ wurde gelöscht.", Severity.Success);
        await LoadAsync();
    }

    private static string Shorten(string? text) =>
        string.IsNullOrWhiteSpace(text)
            ? "—"
            : text.Length <= 70 ? text : string.Concat(text.AsSpan(0, 70), "…");
}
