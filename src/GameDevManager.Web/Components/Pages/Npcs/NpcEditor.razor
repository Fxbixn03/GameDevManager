@page "/modules/npcs/neu"
@page "/modules/npcs/{Id:guid}"
@inject NpcService Npcs
@inject FactionService Factions
@inject MapService Maps
@inject ConditionService Conditions
@inject DialogueService Dialogues
@inject ReferenceService References
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<NpcEditor> L

<PageTitle>@L["PageTitle", PageHeading]</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @L["NotFoundMessage"]
    </MudAlert>
    <MudButton Variant="Variant.Outlined" Href="/modules/npcs">@L["BackToList"]</MudButton>
}
else if (_context is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <ModuleHeader Module="Module"
                  Title="@PageHeading"
                  Subtitle="@(_context.IsNew ? (string?)L["NotSavedYet"] : null)"
                  Breadcrumbs="Breadcrumbs">
        <Actions>
            @if (_dirty)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                    @L["UnsavedChanges"]
                </MudChip>
            }
            @if (!_context.IsNew)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteOutline"
                           OnClick="DeleteAsync">
                    @L["Delete"]
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Href="/modules/npcs">@L["Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       Disabled="_saving"
                       data-gdm-save
                       OnClick="SaveAsync">
                @L["Save"]
            </MudButton>
        </Actions>
    </ModuleHeader>

    <MudGrid Spacing="4">
        <MudItem xs="12" md="8">
            <MudStack Spacing="4">

                @* ------------------------------------------------------------- Stammdaten *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["MasterDataSection"]</MudText>

                    <MudStack Spacing="4">
                        <MudTextField Value="_context.Entity.Name"
                                      ValueChanged="@((string name) => Touch(() => _context.Entity.Name = name))"
                                      T="string"
                                      Label="@L["NameLabel"]"
                                      Variant="Variant.Outlined"
                                      Immediate="true" />

                        <MudTextField Value="_context.Entity.Description"
                                      ValueChanged="@((string text) => Touch(() => _context.Entity.Description = text))"
                                      T="string"
                                      Label="@L["DescriptionLabel"]"
                                      Variant="Variant.Outlined"
                                      Lines="3" />

                        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudSelect T="NpcKind"
                                       Value="_context.Entity.Kind"
                                       ValueChanged="@((NpcKind kind) => Touch(() => _context.Entity.Kind = kind))"
                                       Label="@L["KindLabel"]"
                                       Variant="Variant.Outlined"
                                       Style="max-width:180px;">
                                <MudSelectItem T="NpcKind" Value="@(NpcKind.Npc)">@L["KindNpc"]</MudSelectItem>
                                <MudSelectItem T="NpcKind" Value="@(NpcKind.Mob)">@L["KindMob"]</MudSelectItem>
                            </MudSelect>

                            <MudSelect T="Guid?"
                                       Value="_context.Entity.ContentTypeId"
                                       ValueChanged="ChangeType"
                                       Label="@L["TypeLabel"]"
                                       Variant="Variant.Outlined"
                                       Clearable="true"
                                       Style="max-width:240px;">
                                @foreach (var type in _context.AvailableTypes)
                                {
                                    <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudStack>

                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["RolesLabel"]</MudText>
                            <MudStack Row="true" Spacing="4" Wrap="Wrap.Wrap">
                                <MudSwitch T="bool"
                                           Value="_context.Entity.IsTrader"
                                           ValueChanged="@((bool on) => Touch(() => _context.Entity.IsTrader = on))"
                                           Color="Color.Primary"
                                           Label="@L["TraderLabel"]" />
                                <MudSwitch T="bool"
                                           Value="_context.Entity.IsQuestGiver"
                                           ValueChanged="@((bool on) => Touch(() => _context.Entity.IsQuestGiver = on))"
                                           Color="Color.Primary"
                                           Label="@L["QuestGiverLabel"]" />
                            </MudStack>
                        </div>

                        @* Einzigartige Figur oder wiederkehrender Spawn — unabhängig von NPC/Mob. *@
                        <div>
                            <MudSwitch T="bool"
                                       Value="_context.Entity.IsUnique"
                                       ValueChanged="@((bool on) => Touch(() => _context.Entity.IsUnique = on))"
                                       Color="Color.Primary"
                                       Label="@L["UniqueLabel"]" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @(_context.Entity.IsUnique ? L["UniqueOnHint"] : L["UniqueOffHint"])
                            </MudText>
                        </div>

                        @* Im Konzept: „Diese Loot-Tables sollen dann im NPC-Modul auswählbar sein.“ *@
                        <MudSelect T="Guid?"
                                   Value="_context.Entity.LootTableId"
                                   ValueChanged="@((Guid? id) => Touch(() => _context.Entity.LootTableId = id))"
                                   Label="@L["LootTableLabel"]"
                                   Variant="Variant.Outlined"
                                   Clearable="true"
                                   Disabled="@(_lootTables.Count == 0)"
                                   HelperText="@(_lootTables.Count == 0
                                       ? L["NoLootTablesHint"]
                                       : L["LootTableHint"])">
                            @foreach (var table in _lootTables)
                            {
                                <MudSelectItem T="Guid?" Value="@table.Id">@table.Name</MudSelectItem>
                            }
                        </MudSelect>

                        @* Im Konzept (Klassen-Modul): „auf die Spielerfigur und die NPCs gemappt“. *@
                        <MudSelect T="Guid?"
                                   Value="_context.Entity.CharacterClassId"
                                   ValueChanged="@((Guid? id) => Touch(() => _context.Entity.CharacterClassId = id))"
                                   Label="@L["ClassLabel"]"
                                   Variant="Variant.Outlined"
                                   Clearable="true"
                                   Disabled="@(_classes.Count == 0)"
                                   HelperText="@(_classes.Count == 0
                                       ? L["NoClassesHint"]
                                       : L["ClassHint"])">
                            @foreach (var characterClass in _classes)
                            {
                                <MudSelectItem T="Guid?" Value="@characterClass.Id">@characterClass.Name</MudSelectItem>
                            }
                        </MudSelect>

                        @if (_context.Entity.LootTableId is { } lootId)
                        {
                            <MudLink Href="@($"/modules/loot/{lootId}")" Typo="Typo.body2" Color="Color.Primary">
                                @L["OpenLootTable"]
                            </MudLink>
                        }
                    </MudStack>
                </MudPaper>

                @* --------------------------------------------------------- Warenangebot *@
                @if (_context.Entity.IsTrader)
                {
                    <MudPaper Elevation="0" Class="gdm-panel pa-4">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                            <MudText Typo="Typo.overline" Color="Color.Secondary">@L["OffersSection"]</MudText>
                            <MudButton StartIcon="@Icons.Material.Filled.Add"
                                       Size="Size.Small"
                                       Disabled="@(_items.Count == 0)"
                                       OnClick="AddOffer">
                                @L["AddOffer"]
                            </MudButton>
                        </MudStack>

                        @* Im Konzept: „Manche Shops … sind nur nach einer Bedingung verfügbar.“ *@
                        @if (!_context.IsNew)
                        {
                            <MudExpansionPanels Elevation="0" Class="mb-3">
                                <MudExpansionPanel Text="@(_shopConditionCount > 0 ? L["ShopAvailabilityCount", _shopConditionCount] : L["ShopAvailability"])">
                                    <ConditionEditor OwnerId="_context.Entity.Id"
                                                     OwnerModuleKey="@ModuleKeys.Npcs"
                                                     Slot="@ConditionSlots.Shop"
                                                     EmptyHint="@L["ShopConditionEmptyHint"]"
                                                     OnSaved="@((int count) => _shopConditionCount = count)" />
                                </MudExpansionPanel>
                            </MudExpansionPanels>
                        }

                        @if (_items.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">
                                @L["NoItemsToTrade"]
                                <MudLink Href="/modules/items" Color="Color.Primary">@L["CreateItemsNow"]</MudLink>.
                            </MudAlert>
                        }
                        else if (_context.Entity.Offers.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @L["NoOffersHint"]
                            </MudText>
                        }
                        else
                        {
                            @if (_currencies.Count == 0)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                                    @L["NoCurrenciesWarning"]
                                    <MudLink Href="/modules/currencies" Color="Color.Primary">@L["CreateCurrencyNow"]</MudLink>.
                                </MudAlert>
                            }

                            <MudStack Spacing="0">
                                @foreach (var offer in _context.Entity.Offers)
                                {
                                    <div class="pa-2 gdm-field-row">
                                        <MudGrid Spacing="2">
                                            <MudItem xs="12" sm="6" md="4">
                                                <MudAutocomplete T="EntitySummary"
                                                                 Value="@ItemFor(offer.ItemId)"
                                                                 ValueChanged="@((EntitySummary? e) => Touch(() => offer.ItemId = e?.Id ?? Guid.Empty))"
                                                                 SearchFunc="SearchItemsAsync"
                                                                 ToStringFunc="@(e => e?.Name ?? string.Empty)"
                                                                 Label="@L["ItemLabel"]"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Clearable="true"
                                                                 ResetValueOnEmptyText="true"
                                                                 CoerceValue="false"
                                                                 MaxItems="50" />
                                            </MudItem>

                                            <MudItem xs="6" sm="3" md="2">
                                                <MudNumericField T="double?"
                                                                 Value="offer.SellPrice"
                                                                 ValueChanged="@((double? v) => Touch(() => offer.SellPrice = v))"
                                                                 Label="@L["SellLabel"]"
                                                                 HelperText="@L["SellHelper"]"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Min="0"
                                                                 Clearable="true" />
                                            </MudItem>

                                            <MudItem xs="6" sm="3" md="2">
                                                <MudNumericField T="double?"
                                                                 Value="offer.BuyPrice"
                                                                 ValueChanged="@((double? v) => Touch(() => offer.BuyPrice = v))"
                                                                 Label="@L["BuyLabel"]"
                                                                 HelperText="@L["BuyHelper"]"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Min="0"
                                                                 Clearable="true" />
                                            </MudItem>

                                            <MudItem xs="12" sm="6" md="4">
                                                <MudSelect T="Guid?"
                                                           Value="offer.CurrencyId"
                                                           ValueChanged="@((Guid? v) => Touch(() => offer.CurrencyId = v))"
                                                           Label="@L["CurrencyLabel"]"
                                                           Variant="Variant.Outlined"
                                                           Margin="Margin.Dense"
                                                           Clearable="true">
                                                    @foreach (var currency in _currencies)
                                                    {
                                                        <MudSelectItem T="Guid?" Value="@currency.Id">@currency.Name</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudItem>

                                            <MudItem xs="6" sm="4" md="3">
                                                <MudNumericField T="int?"
                                                                 Value="offer.Stock"
                                                                 ValueChanged="@((int? v) => Touch(() => offer.Stock = v))"
                                                                 Label="@L["StockLabel"]"
                                                                 HelperText="@L["StockHelper"]"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Min="0"
                                                                 Clearable="true" />
                                            </MudItem>

                                            <MudItem xs="6" sm="4" md="3">
                                                <MudNumericField T="double?"
                                                                 Value="offer.RestockSeconds"
                                                                 ValueChanged="@((double? v) => Touch(() => offer.RestockSeconds = v))"
                                                                 Label="@L["RestockLabel"]"
                                                                 Adornment="Adornment.End"
                                                                 AdornmentText="s"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Min="0"
                                                                 Clearable="true" />
                                            </MudItem>

                                            <MudItem xs="12" sm="4" md="6" Class="d-flex align-center justify-end">
                                                @* „…teilweise auch nur Items aus einem Shop“ — je Posten eigene Bedingungen. *@
                                                <MudTooltip Text="@L["OfferConditionsTooltip"]">
                                                    <MudButton Size="Size.Small"
                                                               Variant="Variant.Text"
                                                               StartIcon="@Icons.Material.Filled.Rule"
                                                               Disabled="_context.IsNew"
                                                               OnClick="@(() => EditOfferConditionsAsync(offer))">
                                                        @(_offerConditionCounts.GetValueOrDefault(offer.Id) is var n && n > 0
                                                            ? L["ConditionsButtonCount", n] : L["ConditionsButton"])
                                                    </MudButton>
                                                </MudTooltip>
                                                <MudTooltip Text="@L["RemoveOffer"]">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                                   Size="Size.Small"
                                                                   OnClick="@(() => RemoveOffer(offer))"
                                                                   aria-label="@L["RemoveOffer"]" />
                                                </MudTooltip>
                                            </MudItem>
                                        </MudGrid>
                                    </div>
                                }
                            </MudStack>
                        }
                    </MudPaper>
                }

                @* ------------------------------------------- Persönlichkeit & Wesenszüge *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["PersonalitySection"]</MudText>

                    <MudStack Spacing="4">
                        <ChipListInput Value="@_context.Entity.Preferences"
                                       ValueChanged="@((string? v) => Touch(() => _context.Entity.Preferences = v))"
                                       Label="@L["PreferencesLabel"]"
                                       HelperText="@L["ChipInputHint"]" />

                        <ChipListInput Value="@_context.Entity.Personality"
                                       ValueChanged="@((string? v) => Touch(() => _context.Entity.Personality = v))"
                                       Label="@L["PersonalityLabel"]"
                                       HelperText="@L["ChipInputHint"]" />

                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">@L["TraitsLabel"]</MudText>
                            <TraitBarEditor Value="@_context.Entity.Traits"
                                            ValueChanged="@((string? v) => Touch(() => _context.Entity.Traits = v))" />
                        </div>
                    </MudStack>
                </MudPaper>

                @* --------------------------------------------------------- Beziehungen *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">@L["RelationsSection"]</MudText>
                        <MudStack Row="true" Spacing="2">
                            <MudButton StartIcon="@Icons.Material.Filled.Settings"
                                       Size="Size.Small"
                                       OnClick="ManageRelationTypesAsync">
                                @L["ManageRelationTypes"]
                            </MudButton>
                            <MudButton StartIcon="@Icons.Material.Filled.Add"
                                       Size="Size.Small"
                                       Disabled="@(_relationTypes.Count == 0 || _npcs.Count == 0)"
                                       OnClick="AddRelation">
                                @L["AddRelation"]
                            </MudButton>
                        </MudStack>
                    </MudStack>

                    @if (_relationTypes.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["NoRelationTypesHint"]</MudText>
                    }
                    else if (_context.Entity.Relations.Count == 0 && _incomingRelations.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["NoRelationsHint"]</MudText>
                    }

                    @if (_context.Entity.Relations.Count > 0)
                    {
                        <MudStack Spacing="0">
                            @foreach (var relation in _context.Entity.Relations)
                            {
                                <div class="pa-2 gdm-field-row">
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="4">
                                            <MudSelect T="Guid"
                                                       Value="relation.RelationTypeId"
                                                       ValueChanged="@((Guid id) => Touch(() => relation.RelationTypeId = id))"
                                                       Label="@L["RelationTypeLabel"]"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense">
                                                @foreach (var type in _relationTypes)
                                                {
                                                    <MudSelectItem T="Guid" Value="@type.Id">@type.Name</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>

                                        <MudItem xs="12" sm="4">
                                            <MudAutocomplete T="EntitySummary"
                                                             Value="@NpcFor(relation.OtherNpcId)"
                                                             ValueChanged="@((EntitySummary? e) => Touch(() => relation.OtherNpcId = e?.Id ?? Guid.Empty))"
                                                             SearchFunc="SearchNpcsAsync"
                                                             ToStringFunc="@(e => e?.Name ?? string.Empty)"
                                                             Label="@L["RelationOtherLabel"]"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Clearable="true"
                                                             ResetValueOnEmptyText="true"
                                                             CoerceValue="false"
                                                             MaxItems="50" />
                                        </MudItem>

                                        <MudItem xs="8" sm="3">
                                            <MudSelect T="NpcRelationStance"
                                                       Value="relation.Stance"
                                                       ValueChanged="@((NpcRelationStance stance) => Touch(() => relation.Stance = stance))"
                                                       Label="@L["RelationStanceLabel"]"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense">
                                                <MudSelectItem T="NpcRelationStance" Value="@(NpcRelationStance.Friendly)">@L["StanceFriendly"]</MudSelectItem>
                                                <MudSelectItem T="NpcRelationStance" Value="@(NpcRelationStance.Neutral)">@L["StanceNeutral"]</MudSelectItem>
                                                <MudSelectItem T="NpcRelationStance" Value="@(NpcRelationStance.Hostile)">@L["StanceHostile"]</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>

                                        <MudItem xs="4" sm="1" Class="d-flex align-center justify-end">
                                            <MudTooltip Text="@L["RemoveRelation"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                               Size="Size.Small"
                                                               OnClick="@(() => RemoveRelation(relation))"
                                                               aria-label="@L["RemoveRelation"]" />
                                            </MudTooltip>
                                        </MudItem>

                                        @if (RelationPreview(relation) is { } preview)
                                        {
                                            <MudItem xs="12" Class="pt-0">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@preview</MudText>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </div>
                            }
                        </MudStack>
                    }

                    @* Bei anderen NPCs gespeicherte Beziehungen, die hierher zeigen —
                       angezeigt mit der Gegenrichtungs-Bezeichnung, bearbeitet beim Quell-NPC. *@
                    @if (_incomingRelations.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3 mb-1">@L["IncomingRelations"]</MudText>
                        @foreach (var incoming in _incomingRelations)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"
                                      Class="gdm-field-row py-1">
                                <MudText Typo="Typo.body2">
                                    <MudLink Href="@($"/modules/npcs/{incoming.OwnerNpcId}")" Typo="Typo.body2">@incoming.OwnerNpcName</MudLink>
                                    @($" {incoming.Label} ") <b>@_context.Entity.Name</b>
                                </MudText>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@StanceColor(incoming.Stance)">
                                    @StanceLabel(incoming.Stance)
                                </MudChip>
                            </MudStack>
                        }
                    }
                </MudPaper>

                @* ------------------------------------------------------------------ Sprites *@
                <AssetSpritePanel ModuleKey="@ModuleKeys.Npcs"
                                  EntityId="_context.Entity.Id"
                                  Disabled="_context.IsNew" />

                @* ------------------------------------------------------------------- Felder *@
                <div>
                    <ContentFieldsPanel TEntity="Npc"
                                        Context="_context"
                                        ModuleKey="@ModuleKeys.Npcs"
                                        TypesRoute="/modules/npcs/arten"
                                        IndividualHint="@L["IndividualHint"]"
                                        OnValueChanged="MarkDirty"
                                        OnFieldDefinitionChanged="ReloadKeepingChangesAsync" />
                </div>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudStack Spacing="4">
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["ReferenceSection"]</MudText>

                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["GuidLabel"]</MudText>
                    <EntityIdChip Id="_context.Entity.Id" />

                    @if (!_context.IsNew)
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["CreatedLabel"]</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">@L["UpdatedLabel"]</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                    }
                </MudPaper>

                @* ----------------------------------------------------------- Dialoge *@
                @if (!_context.IsNew)
                {
                    <MudPaper Elevation="0" Class="gdm-panel pa-4">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                            <MudText Typo="Typo.overline" Color="Color.Secondary">@L["DialoguesSection"]</MudText>
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Text"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       Href="/modules/dialogs/neu">
                                @L["NewButton"]
                            </MudButton>
                        </MudStack>

                        @if (_dialogues.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @L["NoDialogues"]
                            </MudText>
                        }
                        else
                        {
                            @foreach (var dialogue in _dialogues)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"
                                          Class="gdm-field-row py-1">
                                    <MudLink Href="@($"/modules/dialogs/{dialogue.Id}")" Typo="Typo.body2">
                                        @dialogue.Name
                                    </MudLink>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @(dialogue.Kind == DialogueKind.Bark ? L["Barks"] : L["LineCount", dialogue.LineCount])
                                    </MudText>
                                </MudStack>
                            }
                        }
                    </MudPaper>
                }

                @* --------------------------------------------------------- Fraktionen *@
                @* Im Konzept: „Dies wird dann auch zu einem NPC in dem NPC-Modul angezeigt.“ *@
                @if (!_context.IsNew)
                {
                    <MudPaper Elevation="0" Class="gdm-panel pa-4">
                        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["FactionsSection"]</MudText>

                        @if (_factions.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @L["NoFactions"]
                            </MudText>
                        }
                        else
                        {
                            @foreach (var faction in _factions)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"
                                          Class="gdm-field-row py-1">
                                    <MudLink Href="@($"/modules/factions/{faction.FactionId}")" Typo="Typo.body2">
                                        @faction.FactionName
                                    </MudLink>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @(faction.Role ?? L["MemberFallback"])
                                    </MudText>
                                </MudStack>
                            }
                        }
                    </MudPaper>
                }

                @* --------------------------------------------------------- Spawn-Orte *@
                @if (!_context.IsNew)
                {
                    <MudPaper Elevation="0" Class="gdm-panel pa-4">
                        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SpawnSection"]</MudText>

                        @if (_placements.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @L["NoSpawns"]
                            </MudText>
                        }
                        else
                        {
                            @foreach (var placement in _placements)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"
                                          Class="gdm-field-row py-1">
                                    <MudLink Href="@($"/modules/maps/{placement.MapId}")" Typo="Typo.body2">
                                        @placement.MapName@(string.IsNullOrWhiteSpace(placement.Label) ? "" : $" — {placement.Label}")
                                    </MudLink>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="gdm-mono">
                                        @(placement.Radius is > 0 ? L["Area"] : L["Point"])
                                    </MudText>
                                </MudStack>
                            }
                        }
                    </MudPaper>
                }


                @if (!_context.IsNew)
                {
                    <EntityTagsPanel ModuleKey="@ModuleKeys.Npcs" EntityId="_context.Entity.Id" />
                    <ReferencesPanel @ref="_referencesPanel" EntityId="_context.Entity.Id" />
                }
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Npcs);

    [Parameter]
    public Guid? Id { get; set; }

    private ContentEditContext<Npc>? _context;
    private ReferencesPanel? _referencesPanel;
    private List<EntitySummary> _items = [];
    private List<EntitySummary> _currencies = [];
    private List<EntitySummary> _lootTables = [];
    private List<EntitySummary> _classes = [];
    private List<EntitySummary> _npcs = [];
    private List<NpcRelationType> _relationTypes = [];
    private List<NpcRelationRow> _incomingRelations = [];
    private List<MapPlacement> _placements = [];
    private List<FactionForNpc> _factions = [];
    private Dictionary<Guid, int> _offerConditionCounts = [];
    private int _shopConditionCount;
    private List<DialogueListRow> _dialogues = [];
    private Guid? _loadedId;
    private bool _notFound;
    private bool _saving;
    private bool _dirty;

    private string PageHeading => _context switch
    {
        null => L["HeadingFallback"],
        { IsNew: true } => L["HeadingNew"],
        { Entity.Name: var name } when !string.IsNullOrWhiteSpace(name) => name,
        _ => L["HeadingUnnamed"]
    };

    private List<BreadcrumbItem> Breadcrumbs => [new(PageHeading, null, disabled: true)];

    protected override async Task OnParametersSetAsync()
    {
        if (_context is not null && _loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _notFound = false;
        _dirty = false;
        _context = null;

        var projectId = await Project.GetCurrentIdAsync();
        _items = await References.GetEntitiesAsync(projectId, ModuleKeys.Items);
        _currencies = await References.GetEntitiesAsync(projectId, ModuleKeys.Currencies);
        _lootTables = await References.GetEntitiesAsync(projectId, ModuleKeys.Loot);
        _classes = await References.GetEntitiesAsync(projectId, ModuleKeys.Classes);
        _relationTypes = await Npcs.GetRelationTypesAsync(projectId);
        _context = await Npcs.LoadForEditAsync(projectId, Id);

        if (_context is null)
        {
            _notFound = true;
            return;
        }

        // Für die Gegenseite einer Beziehung — der NPC selbst gehört nicht in die Auswahl.
        _npcs = (await References.GetEntitiesAsync(projectId, ModuleKeys.Npcs))
            .Where(npc => npc.Id != _context.Entity.Id)
            .ToList();

        if (!_context.IsNew)
        {
            _placements = await Maps.GetPlacementsForEntityAsync(projectId, _context.Entity.Id);
            _factions = await Factions.GetFactionsForNpcAsync(projectId, _context.Entity.Id);
            await RefreshConditionCountsAsync();
            _dialogues = await Dialogues.GetDialoguesForNpcAsync(projectId, _context.Entity.Id);
            _incomingRelations = await Npcs.GetIncomingRelationsAsync(_context.Entity.Id);
        }
    }

    /// <summary>Zählt die Bedingungen von Shop und Posten für die Abzeichen in der Maske.</summary>
    private async Task RefreshConditionCountsAsync()
    {
        if (_context is null)
        {
            return;
        }

        var offerIds = _context.Entity.Offers.Select(offer => offer.Id).ToList();
        _offerConditionCounts = await Conditions.CountByOwnersAsync(offerIds, ConditionSlots.Availability);

        var shop = await Conditions.CountByOwnersAsync([_context.Entity.Id], ConditionSlots.Shop);
        _shopConditionCount = shop.GetValueOrDefault(_context.Entity.Id);
    }

    private async Task EditOfferConditionsAsync(TraderOffer offer)
    {
        var itemName = ItemFor(offer.ItemId)?.Name ?? L["OfferFallbackName"];

        var parameters = new DialogParameters<ConditionDialog>
        {
            { dialog => dialog.OwnerId, offer.Id },
            { dialog => dialog.OwnerModuleKey, ModuleKeys.Npcs },
            { dialog => dialog.Slot, ConditionSlots.Availability },
            { dialog => dialog.Subject, L["ConditionSubject", itemName, _context!.Entity.Name] },
            { dialog => dialog.EmptyHint, L["OfferConditionEmptyHint"] }
        };

        var reference = await Dialogs.ShowAsync<ConditionDialog>(
            L["ConditionsDialogTitle"], parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        await reference.Result;
        await RefreshConditionCountsAsync();
    }

    private EntitySummary? ItemFor(Guid itemId) => _items.FirstOrDefault(entity => entity.Id == itemId);

    private Task<IEnumerable<EntitySummary>> SearchItemsAsync(string? search, CancellationToken ct)
    {
        IEnumerable<EntitySummary> matches = string.IsNullOrWhiteSpace(search)
            ? _items
            : _items.Where(entity => entity.Name.Contains(search, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(matches);
    }

    private void AddOffer() =>
        Touch(() => _context!.Entity.Offers.Add(new TraderOffer
        {
            NpcId = _context.Entity.Id,
            ItemId = Guid.Empty,
            // Gibt es nur eine Währung, ist sie fast immer die gemeinte.
            CurrencyId = _currencies.Count == 1 ? _currencies[0].Id : null,
            SortOrder = _context.Entity.Offers.Count
        }));

    private void RemoveOffer(TraderOffer offer) =>
        Touch(() => _context!.Entity.Offers.Remove(offer));

    private EntitySummary? NpcFor(Guid npcId) => _npcs.FirstOrDefault(entity => entity.Id == npcId);

    private Task<IEnumerable<EntitySummary>> SearchNpcsAsync(string? search, CancellationToken ct)
    {
        IEnumerable<EntitySummary> matches = string.IsNullOrWhiteSpace(search)
            ? _npcs
            : _npcs.Where(entity => entity.Name.Contains(search, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(matches);
    }

    private void AddRelation() =>
        Touch(() => _context!.Entity.Relations.Add(new NpcRelation
        {
            NpcId = _context.Entity.Id,
            // Gibt es nur eine Art, ist sie fast immer die gemeinte.
            RelationTypeId = _relationTypes.Count == 1 ? _relationTypes[0].Id : Guid.Empty,
            SortOrder = _context.Entity.Relations.Count
        }));

    private void RemoveRelation(NpcRelation relation) =>
        Touch(() => _context!.Entity.Relations.Remove(relation));

    /// <summary>Lesehilfe unter der Zeile: „Anton ist Vater von Berta — Berta ist Sohn von Anton“.</summary>
    private string? RelationPreview(NpcRelation relation)
    {
        var type = _relationTypes.FirstOrDefault(t => t.Id == relation.RelationTypeId);
        var other = NpcFor(relation.OtherNpcId);

        if (type is null || other is null || _context is null || string.IsNullOrWhiteSpace(_context.Entity.Name))
        {
            return null;
        }

        return L["RelationPreview", _context.Entity.Name, type.Name, other.Name, type.InverseName];
    }

    private string StanceLabel(NpcRelationStance stance) => stance switch
    {
        NpcRelationStance.Friendly => L["StanceFriendly"],
        NpcRelationStance.Hostile => L["StanceHostile"],
        _ => L["StanceNeutral"]
    };

    private static Color StanceColor(NpcRelationStance stance) => stance switch
    {
        NpcRelationStance.Friendly => Color.Success,
        NpcRelationStance.Hostile => Color.Error,
        _ => Color.Default
    };

    private async Task ManageRelationTypesAsync()
    {
        var reference = await Dialogs.ShowAsync<NpcRelationTypesDialog>(
            L["RelationTypesDialogTitle"], new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        await reference.Result;

        var projectId = await Project.GetCurrentIdAsync();
        _relationTypes = await Npcs.GetRelationTypesAsync(projectId);
    }

    private void ChangeType(Guid? contentTypeId) =>
        Touch(() => _context!.Entity.ContentTypeId = contentTypeId);

    private void Touch(Action change)
    {
        change();
        MarkDirty();
    }

    private void MarkDirty() => _dirty = true;

    private async Task SaveAsync()
    {
        if (_context is null)
        {
            return;
        }

        // Leere Eingabezeilen sind ein Bedienschritt, kein Inhalt.
        _context.Entity.Offers.RemoveAll(offer => offer.ItemId == Guid.Empty);
        _context.Entity.Relations.RemoveAll(relation =>
            relation.OtherNpcId == Guid.Empty || relation.RelationTypeId == Guid.Empty);

        _saving = true;

        try
        {
            var wasNew = _context.IsNew;
            await Npcs.SaveNpcAsync(_context);
            _dirty = false;

            Snackbar.Add(L["SavedMessage", _context.Entity.Name], Severity.Success);

            if (wasNew)
            {
                Navigation.NavigateTo($"/modules/npcs/{_context.Entity.Id}");
                return;
            }

            if (_referencesPanel is not null)
            {
                await _referencesPanel.RefreshAsync();
            }
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_context is null)
        {
            return;
        }

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", _context.Entity.Name],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Npcs.DeleteNpcAsync(_context.Entity.Id);
        Snackbar.Add(L["DeletedMessage"], Severity.Success);
        Navigation.NavigateTo("/modules/npcs");
    }

    /// <summary>
    /// Lädt nach einer Änderung an den Felddefinitionen neu und behält dabei, was in der Maske
    /// noch nicht gespeichert ist.
    /// </summary>
    private async Task ReloadKeepingChangesAsync()
    {
        if (_context is null)
        {
            return;
        }

        var entity = _context.Entity;
        var wasDirty = _dirty;

        var projectId = await Project.GetCurrentIdAsync();
        var reloaded = await Npcs.LoadForEditAsync(projectId, entity.Id);

        if (reloaded is null)
        {
            _notFound = true;
            _context = null;
            return;
        }

        reloaded.Entity.Name = entity.Name;
        reloaded.Entity.Description = entity.Description;
        reloaded.Entity.ContentTypeId = entity.ContentTypeId;
        reloaded.Entity.Kind = entity.Kind;
        reloaded.Entity.IsUnique = entity.IsUnique;
        reloaded.Entity.IsTrader = entity.IsTrader;
        reloaded.Entity.IsQuestGiver = entity.IsQuestGiver;
        reloaded.Entity.LootTableId = entity.LootTableId;
        reloaded.Entity.CharacterClassId = entity.CharacterClassId;
        reloaded.Entity.Preferences = entity.Preferences;
        reloaded.Entity.Personality = entity.Personality;
        reloaded.Entity.Traits = entity.Traits;
        reloaded.Entity.Offers = entity.Offers;
        reloaded.Entity.Relations = entity.Relations;

        _context = reloaded;
        _dirty = wasDirty;
    }
}
