@page "/modules/world/arten"
@inject IStringLocalizer<WorldStateTypes> L

<PageTitle>@L["PageTitle"]</PageTitle>

<ModuleHeader Module="Module"
              Title="@L["Title"]"
              Subtitle="@L["Subtitle"]"
              Breadcrumbs="Breadcrumbs">
    <Actions>
        <MudButton Variant="Variant.Outlined" Href="/modules/world">@L["ToStates"]</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddAsync">
            @L["NewType"]
        </MudButton>
    </Actions>
</ModuleHeader>

<ContentTypeManager @ref="_manager"
                    ModuleKey="@ModuleKeys.World"
                    EntityNoun="@L["EntityNoun"]"
                    EmptyTitle="@L["EmptyTitle"]"
                    EmptyHint="@L["EmptyHint"]" />

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.World);

    private List<BreadcrumbItem> Breadcrumbs => [new(L["BreadcrumbTypes"], null, disabled: true)];

    private ContentTypeManager? _manager;

    private Task AddAsync() => _manager?.AddTypeAsync() ?? Task.CompletedTask;
}
