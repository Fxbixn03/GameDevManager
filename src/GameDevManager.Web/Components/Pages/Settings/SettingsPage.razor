@page "/einstellungen"
@page "/einstellungen/{Section}"
@using Microsoft.Extensions.Configuration
@inject IStringLocalizer<SettingsPage> L
@inject IConfiguration Configuration
@inject DatabaseOptions DbOptions
@inject LocalSettingsFile LocalSettings
@inject ModuleState ModuleState
@inject ModuleLabels Modules
@inject TopbarSelection Topbar
@inject AppearanceSelection Appearance
@inject LanguageSelection Language
@inject NavigationManager Navigation
@inject NavigationManager Navigation
@inject AssetService Assets
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

@*
    Die Einstellungen als ganz normale Seite: links eine Navigationsleiste, rechts der Inhalt
    des gewählten Bereichs — kein Kasten um alles herum. Jeder Bereich hat seine eigene Route
    und ist damit direkt verlinkbar; die Leiste hebt den aktiven Eintrag über den NavLink hervor.

    Datenbank-Änderungen landen in appsettings.Local.json und gelten erst nach einem Neustart —
    die laufende DbContext-Factory lässt sich nicht umverdrahten. Die Modul-Schalter wirken
    sofort: Sie speichern in die Datenbank und benachrichtigen Topbar, Dashboard und Suche über
    den ModuleState. Topbar-Reihenfolge und Darstellung gelten installationsweit (siehe
    TopbarSelection und AppearanceSelection).
*@

<PageTitle>@L["PageTitle"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@L["Heading"]</MudText>
<MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">@L["Subtitle"]</MudText>

<div class="d-flex align-start">
    @* Ebenen trennen sich im Tool über 1px-Linien, nicht über Schatten oder Kästen. *@
    <MudNavMenu Style="width: 220px; flex: 0 0 auto; border-right: 1px solid var(--mud-palette-lines-default); min-height: 60vh;"
                Class="pr-2">
        <MudNavLink Href="/einstellungen/datenbank" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Storage">
            @L["TabDatabase"]
        </MudNavLink>
        <MudNavLink Href="/einstellungen/module" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Apps">
            @L["TabModules"]
        </MudNavLink>
        <MudNavLink Href="/einstellungen/topbar" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ViewHeadline">
            @L["TabTopbar"]
        </MudNavLink>
        <MudNavLink Href="/einstellungen/darstellung" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.DarkMode">
            @L["TabAppearance"]
        </MudNavLink>
        <MudNavLink Href="/einstellungen/speicher" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.CleaningServices">
            @L["TabStorage"]
        </MudNavLink>
    </MudNavMenu>

    <div class="pl-8" style="flex: 1 1 auto; min-width: 0;">
        @switch (CurrentSection)
        {
            case ModulesSection:
                <MudStack Spacing="0" Style="max-width: 640px;">
                    <MudText Typo="Typo.h6">@L["TabModules"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">@L["ModulesHint"]</MudText>

                    @* Gruppiert wie der Inhaltsbestand des Dashboards — 26 Schalter in einer
                       flachen Liste waren eine Wand, in Gruppen lesen sie sich. *@
                    @foreach (var group in Groups)
                    {
                        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mt-4">
                            @Modules.GroupName(group)
                        </MudText>

                        @foreach (var module in ModuleRegistry.All.Where(m => m.Group == group))
                        {
                            <MudSwitch T="bool"
                                       Value="ModuleState.IsEnabled(module)"
                                       ValueChanged="@((bool enabled) => ToggleModuleAsync(module, enabled))"
                                       Color="Color.Primary"
                                       Label="@Modules.Name(module)" />
                        }
                    }
                </MudStack>
                break;

            case TopbarSection:
                <MudStack Spacing="0" Style="max-width: 640px;">
                    <MudText Typo="Typo.h6">@L["TabTopbar"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["TopbarHint"]</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">@L["TopbarOverflowHint"]</MudText>

                    @foreach (var module in _order)
                    {
                        @* Verschieben per Drag & Drop: Zeile greifen und auf der Zielzeile
                           loslassen — die Pfeile daneben bleiben als tastaturfreundlicher Weg.
                           Ein einfaches div statt MudPaper, weil die Drag-Direktiven
                           (:preventDefault) nur auf HTML-Elementen erlaubt sind. *@
                        <div class="mud-paper gdm-panel pa-2 mb-1"
                             style="@(ReferenceEquals(_dragging, module) ? "opacity:0.4;" : _dragging is not null ? "cursor:grabbing;" : null)"
                             draggable="true"
                             @ondragstart="@(() => _dragging = module)"
                             @ondragend="@(() => _dragging = null)"
                             @ondragover:preventDefault="true"
                             @ondrop="@(() => DropOnAsync(module))">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.DragIndicator"
                                         Size="Size.Small"
                                         Color="Color.Secondary"
                                         Style="cursor:grab;"
                                         title="@L["DragHint"]" />
                                <MudIcon Icon="@module.Icon" Size="Size.Small" />
                                <MudText Typo="Typo.body2">@Modules.Name(module)</MudText>

                                @* Abgeschaltete Module bleiben in der Liste: Sie stehen nur
                                   nicht in der Leiste, ihre Stelle in der Reihenfolge behalten
                                   sie für den Fall, dass sie wieder eingeschaltet werden. *@
                                @if (!ModuleState.IsEnabled(module))
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                        @L["ModuleHidden"]
                                    </MudChip>
                                }

                                <MudSpacer />

                                <MudTooltip Text="@L["MoveUpTooltip"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                                   Size="Size.Small"
                                                   Disabled="@(module == _order[0])"
                                                   OnClick="@(() => MoveAsync(module, up: true))"
                                                   aria-label="@L["MoveUpAria", Modules.Name(module)]" />
                                </MudTooltip>
                                <MudTooltip Text="@L["MoveDownTooltip"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward"
                                                   Size="Size.Small"
                                                   Disabled="@(module == _order[^1])"
                                                   OnClick="@(() => MoveAsync(module, up: false))"
                                                   aria-label="@L["MoveDownAria", Modules.Name(module)]" />
                                </MudTooltip>
                            </MudStack>
                        </div>
                    }

                    <div class="mt-3">
                        <MudButton Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.Restore"
                                   OnClick="ResetOrderAsync">
                            @L["ResetOrder"]
                        </MudButton>
                    </div>
                </MudStack>
                break;

            case AppearanceSection:
                <MudStack Spacing="3" Style="max-width: 640px;">
                    <MudText Typo="Typo.h6">@L["TabAppearance"]</MudText>

                    <MudSwitch T="bool"
                               Value="Appearance.IsDarkMode"
                               ValueChanged="ToggleDarkModeAsync"
                               Color="Color.Primary"
                               Label="@L["DarkModeLabel"]" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["DarkModeHint"]</MudText>

                    <MudDivider Class="my-2" />

                    <MudSelect T="string"
                               Value="Language.Code"
                               ValueChanged="SetLanguageAsync"
                               Label="@L["LanguageLabel"]"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        @* Nicht „code" als Laufvariable: „@code" ist eine Razor-Direktive. *@
                        @foreach (var language in LanguageSelection.Available)
                        {
                            <MudSelectItem T="string" Value="@language.Code">@language.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["LanguageHint"]</MudText>
                </MudStack>
                break;

            default:
                <MudStack Spacing="3" Style="max-width: 640px;">
                    <MudText Typo="Typo.h6">@L["TabDatabase"]</MudText>
                    <MudAlert Severity="Severity.Info" Dense="true">@L["RestartHint"]</MudAlert>

                    <MudSelect T="DatabaseProvider"
                               Value="_provider"
                               ValueChanged="OnProviderChanged"
                               Label="@L["ProviderLabel"]"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        @foreach (var provider in Enum.GetValues<DatabaseProvider>())
                        {
                            <MudSelectItem T="DatabaseProvider" Value="provider">@ProviderName(provider)</MudSelectItem>
                        }
                    </MudSelect>

                    <MudTextField T="string"
                                  @bind-Value="_connectionString"
                                  Label="@L["ConnectionStringLabel"]"
                                  HelperText="@L["ConnectionStringHelper"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="2" />

                    @if (_testResult is not null)
                    {
                        <MudAlert Severity="@(_testSucceeded ? Severity.Success : Severity.Error)" Dense="true">
                            @_testResult
                        </MudAlert>
                    }

                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.Cable"
                                   OnClick="TestConnectionAsync"
                                   Disabled="_testing">
                            @L["TestButton"]
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   data-gdm-save
                                   OnClick="SaveDatabaseAsync">
                            @L["SaveButton"]
                        </MudButton>
                    </MudStack>
                </MudStack>
                break;

            @* --------------------------------------------------------------- Speicher *@
            case StorageSection:
                <MudStack Spacing="0" Style="max-width: 760px;">
                    <MudText Typo="Typo.h6">@L["TabStorage"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">@L["StorageHint"]</MudText>

                    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-3">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Search"
                                   Disabled="_scanning"
                                   OnClick="ScanOrphansAsync">
                            @L["StorageScan"]
                        </MudButton>

                        @* Angezeigt statt gelöscht — das Löschen ist ein zweiter, ausdrücklicher
                           Klick, dieselbe Zurückhaltung wie beim Aufräumen der Exportstände. *@
                        @if (_orphans is { Count: > 0 })
                        {
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.DeleteSweep"
                                       Disabled="_scanning"
                                       OnClick="DeleteOrphansAsync">
                                @L["StorageDelete", _orphans.Count]
                            </MudButton>
                        }
                    </MudStack>

                    @if (_scanning)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    }
                    else if (_orphans is null)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["StorageNotScanned"]</MudText>
                    }
                    else if (_orphans.Count == 0)
                    {
                        <MudAlert Severity="Severity.Success" Dense="true" Square="true">@L["StorageClean"]</MudAlert>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Square="true" Class="mb-3">
                            @L["StorageFound", _orphans.Count]
                        </MudAlert>

                        <MudSimpleTable Dense="true" Elevation="0">
                            <tbody>
                                @foreach (var key in _orphans)
                                {
                                    <tr><td class="gdm-mono">@key</td></tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </MudStack>
                break;
        }
    </div>
</div>

@code {
    private const string DatabaseSection = "datenbank";
    private const string ModulesSection = "module";
    private const string TopbarSection = "topbar";
    private const string AppearanceSection = "darstellung";
    private const string StorageSection = "speicher";

    /// <summary>Der Bereich aus der Route — ohne oder mit unbekanntem Segment die Datenbank.</summary>
    [Parameter]
    public string? Section { get; set; }

    private string CurrentSection => Section?.ToLowerInvariant() switch
    {
        ModulesSection => ModulesSection,
        TopbarSection => TopbarSection,
        AppearanceSection => AppearanceSection,
        StorageSection => StorageSection,
        _ => DatabaseSection
    };

    private DatabaseProvider _provider;
    private string _connectionString = string.Empty;

    // Merkt sich Eingaben je Provider — wer im Auswahlfeld hin- und herwechselt, verliert nichts.
    private readonly Dictionary<DatabaseProvider, string> _edited = [];

    private bool _testing;
    private bool _testSucceeded;
    private string? _testResult;

    /// <summary>
    /// Die Reihenfolge der Modulleiste — alle Module, auch abgeschaltete: Die Reihenfolge ist
    /// vollständig, gezeigt wird davon nur, was eingeschaltet und freigegeben ist.
    /// </summary>
    private List<ModuleDefinition> _order = [];

    private ModuleDefinition? _dragging;

    /// <summary>Verwaiste Dateien: <c>null</c> heißt „noch nicht nachgesehen“.</summary>
    private List<string>? _orphans;

    private bool _scanning;

    /// <summary>Die Arbeitsfelder in der Reihenfolge des Dashboards, Werkzeuge zuletzt.</summary>
    private static IEnumerable<ModuleGroup> Groups =>
        [.. ModuleRegistry.ContentGroups, ModuleGroup.Tools];

    protected override async Task OnInitializedAsync()
    {
        _provider = DbOptions.Provider;
        _connectionString = StoredConnectionString(_provider);
        _order = [.. Topbar.Sort(ModuleRegistry.All)];

        await ModuleState.EnsureLoadedAsync();
    }

    /// <summary>
    /// Ohne Bereich auf den ersten umleiten — so trägt die Leiste immer eine aktive
    /// Markierung. In OnParametersSet statt OnInitializedAsync, weil Blazor die Komponente
    /// bei einem erneuten Aufruf von „/einstellungen“ wiederverwendet, ohne neu zu
    /// initialisieren.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(Section))
        {
            Navigation.NavigateTo($"/einstellungen/{DatabaseSection}", replace: true);
        }
    }

    // ------------------------------------------------------------------------- Speicher

    private async Task ScanOrphansAsync()
    {
        _scanning = true;

        try
        {
            _orphans = await Assets.FindOrphanedFilesAsync();
        }
        finally
        {
            _scanning = false;
        }
    }

    private async Task DeleteOrphansAsync()
    {
        if (_orphans is not { Count: > 0 })
        {
            return;
        }

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["StorageDeleteTitle"],
            L["StorageDeleteMessage", _orphans.Count],
            yesText: L["StorageDeleteYes"],
            cancelText: L["Cancel"]);

        if (confirmed != true)
        {
            return;
        }

        try
        {
            var deleted = await Assets.DeleteOrphanedFilesAsync(_orphans);
            Snackbar.Add(L["StorageDeletedMessage", deleted], Severity.Success);

            await ScanOrphansAsync();
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private string StoredConnectionString(DatabaseProvider provider) =>
        Configuration.GetConnectionString(provider.ToString()) ?? string.Empty;

    private void OnProviderChanged(DatabaseProvider provider)
    {
        _edited[_provider] = _connectionString;
        _provider = provider;
        _connectionString = _edited.TryGetValue(provider, out var edited)
            ? edited
            : StoredConnectionString(provider);
        _testResult = null;
    }

    private async Task TestConnectionAsync()
    {
        if (string.IsNullOrWhiteSpace(_connectionString))
        {
            Snackbar.Add(L["ConnectionStringRequired"], Severity.Warning);
            return;
        }

        _testing = true;
        _testResult = null;

        try
        {
            await DatabaseServiceExtensions.TestConnectionAsync(_provider, _connectionString.Trim());
            _testSucceeded = true;
            _testResult = L["TestSucceeded"];
        }
        catch (Exception ex)
        {
            _testSucceeded = false;
            _testResult = L["TestFailed", ex.Message];
        }
        finally
        {
            _testing = false;
        }
    }

    private async Task SaveDatabaseAsync()
    {
        if (string.IsNullOrWhiteSpace(_connectionString))
        {
            Snackbar.Add(L["ConnectionStringRequired"], Severity.Warning);
            return;
        }

        await LocalSettings.WriteDatabaseSettingsAsync(_provider, _connectionString.Trim());
        Snackbar.Add(L["SavedRestartRequired"], Severity.Success);
    }

    private async Task ToggleModuleAsync(ModuleDefinition module, bool enabled)
    {
        try
        {
            await ModuleState.SetEnabledAsync(module, enabled);
        }
        catch (ContentValidationException ex)
        {
            // Ein Nur-Lese-Konto darf die Moduleinstellungen nicht ändern — die Meldung
            // kommt aus dem Schreibschutz der Datenschicht.
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /// <summary>Ein Modul einen Platz nach oben oder unten schieben.</summary>
    private async Task MoveAsync(ModuleDefinition module, bool up)
    {
        var index = _order.IndexOf(module);
        var target = up ? index - 1 : index + 1;

        if (index < 0 || target < 0 || target >= _order.Count)
        {
            return;
        }

        _order.RemoveAt(index);
        _order.Insert(target, module);
        await SaveOrderAsync();
    }

    /// <summary>Das gegriffene Modul an der Stelle des Zielmoduls einsortieren.</summary>
    private async Task DropOnAsync(ModuleDefinition target)
    {
        if (_dragging is null || ReferenceEquals(_dragging, target))
        {
            _dragging = null;
            return;
        }

        var moved = _dragging;
        _dragging = null;

        var targetIndex = _order.IndexOf(target);
        _order.Remove(moved);
        _order.Insert(targetIndex, moved);

        await SaveOrderAsync();
    }

    private async Task ResetOrderAsync()
    {
        await Topbar.ResetAsync();
        _order = [.. ModuleRegistry.All];
        Snackbar.Add(L["OrderReset"], Severity.Success);
    }

    /// <summary>
    /// Speichert sofort — wie die Modul-Schalter daneben. Die Topbar zieht über das Ereignis
    /// der <see cref="TopbarSelection"/> von selbst nach, auch in anderen offenen Fenstern.
    /// </summary>
    private Task SaveOrderAsync() => Topbar.SetOrderAsync(_order.Select(m => m.Id));

    /// <summary>
    /// Dieselbe Wahl wie der Knopf in der Appbar — sie gilt installationsweit und wird in
    /// appsettings.Local.json gemerkt (<see cref="AppearanceSelection"/>).
    /// </summary>
    private Task ToggleDarkModeAsync(bool darkMode) => Appearance.SetDarkModeAsync(darkMode);

    /// <summary>
    /// Nach dem Wechsel wird die Anwendung neu geladen — dieselbe Linie wie beim Projektwechsel:
    /// Jede offene Seite hat ihre Texte bereits gerendert, und ein Ereignis an ~60 Seiten wäre
    /// der aufwendigere Weg zum selben Ergebnis.
    /// </summary>
    private async Task SetLanguageAsync(string code)
    {
        await Language.SetLanguageAsync(code);

        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private string ProviderName(DatabaseProvider provider) => provider switch
    {
        DatabaseProvider.SqlServer => L["ProviderSqlServer"],
        DatabaseProvider.PostgreSql => L["ProviderPostgreSql"],
        DatabaseProvider.MySql => L["ProviderMySql"],
        _ => L["ProviderSqlite"]
    };
}
