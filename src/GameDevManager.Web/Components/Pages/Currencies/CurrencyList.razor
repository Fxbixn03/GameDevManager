@page "/modules/currencies"
@inject CurrencyService Currencies
@inject ContentTypeService ContentTypes
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IStringLocalizer<CurrencyList> L

<PageTitle>@L["PageTitle"]</PageTitle>

<ModuleHeader Module="Module" Subtitle="@Subtitle">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Style"
                   Href="/modules/currencies/arten">
            @L["TypesButton"]
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   data-gdm-new
                   Href="/modules/currencies/neu">
            @L["NewCurrency"]
        </MudButton>
    </Actions>
</ModuleHeader>

@if (_currencies is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_currencies.Count == 0)
{
    <div class="gdm-empty">
        <MudIcon Icon="@Icons.Material.Filled.Paid" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
        <MudText Typo="Typo.h6">@L["EmptyTitle"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            @L["EmptyHint"]
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/modules/currencies/neu">
            @L["FirstCurrency"]
        </MudButton>
    </div>
}
else
{
    var filtered = Filtered;

    <MudPaper Elevation="0" Class="gdm-panel pa-4 mb-4">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_search"
                          Placeholder="@L["SearchPlaceholder"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="max-width:360px;" />

            <MudSelect T="Guid?"
                       @bind-Value="_typeFilter"
                       Label="@L["TypeFilterLabel"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="max-width:220px;">
                @foreach (var type in _types)
                {
                    <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSpacer />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["FilterCount", filtered.Count, _currencies.Count]</MudText>
        </MudStack>
    </MudPaper>

    @if (filtered.Count == 0)
    {
        <MudPaper Elevation="0" Class="gdm-panel pa-4">
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["NoRecords"]</MudText>
        </MudPaper>
    }
    else
    {
        <div class="gdm-item-grid">
            @foreach (var currency in filtered)
            {
                <EntityContextMenu ModuleKey="@Module.Id"
                                   EntityId="currency.Id"
                                   Name="@currency.Name"
                                   EditRoute="/modules/currencies"
                                   OnDelete="@(() => DeleteAsync(currency))">
                    <MudPaper Elevation="0" Class="gdm-panel gdm-card-link">
                        <MudLink Href="@($"/modules/currencies/{currency.Id}")" Underline="Underline.None">
                            <AssetThumbnail AssetId="currency.PrimaryAssetId"
                                            Class="gdm-item-tile"
                                            Alt="@currency.Name"
                                            FallbackIcon="@Icons.Material.Filled.Paid" />
                        </MudLink>

                        <div class="pa-3">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                                <MudLink Href="@($"/modules/currencies/{currency.Id}")" Typo="Typo.body1" Class="gdm-ellipsis">
                                    <b>@currency.Name</b>
                                </MudLink>
                                <EntityDuplicateButton ModuleKey="@Module.Id"
                                                       EntityId="currency.Id"
                                                       Name="@currency.Name"
                                                       EditRoute="/modules/currencies" />
                                <MudTooltip Text="@L["DeleteTooltip"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                   Size="Size.Small"
                                                   OnClick="@(() => DeleteAsync(currency))"
                                                   aria-label="@L["DeleteAria", currency.Name]" />
                                </MudTooltip>
                            </MudStack>

                            @if (!string.IsNullOrWhiteSpace(currency.Description))
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="gdm-ellipsis">
                                    @currency.Description
                                </MudText>
                            }

                            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-2">
                                @* Das Zeichen trägt jede Preisangabe — es steht deshalb auch in der Übersicht. *@
                                @if (!string.IsNullOrWhiteSpace(currency.Symbol))
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="gdm-mono">
                                        @currency.Symbol
                                    </MudChip>
                                }
                                @if (currency.TypeName is null)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NoType"]</MudText>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@currency.TypeName</MudChip>
                                }
                            </MudStack>

                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                @L["UpdatedAt", currency.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")]
                            </MudText>
                        </div>
                    </MudPaper>
                </EntityContextMenu>
            }
        </div>
    }
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Currencies);

    private List<CurrencyListRow>? _currencies;
    private List<ContentType> _types = [];
    private string? _search;
    private Guid? _typeFilter;

    private string Subtitle => _currencies is null
        ? L["Loading"]
        : L["SubtitleCount", _currencies.Count];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var projectId = await Project.GetCurrentIdAsync();
        _types = await ContentTypes.GetTypesAsync(projectId, ModuleKeys.Currencies);
        _currencies = await Currencies.GetCurrenciesAsync(projectId);
    }

    private List<CurrencyListRow> Filtered
    {
        get
        {
            IEnumerable<CurrencyListRow> rows = _currencies ?? [];

            if (_typeFilter is { } typeId)
            {
                rows = rows.Where(row => row.ContentTypeId == typeId);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                rows = rows.Where(row =>
                    row.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (row.Symbol?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (row.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return [.. rows];
        }
    }

    private async Task DeleteAsync(CurrencyListRow row)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", row.Name],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Currencies.DeleteCurrencyAsync(row.Id);
        Snackbar.Add(L["DeletedMessage", row.Name], Severity.Success);
        await LoadAsync();
    }
}
