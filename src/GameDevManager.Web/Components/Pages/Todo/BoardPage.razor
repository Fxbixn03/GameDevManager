@page "/modules/todo/{Id:guid}"
@inject KanbanService Kanban
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<BoardPage> L

<PageTitle>@L["PageTitle", _board?.Name ?? L["HeadingFallback"]]</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @L["NotFoundMessage"]
    </MudAlert>
    <MudButton Variant="Variant.Outlined" Href="/modules/todo">@L["BackToBoards"]</MudButton>
}
else if (_board is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <ModuleHeader Module="Module"
                  Title="@_board.Name"
                  Subtitle="@_board.Description"
                  Breadcrumbs="Breadcrumbs">
        <Actions>
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="RenameBoardAsync">
                @L["RenameBoard"]
            </MudButton>
            <MudButton Variant="Variant.Outlined" Href="/modules/todo">@L["BackToBoards"]</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddColumnAsync">
                @L["AddColumn"]
            </MudButton>
        </Actions>
    </ModuleHeader>

    @* Der Filter blendet nur aus, er verschiebt nichts: Überfälliges zählt zu „diese Woche“,
       denn wer nach Fälligem filtert, will das Liegengebliebene zuerst sehen. *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudSwitch T="bool"
                   @bind-Value="_dueThisWeekOnly"
                   Color="Color.Primary"
                   Label="@L["FilterDueThisWeek"]" />
    </MudStack>

    <div style="display:flex;gap:16px;align-items:flex-start;overflow-x:auto;padding-bottom:8px;">
        @foreach (var column in _board.Columns)
        {
            var visibleCards = VisibleCards(column);
            <div class="mud-paper gdm-panel pa-3"
                 style="min-width:280px;max-width:280px;flex-shrink:0;"
                 @ondragover:preventDefault="true"
                 @ondrop="@(() => DropOnColumnAsync(column))">

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
                    <MudTextField Value="column.Name"
                                  ValueChanged="@((string name) => RenameColumnAsync(column, name))"
                                  T="string"
                                  Variant="Variant.Text"
                                  Margin="Margin.Dense"
                                  Style="flex-grow:1;font-weight:600;" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="gdm-mono">@visibleCards.Count</MudText>
                    <MudTooltip Text="@L["MoveColumnLeft"]">
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                       Size="Size.Small"
                                       Disabled="@(column == _board.Columns.First())"
                                       OnClick="@(() => MoveColumnAsync(column, left: true))"
                                       aria-label="@L["MoveColumnLeft"]" />
                    </MudTooltip>
                    <MudTooltip Text="@L["MoveColumnRight"]">
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                       Size="Size.Small"
                                       Disabled="@(column == _board.Columns.Last())"
                                       OnClick="@(() => MoveColumnAsync(column, left: false))"
                                       aria-label="@L["MoveColumnRight"]" />
                    </MudTooltip>
                    <MudTooltip Text="@L["DeleteColumnTooltip"]">
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteColumnAsync(column))"
                                       aria-label="@L["DeleteColumnAria", column.Name]" />
                    </MudTooltip>
                </MudStack>

                <MudStack Spacing="2">
                    @foreach (var card in visibleCards)
                    {
                        @* Rechtsklick auf eine Karte: dieselben Handgriffe wie im Dialog, nur ohne
                           Umweg — dazu das Verschieben in eine andere Spalte für alle, die nicht
                           ziehen wollen oder können. Aufbau wie beim EntityContextMenu der
                           Modul-Listen: Der Aktivator bildet keinen eigenen Kasten (app.css), und
                           das Ereignis wird angehalten, damit das eben geöffnete Menü nicht beim
                           Aktivator von MudBlazor noch einmal ankommt und zuklappt. *@
                        <MudMenu PositionAtCursor="true"
                                 Dense="true"
                                 ActivationEvent="MouseEvent.RightClick"
                                 Class="gdm-context-menu">
                            <ActivatorContent>
                                <div class="gdm-context-target"
                                     @oncontextmenu="@(args => context.OpenAsync(args))"
                                     @oncontextmenu:preventDefault="true"
                                     @oncontextmenu:stopPropagation="true">
                                    <div class="mud-paper gdm-panel pa-3"
                                         style="@CardFaceStyle(card)"
                                         draggable="true"
                                         @ondragstart="@(() => _dragging = card)"
                                         @ondragend="@(() => _dragging = null)"
                                         @ondragover:preventDefault="true"
                                         @ondrop="@(() => DropOnCardAsync(column, card))"
                                         @ondrop:stopPropagation="true"
                                         @onclick="@(() => EditCardAsync(card))">
                                        <MudText Typo="Typo.body2" Style="font-weight:500;">@card.Title</MudText>
                                        @if (!string.IsNullOrWhiteSpace(card.Notes))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@Shorten(card.Notes)</MudText>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(card.Label) || card.DueDate is not null || AssigneeName(card) is not null)
                                        {
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-1" Wrap="Wrap.Wrap">
                                                @if (!string.IsNullOrWhiteSpace(card.Label))
                                                {
                                                    <MudText Typo="Typo.caption" Class="gdm-mono">@card.Label</MudText>
                                                }
                                                @if (card.DueDate is { } due)
                                                {
                                                    <MudText Typo="Typo.caption"
                                                             Color="@(due.Date < DateTime.Today ? Color.Error : Color.Secondary)">
                                                        <MudIcon Icon="@Icons.Material.Filled.Event"
                                                                 Size="Size.Small"
                                                                 Style="font-size:0.9rem;vertical-align:text-bottom;" />
                                                        @due.ToString("dd.MM.yyyy")
                                                    </MudText>
                                                }
                                                @if (AssigneeName(card) is { } assignee)
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        <MudIcon Icon="@Icons.Material.Filled.Person"
                                                                 Size="Size.Small"
                                                                 Style="font-size:0.9rem;vertical-align:text-bottom;" />
                                                        @assignee
                                                    </MudText>
                                                }
                                            </MudStack>
                                        }
                                    </div>
                                </div>
                            </ActivatorContent>

                            <ChildContent>
                                <MudMenuItem Icon="@Icons.Material.Filled.EditNote"
                                             OnClick="@(() => EditCardAsync(card))">
                                    @L["CardMenuEdit"]
                                </MudMenuItem>

                                @foreach (var target in _board.Columns.Where(other => other != column))
                                {
                                    <MudMenuItem Icon="@Icons.Material.Filled.ArrowForward"
                                                 OnClick="@(() => MoveCardAsync(card, target))">
                                        @L["CardMenuMoveTo", target.Name]
                                    </MudMenuItem>
                                }

                                <MudDivider />
                                <MudMenuItem Icon="@Icons.Material.Filled.DeleteOutline"
                                             IconColor="Color.Error"
                                             OnClick="@(() => DeleteCardAsync(card))">
                                    @L["CardMenuDelete"]
                                </MudMenuItem>
                            </ChildContent>
                        </MudMenu>
                    }

                    @if (_newCardColumnId == column.Id)
                    {
                        <MudTextField @bind-Value="_newCardTitle"
                                      Label="@L["NewCardLabel"]"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      AutoFocus="true"
                                      OnKeyDown="@(args => OnNewCardKeyAsync(args, column))" />
                        <MudStack Row="true" Spacing="1">
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@string.IsNullOrWhiteSpace(_newCardTitle)"
                                       OnClick="@(() => CommitNewCardAsync(column))">
                                @L["AddCardConfirm"]
                            </MudButton>
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Text"
                                       OnClick="@(() => { _newCardColumnId = null; _newCardTitle = null; })">
                                @L["AddCardCancel"]
                            </MudButton>
                        </MudStack>
                    }
                    else
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.Add"
                                   Size="Size.Small"
                                   Variant="Variant.Text"
                                   OnClick="@(() => { _newCardColumnId = column.Id; _newCardTitle = null; })">
                            @L["AddCard"]
                        </MudButton>
                    }
                </MudStack>
            </div>
        }
    </div>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Todo);

    [Parameter]
    public Guid Id { get; set; }

    private KanbanBoard? _board;

    private Guid _projectId;

    private List<TaskAssignee> _users = [];
    private KanbanCard? _dragging;
    private bool _dueThisWeekOnly;
    private Guid? _newCardColumnId;
    private string? _newCardTitle;
    private Guid? _loadedId;
    private bool _notFound;

    private List<BreadcrumbItem> Breadcrumbs => [new(_board?.Name ?? L["HeadingFallback"], null, disabled: true)];

    protected override async Task OnParametersSetAsync()
    {
        if (_board is not null && _loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _projectId = await Project.GetCurrentIdAsync();
        _board = await Kanban.GetBoardAsync(_projectId, Id);
        _notFound = _board is null;

        _users = await Kanban.GetAssigneesAsync();
    }

    private async Task RenameBoardAsync()
    {
        if (_board is null)
        {
            return;
        }

        var parameters = new DialogParameters<BoardRenameDialog>
        {
            { dialog => dialog.BoardName, _board.Name },
            { dialog => dialog.BoardDescription, _board.Description }
        };

        var reference = await Dialogs.ShowAsync<BoardRenameDialog>(
            L["RenameDialogTitle"], parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await reference.Result;

        if (result is { Canceled: false, Data: BoardRenameDialog.Outcome outcome })
        {
            await Run(() => Kanban.RenameBoardAsync(_board.Id, outcome.Name, outcome.Description));
        }
    }

    private async Task AddColumnAsync()
    {
        if (_board is null)
        {
            return;
        }

        await Run(() => Kanban.AddColumnAsync(_board.Id, L["NewColumnName", _board.Columns.Count + 1]));
    }

    private Task RenameColumnAsync(KanbanColumn column, string name) =>
        Run(() => Kanban.RenameColumnAsync(column.Id, name));

    private Task MoveColumnAsync(KanbanColumn column, bool left) =>
        Run(() => Kanban.MoveColumnAsync(column.Id, left));

    private async Task DeleteColumnAsync(KanbanColumn column)
    {
        if (column.Cards.Count > 0)
        {
            var confirmed = await Dialogs.ShowMessageBoxAsync(
                L["DeleteColumnConfirmTitle"],
                L["DeleteColumnConfirmMessage", column.Name, column.Cards.Count],
                yesText: L["DeleteYes"],
                cancelText: L["DeleteCancel"]);

            if (confirmed != true)
            {
                return;
            }
        }

        await Run(() => Kanban.DeleteColumnAsync(column.Id));
    }

    private async Task OnNewCardKeyAsync(KeyboardEventArgs args, KanbanColumn column)
    {
        if (args.Key is "Enter" or "NumpadEnter")
        {
            await CommitNewCardAsync(column);
        }
        else if (args.Key is "Escape")
        {
            _newCardColumnId = null;
            _newCardTitle = null;
        }
    }

    private async Task CommitNewCardAsync(KanbanColumn column)
    {
        if (string.IsNullOrWhiteSpace(_newCardTitle))
        {
            return;
        }

        var title = _newCardTitle;
        _newCardTitle = null;

        await Run(() => Kanban.AddCardAsync(column.Id, title));
    }

    private async Task EditCardAsync(KanbanCard card)
    {
        // Auf einer Kopie: Ein Abbruch soll die Karte im Board unberührt lassen.
        var draft = new KanbanCard
        {
            Id = card.Id,
            ColumnId = card.ColumnId,
            Title = card.Title,
            Notes = card.Notes,
            AssignedUserId = card.AssignedUserId,
            DueDate = card.DueDate,
            Color = card.Color,
            Label = card.Label,
            TargetModuleKey = card.TargetModuleKey,
            TargetEntityId = card.TargetEntityId
        };

        var parameters = new DialogParameters<CardEditDialog>
        {
            { dialog => dialog.Card, draft },
            { dialog => dialog.Users, _users },
            { dialog => dialog.ProjectId, _projectId }
        };

        var reference = await Dialogs.ShowAsync<CardEditDialog>(
            L["CardDialogTitle"], parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await reference.Result;

        if (result is { Canceled: false, Data: CardEditDialog.Outcome outcome })
        {
            if (outcome.Delete)
            {
                await Run(() => Kanban.DeleteCardAsync(card.Id));
            }
            else
            {
                await Run(() => Kanban.UpdateCardAsync(outcome.Card));
            }
        }
    }

    /// <summary>Aus dem Rechtsklick-Menü: die Karte ans Ende einer anderen Spalte hängen.</summary>
    private Task MoveCardAsync(KanbanCard card, KanbanColumn target) =>
        Run(() => Kanban.MoveCardAsync(card.Id, target.Id, target.Cards.Count));

    private async Task DeleteCardAsync(KanbanCard card)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteCardConfirmTitle"],
            L["DeleteCardConfirmMessage", card.Title],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Run(() => Kanban.DeleteCardAsync(card.Id));
    }

    /// <summary>Auf einer Karte losgelassen: an deren Position in deren Spalte einsortieren.</summary>
    private async Task DropOnCardAsync(KanbanColumn column, KanbanCard target)
    {
        if (_dragging is null || ReferenceEquals(_dragging, target))
        {
            _dragging = null;
            return;
        }

        var moved = _dragging;
        _dragging = null;

        await Run(() => Kanban.MoveCardAsync(moved.Id, column.Id, column.Cards.IndexOf(target)));
    }

    /// <summary>Auf der Spalte (unterhalb der Karten) losgelassen: ans Ende der Spalte.</summary>
    private async Task DropOnColumnAsync(KanbanColumn column)
    {
        if (_dragging is null)
        {
            return;
        }

        var moved = _dragging;
        _dragging = null;

        await Run(() => Kanban.MoveCardAsync(moved.Id, column.Id, column.Cards.Count));
    }

    /// <summary>Führt eine Board-Änderung aus, zeigt Validierungsfehler an und lädt neu.</summary>
    private async Task Run(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }

        await LoadAsync();
    }

    /// <summary>
    /// Die Karten einer Spalte, wie der Filter sie zeigt. Gefiltert wird nur die Anzeige —
    /// Verschieben und Ablegen rechnen weiter auf der vollen Liste der Spalte.
    /// </summary>
    private List<KanbanCard> VisibleCards(KanbanColumn column) =>
        _dueThisWeekOnly ? [.. column.Cards.Where(IsDueThisWeek)] : column.Cards;

    /// <summary>
    /// Fällig diese Woche heißt: bis einschließlich Sonntag — und alles Überfällige dazu,
    /// denn der Filter soll das Drängende zeigen, nicht das Liegengebliebene verstecken.
    /// </summary>
    private static bool IsDueThisWeek(KanbanCard card)
    {
        if (card.DueDate is not { } due)
        {
            return false;
        }

        var today = DateTime.Today;
        var endOfWeek = today.AddDays(((int)DayOfWeek.Sunday - (int)today.DayOfWeek + 7) % 7);

        return due.Date <= endOfWeek;
    }

    /// <summary>
    /// Der Rand in der Kartenfarbe. Die Farbe kommt aus dem Farbwähler, steht aber als freier
    /// Text in der Datenbank — in das style-Attribut geht nur, was wie ein Hex-Wert aussieht.
    /// </summary>
    private string CardFaceStyle(KanbanCard card)
    {
        var style = ReferenceEquals(_dragging, card) ? "opacity:0.4;cursor:grab;" : "cursor:grab;";

        if (card.Color is { } color
            && color.Length is 4 or 7 or 9
            && color[0] == '#'
            && color.Skip(1).All(Uri.IsHexDigit))
        {
            style += $"border-left:3px solid {color};";
        }

        return style;
    }

    private string? AssigneeName(KanbanCard card) =>
        card.AssignedUserId is { } userId
            ? _users.FirstOrDefault(user => user.Id == userId)?.DisplayName
            : null;

    private static string Shorten(string? text) =>
        string.IsNullOrWhiteSpace(text)
            ? string.Empty
            : text.Length <= 120 ? text : string.Concat(text.AsSpan(0, 120), "…");
}
