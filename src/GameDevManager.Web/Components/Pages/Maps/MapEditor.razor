@page "/modules/maps/neu"
@page "/modules/maps/{Id:guid}"
@inject MapService Maps
@inject ReferenceService References
@inject AssetService Library
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@PageHeading – GameDevManager</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        Es gibt keine Karte mit dieser GUID. Vielleicht wurde sie gelöscht.
    </MudAlert>
    <MudButton Variant="Variant.Outlined" Href="/modules/maps">Zurück zur Übersicht</MudButton>
}
else if (_context is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <ModuleHeader Module="Module"
                  Title="@PageHeading"
                  Subtitle="@(_context.IsNew ? "Noch nicht gespeichert" : null)"
                  Breadcrumbs="Breadcrumbs">
        <Actions>
            @if (_dirty)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                    Ungespeicherte Änderungen
                </MudChip>
            }
            @if (!_context.IsNew)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteOutline"
                           OnClick="DeleteAsync">
                    Löschen
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Href="/modules/maps">Abbrechen</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       Disabled="_saving"
                       OnClick="SaveAsync">
                Speichern
            </MudButton>
        </Actions>
    </ModuleHeader>

    <MudGrid Spacing="4">
        <MudItem xs="12" md="8">
            <MudStack Spacing="4">

                @* ---------------------------------------------------------------- Karte *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Karte</MudText>

                        @if (!_context.IsNew)
                        {
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                @if (_mode != PlaceMode.None)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Primary">
                                        @(_mode == PlaceMode.Add
                                            ? "Auf die Karte klicken, um zu setzen"
                                            : "Auf die Karte klicken, um zu verschieben")
                                    </MudText>
                                }
                                <MudButton Size="Size.Small"
                                           Variant="@(_mode == PlaceMode.Add ? Variant.Filled : Variant.Outlined)"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.AddLocationAlt"
                                           Disabled="@(_imageAssetId is null)"
                                           OnClick="ToggleAdd">
                                    @(_mode == PlaceMode.Add ? "Fertig" : "Markierung setzen")
                                </MudButton>
                            </MudStack>
                        }
                    </MudStack>

                    @if (_context.IsNew)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">
                            Kartenbild und Markierungen hängen an der GUID der Karte — beides lässt
                            sich anlegen, sobald sie einmal gespeichert wurde.
                        </MudAlert>
                    }
                    else
                    {
                        @if (_imageAssetId is null)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                                Lade unten ein Bild hoch — das erste wird automatisch zum Kartenbild.
                            </MudAlert>
                        }

                        <MapCanvas ImageAssetId="_imageAssetId"
                                   Alt="@_context.Entity.Name"
                                   Markers="_context.Entity.Markers"
                                   SelectedId="_selected?.Id"
                                   Placing="@(_mode != PlaceMode.None)"
                                   OnPointPicked="OnPointPickedAsync"
                                   OnMarkerSelected="SelectMarker" />
                    }
                </MudPaper>

                @* --------------------------------------------------------- Stammdaten *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">Stammdaten</MudText>

                    <MudStack Spacing="4">
                        <MudTextField Value="_context.Entity.Name"
                                      ValueChanged="@((string name) => Touch(() => _context.Entity.Name = name))"
                                      T="string"
                                      Label="Name *"
                                      Variant="Variant.Outlined"
                                      Immediate="true" />

                        <MudTextField Value="_context.Entity.Description"
                                      ValueChanged="@((string text) => Touch(() => _context.Entity.Description = text))"
                                      T="string"
                                      Label="Beschreibung"
                                      Variant="Variant.Outlined"
                                      Lines="2" />

                        <MudSelect T="Guid?"
                                   Value="_context.Entity.ContentTypeId"
                                   ValueChanged="@((Guid? id) => Touch(() => _context.Entity.ContentTypeId = id))"
                                   Label="Karten-Art"
                                   Variant="Variant.Outlined"
                                   Clearable="true">
                            @foreach (var type in _context.AvailableTypes)
                            {
                                <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudStack>
                </MudPaper>

                @* -------------------------------------------------------------- Bilder *@
                <AssetSpritePanel ModuleKey="@ModuleKeys.Maps"
                                  EntityId="_context.Entity.Id"
                                  Disabled="_context.IsNew"
                                  OnChanged="RefreshImageAsync" />

                @* -------------------------------------------------------------- Felder *@
                <div>
                    <ContentFieldsPanel TEntity="GameMap"
                                        Context="_context"
                                        ModuleKey="@ModuleKeys.Maps"
                                        TypesRoute="/modules/maps/arten"
                                        IndividualHint="Für Angaben, die nur diese eine Karte braucht."
                                        OnValueChanged="MarkDirty"
                                        OnFieldDefinitionChanged="ReloadKeepingChangesAsync" />
                </div>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudStack Spacing="4">

                @* ------------------------------------------------ Ausgewählte Markierung *@
                @if (_selected is { } marker)
                {
                    <MudPaper Elevation="0" Class="gdm-panel pa-4">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                            <MudText Typo="Typo.overline" Color="Color.Secondary">Markierung</MudText>
                            <MudStack Row="true" Spacing="0">
                                <MudTooltip Text="Auf der Karte verschieben">
                                    <MudIconButton Icon="@Icons.Material.Filled.OpenWith"
                                                   Size="Size.Small"
                                                   Color="@(_mode == PlaceMode.Move ? Color.Primary : Color.Default)"
                                                   OnClick="ToggleMove"
                                                   aria-label="Verschieben" />
                                </MudTooltip>
                                <MudTooltip Text="Entfernen">
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                   Size="Size.Small"
                                                   OnClick="@(() => RemoveMarker(marker))"
                                                   aria-label="Markierung entfernen" />
                                </MudTooltip>
                            </MudStack>
                        </MudStack>

                        <MudStack Spacing="3">
                            <MudTextField Value="marker.Label"
                                          ValueChanged="@((string v) => Touch(() => marker.Label = v))"
                                          T="string"
                                          Label="Beschriftung"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Immediate="true" />

                            <MudSelect T="string"
                                       Value="marker.TargetModuleKey"
                                       ValueChanged="ChangeTargetModuleAsync"
                                       Label="Zeigt auf"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense">
                                <MudSelectItem T="string" Value="@(null as string)">Nichts (reine Notiz)</MudSelectItem>
                                @foreach (var module in ModuleRegistry.All.Where(m => m.Implemented))
                                {
                                    <MudSelectItem T="string" Value="@module.Id">@module.Name</MudSelectItem>
                                }
                            </MudSelect>

                            @if (marker.TargetModuleKey is { } targetModule)
                            {
                                @if (TargetOptions(targetModule).Count == 0)
                                {
                                    <MudAlert Severity="Severity.Info" Dense="true">
                                        In diesem Modul gibt es noch nichts, worauf die Markierung zeigen könnte.
                                    </MudAlert>
                                }
                                else
                                {
                                    <MudAutocomplete T="EntitySummary"
                                                     Value="@TargetFor(marker)"
                                                     ValueChanged="@((EntitySummary? e) => Touch(() => marker.TargetEntityId = e?.Id))"
                                                     SearchFunc="@((string? s, CancellationToken ct) => SearchTargetsAsync(targetModule, s))"
                                                     ToStringFunc="@(e => e?.Name ?? string.Empty)"
                                                     Label="Ziel"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Clearable="true"
                                                     ResetValueOnEmptyText="true"
                                                     CoerceValue="false"
                                                     MaxItems="50" />
                                }

                                @if (marker.IsMapLink && marker.TargetEntityId is { } linkedMap)
                                {
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Outlined"
                                               StartIcon="@Icons.Material.Filled.Map"
                                               Href="@($"/modules/maps/{linkedMap}")">
                                        Verknüpfte Karte öffnen
                                    </MudButton>
                                }
                            }

                            <MudSwitch T="bool"
                                       Value="marker.IsArea"
                                       ValueChanged="ToggleArea"
                                       Color="Color.Primary"
                                       Label="Bereich statt Punkt" />

                            @if (marker.IsArea)
                            {
                                <MudSlider T="double"
                                           Value="@((marker.Radius ?? 0.05) * 100)"
                                           ValueChanged="@((double v) => Touch(() => marker.Radius = v / 100))"
                                           Min="1"
                                           Max="50"
                                           Step="0.5"
                                           Color="Color.Primary">
                                    Radius: @(((marker.Radius ?? 0) * 100).ToString("0.#")) % der Breite
                                </MudSlider>
                            }

                            <MudSelect T="Guid?"
                                       Value="marker.IconAssetId"
                                       ValueChanged="@((Guid? id) => Touch(() => marker.IconAssetId = id))"
                                       Label="Symbol"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true"
                                       Disabled="@(_markerIcons.Count == 0)"
                                       HelperText="@(_markerIcons.Count == 0
                                           ? "Werkzeug-Assets ohne Entität stehen hier zur Auswahl."
                                           : null)">
                                @foreach (var icon in _markerIcons)
                                {
                                    <MudSelectItem T="Guid?" Value="@icon.Asset.Id">@icon.Asset.FileName</MudSelectItem>
                                }
                            </MudSelect>

                            <MudStack Row="true" Spacing="2">
                                <MudNumericField T="double"
                                                 Value="@(marker.X * 100)"
                                                 ValueChanged="@((double v) => Touch(() => marker.X = v / 100))"
                                                 Label="X"
                                                 Adornment="Adornment.End"
                                                 AdornmentText="%"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 Min="0" Max="100" Step="0.5" />
                                <MudNumericField T="double"
                                                 Value="@(marker.Y * 100)"
                                                 ValueChanged="@((double v) => Touch(() => marker.Y = v / 100))"
                                                 Label="Y"
                                                 Adornment="Adornment.End"
                                                 AdornmentText="%"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 Min="0" Max="100" Step="0.5" />
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }

                @* ---------------------------------------------------------- Alle Marker *@
                @if (!_context.IsNew)
                {
                    <MudPaper Elevation="0" Class="gdm-panel pa-4">
                        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">
                            Markierungen (@_context.Entity.Markers.Count)
                        </MudText>

                        @if (_context.Entity.Markers.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Noch keine. Über „Markierung setzen“ und einen Klick auf die Karte entsteht die erste.
                            </MudText>
                        }
                        else
                        {
                            @foreach (var entry in _context.Entity.Markers)
                            {
                                <div class="gdm-field-row py-1" style="cursor:pointer;" @onclick="@(() => SelectMarker(entry))">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudIcon Icon="@MarkerIcon(entry)"
                                                     Size="Size.Small"
                                                     Color="@(entry.Id == _selected?.Id ? Color.Primary : Color.Secondary)" />
                                            <MudText Typo="Typo.body2">@MarkerTitle(entry)</MudText>
                                        </MudStack>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="gdm-mono">
                                            @((entry.X * 100).ToString("0")) / @((entry.Y * 100).ToString("0"))
                                        </MudText>
                                    </MudStack>
                                </div>
                            }
                        }
                    </MudPaper>
                }

                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">Referenz</MudText>

                    <MudText Typo="Typo.caption" Color="Color.Secondary">GUID</MudText>
                    <EntityIdChip Id="_context.Entity.Id" />

                    @if (!_context.IsNew)
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Zuletzt geändert</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                    }
                </MudPaper>

                @if (!_context.IsNew)
                {
                    <ReferencesPanel @ref="_referencesPanel" EntityId="_context.Entity.Id" />
                }
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Maps);

    /// <summary>Was der nächste Klick auf die Karte bewirkt.</summary>
    private enum PlaceMode
    {
        None,
        Add,
        Move
    }

    [Parameter]
    public Guid? Id { get; set; }

    private ContentEditContext<GameMap>? _context;
    private ReferencesPanel? _referencesPanel;
    private MapMarker? _selected;
    private PlaceMode _mode = PlaceMode.None;
    private Guid? _imageAssetId;
    private List<AssetLibraryEntry> _markerIcons = [];
    private readonly Dictionary<string, List<EntitySummary>> _targets = [];
    private Guid? _loadedId;
    private bool _notFound;
    private bool _saving;
    private bool _dirty;

    private string PageHeading => _context switch
    {
        null => "Karte",
        { IsNew: true } => "Neue Karte",
        { Entity.Name: var name } when !string.IsNullOrWhiteSpace(name) => name,
        _ => "Karte ohne Namen"
    };

    private List<BreadcrumbItem> Breadcrumbs => [new(PageHeading, null, disabled: true)];

    protected override async Task OnParametersSetAsync()
    {
        if (_context is not null && _loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _notFound = false;
        _dirty = false;
        _context = null;
        _selected = null;
        _mode = PlaceMode.None;

        var projectId = await Project.GetCurrentIdAsync();
        _context = await Maps.LoadForEditAsync(projectId, Id);

        if (_context is null)
        {
            _notFound = true;
            return;
        }

        // Werkzeug-Assets ohne Entität sind laut Konzept genau die Marker für Karten.
        _markerIcons = [.. (await Library.GetLibraryAsync(projectId)).Where(entry => entry.Asset.IsToolAsset)];

        await RefreshImageAsync();
        await LoadTargetsAsync();
    }

    /// <summary>Das primäre Sprite der Karte ist ihr Bild.</summary>
    private async Task RefreshImageAsync()
    {
        if (_context is { IsNew: false })
        {
            _imageAssetId = await Library.GetPrimaryAssetIdAsync(_context.Entity.Id);
        }
    }

    private async Task LoadTargetsAsync()
    {
        if (_context is null)
        {
            return;
        }

        var projectId = await Project.GetCurrentIdAsync();

        foreach (var moduleKey in _context.Entity.Markers
            .Select(marker => marker.TargetModuleKey)
            .OfType<string>()
            .Distinct())
        {
            await EnsureTargetsAsync(projectId, moduleKey);
        }
    }

    private async Task EnsureTargetsAsync(Guid projectId, string moduleKey)
    {
        if (!_targets.ContainsKey(moduleKey))
        {
            _targets[moduleKey] = await References.GetEntitiesAsync(projectId, moduleKey);
        }
    }

    private List<EntitySummary> TargetOptions(string moduleKey) =>
        _targets.GetValueOrDefault(moduleKey, []);

    private EntitySummary? TargetFor(MapMarker marker) =>
        marker.TargetModuleKey is { } moduleKey && marker.TargetEntityId is { } id
            ? TargetOptions(moduleKey).FirstOrDefault(entity => entity.Id == id)
            : null;

    private Task<IEnumerable<EntitySummary>> SearchTargetsAsync(string moduleKey, string? search)
    {
        IEnumerable<EntitySummary> matches = string.IsNullOrWhiteSpace(search)
            ? TargetOptions(moduleKey)
            : TargetOptions(moduleKey).Where(entity =>
                entity.Name.Contains(search, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(matches);
    }

    private async Task ChangeTargetModuleAsync(string? moduleKey)
    {
        if (_selected is null)
        {
            return;
        }

        _selected.TargetModuleKey = moduleKey;
        _selected.TargetEntityId = null;
        MarkDirty();

        if (moduleKey is not null)
        {
            await EnsureTargetsAsync(await Project.GetCurrentIdAsync(), moduleKey);
        }
    }

    // ------------------------------------------------------------------- Markierungen

    private void ToggleAdd()
    {
        _mode = _mode == PlaceMode.Add ? PlaceMode.None : PlaceMode.Add;
    }

    private void ToggleMove()
    {
        _mode = _mode == PlaceMode.Move ? PlaceMode.None : PlaceMode.Move;
    }

    private void SelectMarker(MapMarker marker)
    {
        _selected = marker;

        // Beim Auswählen soll nicht versehentlich verschoben werden.
        if (_mode == PlaceMode.Move)
        {
            _mode = PlaceMode.None;
        }
    }

    private Task OnPointPickedAsync((double X, double Y) point)
    {
        if (_context is null)
        {
            return Task.CompletedTask;
        }

        switch (_mode)
        {
            case PlaceMode.Add:
                var marker = new MapMarker
                {
                    MapId = _context.Entity.Id,
                    X = point.X,
                    Y = point.Y,
                    SortOrder = _context.Entity.Markers.Count
                };

                _context.Entity.Markers.Add(marker);
                _selected = marker;
                MarkDirty();
                break;

            case PlaceMode.Move when _selected is not null:
                _selected.X = point.X;
                _selected.Y = point.Y;
                _mode = PlaceMode.None;
                MarkDirty();
                break;
        }

        return Task.CompletedTask;
    }

    private void RemoveMarker(MapMarker marker)
    {
        _context?.Entity.Markers.Remove(marker);
        _selected = null;
        _mode = PlaceMode.None;
        MarkDirty();
    }

    private void ToggleArea(bool isArea) =>
        Touch(() =>
        {
            if (_selected is not null)
            {
                _selected.Radius = isArea ? 0.05 : null;
            }
        });

    private static string MarkerIcon(MapMarker marker) =>
        marker.IsMapLink ? Icons.Material.Filled.Map
        : marker.IsArea ? Icons.Material.Filled.RadioButtonUnchecked
        : Icons.Material.Filled.Place;

    private string MarkerTitle(MapMarker marker)
    {
        if (!string.IsNullOrWhiteSpace(marker.Label))
        {
            return marker.Label;
        }

        if (marker.TargetModuleKey is { } moduleKey && marker.TargetEntityId is { } id)
        {
            var target = TargetOptions(moduleKey).FirstOrDefault(entity => entity.Id == id);
            if (target is not null)
            {
                return target.Name;
            }
        }

        return marker.IsArea ? "Bereich" : "Markierung";
    }

    // ------------------------------------------------------------------------ Speichern

    private void Touch(Action change)
    {
        change();
        MarkDirty();
    }

    private void MarkDirty() => _dirty = true;

    private async Task SaveAsync()
    {
        if (_context is null)
        {
            return;
        }

        _saving = true;

        try
        {
            var wasNew = _context.IsNew;
            await Maps.SaveMapAsync(_context);
            _dirty = false;

            Snackbar.Add($"„{_context.Entity.Name}“ wurde gespeichert.", Severity.Success);

            if (wasNew)
            {
                Navigation.NavigateTo($"/modules/maps/{_context.Entity.Id}");
                return;
            }

            if (_referencesPanel is not null)
            {
                await _referencesPanel.RefreshAsync();
            }
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_context is null)
        {
            return;
        }

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Karte löschen",
            $"„{_context.Entity.Name}“ wird mit Markierungen, Bildern und Feldwerten gelöscht. "
            + "Verknüpfungen anderer Karten hierher verlieren ihr Ziel.",
            yesText: "Löschen",
            cancelText: "Abbrechen");

        if (confirmed != true)
        {
            return;
        }

        await Maps.DeleteMapAsync(_context.Entity.Id);
        Snackbar.Add("Karte gelöscht.", Severity.Success);
        Navigation.NavigateTo("/modules/maps");
    }

    /// <summary>
    /// Lädt nach einer Änderung an den Felddefinitionen neu und behält dabei, was in der Maske
    /// noch nicht gespeichert ist.
    /// </summary>
    private async Task ReloadKeepingChangesAsync()
    {
        if (_context is null)
        {
            return;
        }

        var entity = _context.Entity;
        var wasDirty = _dirty;
        var selectedId = _selected?.Id;

        var projectId = await Project.GetCurrentIdAsync();
        var reloaded = await Maps.LoadForEditAsync(projectId, entity.Id);

        if (reloaded is null)
        {
            _notFound = true;
            _context = null;
            return;
        }

        reloaded.Entity.Name = entity.Name;
        reloaded.Entity.Description = entity.Description;
        reloaded.Entity.ContentTypeId = entity.ContentTypeId;
        reloaded.Entity.Markers = entity.Markers;

        _context = reloaded;
        _dirty = wasDirty;
        _selected = _context.Entity.Markers.FirstOrDefault(marker => marker.Id == selectedId);
    }
}
