@page "/modules/maps/neu"
@page "/modules/maps/{Id:guid}"
@inject MapService Maps
@inject ReferenceService References
@inject AssetService Library
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<MapEditor> L
@inject ModuleLabels Modules

<PageTitle>@L["PageTitle", PageHeading]</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @L["NotFoundMessage"]
    </MudAlert>
    <MudButton Variant="Variant.Outlined" Href="/modules/maps">@L["BackToOverview"]</MudButton>
}
else if (_context is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <ModuleHeader Module="Module"
                  Title="@PageHeading"
                  Subtitle="@(_context.IsNew ? L["NotSavedYet"].Value : null)"
                  Breadcrumbs="Breadcrumbs">
        <Actions>
            @if (_dirty)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                    @L["UnsavedChanges"]
                </MudChip>
            }
            @if (!_context.IsNew)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteOutline"
                           OnClick="DeleteAsync">
                    @L["Delete"]
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Href="/modules/maps">@L["Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       Disabled="_saving"
                       data-gdm-save
                       OnClick="SaveAsync">
                @L["Save"]
            </MudButton>
        </Actions>
    </ModuleHeader>

    @* Sagt vor dem Speichern, was die Schreibkonflikt-Erkennung erst danach meldet. *@
    <EditingPresenceBanner EntityId="@(_context.IsNew ? null : _context.Entity.Id)" />

    <MudGrid Spacing="4">
        <MudItem xs="12" md="8">
            <MudStack Spacing="4">

                @* ---------------------------------------------------------------- Karte *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">@L["SectionMap"]</MudText>

                        @if (!_context.IsNew)
                        {
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                @if (_mode != PlaceMode.None)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Primary">
                                        @ModeCaption
                                    </MudText>
                                }
                                @if (_mode == PlaceMode.Draw)
                                {
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Check"
                                               Disabled="@(_draftPoints.Count < 3)"
                                               OnClick="CommitDraft">
                                        @L["FinishArea", _draftPoints.Count]
                                    </MudButton>
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Outlined"
                                               OnClick="CancelDraft">
                                        @L["DiscardArea"]
                                    </MudButton>
                                }
                                else
                                {
                                    <MudButton Size="Size.Small"
                                               Variant="@(_mode == PlaceMode.Add ? Variant.Filled : Variant.Outlined)"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.AddLocationAlt"
                                               Disabled="@(_imageAssetId is null)"
                                               OnClick="ToggleAdd">
                                        @(_mode == PlaceMode.Add ? L["PlacingDone"] : L["SetMarker"])
                                    </MudButton>
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Polyline"
                                               Disabled="@(_imageAssetId is null)"
                                               OnClick="StartDraft">
                                        @L["DrawArea"]
                                    </MudButton>
                                }
                            </MudStack>
                        }
                    </MudStack>

                    @if (_context.IsNew)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">
                            @L["NewMapHint"]
                        </MudAlert>
                    }
                    else
                    {
                        @if (_imageAssetId is null)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                                @L["UploadImageHint"]
                            </MudAlert>
                        }

                        <MapCanvas ImageAssetId="_imageAssetId"
                                   Alt="@_context.Entity.Name"
                                   Markers="VisibleMarkers"
                                   SelectedId="_selected?.Id"
                                   DraftPoints="_draftPoints"
                                   Placing="@(_mode != PlaceMode.None)"
                                   OnPointPicked="OnPointPickedAsync"
                                   OnMarkerSelected="SelectMarker"
                                   OnMarkerContextMenu="OpenMarkerMenuAsync" />

                        @* Rechtsklick auf eine Markierung: die Handgriffe der Maske daneben,
                           nur direkt am Ort. Das Menü hat bewusst keinen eigenen Aktivator
                           (leerer ActivatorContent) — geöffnet wird es von der Karte aus an
                           der Mausposition, und es zeigt immer auf die eben ausgewählte
                           Markierung. *@
                        <MudMenu @ref="_markerMenu" PositionAtCursor="true" Dense="true">
                            <ActivatorContent></ActivatorContent>
                            <ChildContent>
                                @if (_selected is { } menuMarker)
                                {
                                    <MudMenuItem Icon="@Icons.Material.Filled.OpenWith" OnClick="ToggleMove">
                                        @L["MarkerMenuMove"]
                                    </MudMenuItem>

                                    @if (menuMarker.IsPolygon)
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Filled.Add" OnClick="ToggleExtend">
                                            @L["MarkerMenuExtend"]
                                        </MudMenuItem>
                                    }

                                    <MudDivider />
                                    <MudMenuItem Icon="@Icons.Material.Filled.DeleteOutline"
                                                 IconColor="Color.Error"
                                                 OnClick="@(() => RemoveMarker(menuMarker))">
                                        @L["MarkerMenuRemove"]
                                    </MudMenuItem>
                                }
                            </ChildContent>
                        </MudMenu>
                    }
                </MudPaper>

                @* --------------------------------------------------------- Stammdaten *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionMasterData"]</MudText>

                    <MudStack Spacing="4">
                        <MudTextField Value="_context.Entity.Name"
                                      ValueChanged="@((string name) => Touch(() => _context.Entity.Name = name))"
                                      T="string"
                                      Label="@L["NameLabel"]"
                                      Variant="Variant.Outlined"
                                      Immediate="true" />

                        <MudTextField Value="_context.Entity.Description"
                                      ValueChanged="@((string text) => Touch(() => _context.Entity.Description = text))"
                                      T="string"
                                      Label="@L["DescriptionLabel"]"
                                      Variant="Variant.Outlined"
                                      Lines="2" />

                        <MudSelect T="Guid?"
                                   Value="_context.Entity.ContentTypeId"
                                   ValueChanged="@((Guid? id) => Touch(() => _context.Entity.ContentTypeId = id))"
                                   Label="@L["TypeLabel"]"
                                   Variant="Variant.Outlined"
                                   Clearable="true">
                            @foreach (var type in _context.AvailableTypes)
                            {
                                <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudStack>
                </MudPaper>

                @* -------------------------------------------------------------- Bilder *@
                <AssetSpritePanel ModuleKey="@ModuleKeys.Maps"
                                  EntityId="_context.Entity.Id"
                                  Disabled="_context.IsNew"
                                  OnChanged="RefreshImageAsync" />

                @* -------------------------------------------------------------- Felder *@
                <div>
                    <ContentFieldsPanel TEntity="GameMap"
                                        Context="_context"
                                        ModuleKey="@ModuleKeys.Maps"
                                        TypesRoute="/modules/maps/arten"
                                        IndividualHint="@L["IndividualHint"]"
                                        OnValueChanged="MarkDirty"
                                        OnFieldDefinitionChanged="ReloadKeepingChangesAsync" />
                </div>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudStack Spacing="4">

                @* ------------------------------------------------ Ausgewählte Markierung *@
                @if (_selected is { } marker)
                {
                    <MudPaper Elevation="0" Class="gdm-panel pa-4">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                            <MudText Typo="Typo.overline" Color="Color.Secondary">@L["SectionMarker"]</MudText>
                            <MudStack Row="true" Spacing="0">
                                <MudTooltip Text="@L["MoveTooltip"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.OpenWith"
                                                   Size="Size.Small"
                                                   Color="@(_mode == PlaceMode.Move ? Color.Primary : Color.Default)"
                                                   OnClick="ToggleMove"
                                                   aria-label="@L["MoveAria"]" />
                                </MudTooltip>
                                <MudTooltip Text="@L["RemoveTooltip"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                   Size="Size.Small"
                                                   OnClick="@(() => RemoveMarker(marker))"
                                                   aria-label="@L["RemoveAria"]" />
                                </MudTooltip>
                            </MudStack>
                        </MudStack>

                        <MudStack Spacing="3">
                            <MudTextField Value="marker.Label"
                                          ValueChanged="@((string v) => Touch(() => marker.Label = v))"
                                          T="string"
                                          Label="@L["MarkerLabelLabel"]"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Immediate="true" />

                            <MudSelect T="string"
                                       Value="marker.TargetModuleKey"
                                       ValueChanged="ChangeTargetModuleAsync"
                                       Label="@L["TargetModuleLabel"]"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense">
                                <MudSelectItem T="string" Value="@(null as string)">@L["TargetNone"]</MudSelectItem>
                                @foreach (var module in ModuleRegistry.All.Where(m => m.Implemented))
                                {
                                    <MudSelectItem T="string" Value="@module.Id">@Modules.Name(module)</MudSelectItem>
                                }
                            </MudSelect>

                            @if (marker.TargetModuleKey is { } targetModule)
                            {
                                @if (TargetOptions(targetModule).Count == 0)
                                {
                                    <MudAlert Severity="Severity.Info" Dense="true">
                                        @L["NoTargetsHint"]
                                    </MudAlert>
                                }
                                else
                                {
                                    <MudAutocomplete T="EntitySummary"
                                                     Value="@TargetFor(marker)"
                                                     ValueChanged="@((EntitySummary? e) => Touch(() => marker.TargetEntityId = e?.Id))"
                                                     SearchFunc="@((string? s, CancellationToken ct) => SearchTargetsAsync(targetModule, s))"
                                                     ToStringFunc="@(e => e?.Name ?? string.Empty)"
                                                     Label="@L["TargetLabel"]"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Clearable="true"
                                                     ResetValueOnEmptyText="true"
                                                     CoerceValue="false"
                                                     MaxItems="50" />
                                }

                                @if (marker.IsMapLink && marker.TargetEntityId is { } linkedMap)
                                {
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Outlined"
                                               StartIcon="@Icons.Material.Filled.Map"
                                               Href="@($"/modules/maps/{linkedMap}")">
                                        @L["OpenLinkedMap"]
                                    </MudButton>
                                }
                            }

                            @if (marker.IsPolygon)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @L["PolygonPointCount", marker.GetPolygonPoints().Count]
                                </MudText>

                                <MudStack Row="true" Spacing="2">
                                    <MudButton Size="Size.Small"
                                               Variant="@(_mode == PlaceMode.Extend ? Variant.Filled : Variant.Outlined)"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Add"
                                               OnClick="ToggleExtend">
                                        @(_mode == PlaceMode.Extend ? L["PlacingDone"] : L["ExtendPolygon"])
                                    </MudButton>
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Outlined"
                                               Disabled="@(marker.GetPolygonPoints().Count <= 3)"
                                               OnClick="RemoveLastPoint">
                                        @L["RemoveLastPoint"]
                                    </MudButton>
                                </MudStack>

                                <MudButton Size="Size.Small"
                                           Variant="Variant.Text"
                                           StartIcon="@Icons.Material.Filled.Place"
                                           OnClick="DissolvePolygon">
                                    @L["DissolvePolygon"]
                                </MudButton>
                            }
                            else
                            {
                                <MudSwitch T="bool"
                                           Value="marker.IsArea"
                                           ValueChanged="ToggleArea"
                                           Color="Color.Primary"
                                           Label="@L["AreaSwitchLabel"]" />

                                @if (marker.IsArea)
                                {
                                    <MudSlider T="double"
                                               Value="@((marker.Radius ?? 0.05) * 100)"
                                               ValueChanged="@((double v) => Touch(() => marker.Radius = v / 100))"
                                               Min="1"
                                               Max="50"
                                               Step="0.5"
                                               Color="Color.Primary">
                                        @L["RadiusLabel", ((marker.Radius ?? 0) * 100).ToString("0.#")]
                                    </MudSlider>
                                }
                            }

                            <MudSelect T="Guid?"
                                       Value="marker.IconAssetId"
                                       ValueChanged="@((Guid? id) => Touch(() => marker.IconAssetId = id))"
                                       Label="@L["IconLabel"]"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true"
                                       Disabled="@(_markerIcons.Count == 0)"
                                       HelperText="@(_markerIcons.Count == 0
                                           ? L["IconHelperText"].Value
                                           : null)">
                                @foreach (var icon in _markerIcons)
                                {
                                    <MudSelectItem T="Guid?" Value="@icon.Asset.Id">@icon.Asset.FileName</MudSelectItem>
                                }
                            </MudSelect>

                            <MudColorPicker Text="@marker.Color"
                                            TextChanged="@((string color) => Touch(() => marker.Color = color))"
                                            Label="@L["ColorLabel"]"
                                            HelperText="@(marker.IconAssetId is null ? L["ColorHelperText"].Value : L["ColorIconHint"].Value)"
                                            Variant="Variant.Outlined"
                                            Margin="Margin.Dense"
                                            ColorPickerView="ColorPickerView.Spectrum"
                                            ShowAlpha="false" />

                            @if (_context.Entity.Layers.Count > 0)
                            {
                                <MudSelect T="Guid?"
                                           Value="marker.LayerId"
                                           ValueChanged="@((Guid? id) => Touch(() => marker.LayerId = id))"
                                           Label="@L["MarkerLayerLabel"]"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense">
                                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">@L["BaseLayer"]</MudSelectItem>
                                    @foreach (var layer in _context.Entity.Layers)
                                    {
                                        <MudSelectItem T="Guid?" Value="@((Guid?)layer.Id)">@layer.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            }

                            <MudStack Row="true" Spacing="2">
                                <MudNumericField T="double"
                                                 Value="@(marker.X * 100)"
                                                 ValueChanged="@((double v) => Touch(() => marker.X = v / 100))"
                                                 Label="@L["XLabel"]"
                                                 Adornment="Adornment.End"
                                                 AdornmentText="%"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 Min="0" Max="100" Step="0.5" />
                                <MudNumericField T="double"
                                                 Value="@(marker.Y * 100)"
                                                 ValueChanged="@((double v) => Touch(() => marker.Y = v / 100))"
                                                 Label="@L["YLabel"]"
                                                 Adornment="Adornment.End"
                                                 AdornmentText="%"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 Min="0" Max="100" Step="0.5" />
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }

                @* --------------------------------------------------------------- Ebenen *@
                @if (!_context.IsNew)
                {
                    <MudPaper Elevation="0" Class="gdm-panel pa-4">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                            <MudText Typo="Typo.overline" Color="Color.Secondary">@L["SectionLayers"]</MudText>
                            <MudButton StartIcon="@Icons.Material.Filled.Add"
                                       Size="Size.Small"
                                       OnClick="AddLayer">
                                @L["AddLayer"]
                            </MudButton>
                        </MudStack>

                        @* Die Grundebene: immer da, immer sichtbar — Markierungen ohne Zuordnung. *@
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="gdm-field-row py-1">
                            <MudTooltip Text="@L["ActivateLayerTooltip"]">
                                <MudIconButton Icon="@(_activeLayerId is null ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)"
                                               Size="Size.Small"
                                               Color="@(_activeLayerId is null ? Color.Primary : Color.Default)"
                                               OnClick="@(() => _activeLayerId = null)"
                                               aria-label="@L["ActivateLayerTooltip"]" />
                            </MudTooltip>
                            <MudText Typo="Typo.body2" Style="flex-grow:1;">@L["BaseLayer"]</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="gdm-mono">
                                @MarkerCountFor(null)
                            </MudText>
                        </MudStack>

                        @foreach (var layer in _context.Entity.Layers)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="gdm-field-row py-1">
                                <MudTooltip Text="@L["ActivateLayerTooltip"]">
                                    <MudIconButton Icon="@(_activeLayerId == layer.Id ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)"
                                                   Size="Size.Small"
                                                   Color="@(_activeLayerId == layer.Id ? Color.Primary : Color.Default)"
                                                   OnClick="@(() => ActivateLayer(layer))"
                                                   aria-label="@L["ActivateLayerTooltip"]" />
                                </MudTooltip>
                                <MudTextField Value="layer.Name"
                                              ValueChanged="@((string name) => Touch(() => layer.Name = name))"
                                              T="string"
                                              Variant="Variant.Text"
                                              Margin="Margin.Dense"
                                              Style="flex-grow:1;" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="gdm-mono">
                                    @MarkerCountFor(layer.Id)
                                </MudText>
                                <MudTooltip Text="@(layer.IsVisible ? L["HideLayerTooltip"] : L["ShowLayerTooltip"])">
                                    <MudIconButton Icon="@(layer.IsVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                                   Size="Size.Small"
                                                   Color="@(layer.IsVisible ? Color.Default : Color.Warning)"
                                                   OnClick="@(() => ToggleLayerVisibility(layer))"
                                                   aria-label="@(layer.IsVisible ? L["HideLayerTooltip"] : L["ShowLayerTooltip"])" />
                                </MudTooltip>
                                <MudTooltip Text="@L["RemoveLayerTooltip"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                   Size="Size.Small"
                                                   OnClick="@(() => RemoveLayer(layer))"
                                                   aria-label="@L["RemoveLayerTooltip"]" />
                                </MudTooltip>
                            </MudStack>
                        }

                        @if (_context.Entity.Layers.Count == 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                                @L["LayersHint"]
                            </MudText>
                        }
                    </MudPaper>
                }

                @* ---------------------------------------------------------- Alle Marker *@
                @if (!_context.IsNew)
                {
                    <MudPaper Elevation="0" Class="gdm-panel pa-4">
                        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">
                            @L["SectionMarkers", _context.Entity.Markers.Count]
                        </MudText>

                        @if (_context.Entity.Markers.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @L["NoMarkersHint"]
                            </MudText>
                        }
                        else
                        {
                            @foreach (var entry in _context.Entity.Markers)
                            {
                                <div class="gdm-field-row py-1" style="cursor:pointer;" @onclick="@(() => SelectMarker(entry))">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudIcon Icon="@MarkerIcon(entry)"
                                                     Size="Size.Small"
                                                     Color="@(entry.Id == _selected?.Id ? Color.Primary : Color.Secondary)" />
                                            <MudText Typo="Typo.body2">@MarkerTitle(entry)</MudText>
                                            @if (LayerNameFor(entry.LayerId) is { } layerName)
                                            {
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@layerName</MudChip>
                                            }
                                        </MudStack>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="gdm-mono">
                                            @((entry.X * 100).ToString("0")) / @((entry.Y * 100).ToString("0"))
                                        </MudText>
                                    </MudStack>
                                </div>
                            }
                        }
                    </MudPaper>
                }

                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionReference"]</MudText>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["GuidLabel"]</MudText>
                        @if (!_context.IsNew)
                        {
                            <EntityPinButton ModuleKey="@Module.Id" EntityId="_context.Entity.Id" />
                        }
                    </MudStack>
                    <EntityIdChip Id="_context.Entity.Id" />

                    <MudDivider Class="my-3" />
                    <EntityStatusSelect Entity="_context.Entity" OnChanged="MarkDirty" />

                    @if (!_context.IsNew)
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["LastModified"]</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                    }
                </MudPaper>

                @if (!_context.IsNew)
                {
                    <EntityTagsPanel ModuleKey="@ModuleKeys.Maps" EntityId="_context.Entity.Id" />
                    <ReferencesPanel @ref="_referencesPanel" EntityId="_context.Entity.Id" />
                    <EntityHistoryPanel @ref="_historyPanel" EntityId="_context.Entity.Id" />
                    <EntityCommentsPanel ModuleKey="@Module.Id" EntityId="_context.Entity.Id" />
                }
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Maps);

    /// <summary>Was der nächste Klick auf die Karte bewirkt.</summary>
    private enum PlaceMode
    {
        None,
        Add,
        Move,

        /// <summary>Ein neues Polygon-Gebiet entsteht: jeder Klick setzt einen Eckpunkt.</summary>
        Draw,

        /// <summary>Jeder Klick hängt einen Eckpunkt an das ausgewählte Polygon an.</summary>
        Extend
    }

    [Parameter]
    public Guid? Id { get; set; }

    private ContentEditContext<GameMap>? _context;
    private ReferencesPanel? _referencesPanel;
    private EntityHistoryPanel? _historyPanel;
    private MapMarker? _selected;
    private MudMenu? _markerMenu;
    private PlaceMode _mode = PlaceMode.None;
    private readonly List<MapPoint> _draftPoints = [];
    private Guid? _imageAssetId;
    private Guid? _activeLayerId;
    private List<AssetLibraryEntry> _markerIcons = [];
    private readonly Dictionary<string, List<EntitySummary>> _targets = [];
    private Guid? _loadedId;
    private bool _notFound;
    private bool _saving;
    private bool _dirty;

    private string ModeCaption => _mode switch
    {
        PlaceMode.Add => L["ClickToPlace"],
        PlaceMode.Move => L["ClickToMove"],
        PlaceMode.Draw => L["ClickToDraw"],
        PlaceMode.Extend => L["ClickToExtend"],
        _ => string.Empty
    };

    private string PageHeading => _context switch
    {
        null => L["HeadingFallback"],
        { IsNew: true } => L["HeadingNew"],
        { Entity.Name: var name } when !string.IsNullOrWhiteSpace(name) => name,
        _ => L["HeadingUnnamed"]
    };

    private List<BreadcrumbItem> Breadcrumbs => [new(PageHeading, null, disabled: true)];

    protected override async Task OnParametersSetAsync()
    {
        if (_context is not null && _loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _notFound = false;
        _dirty = false;
        _context = null;
        _selected = null;
        _mode = PlaceMode.None;
        _draftPoints.Clear();

        var projectId = await Project.GetCurrentIdAsync();
        _context = await Maps.LoadForEditAsync(projectId, Id);

        if (_context is null)
        {
            _notFound = true;
            return;
        }

        // Werkzeug-Assets ohne Entität sind laut Konzept genau die Marker für Karten.
        _markerIcons = [.. (await Library.GetLibraryAsync(projectId)).Where(entry => entry.Asset.IsToolAsset)];

        await RefreshImageAsync();
        await LoadTargetsAsync();
    }

    /// <summary>Das primäre Sprite der Karte ist ihr Bild.</summary>
    private async Task RefreshImageAsync()
    {
        if (_context is { IsNew: false })
        {
            _imageAssetId = await Library.GetPrimaryAssetIdAsync(_context.Entity.Id);
        }
    }

    private async Task LoadTargetsAsync()
    {
        if (_context is null)
        {
            return;
        }

        var projectId = await Project.GetCurrentIdAsync();

        foreach (var moduleKey in _context.Entity.Markers
            .Select(marker => marker.TargetModuleKey)
            .OfType<string>()
            .Distinct())
        {
            await EnsureTargetsAsync(projectId, moduleKey);
        }
    }

    private async Task EnsureTargetsAsync(Guid projectId, string moduleKey)
    {
        if (!_targets.ContainsKey(moduleKey))
        {
            _targets[moduleKey] = await References.GetEntitiesAsync(projectId, moduleKey);
        }
    }

    private List<EntitySummary> TargetOptions(string moduleKey) =>
        _targets.GetValueOrDefault(moduleKey, []);

    private EntitySummary? TargetFor(MapMarker marker) =>
        marker.TargetModuleKey is { } moduleKey && marker.TargetEntityId is { } id
            ? TargetOptions(moduleKey).FirstOrDefault(entity => entity.Id == id)
            : null;

    private Task<IEnumerable<EntitySummary>> SearchTargetsAsync(string moduleKey, string? search)
    {
        IEnumerable<EntitySummary> matches = string.IsNullOrWhiteSpace(search)
            ? TargetOptions(moduleKey)
            : TargetOptions(moduleKey).Where(entity =>
                entity.Name.Contains(search, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(matches);
    }

    private async Task ChangeTargetModuleAsync(string? moduleKey)
    {
        if (_selected is null)
        {
            return;
        }

        _selected.TargetModuleKey = moduleKey;
        _selected.TargetEntityId = null;
        MarkDirty();

        if (moduleKey is not null)
        {
            await EnsureTargetsAsync(await Project.GetCurrentIdAsync(), moduleKey);
        }
    }

    // ------------------------------------------------------------------------- Ebenen

    /// <summary>Nur Markierungen sichtbarer Ebenen werden gezeichnet; die Grundebene ist immer sichtbar.</summary>
    private List<MapMarker> VisibleMarkers =>
        _context is null
            ? []
            : [.. _context.Entity.Markers.Where(marker => IsLayerVisible(marker.LayerId))];

    private bool IsLayerVisible(Guid? layerId) =>
        layerId is null
        || (_context?.Entity.Layers.FirstOrDefault(layer => layer.Id == layerId)?.IsVisible ?? true);

    private int MarkerCountFor(Guid? layerId) =>
        _context?.Entity.Markers.Count(marker => marker.LayerId == layerId) ?? 0;

    private string? LayerNameFor(Guid? layerId) =>
        layerId is null ? null : _context?.Entity.Layers.FirstOrDefault(layer => layer.Id == layerId)?.Name;

    private void AddLayer() =>
        Touch(() =>
        {
            var layer = new MapLayer
            {
                MapId = _context!.Entity.Id,
                Name = L["NewLayerName", _context.Entity.Layers.Count + 1],
                SortOrder = _context.Entity.Layers.Count
            };

            _context.Entity.Layers.Add(layer);
            _activeLayerId = layer.Id;
        });

    /// <summary>Aktiviert eine Ebene für neue Markierungen; eine ausgeblendete wird dabei eingeblendet.</summary>
    private void ActivateLayer(MapLayer layer)
    {
        _activeLayerId = layer.Id;

        if (!layer.IsVisible)
        {
            Touch(() => layer.IsVisible = true);
        }
    }

    private void ToggleLayerVisibility(MapLayer layer) =>
        Touch(() =>
        {
            layer.IsVisible = !layer.IsVisible;

            if (!layer.IsVisible)
            {
                // Eine unsichtbare Auswahl ließe sich unbemerkt verschieben oder löschen.
                if (_selected?.LayerId == layer.Id)
                {
                    _selected = null;
                    SetMode(PlaceMode.None);
                }

                if (_activeLayerId == layer.Id)
                {
                    _activeLayerId = null;
                }
            }
        });

    private void RemoveLayer(MapLayer layer) =>
        Touch(() =>
        {
            _context!.Entity.Layers.Remove(layer);

            // Die Markierungen bleiben — sie fallen auf die Grundebene zurück.
            foreach (var marker in _context.Entity.Markers.Where(m => m.LayerId == layer.Id))
            {
                marker.LayerId = null;
            }

            if (_activeLayerId == layer.Id)
            {
                _activeLayerId = null;
            }
        });

    // ------------------------------------------------------------------- Markierungen

    /// <summary>Wechselt den Modus; eine angefangene Polygon-Zeichnung verfällt dabei.</summary>
    private void SetMode(PlaceMode mode)
    {
        if (_mode == PlaceMode.Draw && mode != PlaceMode.Draw)
        {
            _draftPoints.Clear();
        }

        _mode = mode;
    }

    private void ToggleAdd() =>
        SetMode(_mode == PlaceMode.Add ? PlaceMode.None : PlaceMode.Add);

    private void ToggleMove() =>
        SetMode(_mode == PlaceMode.Move ? PlaceMode.None : PlaceMode.Move);

    private void ToggleExtend() =>
        SetMode(_mode == PlaceMode.Extend ? PlaceMode.None : PlaceMode.Extend);

    private void StartDraft()
    {
        _draftPoints.Clear();
        _mode = PlaceMode.Draw;
    }

    private void CancelDraft() => SetMode(PlaceMode.None);

    private void CommitDraft()
    {
        if (_context is null || _draftPoints.Count < 3)
        {
            return;
        }

        // Der Anker (X/Y) trägt Beschriftung und Symbol — der Schwerpunkt ist dafür der
        // natürliche Startwert, verschieben lässt er sich danach wie jeder Punkt.
        var marker = new MapMarker
        {
            MapId = _context.Entity.Id,
            Points = MapMarker.FormatPoints(_draftPoints),
            X = _draftPoints.Average(p => p.X),
            Y = _draftPoints.Average(p => p.Y),
            LayerId = _activeLayerId,
            SortOrder = _context.Entity.Markers.Count
        };

        _context.Entity.Markers.Add(marker);
        _selected = marker;
        _draftPoints.Clear();
        _mode = PlaceMode.None;
        MarkDirty();
    }

    private void SelectMarker(MapMarker marker)
    {
        var changed = !ReferenceEquals(_selected, marker);
        _selected = marker;

        // Beim Auswählen soll nicht versehentlich verschoben oder angefügt werden.
        if (_mode == PlaceMode.Move || (_mode == PlaceMode.Extend && changed))
        {
            SetMode(PlaceMode.None);
        }
    }

    /// <summary>Die Karte meldet einen Rechtsklick — ausgewählt hat sie die Markierung schon.</summary>
    private Task OpenMarkerMenuAsync((MapMarker Marker, MouseEventArgs Args) context) =>
        _markerMenu?.OpenMenuAsync(context.Args) ?? Task.CompletedTask;

    private Task OnPointPickedAsync((double X, double Y) point)
    {
        if (_context is null)
        {
            return Task.CompletedTask;
        }

        switch (_mode)
        {
            case PlaceMode.Add:
                var marker = new MapMarker
                {
                    MapId = _context.Entity.Id,
                    X = point.X,
                    Y = point.Y,
                    LayerId = _activeLayerId,
                    SortOrder = _context.Entity.Markers.Count
                };

                _context.Entity.Markers.Add(marker);
                _selected = marker;
                MarkDirty();
                break;

            case PlaceMode.Move when _selected is not null:
                MoveSelected(point);
                SetMode(PlaceMode.None);
                MarkDirty();
                break;

            case PlaceMode.Draw:
                // Noch kein Marker — erst „Gebiet übernehmen“ macht aus dem Entwurf einen.
                _draftPoints.Add(new MapPoint(point.X, point.Y));
                break;

            case PlaceMode.Extend when _selected is { IsPolygon: true }:
                var corners = _selected.GetPolygonPoints();
                corners.Add(new MapPoint(point.X, point.Y));
                _selected.Points = MapMarker.FormatPoints(corners);
                MarkDirty();
                break;
        }

        return Task.CompletedTask;
    }

    /// <summary>Verschiebt den Anker — bei einem Polygon wandern alle Eckpunkte mit.</summary>
    private void MoveSelected((double X, double Y) point)
    {
        if (_selected is null)
        {
            return;
        }

        if (_selected.IsPolygon)
        {
            var dx = point.X - _selected.X;
            var dy = point.Y - _selected.Y;

            _selected.Points = MapMarker.FormatPoints([.. _selected.GetPolygonPoints()
                .Select(corner => new MapPoint(
                    Math.Clamp(corner.X + dx, 0, 1),
                    Math.Clamp(corner.Y + dy, 0, 1)))]);
        }

        _selected.X = point.X;
        _selected.Y = point.Y;
    }

    private void RemoveLastPoint()
    {
        if (_selected is not { IsPolygon: true })
        {
            return;
        }

        var corners = _selected.GetPolygonPoints();

        // Unter drei Punkten ist es kein Gebiet mehr — dafür gibt es „In Punkt umwandeln“.
        if (corners.Count <= 3)
        {
            return;
        }

        corners.RemoveAt(corners.Count - 1);
        _selected.Points = MapMarker.FormatPoints(corners);
        MarkDirty();
    }

    private void DissolvePolygon()
    {
        if (_selected is null)
        {
            return;
        }

        _selected.Points = null;

        if (_mode == PlaceMode.Extend)
        {
            SetMode(PlaceMode.None);
        }

        MarkDirty();
    }

    private void RemoveMarker(MapMarker marker)
    {
        _context?.Entity.Markers.Remove(marker);
        _selected = null;
        _mode = PlaceMode.None;
        MarkDirty();
    }

    private void ToggleArea(bool isArea) =>
        Touch(() =>
        {
            if (_selected is not null)
            {
                _selected.Radius = isArea ? 0.05 : null;
            }
        });

    private static string MarkerIcon(MapMarker marker) =>
        marker.IsMapLink ? Icons.Material.Filled.Map
        : marker.IsPolygon ? Icons.Material.Filled.Pentagon
        : marker.IsArea ? Icons.Material.Filled.RadioButtonUnchecked
        : Icons.Material.Filled.Place;

    private string MarkerTitle(MapMarker marker)
    {
        if (!string.IsNullOrWhiteSpace(marker.Label))
        {
            return marker.Label;
        }

        if (marker.TargetModuleKey is { } moduleKey && marker.TargetEntityId is { } id)
        {
            var target = TargetOptions(moduleKey).FirstOrDefault(entity => entity.Id == id);
            if (target is not null)
            {
                return target.Name;
            }
        }

        return marker.IsPolygon ? L["MarkerFallbackPolygon"]
            : marker.IsArea ? L["MarkerFallbackArea"]
            : L["MarkerFallback"];
    }

    // ------------------------------------------------------------------------ Speichern

    private void Touch(Action change)
    {
        change();
        MarkDirty();
    }

    private void MarkDirty() => _dirty = true;

    private async Task SaveAsync()
    {
        if (_context is null)
        {
            return;
        }

        _saving = true;

        try
        {
            var wasNew = _context.IsNew;
            await Maps.SaveMapAsync(_context);
            _dirty = false;

            Snackbar.Add(L["SavedMessage", _context.Entity.Name], Severity.Success);

            if (wasNew)
            {
                Navigation.NavigateTo($"/modules/maps/{_context.Entity.Id}");
                return;
            }

            if (_referencesPanel is not null)
            {
                await _referencesPanel.RefreshAsync();
            }

            if (_historyPanel is not null)
            {
                await _historyPanel.RefreshAsync();
            }
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_context is null)
        {
            return;
        }

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", _context.Entity.Name],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Maps.DeleteMapAsync(_context.Entity.Id);
        Snackbar.Add(L["DeletedMessage"], Severity.Success);
        Navigation.NavigateTo("/modules/maps");
    }

    /// <summary>
    /// Lädt nach einer Änderung an den Felddefinitionen neu und behält dabei, was in der Maske
    /// noch nicht gespeichert ist.
    /// </summary>
    private async Task ReloadKeepingChangesAsync()
    {
        if (_context is null)
        {
            return;
        }

        var entity = _context.Entity;
        var wasDirty = _dirty;
        var selectedId = _selected?.Id;

        var projectId = await Project.GetCurrentIdAsync();
        var reloaded = await Maps.LoadForEditAsync(projectId, entity.Id);

        if (reloaded is null)
        {
            _notFound = true;
            _context = null;
            return;
        }

        reloaded.Entity.Name = entity.Name;
        reloaded.Entity.Description = entity.Description;
        reloaded.Entity.ContentTypeId = entity.ContentTypeId;
        reloaded.Entity.Markers = entity.Markers;
        reloaded.Entity.Layers = entity.Layers;

        _context = reloaded;
        _dirty = wasDirty;
        _selected = _context.Entity.Markers.FirstOrDefault(marker => marker.Id == selectedId);
    }
}
