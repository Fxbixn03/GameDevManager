@page "/modules/views"
@inject SavedViewService Views
@inject ContentTypeService ContentTypes
@inject TagService Tags
@inject ProjectContext Project
@inject ModuleLabels Modules
@inject ContentStatusLabels Statuses
@inject FieldTypeLabels FieldTypes
@inject IUserPermissionsProvider PermissionsProvider
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject IStringLocalizer<SavedViewsPage> L

@*
    Gespeicherte Suchen und Listenansichten (F27).

    Eine Seite für alle Module statt einer Filterleiste in jeder der gut zwanzig Modul-Listen:
    Die sind je Modul eigen gebaut (Kachelraster, Tabelle, Zeitstreifen), und dieselbe Leiste
    zwanzigmal nachzubauen hieße, sie zwanzigmal zu pflegen — dieselbe Überlegung wie bei der
    Massenbearbeitung. Über die IModuleEntitySource deckt eine Seite alle ab, auch die künftigen.
*@

<PageTitle>@L["PageTitle"]</PageTitle>

<ModuleHeader Module="Module" Subtitle="@Subtitle">
    <Actions>
        @if (_moduleKey is not null)
        {
            @* Der Name steht neben dem Knopf statt in einem Dialog: Wer eine Ansicht speichert,
               hat den Filter vor sich und soll ihn beim Benennen nicht verlieren. *@
            <MudTextField @bind-Value="_viewName"
                          Placeholder="@L["NamePlaceholder"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Style="max-width:220px;" />
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.BookmarkAdd"
                       Disabled="@(!_permissions.CanWrite || string.IsNullOrWhiteSpace(_viewName))"
                       OnClick="SaveViewAsync">
                @(_currentViewId is null ? L["SaveView"] : L["UpdateView"])
            </MudButton>
        }
    </Actions>
</ModuleHeader>

@* ------------------------------------------------------------- Gespeicherte Ansichten *@
@if (_views.Count > 0)
{
    <MudPaper Elevation="0" Class="gdm-panel pa-3 mb-4">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SavedViewsLabel"]</MudText>
            @foreach (var view in _views)
            {
                <MudChip T="string"
                         Size="Size.Small"
                         Variant="@(view.Id == _currentViewId ? Variant.Filled : Variant.Outlined)"
                         Color="@(view.Id == _currentViewId ? Color.Primary : Color.Default)"
                         OnClick="@(() => ApplyViewAsync(view))"
                         OnClose="@(() => DeleteViewAsync(view))">
                    @view.Name (@Modules.NameOrKey(view.ModuleKey))
                </MudChip>
            }
        </MudStack>
    </MudPaper>
}

@* -------------------------------------------------------------------------- Filter *@
<MudPaper Elevation="0" Class="gdm-panel pa-4 mb-4">
    <MudStack Spacing="3">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudSelect T="string"
                       Value="_moduleKey"
                       ValueChanged="SelectModuleAsync"
                       Label="@L["ModuleLabel"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Style="min-width:220px;">
                @foreach (var module in AvailableModules)
                {
                    <MudSelectItem T="string" Value="@module.Id">@Modules.Name(module)</MudSelectItem>
                }
            </MudSelect>

            <MudTextField T="string"
                          Value="_filter.Text"
                          ValueChanged="@(async (string text) => { _filter.Text = text; await RunAsync(); })"
                          Label="@L["TextLabel"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="max-width:280px;" />

            @if (_types.Count > 0)
            {
                <MudSelect T="Guid?"
                           Value="_filter.ContentTypeId"
                           ValueChanged="@(async (Guid? id) => { _filter.ContentTypeId = id; await RunAsync(); })"
                           Label="@L["TypeLabel"]"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true"
                           Style="min-width:200px;">
                    @foreach (var type in _types)
                    {
                        <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                    }
                </MudSelect>
            }

            <MudSelect T="ContentStatus"
                       MultiSelection="true"
                       SelectedValues="_filter.Statuses"
                       SelectedValuesChanged="SetStatusesAsync"
                       MultiSelectionTextFunc="@(_ => DescribeStatuses())"
                       Label="@L["StatusLabel"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Style="min-width:200px;">
                @foreach (var status in ContentStatusLabels.All)
                {
                    <MudSelectItem T="ContentStatus" Value="@status">@Statuses.Describe(status)</MudSelectItem>
                }
            </MudSelect>
        </MudStack>

        <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudSwitch T="bool"
                       Value="_filter.WithoutSprite"
                       ValueChanged="@(async (bool on) => { _filter.WithoutSprite = on; await RunAsync(); })"
                       Color="Color.Primary"
                       Label="@L["WithoutSprite"]" />

            <MudSwitch T="bool"
                       Value="_filter.OnlyVariants"
                       ValueChanged="@(async (bool on) => { _filter.OnlyVariants = on; await RunAsync(); })"
                       Color="Color.Primary"
                       Label="@L["OnlyVariants"]" />

            <MudSwitch T="bool"
                       Value="_filter.IncludeSubtypes"
                       ValueChanged="@(async (bool on) => { _filter.IncludeSubtypes = on; await RunAsync(); })"
                       Color="Color.Primary"
                       Label="@L["IncludeSubtypes"]" />

            @if (_tags.Count > 0)
            {
                <MudSelect T="Guid"
                           MultiSelection="true"
                           SelectedValues="_filter.TagIds"
                           SelectedValuesChanged="SetTagsAsync"
                           MultiSelectionTextFunc="@(_ => DescribeTags())"
                           Label="@L["TagsLabel"]"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Style="min-width:200px;">
                    @foreach (var tag in _tags)
                    {
                        <MudSelectItem T="Guid" Value="@tag.Id">@tag.Name</MudSelectItem>
                    }
                </MudSelect>
            }
        </MudStack>

        @* ------------------------------------------------------ Feldbedingungen *@
        @if (_fields.Count > 0)
        {
            <MudDivider />

            @foreach (var criterion in _filter.Fields.ToList())
            {
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudSelect T="Guid"
                               Value="criterion.FieldDefinitionId"
                               ValueChanged="@(async (Guid id) => { criterion.FieldDefinitionId = id; await RunAsync(); })"
                               Label="@L["FieldLabel"]"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Style="min-width:200px;">
                        @foreach (var definition in _fields)
                        {
                            <MudSelectItem T="Guid" Value="@definition.Id">@definition.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="FieldComparison"
                               Value="criterion.Comparison"
                               ValueChanged="@(async (FieldComparison mode) => { criterion.Comparison = mode; await RunAsync(); })"
                               Label="@L["ComparisonLabel"]"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Style="min-width:180px;">
                        @foreach (var mode in Comparisons)
                        {
                            <MudSelectItem T="FieldComparison" Value="@mode">@L[$"Comparison_{mode}"]</MudSelectItem>
                        }
                    </MudSelect>

                    @if (criterion.Comparison is not (FieldComparison.IsEmpty or FieldComparison.IsNotEmpty))
                    {
                        <MudTextField T="string"
                                      Value="criterion.Value"
                                      ValueChanged="@(async (string value) => { criterion.Value = value; await RunAsync(); })"
                                      Label="@L["ValueLabel"]"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Style="max-width:200px;" />
                    }

                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                   Size="Size.Small"
                                   OnClick="@(async () => { _filter.Fields.Remove(criterion); await RunAsync(); })"
                                   aria-label="@L["RemoveCriterion"]" />
                </MudStack>
            }

            <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="AddCriterion">
                @L["AddCriterion"]
            </MudButton>
        }

        @* ------------------------------------------------------------ Spaltenwahl *@
        @if (_fields.Count > 0)
        {
            <MudDivider />
            <MudSelect T="Guid"
                       MultiSelection="true"
                       SelectedValues="_columns"
                       SelectedValuesChanged="SetColumnsAsync"
                       MultiSelectionTextFunc="@(_ => DescribeColumns())"
                       Label="@L["ColumnsLabel"]"
                       HelperText="@L["ColumnsHelper"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">
                @foreach (var definition in _fields)
                {
                    <MudSelectItem T="Guid" Value="@definition.Id">
                        @definition.Name (@FieldTypes.Describe(definition.Type))
                    </MudSelectItem>
                }
            </MudSelect>
        }
    </MudStack>
</MudPaper>

@* ------------------------------------------------------------------------ Ergebnis *@
@if (_moduleKey is null)
{
    <div class="gdm-empty">
        <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
        <MudText Typo="Typo.h6">@L["PickModuleTitle"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["PickModuleHint"]</MudText>
    </div>
}
else if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_rows.Count == 0)
{
    <MudAlert Severity="Severity.Normal">@L["NoMatches"]</MudAlert>
}
else
{
    <MudPaper Elevation="0" Class="gdm-panel">
        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Style="overflow-x:auto;">
            <thead>
                <tr>
                    <th>@L["ColumnName"]</th>
                    <th>@L["ColumnType"]</th>
                    <th>@L["ColumnStatus"]</th>
                    @foreach (var definition in VisibleColumns)
                    {
                        <th>@definition.Name</th>
                    }
                    <th>@L["ColumnUpdated"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr>
                        <td>
                            <MudLink Href="@($"{ModuleRoute}/{row.Id}")">@row.Name</MudLink>
                        </td>
                        <td>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@row.TypeName</MudText>
                        </td>
                        <td>
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@ContentStatusLabels.Icon(row.Status)"
                                         Color="@ContentStatusLabels.Accent(row.Status)"
                                         Size="Size.Small" />
                                <MudText Typo="Typo.body2">@Statuses.Describe(row.Status)</MudText>
                            </MudStack>
                        </td>
                        @foreach (var definition in VisibleColumns)
                        {
                            <td>
                                <MudText Typo="Typo.body2" Class="gdm-mono">@Cell(row, definition)</MudText>
                            </td>
                        }
                        <td>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @row.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </MudText>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Views);

    private static readonly FieldComparison[] Comparisons =
    [
        FieldComparison.Contains, FieldComparison.Equals, FieldComparison.GreaterThan,
        FieldComparison.LessThan, FieldComparison.IsEmpty, FieldComparison.IsNotEmpty
    ];

    private UserPermissions _permissions = UserPermissions.Full;

    private string? _moduleKey;
    private ContentFilter _filter = new();
    private HashSet<Guid> _columns = [];
    private Guid? _currentViewId;
    private string? _viewName;

    private List<ContentRow> _rows = [];
    private List<ContentType> _types = [];
    private List<ContentTagRow> _tags = [];
    private List<FieldDefinition> _fields = [];
    private List<SavedViewRow> _views = [];
    private bool _loading;

    private List<ModuleDefinition> AvailableModules =>
    [
        .. ModuleRegistry.All
            .Where(module => module.Implemented
                && module.Group != ModuleGroup.Tools
                && _permissions.CanAccessModule(module.Id))
    ];

    private string ModuleRoute =>
        _moduleKey is null ? "/" : ModuleRegistry.Find(_moduleKey)?.Route ?? "/";

    private string Subtitle => _moduleKey is null
        ? L["SubtitleEmpty"]
        : L["SubtitleCount", _rows.Count, Modules.NameOrKey(_moduleKey)];

    /// <summary>
    /// Die Spalten, die die Tabelle zeigt. Ohne Auswahl keine — bei einer Art mit 25 Feldern
    /// wäre die Tabelle sonst breiter als jeder Bildschirm.
    /// </summary>
    private List<FieldDefinition> VisibleColumns =>
        [.. _fields.Where(definition => _columns.Contains(definition.Id))];

    protected override async Task OnInitializedAsync()
    {
        _permissions = await PermissionsProvider.GetCurrentAsync();
        _views = await Views.GetViewsAsync(await Project.GetCurrentIdAsync());
    }

    private async Task SelectModuleAsync(string? moduleKey)
    {
        _moduleKey = moduleKey;
        _currentViewId = null;
        _viewName = null;
        _filter = new ContentFilter();
        _columns = [];

        await LoadModuleDataAsync();
        await RunAsync();
    }

    private async Task LoadModuleDataAsync()
    {
        if (_moduleKey is null)
        {
            _types = [];
            _tags = [];
            _fields = [];
            return;
        }

        var projectId = await Project.GetCurrentIdAsync();

        _types = await ContentTypes.GetTypesAsync(projectId, _moduleKey);
        // Tags sind modulübergreifend; die Freigaben je Modul stehen an ihnen selbst.
        _tags =
        [
            .. (await Tags.GetTagsAsync(projectId))
                .Where(tag => tag.ModuleKeys.Count == 0 || tag.ModuleKeys.Contains(_moduleKey))
        ];

        // Die Felder aller Arten des Moduls, ohne Dubletten: Zwei Geschwister-Arten mit einem
        // Feld „Schaden“ teilen sich die Spalte — in einer Tabelle ist das die erwartete Form,
        // dieselbe Regel wie beim Modul-CSV.
        _fields =
        [
            .. _types
                .SelectMany(type => type.InheritedFields.Concat(type.Fields))
                .GroupBy(definition => definition.Name, StringComparer.CurrentCultureIgnoreCase)
                .Select(group => group.First())
                .OrderBy(definition => definition.Name)
        ];
    }

    private async Task RunAsync()
    {
        if (_moduleKey is null)
        {
            _rows = [];
            return;
        }

        _loading = true;

        try
        {
            _rows = await Views.QueryAsync(
                await Project.GetCurrentIdAsync(), _moduleKey, _filter, [.. _columns]);
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _rows = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SetStatusesAsync(IEnumerable<ContentStatus> chosen)
    {
        _filter.Statuses = [.. chosen];
        await RunAsync();
    }

    private async Task SetTagsAsync(IEnumerable<Guid> chosen)
    {
        _filter.TagIds = [.. chosen];
        await RunAsync();
    }

    private async Task SetColumnsAsync(IEnumerable<Guid> chosen)
    {
        _columns = [.. chosen];
        await RunAsync();
    }

    private async Task AddCriterion()
    {
        _filter.Fields.Add(new FieldCriterion
        {
            FieldDefinitionId = _fields[0].Id,
            Comparison = FieldComparison.Contains
        });

        await RunAsync();
    }

    private string Cell(ContentRow row, FieldDefinition definition)
    {
        if (!row.Values.TryGetValue(definition.Id, out var value))
        {
            return "—";
        }

        return value.TextValue
            ?? value.NumberValue?.ToString("0.##")
            ?? (value.BooleanValue is { } flag ? (flag ? L["Yes"] : L["No"]) : null)
            ?? value.DateValue?.ToLocalTime().ToString("dd.MM.yyyy")
            ?? value.ReferenceValue?.ToString()
            ?? "—";
    }

    private string DescribeStatuses() =>
        _filter.Statuses.Count == 0
            ? string.Empty
            : string.Join(", ", _filter.Statuses.Select(Statuses.Describe));

    private string DescribeTags() =>
        _filter.TagIds.Count == 0
            ? string.Empty
            : string.Join(", ", _tags.Where(row => _filter.TagIds.Contains(row.Id)).Select(row => row.Name));

    private string DescribeColumns() =>
        _columns.Count == 0 ? string.Empty : L["ColumnsChosen", _columns.Count];

    // ------------------------------------------------------------ Ansichten verwalten

    private async Task ApplyViewAsync(SavedViewRow view)
    {
        _moduleKey = view.ModuleKey;
        _currentViewId = view.Id;
        _viewName = view.Name;
        _filter = view.Filter;

        await LoadModuleDataAsync();

        // Nach dem Laden der Felder: Eine Spalte, deren Feld es nicht mehr gibt, fällt heraus,
        // statt die Tabelle mit einer leeren Spalte zu belasten.
        _columns = [.. view.ColumnFieldIds.Where(id => _fields.Any(definition => definition.Id == id))];

        await RunAsync();
    }

    private async Task SaveViewAsync()
    {
        if (_moduleKey is null || string.IsNullOrWhiteSpace(_viewName))
        {
            return;
        }

        var existing = _views.FirstOrDefault(view => view.Id == _currentViewId);

        try
        {
            var projectId = await Project.GetCurrentIdAsync();

            // Unter neuem Namen entsteht eine zweite Ansicht — der häufigste Weg, eine Variante
            // einer bestehenden anzulegen.
            var viewId = await Views.SaveViewAsync(
                projectId,
                existing is not null && existing.Name == _viewName.Trim() ? existing.Id : null,
                _moduleKey, _viewName, _filter, [.. _columns]);

            _currentViewId = viewId;
            _views = await Views.GetViewsAsync(projectId);

            Snackbar.Add(L["SavedMessage", _viewName], Severity.Success);
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteViewAsync(SavedViewRow view)
    {
        await Views.DeleteViewAsync(view.Id);

        if (_currentViewId == view.Id)
        {
            _currentViewId = null;
        }

        _views = await Views.GetViewsAsync(await Project.GetCurrentIdAsync());
    }
}
