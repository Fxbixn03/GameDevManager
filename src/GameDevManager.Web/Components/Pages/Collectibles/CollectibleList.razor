@page "/modules/collectibles"
@inject CollectibleService Collectibles
@inject ContentTypeService ContentTypes
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IStringLocalizer<CollectibleList> L

<PageTitle>@L["PageTitle"]</PageTitle>

<ModuleHeader Module="Module" Subtitle="@Subtitle">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Style"
                   Href="/modules/collectibles/arten">
            @L["TypesButton"]
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/modules/collectibles/neu">
            @L["NewCollectible"]
        </MudButton>
    </Actions>
</ModuleHeader>

@if (_collectibles is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_collectibles.Count == 0)
{
    <div class="gdm-empty">
        <MudIcon Icon="@Icons.Material.Filled.Collections" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
        <MudText Typo="Typo.h6">@L["EmptyTitle"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            @L["EmptyHint"]
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/modules/collectibles/neu">
            @L["FirstCollectible"]
        </MudButton>
    </div>
}
else
{
    var filtered = Filtered;

    <MudPaper Elevation="0" Class="gdm-panel pa-4 mb-4">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_search"
                          Placeholder="@L["SearchPlaceholder"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="max-width:360px;" />

            <MudSelect T="Guid?"
                       @bind-Value="_typeFilter"
                       Label="@L["TypeFilterLabel"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="max-width:220px;">
                @foreach (var type in _types)
                {
                    <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSpacer />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["FilterCount", filtered.Count, _collectibles.Count]</MudText>
        </MudStack>
    </MudPaper>

    @if (filtered.Count == 0)
    {
        <MudPaper Elevation="0" Class="gdm-panel pa-4">
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["NoRecords"]</MudText>
        </MudPaper>
    }
    else
    {
        <div class="gdm-item-grid">
            @foreach (var collectible in filtered)
            {
                <MudPaper Elevation="0" Class="gdm-panel gdm-card-link">
                    <MudLink Href="@($"/modules/collectibles/{collectible.Id}")" Underline="Underline.None">
                        <AssetThumbnail AssetId="collectible.PrimaryAssetId"
                                        Class="gdm-item-tile"
                                        Alt="@collectible.Name"
                                        FallbackIcon="@Icons.Material.Filled.Collections" />
                    </MudLink>

                    <div class="pa-3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                            <MudLink Href="@($"/modules/collectibles/{collectible.Id}")" Typo="Typo.body1" Class="gdm-ellipsis">
                                <b>@collectible.Name</b>
                            </MudLink>
                            <MudTooltip Text="@L["DeleteTooltip"]">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                               Size="Size.Small"
                                               OnClick="@(() => DeleteAsync(collectible))"
                                               aria-label="@L["DeleteAria", collectible.Name]" />
                            </MudTooltip>
                        </MudStack>

                        @if (!string.IsNullOrWhiteSpace(collectible.Description))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="gdm-ellipsis">
                                @collectible.Description
                            </MudText>
                        }

                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-2">
                            @if (collectible.PlacementCount == 0)
                            {
                                <MudTooltip Text="@L["NoPlacementsTooltip"]">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@L["NoPlacements"]</MudChip>
                                </MudTooltip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">
                                    @L["PlacementCountChip", collectible.PlacementCount]
                                </MudChip>
                            }
                            @if (collectible.TypeName is null)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NoType"]</MudText>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@collectible.TypeName</MudChip>
                            }
                        </MudStack>

                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                            @L["UpdatedAt", collectible.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")]
                        </MudText>
                    </div>
                </MudPaper>
            }
        </div>
    }
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Collectibles);

    private List<CollectibleListRow>? _collectibles;
    private List<ContentType> _types = [];
    private string? _search;
    private Guid? _typeFilter;

    private string Subtitle => _collectibles is null
        ? L["Loading"]
        : L["SubtitleCount", _collectibles.Count];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var projectId = await Project.GetCurrentIdAsync();
        _types = await ContentTypes.GetTypesAsync(projectId, ModuleKeys.Collectibles);
        _collectibles = await Collectibles.GetCollectiblesAsync(projectId);
    }

    private List<CollectibleListRow> Filtered
    {
        get
        {
            IEnumerable<CollectibleListRow> rows = _collectibles ?? [];

            if (_typeFilter is { } typeId)
            {
                rows = rows.Where(row => row.ContentTypeId == typeId);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                rows = rows.Where(row =>
                    row.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (row.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return [.. rows];
        }
    }

    private async Task DeleteAsync(CollectibleListRow row)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", row.Name],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Collectibles.DeleteCollectibleAsync(row.Id);
        Snackbar.Add(L["DeletedMessage", row.Name], Severity.Success);
        await LoadAsync();
    }
}
