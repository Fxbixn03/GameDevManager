@page "/modules/collectibles/arten"

<PageTitle>Sammelobjekt-Arten – GameDevManager</PageTitle>

<ModuleHeader Module="Module"
              Title="Sammelobjekt-Arten"
              Subtitle="Das Konzept verlangt hier ausdrücklich eigene Felder — sie kommen über die Arten."
              Breadcrumbs="Breadcrumbs">
    <Actions>
        <MudButton Variant="Variant.Outlined" Href="/modules/collectibles">Zu den Sammelobjekten</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddAsync">
            Neue Art
        </MudButton>
    </Actions>
</ModuleHeader>

<ContentTypeManager @ref="_manager"
                    ModuleKey="@ModuleKeys.Collectibles"
                    EntityNoun="Sammelobjekt"
                    EmptyTitle="Noch keine Sammelobjekt-Arten"
                    EmptyHint="Über Arten lassen sich Sammelobjekte einteilen — etwa Statue, Notiz oder Relikt — und um eigene Felder wie Fundregion oder Belohnungsstufe ergänzen." />

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Collectibles);

    private static readonly List<BreadcrumbItem> Breadcrumbs = [new("Arten", null, disabled: true)];

    private ContentTypeManager? _manager;

    private Task AddAsync() => _manager?.AddTypeAsync() ?? Task.CompletedTask;
}
