@page "/modules/quests/neu"
@page "/modules/quests/{Id:guid}"
@inject QuestService Quests
@inject ConditionService Conditions
@inject ReferenceService References
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<QuestEditor> L

<PageTitle>@L["PageTitle", PageHeading]</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @L["NotFound"]
    </MudAlert>
    <MudButton Variant="Variant.Outlined" Href="/modules/quests">@L["BackToList"]</MudButton>
}
else if (_context is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <ModuleHeader Module="Module"
                  Title="@PageHeading"
                  Subtitle="@(_context.IsNew ? L["NotSavedYet"].Value : null)"
                  Breadcrumbs="Breadcrumbs">
        <Actions>
            @if (_dirty)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                    @L["UnsavedChanges"]
                </MudChip>
            }
            @if (!_context.IsNew)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteOutline"
                           OnClick="DeleteAsync">
                    @L["Delete"]
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Href="/modules/quests">@L["Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       Disabled="_saving"
                       OnClick="SaveAsync">
                @L["Save"]
            </MudButton>
        </Actions>
    </ModuleHeader>

    <MudGrid Spacing="4">
        <MudItem xs="12" md="8">
            <MudStack Spacing="4">

                @* ------------------------------------------------------------- Stammdaten *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionMasterData"]</MudText>

                    <MudStack Spacing="4">
                        <MudTextField Value="_context.Entity.Name"
                                      ValueChanged="@((string name) => Touch(() => _context.Entity.Name = name))"
                                      T="string"
                                      Label="@L["NameLabel"]"
                                      Variant="Variant.Outlined"
                                      Immediate="true" />

                        <MudTextField Value="_context.Entity.Description"
                                      ValueChanged="@((string text) => Touch(() => _context.Entity.Description = text))"
                                      T="string"
                                      Label="@L["DescriptionLabel"]"
                                      Variant="Variant.Outlined"
                                      Lines="3" />

                        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudSelect T="QuestKind"
                                       Value="_context.Entity.Kind"
                                       ValueChanged="@((QuestKind kind) => Touch(() => _context.Entity.Kind = kind))"
                                       Label="@L["KindLabel"]"
                                       Variant="Variant.Outlined"
                                       Style="max-width:220px;">
                                @foreach (var kind in Enum.GetValues<QuestKind>())
                                {
                                    <MudSelectItem T="QuestKind" Value="@kind">@Quests.KindLabel(kind)</MudSelectItem>
                                }
                            </MudSelect>

                            <MudSelect T="Guid?"
                                       Value="_context.Entity.ContentTypeId"
                                       ValueChanged="ChangeType"
                                       Label="@L["TypeLabel"]"
                                       Variant="Variant.Outlined"
                                       Clearable="true"
                                       Style="max-width:240px;">
                                @foreach (var type in _context.AvailableTypes)
                                {
                                    <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudStack>

                        @if (_context.Entity.Kind == QuestKind.Event)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">
                                @L["EventHintBefore"]
                                <MudLink Href="/modules/events" Color="Color.Primary">@L["EventHintLink"]</MudLink>
                                @L["EventHintAfter"]
                            </MudAlert>
                        }
                    </MudStack>
                </MudPaper>

                @* ---------------------------------------------------------- Verknüpfungen *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionLinks"]</MudText>

                    <MudStack Spacing="4">
                        <MudAutocomplete T="EntitySummary"
                                         Value="@EntityFor(_npcs, _context.Entity.GiverNpcId)"
                                         ValueChanged="@((EntitySummary? e) => Touch(() => _context.Entity.GiverNpcId = e?.Id))"
                                         SearchFunc="@((s, ct) => SearchAsync(_npcs, s, ct))"
                                         ToStringFunc="@(e => e?.Name ?? string.Empty)"
                                         Label="@L["GiverLabel"]"
                                         HelperText="@L["GiverHelper"]"
                                         Variant="Variant.Outlined"
                                         Clearable="true"
                                         ResetValueOnEmptyText="true"
                                         CoerceValue="false"
                                         MaxItems="50" />

                        <MudAutocomplete T="EntitySummary"
                                         Value="@EntityFor(_storyEntries, _context.Entity.StoryEntryId)"
                                         ValueChanged="@((EntitySummary? e) => Touch(() => _context.Entity.StoryEntryId = e?.Id))"
                                         SearchFunc="@((s, ct) => SearchAsync(_storyEntries, s, ct))"
                                         ToStringFunc="@(e => e?.Name ?? string.Empty)"
                                         Label="@L["StoryEntryLabel"]"
                                         HelperText="@L["StoryEntryHelper"]"
                                         Variant="Variant.Outlined"
                                         Clearable="true"
                                         ResetValueOnEmptyText="true"
                                         CoerceValue="false"
                                         MaxItems="50" />

                        <MudAutocomplete T="EntitySummary"
                                         Value="@EntityFor(_dialogues, _context.Entity.DialogueId)"
                                         ValueChanged="@((EntitySummary? e) => Touch(() => _context.Entity.DialogueId = e?.Id))"
                                         SearchFunc="@((s, ct) => SearchAsync(_dialogues, s, ct))"
                                         ToStringFunc="@(e => e?.Name ?? string.Empty)"
                                         Label="@L["DialogueLabel"]"
                                         HelperText="@L["DialogueHelper"]"
                                         Variant="Variant.Outlined"
                                         Clearable="true"
                                         ResetValueOnEmptyText="true"
                                         CoerceValue="false"
                                         MaxItems="50" />
                    </MudStack>
                </MudPaper>

                @* ------------------------------------------------------------------- Ziele *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">@L["SectionObjectives"]</MudText>
                        <MudSpacer />
                        <MudButton Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddObjective">
                            @L["AddObjective"]
                        </MudButton>
                    </MudStack>

                    @if (_context.Entity.Objectives.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["NoObjectives"]</MudText>
                    }
                    else
                    {
                        <MudStack Spacing="0">
                            @for (var index = 0; index < _context.Entity.Objectives.Count; index++)
                            {
                                var objective = _context.Entity.Objectives[index];
                                var position = index;
                                var conditionCount = _objectiveConditionCounts.GetValueOrDefault(objective.Id);

                                <div class="pa-2 gdm-field-row">
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start">
                                        <MudText Typo="Typo.subtitle2" Class="gdm-mono mt-3" Style="min-width:32px;">
                                            @(position + 1).
                                        </MudText>

                                        <div style="flex:1 1 auto; min-width:0;">
                                            <MudTextField T="string"
                                                          Value="objective.Text"
                                                          ValueChanged="@((string text) => Touch(() => objective.Text = text))"
                                                          Label="@L["ObjectiveTextLabel"]"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          MaxLength="2000" />

                                            <MudSwitch T="bool"
                                                       Value="objective.IsOptional"
                                                       ValueChanged="@((bool value) => Touch(() => objective.IsOptional = value))"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Label="@L["ObjectiveOptional"]" />
                                        </div>

                                        @* Die Abschlussbedingung hängt an der GUID des Ziels — deshalb
                                           erst nach dem ersten Speichern, wie überall bei Teilobjekten. *@
                                        <MudTooltip Text="@(_context.IsNew ? L["ObjectiveConditionsAfterSave"] : L["ObjectiveConditions"])">
                                            <MudButton Size="Size.Small"
                                                       Variant="@(conditionCount > 0 ? Variant.Filled : Variant.Text)"
                                                       Color="@(conditionCount > 0 ? Color.Primary : Color.Default)"
                                                       StartIcon="@Icons.Material.Filled.Rule"
                                                       Disabled="@(_context.IsNew || _dirty)"
                                                       OnClick="@(() => EditObjectiveConditionsAsync(objective))">
                                                @(conditionCount > 0 ? conditionCount.ToString() : L["ObjectiveConditionsShort"].Value)
                                            </MudButton>
                                        </MudTooltip>

                                        <MudStack Spacing="0">
                                            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                                           Size="Size.Small"
                                                           Disabled="@(position == 0)"
                                                           OnClick="@(() => MoveObjective(position, -1))"
                                                           aria-label="@L["MoveObjectiveUp"]" />
                                            <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward"
                                                           Size="Size.Small"
                                                           Disabled="@(position == _context.Entity.Objectives.Count - 1)"
                                                           OnClick="@(() => MoveObjective(position, 1))"
                                                           aria-label="@L["MoveObjectiveDown"]" />
                                        </MudStack>

                                        <MudTooltip Text="@L["RemoveObjective"]">
                                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                           Size="Size.Small"
                                                           OnClick="@(() => RemoveObjective(objective))"
                                                           aria-label="@L["RemoveObjective"]" />
                                        </MudTooltip>
                                    </MudStack>
                                </div>
                            }
                        </MudStack>

                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">
                            @L["ObjectivesHint"]
                        </MudText>
                    }
                </MudPaper>

                @* ------------------------------------------------------------ Bedingungen *@
                @if (!_context.IsNew)
                {
                    <MudPaper Elevation="0" Class="gdm-panel pa-4">
                        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionConditions"]</MudText>

                        <MudExpansionPanels Elevation="0" MultiExpansion="true">
                            @* „Manche Quests sind nur nach einer Bedingung verfügbar.“ *@
                            <MudExpansionPanel Text="@(_availabilityCount > 0 ? L["AvailabilityPanelCount", _availabilityCount] : L["AvailabilityPanel"])">
                                <ConditionEditor OwnerId="_context.Entity.Id"
                                                 OwnerModuleKey="@ModuleKeys.Quests"
                                                 Slot="@ConditionSlots.Availability"
                                                 EmptyHint="@L["AvailabilityHint"]"
                                                 OnSaved="@((int count) => _availabilityCount = count)" />
                            </MudExpansionPanel>

                            @* Der Health Check „Quests ohne Abschlussbedingung“ schaut auf diesen Slot. *@
                            <MudExpansionPanel Text="@(_completionCount > 0 ? L["CompletionPanelCount", _completionCount] : L["CompletionPanel"])">
                                <ConditionEditor OwnerId="_context.Entity.Id"
                                                 OwnerModuleKey="@ModuleKeys.Quests"
                                                 Slot="@ConditionSlots.Completion"
                                                 EmptyHint="@L["CompletionHint"]"
                                                 OnSaved="@((int count) => _completionCount = count)" />
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    </MudPaper>
                }

                @* ------------------------------------------------------------------ Sprites *@
                <AssetSpritePanel ModuleKey="@ModuleKeys.Quests"
                                  EntityId="_context.Entity.Id"
                                  Disabled="_context.IsNew" />

                @* ------------------------------------------------------------------- Felder *@
                <div>
                    <ContentFieldsPanel TEntity="Quest"
                                        Context="_context"
                                        ModuleKey="@ModuleKeys.Quests"
                                        TypesRoute="/modules/quests/arten"
                                        IndividualHint="@L["IndividualHint"]"
                                        OnValueChanged="MarkDirty"
                                        OnFieldDefinitionChanged="ReloadKeepingChangesAsync" />
                </div>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudStack Spacing="4">
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionReference"]</MudText>

                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["GuidCaption"]</MudText>
                    <EntityIdChip Id="_context.Entity.Id" />

                    <MudDivider Class="my-3" />
                    <EntityStatusSelect Entity="_context.Entity" OnChanged="MarkDirty" />

                    @if (!_context.IsNew)
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["CreatedCaption"]</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">@L["UpdatedCaption"]</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                    }
                </MudPaper>

                @if (!_context.IsNew)
                {
                    <EntityTagsPanel ModuleKey="@ModuleKeys.Quests" EntityId="_context.Entity.Id" />
                    <ReferencesPanel @ref="_referencesPanel" EntityId="_context.Entity.Id" />
                    <EntityHistoryPanel @ref="_historyPanel" EntityId="_context.Entity.Id" />
                }
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Quests);

    [Parameter]
    public Guid? Id { get; set; }

    private ContentEditContext<Quest>? _context;
    private ReferencesPanel? _referencesPanel;
    private EntityHistoryPanel? _historyPanel;
    private List<EntitySummary> _npcs = [];
    private List<EntitySummary> _storyEntries = [];
    private List<EntitySummary> _dialogues = [];
    private int _availabilityCount;
    private int _completionCount;
    private Dictionary<Guid, int> _objectiveConditionCounts = [];
    private Guid? _loadedId;
    private bool _notFound;
    private bool _saving;
    private bool _dirty;

    private string PageHeading => _context switch
    {
        null => L["HeadingDefault"],
        { IsNew: true } => L["HeadingNew"],
        { Entity.Name: var name } when !string.IsNullOrWhiteSpace(name) => name,
        _ => L["HeadingUnnamed"]
    };

    private List<BreadcrumbItem> Breadcrumbs => [new(PageHeading, null, disabled: true)];

    protected override async Task OnParametersSetAsync()
    {
        if (_context is not null && _loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _notFound = false;
        _dirty = false;
        _context = null;

        var projectId = await Project.GetCurrentIdAsync();
        _npcs = await References.GetEntitiesAsync(projectId, ModuleKeys.Npcs);
        _storyEntries = await References.GetEntitiesAsync(projectId, ModuleKeys.Story);
        _dialogues = await References.GetEntitiesAsync(projectId, ModuleKeys.Dialogs);
        _context = await Quests.LoadForEditAsync(projectId, Id);

        if (_context is null)
        {
            _notFound = true;
            return;
        }

        if (!_context.IsNew)
        {
            var counts = await Conditions.CountByOwnersAsync([_context.Entity.Id], ConditionSlots.Availability);
            _availabilityCount = counts.GetValueOrDefault(_context.Entity.Id);

            await RefreshCompletionCountsAsync();
        }
    }

    /// <summary>
    /// Der Abschluss-Slot hängt sowohl an der Quest selbst als auch an jedem einzelnen Ziel —
    /// beides in einem Zug, damit die Knöpfe nach dem Bedingungs-Dialog stimmen.
    /// </summary>
    private async Task RefreshCompletionCountsAsync()
    {
        if (_context is null)
        {
            return;
        }

        var counts = await Conditions.CountByOwnersAsync([_context.Entity.Id], ConditionSlots.Completion);
        _completionCount = counts.GetValueOrDefault(_context.Entity.Id);

        var objectiveIds = _context.Entity.Objectives.Select(objective => objective.Id).ToList();
        _objectiveConditionCounts = objectiveIds.Count == 0
            ? []
            : await Conditions.CountByOwnersAsync(objectiveIds, ConditionSlots.Completion);
    }

    private static EntitySummary? EntityFor(List<EntitySummary> pool, Guid? id) =>
        id is null ? null : pool.FirstOrDefault(entity => entity.Id == id);

    private static Task<IEnumerable<EntitySummary>> SearchAsync(
        List<EntitySummary> pool, string? search, CancellationToken ct)
    {
        IEnumerable<EntitySummary> matches = string.IsNullOrWhiteSpace(search)
            ? pool
            : pool.Where(entity => entity.Name.Contains(search, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(matches);
    }

    private void AddObjective() =>
        Touch(() => _context!.Entity.Objectives.Add(new QuestObjective
        {
            QuestId = _context.Entity.Id,
            Text = string.Empty,
            SortOrder = _context.Entity.Objectives.Count
        }));

    private void RemoveObjective(QuestObjective objective) =>
        Touch(() => _context!.Entity.Objectives.Remove(objective));

    private void MoveObjective(int index, int offset) =>
        Touch(() =>
        {
            var objectives = _context!.Entity.Objectives;
            (objectives[index], objectives[index + offset]) =
                (objectives[index + offset], objectives[index]);
        });

    /// <summary>
    /// Die Abschlussbedingung eines Ziels — sie hängt an dessen eigener GUID, genau wie die
    /// eines Händler-Postens. Der Dialog speichert selbst, deshalb danach nachzählen.
    /// </summary>
    private async Task EditObjectiveConditionsAsync(QuestObjective objective)
    {
        var parameters = new DialogParameters<ConditionDialog>
        {
            { dialog => dialog.OwnerId, objective.Id },
            { dialog => dialog.OwnerModuleKey, ModuleKeys.Quests },
            { dialog => dialog.Slot, ConditionSlots.Completion },
            { dialog => dialog.Subject, L["ObjectiveConditionSubject", objective.Text, _context!.Entity.Name].Value },
            { dialog => dialog.EmptyHint, L["ObjectiveConditionEmptyHint"].Value }
        };

        var reference = await Dialogs.ShowAsync<ConditionDialog>(
            L["ObjectiveConditionsDialogTitle"],
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        await reference.Result;
        await RefreshCompletionCountsAsync();
    }

    private void ChangeType(Guid? contentTypeId) =>
        Touch(() => _context!.Entity.ContentTypeId = contentTypeId);

    private void Touch(Action change)
    {
        change();
        MarkDirty();
    }

    private void MarkDirty() => _dirty = true;

    private async Task SaveAsync()
    {
        if (_context is null)
        {
            return;
        }

        _saving = true;

        try
        {
            var wasNew = _context.IsNew;
            await Quests.SaveQuestAsync(_context);
            _dirty = false;

            Snackbar.Add(L["SavedMessage", _context.Entity.Name], Severity.Success);

            if (wasNew)
            {
                Navigation.NavigateTo($"/modules/quests/{_context.Entity.Id}");
                return;
            }

            // Frisch angelegte Ziele haben ihre GUID erst jetzt in der Datenbank — vorher
            // führte der Bedingungs-Knopf ins Leere.
            await RefreshCompletionCountsAsync();

            if (_referencesPanel is not null)
            {
                await _referencesPanel.RefreshAsync();
            }

            if (_historyPanel is not null)
            {
                await _historyPanel.RefreshAsync();
            }
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_context is null)
        {
            return;
        }

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", _context.Entity.Name],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Quests.DeleteQuestAsync(_context.Entity.Id);
        Snackbar.Add(L["DeletedMessage"], Severity.Success);
        Navigation.NavigateTo("/modules/quests");
    }

    /// <summary>
    /// Lädt nach einer Änderung an den Felddefinitionen neu und behält dabei, was in der Maske
    /// noch nicht gespeichert ist.
    /// </summary>
    private async Task ReloadKeepingChangesAsync()
    {
        if (_context is null)
        {
            return;
        }

        var entity = _context.Entity;
        var wasDirty = _dirty;

        var projectId = await Project.GetCurrentIdAsync();
        var reloaded = await Quests.LoadForEditAsync(projectId, entity.Id);

        if (reloaded is null)
        {
            _notFound = true;
            _context = null;
            return;
        }

        reloaded.Entity.Name = entity.Name;
        reloaded.Entity.Description = entity.Description;
        reloaded.Entity.ContentTypeId = entity.ContentTypeId;
        reloaded.Entity.Kind = entity.Kind;
        reloaded.Entity.GiverNpcId = entity.GiverNpcId;
        reloaded.Entity.StoryEntryId = entity.StoryEntryId;
        reloaded.Entity.DialogueId = entity.DialogueId;
        reloaded.Entity.Objectives = entity.Objectives;

        _context = reloaded;
        _dirty = wasDirty;
    }
}
