@page "/modules/statistics"
@inject StatisticsService Statistics
@inject CraftingService Crafting
@inject LootService Loot
@inject DialogueService Dialogues
@inject ConditionService Conditions
@inject TechTreeService TechTree
@inject EconomyService Economy
@inject VoiceOverService VoiceOvers
@inject QuestService Quests
@inject HealthCheckMuteService Mutes
@inject ProjectContext Project
@inject ISnackbar Snackbar
@inject IStringLocalizer<StatisticsPage> L
@inject ModuleLabels Modules

<PageTitle>@L["PageTitle"]</PageTitle>

<ModuleHeader Module="Module" Subtitle="@L["Subtitle"]">
    <Actions>
        @* Das Gesamtbild der Spielwirtschaft — Preise, Quellen und Senken. *@
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Payments"
                   Href="/modules/statistics/oekonomie">
            @L["ToEconomy"]
        </MudButton>
        @* Zwei Wertesätze gegeneinander — nach dem Muster des Loot-Simulators. *@
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.SportsKabaddi"
                   Href="/modules/statistics/kampf">
            @L["ToCombat"]
        </MudButton>
        @* Was nur dieses Projekt von seinen Inhalten verlangt — neben den eingebauten Checks. *@
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Rule"
                   Href="/modules/statistics/regeln">
            @L["ToRules"]
        </MudButton>
    </Actions>
</ModuleHeader>

@if (_counts is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @* ------------------------------------------------------------------ Kennzahlen *@
    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2">@L["MetricsHeading"]</MudText>
    <MudGrid Spacing="2" Class="mb-2">
        @foreach (var count in _counts)
        {
            var module = ModuleRegistry.Find(count.ModuleKey);
            if (module is null)
            {
                continue;
            }

            <MudItem xs="6" sm="4" md="3" lg="2">
                <MudPaper Elevation="0" Class="gdm-panel pa-3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@module.Icon" Size="Size.Small" Color="Color.Secondary" />
                        <div>
                            <MudText Typo="Typo.h6" Class="gdm-mono">@count.Count</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@Modules.Name(module)</MudText>
                        </div>
                    </MudStack>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    @if (_npcBreakdown is not null)
    {
        <MudPaper Elevation="0" Class="gdm-panel pa-3 mb-6">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @L["NpcBreakdownIntro"] <b>@L["NpcBreakdownPeaceful", _npcBreakdown.NpcCount]</b>, <b>@L["NpcBreakdownHostile", _npcBreakdown.MobCount]</b>
                @L["NpcBreakdownRoles", _npcBreakdown.TraderCount, _npcBreakdown.QuestGiverCount]
            </MudText>
        </MudPaper>
    }

    @* --------------------------------------------------------------- Health Checks *@
    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2">@L["HealthChecksHeading"]</MudText>

    <MudStack Spacing="3">
        @* Zyklische Rezepte *@
        <MudPaper Elevation="0" Class="gdm-panel pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@StatusIcon(_cycles.Count)" Color="@StatusColor(_cycles.Count)" Size="Size.Small" />
                <MudText Typo="Typo.subtitle1"><b>@L["CyclesTitle"]</b></MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@FundLabel(_cycles.Count)</MudText>
                <MudSpacer />
                <MudLink Href="/modules/crafting" Typo="Typo.caption">@L["ToCrafting"]</MudLink>
            </MudStack>
            @foreach (var cycle in _cycles)
            {
                <MudText Typo="Typo.body2" Class="gdm-mono py-1">@string.Join(" → ", cycle.ItemNames)</MudText>
            }
        </MudPaper>

        @* Items ohne Bezugsquelle *@
        <MudPaper Elevation="0" Class="gdm-panel pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@StatusIcon(VisibleDeadItems.Count)" Color="@StatusColor(VisibleDeadItems.Count)" Size="Size.Small" />
                <MudText Typo="Typo.subtitle1"><b>@L["DeadItemsTitle"]</b></MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@FundLabel(VisibleDeadItems.Count)</MudText>
                <MudSpacer />
                <MudLink Href="/modules/items" Typo="Typo.caption">@L["ToItems"]</MudLink>
            </MudStack>
            @if (VisibleDeadItems.Count > 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    @L["DeadItemsHint"]
                </MudText>
                @foreach (var item in VisibleDeadItems)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="py-1">
                        <MudLink Href="@($"/modules/items/{item.Id}")" Typo="Typo.body2">@item.Name</MudLink>
                        @MuteButton(HealthCheckKeys.DeadItems, item.Id, item.Name)
                    </MudStack>
                }
            }
        </MudPaper>

        @* Quests ohne Abschlussbedingung *@
        <MudPaper Elevation="0" Class="gdm-panel pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@StatusIcon(VisibleQuests.Count)" Color="@StatusColor(VisibleQuests.Count)" Size="Size.Small" />
                <MudText Typo="Typo.subtitle1"><b>@L["QuestsTitle"]</b></MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@FundLabel(VisibleQuests.Count)</MudText>
                <MudSpacer />
                <MudLink Href="/modules/quests" Typo="Typo.caption">@L["ToQuests"]</MudLink>
            </MudStack>
            @foreach (var quest in VisibleQuests)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="py-1">
                    <MudLink Href="@($"/modules/quests/{quest.Id}")" Typo="Typo.body2">@quest.Name</MudLink>
                    @MuteButton(HealthCheckKeys.QuestsWithoutCompletion, quest.Id, quest.Name)
                </MudStack>
            }
        </MudPaper>

        @* Dialog-Sackgassen. Stummgeschaltet wird je Dialog — ein Dialog mit drei Sackgassen
           ist ein „bewusst so“ und nicht drei. *@
        <MudPaper Elevation="0" Class="gdm-panel pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@StatusIcon(VisibleDialogueProblems.Count)" Color="@StatusColor(VisibleDialogueProblems.Count)" Size="Size.Small" />
                <MudText Typo="Typo.subtitle1"><b>@L["DialoguesTitle"]</b></MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@FundLabel(VisibleDialogueProblems.Count)</MudText>
                <MudSpacer />
                <MudLink Href="/modules/dialogs" Typo="Typo.caption">@L["ToDialogues"]</MudLink>
            </MudStack>
            @foreach (var problem in VisibleDialogueProblems)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="py-1">
                    <MudLink Href="@($"/modules/dialogs/{problem.DialogueId}")" Typo="Typo.body2">
                        @problem.DialogueName
                    </MudLink>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@problem.Message</MudText>
                    @MuteButton(HealthCheckKeys.DialogueDeadEnds, problem.DialogueId, problem.DialogueName)
                </MudStack>
            }
        </MudPaper>

        @* Loot über 100 % *@
        <MudPaper Elevation="0" Class="gdm-panel pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@StatusIcon(VisibleOverfullTables.Count)" Color="@StatusColor(VisibleOverfullTables.Count)" Size="Size.Small" />
                <MudText Typo="Typo.subtitle1"><b>@L["LootTitle"]</b></MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@FundLabel(VisibleOverfullTables.Count)</MudText>
                <MudSpacer />
                <MudLink Href="/modules/loot" Typo="Typo.caption">@L["ToLoot"]</MudLink>
            </MudStack>
            @foreach (var table in VisibleOverfullTables)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="py-1">
                    <MudLink Href="@($"/modules/loot/{table.Id}")" Typo="Typo.body2">@table.Name</MudLink>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="gdm-mono">
                        @table.TotalChance.ToString("0.##") %
                    </MudText>
                    @MuteButton(HealthCheckKeys.OverfullLoot, table.Id, table.Name)
                </MudStack>
            }
        </MudPaper>

        @* Verwaiste Sprites *@
        <MudPaper Elevation="0" Class="gdm-panel pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@StatusIcon(VisibleOrphans.Count)" Color="@StatusColor(VisibleOrphans.Count)" Size="Size.Small" />
                <MudText Typo="Typo.subtitle1"><b>@L["OrphansTitle"]</b></MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@FundLabel(VisibleOrphans.Count)</MudText>
                <MudSpacer />
                <MudLink Href="/modules/assets" Typo="Typo.caption">@L["ToAssets"]</MudLink>
            </MudStack>
            @foreach (var orphan in VisibleOrphans)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="py-1">
                    <AssetThumbnail AssetId="orphan.AssetId" Size="Size.Small" Alt="@orphan.FileName" />
                    <MudText Typo="Typo.body2">@orphan.FileName</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @Modules.NameOrKey(orphan.OwnerModuleKey)
                    </MudText>
                    @MuteButton(HealthCheckKeys.OrphanedAssets, orphan.AssetId, orphan.FileName)
                </MudStack>
            }
        </MudPaper>

        @* Unerfüllbare Bedingungen *@
        <MudPaper Elevation="0" Class="gdm-panel pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@StatusIcon(_conditionProblems.Count)" Color="@StatusColor(_conditionProblems.Count)" Size="Size.Small" />
                <MudText Typo="Typo.subtitle1"><b>@L["ConditionsTitle"]</b></MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@FundLabel(_conditionProblems.Count)</MudText>
            </MudStack>
            @foreach (var problem in _conditionProblems)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="py-1">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @Modules.Name(problem.OwnerModuleKey):
                    </MudText>
                    <MudText Typo="Typo.body2">@problem.Message</MudText>
                </MudStack>
            }
        </MudPaper>

        @* Ringe im Freischaltungs-Baum — dieselbe Frage wie bei zyklischen Rezepten,
           nur eine Ebene höher: Alles im Ring wartet auf sich selbst. *@
        <MudPaper Elevation="0" Class="gdm-panel pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@StatusIcon(_unlockCycles.Count)" Color="@StatusColor(_unlockCycles.Count)" Size="Size.Small" />
                <MudText Typo="Typo.subtitle1"><b>@L["UnlockCyclesTitle"]</b></MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@FundLabel(_unlockCycles.Count)</MudText>
                <MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Text" Href="/modules/techtree">
                    @L["ToTechTree"]
                </MudButton>
            </MudStack>
            @foreach (var cycle in _unlockCycles)
            {
                <MudText Typo="Typo.body2" Class="py-1">@TechTree.DescribeCycle(cycle)</MudText>
            }
        </MudPaper>

        @* Die Wirtschafts-Prüfung: Zutaten billiger als das Ergebnis. Gemeldet, nicht
           verboten — dieselbe Linie wie beim Loot-Check. *@
        <MudPaper Elevation="0" Class="gdm-panel pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@StatusIcon(VisibleMoneyPrinters.Count)" Color="@StatusColor(VisibleMoneyPrinters.Count)" Size="Size.Small" />
                <MudText Typo="Typo.subtitle1"><b>@L["MoneyPrintersTitle"]</b></MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@FundLabel(VisibleMoneyPrinters.Count)</MudText>
                <MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Text" Href="/modules/crafting">
                    @L["ToCrafting"]
                </MudButton>
            </MudStack>

            @if (VisibleMoneyPrinters.Count > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2">
                    @L["MoneyPrintersHint"]
                </MudText>
            }

            @foreach (var printer in VisibleMoneyPrinters)
            {
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="py-1">
                    <MudLink Href="@($"/modules/crafting/{printer.RecipeId}")">@printer.RecipeName</MudLink>
                    <MudText Typo="Typo.body2" Class="gdm-mono" Color="Color.Warning">
                        @L["MoneyPrinterProfit", printer.Profit.ToString("0.##"), printer.IngredientCost.ToString("0.##"), printer.OutputValue.ToString("0.##")]
                    </MudText>
                    @if (!printer.IsCertain)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary">
                            @L["MoneyPrinterUncertain", printer.MissingPrices]
                        </MudChip>
                    }
                    @MuteButton(HealthCheckKeys.MoneyPrinters, printer.RecipeId, printer.RecipeName)
                </MudStack>
            }
        </MudPaper>

        @* Items ohne Preis: die Pflegelücke, die die Gelddruckmaschinen-Prüfung zur
           Vermutung macht. Gemeldet, nicht verboten — ein Quest-Item ohne Preis kann
           Absicht sein. *@
        <MudPaper Elevation="0" Class="gdm-panel pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@StatusIcon(VisibleUnpricedItems.Count)" Color="@StatusColor(VisibleUnpricedItems.Count)" Size="Size.Small" />
                <MudText Typo="Typo.subtitle1"><b>@L["UnpricedItemsTitle"]</b></MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@FundLabel(VisibleUnpricedItems.Count)</MudText>
                <MudSpacer />
                <MudLink Href="/modules/items" Typo="Typo.caption">@L["ToItems"]</MudLink>
            </MudStack>

            @if (VisibleUnpricedItems.Count > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2">
                    @L["UnpricedItemsHint"]
                </MudText>
            }

            @* Bei hunderten unbepreisten Items ist die vollständige Liste keine Auskunft mehr. *@
            @foreach (var item in VisibleUnpricedItems.Take(25))
            {
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="py-1">
                    <MudLink Href="@($"/modules/items/{item.ItemId}")" Typo="Typo.body2">@item.Name</MudLink>
                    @if (item.TypeName is not null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@item.TypeName</MudText>
                    }
                    @MuteButton(HealthCheckKeys.UnpricedItems, item.ItemId, item.Name)
                </MudStack>
            }

            @if (VisibleUnpricedItems.Count > 25)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">
                    @L["UnpricedItemsMore", VisibleUnpricedItems.Count - 25]
                </MudText>
            }
        </MudPaper>

        @* Vertonung: Zeilen, deren Text in einer Sprache vorliegt, ohne dass sie
           eingesprochen wäre. Ohne Sprachen im Projekt findet die Prüfung nichts. *@
        <MudPaper Elevation="0" Class="gdm-panel pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@StatusIcon(_missingRecordings.Count)" Color="@StatusColor(_missingRecordings.Count)" Size="Size.Small" />
                <MudText Typo="Typo.subtitle1"><b>@L["MissingRecordingsTitle"]</b></MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@FundLabel(_missingRecordings.Count)</MudText>
                <MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Text" Href="/modules/dialogs">
                    @L["ToDialogs"]
                </MudButton>
            </MudStack>

            @* Bei hunderten Zeilen ist die vollständige Liste keine Auskunft mehr; die Seite
               des Dialogs zeigt sie ohnehin je Zeile und Sprache. *@
            @foreach (var gap in _missingRecordings.Take(25))
            {
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="py-1">
                    <MudLink Href="@($"/modules/dialogs/{gap.DialogueId}/vertonung")">@gap.DialogueName</MudLink>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@gap.LanguageCode</MudChip>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="gdm-ellipsis">@gap.LineText</MudText>
                </MudStack>
            }

            @if (_missingRecordings.Count > 25)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">
                    @L["MissingRecordingsMore", _missingRecordings.Count - 25]
                </MudText>
            }
        </MudPaper>

        @* Stummgeschaltete Funde: „bewusst so“. Sie zählen nirgends mit, bleiben hier aber
           einsehbar — eine Stummschaltung, die man nicht wiederfindet, wäre ein Rätsel. *@
        @if (_mutedList.Count > 0)
        {
            <MudPaper Elevation="0" Class="gdm-panel pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.VolumeOff" Color="Color.Secondary" Size="Size.Small" />
                    <MudText Typo="Typo.subtitle1"><b>@L["MutedTitle"]</b></MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@_mutedList.Count</MudText>
                </MudStack>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2">
                    @L["MutedHint"]
                </MudText>
                @foreach (var mute in _mutedList)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="py-1">
                        <MudText Typo="Typo.body2">@(mute.EntityName ?? mute.EntityId.ToString())</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@MutedCheckLabel(mute.CheckKey)</MudText>
                        <MudSpacer />
                        <MudTooltip Text="@L["UnmuteTooltip"]">
                            <MudIconButton Icon="@Icons.Material.Filled.VolumeUp"
                                           Size="Size.Small"
                                           aria-label="@L["UnmuteAria"]"
                                           OnClick="@(() => UnmuteAsync(mute))" />
                        </MudTooltip>
                    </MudStack>
                }
            </MudPaper>
        }
    </MudStack>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Statistics);

    private List<ModuleCount>? _counts;
    private NpcBreakdown? _npcBreakdown;
    private List<CraftingCycle> _cycles = [];
    private List<EntitySummary> _deadItems = [];
    private List<EntitySummary> _questsWithoutCompletion = [];
    private List<DialogueProblem> _dialogueProblems = [];
    private List<LootTableListRow> _overfullTables = [];
    private List<OrphanedAsset> _orphanedAssets = [];
    private List<ConditionProblem> _conditionProblems = [];
    private List<UnlockCycle> _unlockCycles = [];
    private List<MoneyPrinter> _moneyPrinters = [];
    private List<UnpricedItem> _unpricedItems = [];
    private List<VoiceOverGap> _missingRecordings = [];

    private Guid _projectId;
    private List<HealthCheckMute> _mutedList = [];
    private HashSet<(string CheckKey, Guid EntityId)> _muted = [];

    protected override async Task OnInitializedAsync()
    {
        _projectId = await Project.GetCurrentIdAsync();
        var projectId = _projectId;

        _npcBreakdown = await Statistics.GetNpcBreakdownAsync(projectId);
        _cycles = await Crafting.FindCyclesAsync(projectId);
        _deadItems = await Statistics.FindDeadItemsAsync(projectId);
        _questsWithoutCompletion = await Quests.FindQuestsWithoutCompletionAsync(projectId);
        _dialogueProblems = await Dialogues.FindProblemsAsync(projectId);
        _overfullTables = await Loot.FindOverfullTablesAsync(projectId);
        _orphanedAssets = await Statistics.FindOrphanedAssetsAsync(projectId);
        _conditionProblems = await Conditions.FindProblemsAsync(projectId);
        _unlockCycles = await TechTree.FindCyclesAsync(projectId);
        _moneyPrinters = await Economy.FindMoneyPrintersAsync(projectId);
        _unpricedItems = await Economy.FindUnpricedItemsAsync(projectId);
        _missingRecordings = await VoiceOvers.FindMissingRecordingsAsync(projectId);

        // Verschwundene Funde nehmen ihre Stummschaltung mit — kein Leichenbestand.
        await Mutes.PruneStaleAsync(projectId, new Dictionary<string, HashSet<Guid>>
        {
            [HealthCheckKeys.DeadItems] = [.. _deadItems.Select(item => item.Id)],
            [HealthCheckKeys.QuestsWithoutCompletion] = [.. _questsWithoutCompletion.Select(quest => quest.Id)],
            [HealthCheckKeys.DialogueDeadEnds] = [.. _dialogueProblems.Select(problem => problem.DialogueId)],
            [HealthCheckKeys.OverfullLoot] = [.. _overfullTables.Select(table => table.Id)],
            [HealthCheckKeys.OrphanedAssets] = [.. _orphanedAssets.Select(orphan => orphan.AssetId)],
            [HealthCheckKeys.MoneyPrinters] = [.. _moneyPrinters.Select(printer => printer.RecipeId)],
            [HealthCheckKeys.UnpricedItems] = [.. _unpricedItems.Select(item => item.ItemId)]
        });
        await ReloadMutesAsync();

        // Zuletzt, weil die Anzeige darauf wartet — so erscheinen die Checks gemeinsam.
        _counts = await Statistics.GetCountsAsync(projectId);
    }

    // ------------------------------------------------------------- Stummschaltung

    private List<EntitySummary> VisibleDeadItems =>
        [.. _deadItems.Where(item => !IsMuted(HealthCheckKeys.DeadItems, item.Id))];

    private List<EntitySummary> VisibleQuests =>
        [.. _questsWithoutCompletion.Where(quest => !IsMuted(HealthCheckKeys.QuestsWithoutCompletion, quest.Id))];

    private List<DialogueProblem> VisibleDialogueProblems =>
        [.. _dialogueProblems.Where(problem => !IsMuted(HealthCheckKeys.DialogueDeadEnds, problem.DialogueId))];

    private List<LootTableListRow> VisibleOverfullTables =>
        [.. _overfullTables.Where(table => !IsMuted(HealthCheckKeys.OverfullLoot, table.Id))];

    private List<OrphanedAsset> VisibleOrphans =>
        [.. _orphanedAssets.Where(orphan => !IsMuted(HealthCheckKeys.OrphanedAssets, orphan.AssetId))];

    private List<MoneyPrinter> VisibleMoneyPrinters =>
        [.. _moneyPrinters.Where(printer => !IsMuted(HealthCheckKeys.MoneyPrinters, printer.RecipeId))];

    private List<UnpricedItem> VisibleUnpricedItems =>
        [.. _unpricedItems.Where(item => !IsMuted(HealthCheckKeys.UnpricedItems, item.ItemId))];

    private bool IsMuted(string checkKey, Guid entityId) => _muted.Contains((checkKey, entityId));

    private async Task ReloadMutesAsync()
    {
        _mutedList = await Mutes.GetForProjectAsync(_projectId);
        _muted = [.. _mutedList.Select(mute => (mute.CheckKey, mute.EntityId))];
    }

    private async Task MuteFindingAsync(string checkKey, Guid entityId, string? entityName)
    {
        try
        {
            await Mutes.MuteAsync(_projectId, checkKey, entityId, entityName);
            await ReloadMutesAsync();
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task UnmuteAsync(HealthCheckMute mute)
    {
        try
        {
            await Mutes.UnmuteAsync(_projectId, mute.CheckKey, mute.EntityId);
            await ReloadMutesAsync();
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /// <summary>Der Stummschalter an einem Fund — „bewusst so“.</summary>
    private RenderFragment MuteButton(string checkKey, Guid entityId, string? entityName) => __builder =>
    {
        <MudTooltip Text="@L["MuteTooltip"]">
            <MudIconButton Icon="@Icons.Material.Filled.VolumeOff"
                           Size="Size.Small"
                           aria-label="@L["MuteAria"]"
                           OnClick="@(() => MuteFindingAsync(checkKey, entityId, entityName))" />
        </MudTooltip>
    };

    /// <summary>Die Beschriftung der Prüfart in der Liste der Stummschaltungen.</summary>
    private string MutedCheckLabel(string checkKey) => checkKey switch
    {
        HealthCheckKeys.DeadItems => L["DeadItemsTitle"],
        HealthCheckKeys.QuestsWithoutCompletion => L["QuestsTitle"],
        HealthCheckKeys.DialogueDeadEnds => L["DialoguesTitle"],
        HealthCheckKeys.OverfullLoot => L["LootTitle"],
        HealthCheckKeys.OrphanedAssets => L["OrphansTitle"],
        HealthCheckKeys.MoneyPrinters => L["MoneyPrintersTitle"],
        HealthCheckKeys.UnpricedItems => L["UnpricedItemsTitle"],
        _ => checkKey
    };

    private static string StatusIcon(int findings) =>
        findings == 0 ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.ReportProblem;

    private static Color StatusColor(int findings) =>
        findings == 0 ? Color.Success : Color.Warning;

    private string FundLabel(int findings) =>
        findings == 0 ? L["NoFindings"] : L["FindingsCount", findings];
}
