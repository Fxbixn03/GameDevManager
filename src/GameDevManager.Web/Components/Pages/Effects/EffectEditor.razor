@page "/modules/effects/neu"
@page "/modules/effects/{Id:guid}"
@inject EffectService Effects
@inject ReferenceService References
@inject ProjectContext Project
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<EffectEditor> L

<PageTitle>@L["PageTitle", PageHeading]</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @L["NotFound"]
    </MudAlert>
    <MudButton Variant="Variant.Outlined" Href="/modules/effects">@L["BackToList"]</MudButton>
}
else if (_context is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <ModuleHeader Module="Module"
                  Title="@PageHeading"
                  Subtitle="@(_context.IsNew ? L["NotSavedYet"].Value : null)"
                  Breadcrumbs="Breadcrumbs">
        <Actions>
            @if (_dirty)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                    @L["UnsavedChanges"]
                </MudChip>
            }
            @if (!_context.IsNew)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteOutline"
                           OnClick="DeleteAsync">
                    @L["Delete"]
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Href="/modules/effects">@L["Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       data-gdm-save
                       Disabled="_saving"
                       OnClick="SaveAsync">
                @L["Save"]
            </MudButton>
        </Actions>
    </ModuleHeader>

    @* Sagt vor dem Speichern, was die Schreibkonflikt-Erkennung erst danach meldet. *@
    <EditingPresenceBanner EntityId="@(_context.IsNew ? null : _context.Entity.Id)" />

    <MudGrid Spacing="4">
        <MudItem xs="12" md="8">
            <MudStack Spacing="4">

                @* ------------------------------------------------------------- Stammdaten *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionMasterData"]</MudText>

                    <MudStack Spacing="4">
                        <MudTextField Value="_context.Entity.Name"
                                      ValueChanged="@((string name) => Touch(() => _context.Entity.Name = name))"
                                      T="string"
                                      Label="@L["NameLabel"]"
                                      Variant="Variant.Outlined"
                                      Immediate="true" />

                        <MudTextField Value="_context.Entity.Description"
                                      ValueChanged="@((string text) => Touch(() => _context.Entity.Description = text))"
                                      T="string"
                                      Label="@L["DescriptionLabel"]"
                                      HelperText="@L["DescriptionHelper"]"
                                      Variant="Variant.Outlined"
                                      Lines="3" />

                        <MudSelect T="Guid?"
                                   Value="_context.Entity.ContentTypeId"
                                   ValueChanged="ChangeType"
                                   Label="@L["TypeLabel"]"
                                   Variant="Variant.Outlined"
                                   Clearable="true"
                                   HelperText="@L["TypeHelper"]">
                            @foreach (var type in _context.AvailableTypes)
                            {
                                <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudStack>
                </MudPaper>

                @* --------------------------------------------------------- Item-Zuweisung *@
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">@L["SectionAssignments"]</MudText>
                        <MudButton StartIcon="@Icons.Material.Filled.Add"
                                   Size="Size.Small"
                                   Disabled="@(_items.Count == 0)"
                                   OnClick="AddAssignment">
                            @L["AddItem"]
                        </MudButton>
                    </MudStack>

                    @if (_items.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">
                            @L["NoItemsHint"]
                            <MudLink Href="/modules/items" Color="Color.Primary">@L["NoItemsLink"]</MudLink>.
                        </MudAlert>
                    }
                    else if (_context.Entity.Assignments.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @L["NoAssignments"]
                        </MudText>
                    }
                    else
                    {
                        <MudStack Spacing="0">
                            @foreach (var assignment in _context.Entity.Assignments)
                            {
                                <div class="pa-2 gdm-field-row">
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="10">
                                            <MudAutocomplete T="EntitySummary"
                                                             Value="@ItemFor(assignment.ItemId)"
                                                             ValueChanged="@((EntitySummary? e) => Touch(() => assignment.ItemId = e?.Id ?? Guid.Empty))"
                                                             SearchFunc="SearchItemsAsync"
                                                             ToStringFunc="@(e => e?.Name ?? string.Empty)"
                                                             Label="@L["ItemLabel"]"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Clearable="true"
                                                             ResetValueOnEmptyText="true"
                                                             CoerceValue="false"
                                                             MaxItems="50" />
                                        </MudItem>

                                        <MudItem xs="12" sm="2" Class="d-flex align-center justify-end">
                                            <MudTooltip Text="@L["RemoveAssignment"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                               Size="Size.Small"
                                                               OnClick="@(() => RemoveAssignment(assignment))"
                                                               aria-label="@L["RemoveAssignment"]" />
                                            </MudTooltip>
                                        </MudItem>
                                    </MudGrid>
                                </div>
                            }
                        </MudStack>
                    }
                </MudPaper>

                @* ------------------------------------------------------------------ Sprites *@
                <AssetSpritePanel ModuleKey="@ModuleKeys.Effects"
                                  EntityId="_context.Entity.Id"
                                  Disabled="_context.IsNew" />

                @* ------------------------------------------------------------------- Felder *@
                <div>
                    <ContentFieldsPanel TEntity="GameEffect"
                                        Context="_context"
                                        ModuleKey="@ModuleKeys.Effects"
                                        TypesRoute="/modules/effects/arten"
                                        IndividualHint="@L["IndividualHint"]"
                                        OnValueChanged="MarkDirty"
                                        OnFieldDefinitionChanged="ReloadKeepingChangesAsync" />
                </div>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudStack Spacing="4">
                <MudPaper Elevation="0" Class="gdm-panel pa-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">@L["SectionReference"]</MudText>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["GuidCaption"]</MudText>
                        @if (!_context.IsNew)
                        {
                            <EntityPinButton ModuleKey="@Module.Id" EntityId="_context.Entity.Id" />
                        }
                    </MudStack>
                    <EntityIdChip Id="_context.Entity.Id" />

                    <MudDivider Class="my-3" />
                    <EntityStatusSelect Entity="_context.Entity" OnChanged="MarkDirty" />

                    @if (!_context.IsNew)
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["CreatedCaption"]</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">@L["UpdatedCaption"]</MudText>
                        <MudText Typo="Typo.body2">@_context.Entity.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                    }
                </MudPaper>

                @if (!_context.IsNew)
                {
                    <EntityTagsPanel ModuleKey="@ModuleKeys.Effects" EntityId="_context.Entity.Id" />
                    <ReferencesPanel @ref="_referencesPanel" EntityId="_context.Entity.Id" />
                    <EntityHistoryPanel @ref="_historyPanel" EntityId="_context.Entity.Id" />
                    <EntityCommentsPanel ModuleKey="@Module.Id" EntityId="_context.Entity.Id" />
                    <EntityTasksPanel EntityId="_context.Entity.Id" />
                }
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Effects);

    [Parameter]
    public Guid? Id { get; set; }

    private ContentEditContext<GameEffect>? _context;
    private ReferencesPanel? _referencesPanel;
    private EntityHistoryPanel? _historyPanel;
    private List<EntitySummary> _items = [];
    private Guid? _loadedId;
    private bool _notFound;
    private bool _saving;
    private bool _dirty;

    private string PageHeading => _context switch
    {
        null => L["PageHeadingDefault"],
        { IsNew: true } => L["PageHeadingNew"],
        { Entity.Name: var name } when !string.IsNullOrWhiteSpace(name) => name,
        _ => L["PageHeadingUnnamed"]
    };

    private List<BreadcrumbItem> Breadcrumbs => [new(PageHeading, null, disabled: true)];

    protected override async Task OnParametersSetAsync()
    {
        if (_context is not null && _loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _notFound = false;
        _dirty = false;
        _context = null;

        var projectId = await Project.GetCurrentIdAsync();
        _items = await References.GetEntitiesAsync(projectId, ModuleKeys.Items);
        _context = await Effects.LoadForEditAsync(projectId, Id);

        if (_context is null)
        {
            _notFound = true;
        }
    }

    private EntitySummary? ItemFor(Guid itemId) => _items.FirstOrDefault(entity => entity.Id == itemId);

    private Task<IEnumerable<EntitySummary>> SearchItemsAsync(string? search, CancellationToken ct)
    {
        IEnumerable<EntitySummary> matches = string.IsNullOrWhiteSpace(search)
            ? _items
            : _items.Where(entity => entity.Name.Contains(search, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(matches);
    }

    private void AddAssignment() =>
        Touch(() => _context!.Entity.Assignments.Add(new EffectAssignment
        {
            GameEffectId = _context.Entity.Id,
            ItemId = Guid.Empty,
            SortOrder = _context.Entity.Assignments.Count
        }));

    private void RemoveAssignment(EffectAssignment assignment) =>
        Touch(() => _context!.Entity.Assignments.Remove(assignment));

    private void ChangeType(Guid? contentTypeId) =>
        Touch(() => _context!.Entity.ContentTypeId = contentTypeId);

    private void Touch(Action change)
    {
        change();
        MarkDirty();
    }

    private void MarkDirty() => _dirty = true;

    private async Task SaveAsync()
    {
        if (_context is null)
        {
            return;
        }

        // Leere Eingabezeilen sind ein Bedienschritt, kein Inhalt.
        _context.Entity.Assignments.RemoveAll(a => a.ItemId == Guid.Empty);

        _saving = true;

        try
        {
            var wasNew = _context.IsNew;
            await Effects.SaveEffectAsync(_context);
            _dirty = false;

            Snackbar.Add(L["SavedMessage", _context.Entity.Name], Severity.Success);

            if (wasNew)
            {
                Navigation.NavigateTo($"/modules/effects/{_context.Entity.Id}");
                return;
            }

            if (_referencesPanel is not null)
            {
                await _referencesPanel.RefreshAsync();
            }

            if (_historyPanel is not null)
            {
                await _historyPanel.RefreshAsync();
            }
        }
        catch (ContentValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_context is null)
        {
            return;
        }

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeleteConfirmTitle"],
            L["DeleteConfirmMessage", _context.Entity.Name],
            yesText: L["DeleteYes"],
            cancelText: L["DeleteCancel"]);

        if (confirmed != true)
        {
            return;
        }

        await Effects.DeleteEffectAsync(_context.Entity.Id);
        Snackbar.Add(L["DeletedMessage"], Severity.Success);
        Navigation.NavigateTo("/modules/effects");
    }

    /// <summary>
    /// Lädt nach einer Änderung an den Felddefinitionen neu und behält dabei, was in der Maske
    /// noch nicht gespeichert ist.
    /// </summary>
    private async Task ReloadKeepingChangesAsync()
    {
        if (_context is null)
        {
            return;
        }

        var entity = _context.Entity;
        var wasDirty = _dirty;

        var projectId = await Project.GetCurrentIdAsync();
        var reloaded = await Effects.LoadForEditAsync(projectId, entity.Id);

        if (reloaded is null)
        {
            _notFound = true;
            _context = null;
            return;
        }

        reloaded.Entity.Name = entity.Name;
        reloaded.Entity.Description = entity.Description;
        reloaded.Entity.ContentTypeId = entity.ContentTypeId;
        reloaded.Entity.Assignments = entity.Assignments;

        _context = reloaded;
        _dirty = wasDirty;
    }
}
