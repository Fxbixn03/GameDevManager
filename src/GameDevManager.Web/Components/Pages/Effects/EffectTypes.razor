@page "/modules/effects/arten"

<PageTitle>Effekt-Arten – GameDevManager</PageTitle>

<ModuleHeader Module="Module"
              Title="Effekt-Arten"
              Subtitle="Die Item-Zuweisung steht fest am Effekt — Wirkungsgrößen wie Schaden und Dauer definieren die Felder der Art."
              Breadcrumbs="Breadcrumbs">
    <Actions>
        <MudButton Variant="Variant.Outlined" Href="/modules/effects">Zu den Effekten</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddAsync">
            Neue Art
        </MudButton>
    </Actions>
</ModuleHeader>

<ContentTypeManager @ref="_manager"
                    ModuleKey="@ModuleKeys.Effects"
                    EntityNoun="Effekt"
                    EmptyTitle="Noch keine Effekt-Arten"
                    EmptyHint="Über Arten lassen sich Wirkungen einteilen — etwa Schaden über Zeit, Buff oder Debuff — und um eigene Felder wie Schadenswert und Dauer ergänzen." />

@code {
    private static readonly ModuleDefinition Module = ModuleRegistry.Get(ModuleKeys.Effects);

    private static readonly List<BreadcrumbItem> Breadcrumbs = [new("Arten", null, disabled: true)];

    private ContentTypeManager? _manager;

    private Task AddAsync() => _manager?.AddTypeAsync() ?? Task.CompletedTask;
}
