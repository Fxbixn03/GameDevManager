<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    @* Ohne Preload lädt die UI-Schrift erst nach dem CSS und der erste Frame flackert.
       Bewusst der unfingerprintete Pfad — genau den fordert app.css per @@font-face an. *@
    <link rel="preload" as="font" type="font/woff2" href="fonts/inter-latin.woff2" crossorigin />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["GameDevManager.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    @* Rechnet Klicks auf das Kartenbild in relative Koordinaten um — die dargestellte
       Bildgröße kennt nur der Browser. *@
    <script src="@Assets["js/gdm-map.js"]"></script>
    @* Globale Tastatur-Shortcuts: Strg+K Suche, Strg+S Speichern, Alt+Buchstabe Navigation. *@
    <script src="@Assets["js/gdm-shortcuts.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    /// <summary>
    /// Interaktiv ist alles — außer den Seiten rund um die Anmeldung. Die sind mit
    /// <c>[ExcludeFromInteractiveRouting]</c> ausgezeichnet und werden statisch gerendert,
    /// weil ein Anmelde-Cookie nur während einer echten HTTP-Antwort gesetzt werden kann;
    /// über die SignalR-Verbindung von Blazor Server gibt es keine, in die es hineinpasste.
    /// </summary>
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
