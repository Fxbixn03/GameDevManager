{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${input:buildTarget}",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Rebuild",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${input:buildTarget}",
                "--no-incremental",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Clean",
            "type": "process",
            "command": "dotnet",
            "args": [
                "clean",
                "${input:buildTarget}",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Run",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${input:runProject}"
            ],
            "isBackground": true,
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Publish",
            "type": "shell",
            "command": "dotnet publish src/GameDevManager.Web --configuration Release ${input:publishTarget}",
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Hot-Reload",
            "type": "process",
            "command": "dotnet",
            "args": [
                "watch",
                "--project",
                "${input:runProject}"
            ],
            "isBackground": true,
            "problemMatcher": "$msCompile"
        }
    ],
    "inputs": [
        {
            "id": "buildTarget",
            "type": "pickString",
            "description": "Was soll gebaut werden?",
            "default": "${workspaceFolder}/GameDevManager.slnx",
            "options": [
                {
                    "label": "Gesamte Solution",
                    "value": "${workspaceFolder}/GameDevManager.slnx"
                },
                {
                    "label": "GameDevManager.Web",
                    "value": "${workspaceFolder}/src/GameDevManager.Web"
                },
                {
                    "label": "GameDevManager.Domain",
                    "value": "${workspaceFolder}/src/GameDevManager.Domain"
                },
                {
                    "label": "GameDevManager.Data",
                    "value": "${workspaceFolder}/src/GameDevManager.Data"
                },
                {
                    "label": "GameDevManager.Data.Migrations.SqlServer",
                    "value": "${workspaceFolder}/src/GameDevManager.Data.Migrations.SqlServer"
                },
                {
                    "label": "GameDevManager.Data.Migrations.PostgreSql",
                    "value": "${workspaceFolder}/src/GameDevManager.Data.Migrations.PostgreSql"
                },
                {
                    "label": "GameDevManager.Data.Migrations.MySql",
                    "value": "${workspaceFolder}/src/GameDevManager.Data.Migrations.MySql"
                },
                {
                    "label": "GameDevManager.Data.Migrations.Sqlite",
                    "value": "${workspaceFolder}/src/GameDevManager.Data.Migrations.Sqlite"
                }
            ]
        },
        {
            "id": "publishTarget",
            "type": "pickString",
            "description": "Für welche Plattform soll veröffentlicht werden?",
            "default": "--output publish/portable",
            "options": [
                {
                    "label": "Portabel (Windows & Linux, .NET-Runtime muss installiert sein)",
                    "value": "--output publish/portable"
                },
                {
                    "label": "Windows x64 (eigenständig, Runtime enthalten)",
                    "value": "--runtime win-x64 --self-contained true --output publish/win-x64"
                },
                {
                    "label": "Linux x64 (eigenständig, Runtime enthalten)",
                    "value": "--runtime linux-x64 --self-contained true --output publish/linux-x64"
                }
            ]
        },
        {
            "id": "runProject",
            "type": "pickString",
            "description": "Welches Projekt soll gestartet werden?",
            "default": "${workspaceFolder}/src/GameDevManager.Web",
            "options": [
                {
                    "label": "GameDevManager.Web",
                    "value": "${workspaceFolder}/src/GameDevManager.Web"
                }
            ]
        }
    ]
}
